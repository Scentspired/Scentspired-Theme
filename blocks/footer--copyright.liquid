{{ 'footer--copyright.css' | asset_url | stylesheet_tag }}


<footer-copyright
  class="ai-footer-copyright"
  style="--copyright-padding-top: {{ block.settings.padding_top }}px; --copyright-padding-bottom: {{ block.settings.padding_bottom }}px; --copyright-background-color: {{ block.settings.background_color }}; --copyright-container-width: {{ block.settings.container_width }}px; --copyright-text-color: {{ block.settings.text_color }}; --copyright-font-size: {{ block.settings.font_size }}px; --copyright-link-color: {{ block.settings.link_color }}; --copyright-link-hover-color: {{ block.settings.link_hover_color }};"
  {{ block.shopify_attributes }}>
  <div class="ai-footer-copyright__container">
    <div class="ai-footer-copyright__content">
      <p class="ai-footer-copyright__text">
        {% if block.settings.show_copyright_symbol %}© {% endif %}
        {% if block.settings.show_year %}{{ "now" | date: "%Y" }} {% endif %}
        {% if block.settings.copyright_text != blank %}
          {{ block.settings.copyright_text }}
        {% else %}
          {{ shop.name }}
        {% endif %}
        {{ block.settings.rights_text }}
        {{ block.settings.credit_label }}
        <a
          href="{{ block.settings.credit_url }}"
          target="_blank"
          rel="noopener"
          class="footer-credit-link">
          {{ block.settings.credit_name }}
        </a>
      </p>
      {% if block.settings.show_powered_by %}
        <span class="ai-footer-copyright__text">
          {%- assign shopify_link_class = 'ai-footer-copyright__link' -%}
          {{ 'sections.footer.powered_by_shopify_html' | t | replace: '[link_class]', shopify_link_class }}
        </span>
      {% endif %}
    </div>
  </div>
</footer-copyright>


{% schema %}
{
  "name": "Footer copyright",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "checkbox",
      "id": "show_copyright_symbol",
      "label": "Show copyright symbol",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_year",
      "label": "Show current year",
      "default": true
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text",
      "placeholder": "Your store name"
    },
    {
      "type": "text",
      "id": "rights_text",
      "label": "Rights statement"
    },
    {
      "type": "text",
      "id": "credit_label",
      "label": "Built by — label"
    },
    {
      "type": "text",
      "id": "credit_name",
      "label": "Built by — name"
    },
    {
      "type": "url",
      "id": "credit_url",
      "label": "Built by — link"
    },
    {
      "type": "checkbox",
      "id": "show_powered_by",
      "label": "Show powered by Shopify",
      "default": false
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link hover color",
      "default": "#cccccc"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 14
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 500,
      "max": 1600,
      "step": 100,
      "unit": "px",
      "label": "Container width",
      "default": 1000
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding bottom",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Footer copyright"
    }
  ]
}
{% endschema %}
