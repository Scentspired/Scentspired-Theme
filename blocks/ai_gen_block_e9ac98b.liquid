{% assign ai_gen_id = block.id | replace: "_", "" | downcase %}

{% style %}
  .ai-split-editorial-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: 40px 0 35px;
  }

  .ai-split-editorial-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 {{ block.settings.horizontal_padding }}px;
  }

  .ai-split-editorial-wrapper-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: {{ block.settings.column_gap }}px;
  }

  .ai-split-editorial-left-{{ ai_gen_id }} {
    max-width: 45%;
  }

  .ai-split-editorial-right-{{ ai_gen_id }} {
    max-width: 72%;
  }

  .ai-split-editorial-heading-line1-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.heading_line_spacing }}px;
    line-height: {{ block.settings.heading_line_height }};
    letter-spacing: -0.02em;
  }

  .ai-split-editorial-prefix-{{ ai_gen_id }} {
    font-family: 'PP Editorial New', serif;
    font-weight: 400;
    font-style: normal;
    font-size: {{ block.settings.prefix_font_size }}px;
    color: {{ block.settings.heading_color }};
  }

  .ai-split-editorial-brand-scent-{{ ai_gen_id }} {
    font-family: 'PP Editorial New', serif;
    font-weight: 400;
    font-style: normal;
    font-size: {{ block.settings.brand_font_size }}px;
    color: {{ block.settings.heading_color }};
  }

  .ai-split-editorial-brand-spired-{{ ai_gen_id }} {
    font-family: 'PPEditorialNew Ultralight Italic';
    font-weight: 400;
    font-style: italic;
    font-size: {{ block.settings.brand_font_size }}px;
    color: {{ block.settings.heading_color }};
  }

  .ai-split-editorial-heading-line2-{{ ai_gen_id }} {
    margin: 0;
    line-height: {{ block.settings.heading_line_height }};
    letter-spacing: -0.02em;
  }

  .ai-split-editorial-start-{{ ai_gen_id }} {
    font-family: 'PP Editorial New', serif;
    font-weight: 400;
    font-style: normal;
    font-size: {{ block.settings.start_font_size }}px;
    color: {{ block.settings.heading_color }};
    margin-right: 5px;
  }

  .ai-split-editorial-bestsellers-{{ ai_gen_id }} {
    font-family: 'PPEditorialNew Italic', serif;
    font-weight: 400;
    font-style: italic;
    font-size: {{ block.settings.bestsellers_font_size }}px;
    color: {{ block.settings.heading_color }};
  }

  .ai-split-editorial-body-{{ ai_gen_id }} {
    font-family: 'PPMori Regular', Arial, sans-serif;
    font-weight: 400;
    font-style: normal;
    font-size: {{ block.settings.body_font_size }}px;
    line-height: {{ block.settings.body_line_height }};
    color: {{ block.settings.body_color }};
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-split-editorial-wrapper-{{ ai_gen_id }} {
      flex-direction: column;
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-split-editorial-left-{{ ai_gen_id }},
    .ai-split-editorial-right-{{ ai_gen_id }} {
      max-width: 100%;
    }

    .ai-split-editorial-prefix-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.prefix_font_size }}px * {{ block.settings.mobile_scale }});
    }

    .ai-split-editorial-brand-scent-{{ ai_gen_id }},
    .ai-split-editorial-brand-spired-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.brand_font_size }}px * {{ block.settings.mobile_scale }});
    }

    .ai-split-editorial-start-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.start_font_size }}px * {{ block.settings.mobile_scale }});
    }

    .ai-split-editorial-bestsellers-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.bestsellers_font_size }}px * {{ block.settings.mobile_scale }});
    }

    .ai-split-editorial-body-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.body_font_size }}px * 0.6);
    }
  }
{% endstyle %}

<div class="ai-split-editorial-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-split-editorial-container-{{ ai_gen_id }}">
    <div class="ai-split-editorial-wrapper-{{ ai_gen_id }}">
      <div class="ai-split-editorial-left-{{ ai_gen_id }}">
        <h2 class="ai-split-editorial-heading-line1-{{ ai_gen_id }}">
          <span class="ai-split-editorial-prefix-{{ ai_gen_id }}">{{ block.settings.prefix_text }}</span>
          <span class="ai-split-editorial-brand-scent-{{ ai_gen_id }}">{{ block.settings.brand_scent_text }}</span
          ><span class="ai-split-editorial-brand-spired-{{ ai_gen_id }}">{{ block.settings.brand_spired_text }}</span>
        </h2>
        <p class="ai-split-editorial-heading-line2-{{ ai_gen_id }}">
          <span class="ai-split-editorial-start-{{ ai_gen_id }}">{{ block.settings.start_text }}</span>
          <span class="ai-split-editorial-bestsellers-{{ ai_gen_id }}">{{ block.settings.bestsellers_text }}</span>
        </p>
      </div>
      <div class="ai-split-editorial-right-{{ ai_gen_id }}">
        <p class="ai-split-editorial-body-{{ ai_gen_id }}">{{ block.settings.body_text }}</p>
      </div>
    </div>
  </div>
</div>

