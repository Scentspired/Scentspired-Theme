                    categoryImageMobile: "https://cdn.shopify.com/s/files/1/0698/9398/0343/files/ScentSpired_-_Scent_Notes_02_-_Orange_Blossom.png?v=1766131997",
                    topNote: "Bergamot, Litchi, Peach",
                    heartNote: "Peony, Jasmine, Orange Blossom, Petalia",
                    baseNote: "Woody Notes, Musk, Moss",
                    moodDescription: "It’s the fragrance of pure optimism — weightless yet magnetic. On High was created for those who lead with quiet brilliance. Its soft floral energy and luminous citrus notes rise effortlessly, leaving behind a clean, confident trail. Modern, gentle, and endlessly fresh.",
                    productUrl: "/products/on-high"
                },
                {
                    productName: "Forbidden Love",
                    productImage: "https://scentspired.com/cdn/shop/files/Forbidden_Love_-_5.jpg?v=1765437875&width=1000",
                    categoryImage: "https://cdn.shopify.com/s/files/1/0698/9398/0343/files/ScentSpired_-_Scent_Notes_02_-_Orange_Blossom.png?v=1766131997",
                    categoryImageMobile: "https://cdn.shopify.com/s/files/1/0698/9398/0343/files/ScentSpired_-_Scent_Notes_02_-_Orange_Blossom.png?v=1766131997",
                    topNote: "Neroli, Bergamot, Pink Pepper, Coriander",
                    heartNote: "Iris, Jasmine, Honeysuckle, Orange Blossom, Rose",
                    baseNote: "Marshmallow, Vanilla, Caramel, Sugar, Labdanum, Musk, Civet",
                    moodDescription: "Crafted for women unafraid to express desire, Forbidden Love is both innocent and daring. Its gourmand sweetness meets deep emotion, leaving an unforgettable trail. This perfume turns attraction into art — warm, romantic, and passionately feminine.",
                    productUrl: "/products/forbidden-love"
                }
            ]
        };

        let activeExpandedContent = null;
        let currentProductIndex = {};

        // Initialize current product index for each category
        Object.keys(aromaData).forEach(category => {
            currentProductIndex[category] = 0;
        });

        function setBlockBackgrounds() {
            const isMobile = window.innerWidth <= 768;
            document.querySelectorAll('.aroma-block').forEach(block => {
                const category = block.dataset.category;
                if (aromaData[category] && aromaData[category].length > 0) {
                    const currentIndex = currentProductIndex[category] || 0;
                    const imageUrl = isMobile ? 
                        aromaData[category][currentIndex].categoryImageMobile : 
                        aromaData[category][currentIndex].categoryImage;
                    block.style.backgroundImage = `url('${imageUrl}')`;
                }
            });
        }

        function resetDesktopView() {
            const centerImage = document.getElementById('aromaImage');
            const productTitle = document.getElementById('productTitle');
            const aromaDetails = document.getElementById('aromaDetails');
            const paginationNumbers = document.getElementById('paginationNumbers');
            const categoryDots = document.getElementById('categoryDots');

            centerImage.style.backgroundImage = 'none';
            centerImage.classList.add('default-state');
            productTitle.textContent = 'SELECT AROMA';

            paginationNumbers.style.display = 'none';
            categoryDots.style.display = 'flex';

            aromaDetails.innerHTML = '';
        }

        function selectProduct(category, productIndex) {
            currentProductIndex[category] = productIndex;
            
            // Update block background
            setBlockBackgrounds();

            // If this category is currently selected, update the main display
            const activeBlock = document.querySelector('.aroma-block.active');
            if (activeBlock && activeBlock.dataset.category === category) {
                selectAroma(category, activeBlock, productIndex);
            }
        }

        function selectAroma(category, element, productIndex = null) {
            const isMobile = window.innerWidth <= 768;
            
            if (productIndex === null) {
                productIndex = currentProductIndex[category] || 0;
            } else {
                currentProductIndex[category] = productIndex;
            }

            const data = aromaData[category][productIndex];

            // Remove active class from all blocks
            document.querySelectorAll('.aroma-block').forEach(block => block.classList.remove('active'));
            
            // Add active class to clicked element
            if (element) {
                element.classList.add('active');
            }

            if (isMobile) {
                // Remove any existing expanded content
                if (activeExpandedContent) {
                    activeExpandedContent.remove();
                    activeExpandedContent = null;
                }

                // Create the expanded content container
                const expandedContent = document.createElement('div');
                expandedContent.classList.add('aroma-expanded-content');

                // Product Image Section
                const productImageContainer = document.createElement('div');
                productImageContainer.classList.add('product-image-container');
                productImageContainer.style.backgroundImage = `url('${data.productImage}')`;

                const productTitleElement = document.createElement('h1');
                productTitleElement.classList.add('product-title');
                productTitleElement.textContent = data.productName;
                productImageContainer.appendChild(productTitleElement);

                // Mobile Product Numbers (like reference image)
                if (aromaData[category].length > 1) {
                    const mobilePaginationNumbers = document.createElement('div');
                    mobilePaginationNumbers.classList.add('mobile-pagination-numbers');
                    
                    aromaData[category].forEach((product, index) => {
                        const numberElement = document.createElement('div');
                        numberElement.classList.add('mobile-pagination-number');
                        if (index === productIndex) {
                            numberElement.classList.add('active');
                        }
                        numberElement.textContent = String(index + 1).padStart(2, '0'); // Format like "01", "02", "03"
                        numberElement.onclick = (e) => {
                            e.stopPropagation();
                            selectAroma(category, element, index);
                        };
                        mobilePaginationNumbers.appendChild(numberElement);
                    });
                    
                    productImageContainer.appendChild(mobilePaginationNumbers);
                }

                expandedContent.appendChild(productImageContainer);

                // Product Details Section
                const detailsContent = document.createElement('div');
                detailsContent.classList.add('details-content');
                detailsContent.innerHTML = `
                    <div class="fragrance-notes">
                        <div class="note-row">
                            <span class="note-label">TOP</span>
                            <span class="note-value">${data.topNote}</span>
                        </div>
                        <div class="note-row">
                            <span class="note-label">HEART</span>
                            <span class="note-value">${data.heartNote}</span>
                        </div>
                        <div class="note-row">
                            <span class="note-label">BASE</span>
                            <span class="note-value">${data.baseNote}</span>
                        </div>
                    </div>
                    <div class="mood-section">
                        <div class="mood-label">MOOD</div>
                        <div class="mood-description">
                            ${data.moodDescription}
                        </div>
                    </div>
                    <a href="${data.productUrl}" class="shop-button">
                        SHOP ${data.productName}
                    </a>
                `;
                expandedContent.appendChild(detailsContent);

                // Insert the expanded content after the clicked block's row
                const clickedRow = element.closest('.blocks-row');
                if (clickedRow) {
                    clickedRow.after(expandedContent);
                    activeExpandedContent = expandedContent;
                }
            } else {
                // Desktop logic
                const centerImage = document.getElementById('aromaImage');
                const productTitle = document.getElementById('productTitle');
                const aromaDetails = document.getElementById('aromaDetails');
                const paginationNumbers = document.getElementById('paginationNumbers');
                const categoryDots = document.getElementById('categoryDots');

                centerImage.classList.remove('default-state');

                centerImage.style.backgroundImage = `url('${data.productImage}')`;
                centerImage.style.backgroundSize = 'cover';
                centerImage.style.backgroundPosition = 'center';
                centerImage.style.backgroundRepeat = 'no-repeat';

                productTitle.textContent = data.productName;

                // Show/hide pagination based on product count
                if (aromaData[category].length > 1) {
                    // Show product numbers, hide category dots
                    paginationNumbers.style.display = 'flex';
                    categoryDots.style.display = 'none';
                    
                    // Generate product numbers
                    paginationNumbers.innerHTML = '';
                    aromaData[category].forEach((product, index) => {
                        const numberElement = document.createElement('div');
                        numberElement.classList.add('pagination-number');
                        if (index === productIndex) {
                            numberElement.classList.add('active');
                        }
                        numberElement.textContent = String(index + 1).padStart(2, '0'); // Format like "01", "02", "03"
                        numberElement.onclick = () => selectProduct(category, index);
                        paginationNumbers.appendChild(numberElement);
                    });
                } else {
                    // Hide product numbers, show category dots
                    paginationNumbers.style.display = 'none';
                    categoryDots.style.display = 'flex';
                }

                aromaDetails.innerHTML = `
                    <div class="fragrance-notes">
                        <div class="note-row">
                            <span class="note-label">TOP</span>
                            <span class="note-value">${data.topNote}</span>
                        </div>
                        <div class="note-row">
                            <span class="note-label">HEART</span>
                            <span class="note-value">${data.heartNote}</span>
                        </div>
                        <div class="note-row">
                            <span class="note-label">BASE</span>
                            <span class="note-value">${data.baseNote}</span>
                        </div>
                    </div>
                    <div class="mood-section">
                        <div class="mood-label">MOOD</div>
                        <div class="mood-description">
                            ${data.moodDescription}
                        </div>
                    </div>
                    <a href="${data.productUrl}" class="shop-button">
                        SHOP ${data.productName}
                    </a>
                `;

                // Update category pagination dot for desktop
                document.querySelectorAll('.pagination-dot').forEach(dot => dot.classList.remove('active'));
                const blocks = Array.from(document.querySelectorAll('.aroma-block'));
                const index = blocks.findIndex(block => block.dataset.category === category);
                if (index !== -1) {
                    document.querySelectorAll('.pagination-dot')[index].classList.add('active');
                }
            }
        }

        // Initial setup on page load
        document.addEventListener('DOMContentLoaded', function() {
            setBlockBackgrounds();
            const isMobile = window.innerWidth <= 768;
           if (!isMobile) {
    const firstBlock = document.querySelector('.aroma-block.active') 
                    || document.querySelector('.aroma-block');
    if (firstBlock) {
        // Run it immediately to populate without delay
        selectAroma(firstBlock.dataset.category, firstBlock);
    }
}
 else {
    document.getElementById('aromaImage').style.display = 'none';
    document.getElementById('aromaDetails').style.display = 'none';
}

        });

        // Handle window resize
        window.addEventListener('resize', function() {
            setBlockBackgrounds();
            const isMobile = window.innerWidth <= 768;
           if (!isMobile) {
    document.getElementById('aromaImage').style.display = 'flex';
    document.getElementById('aromaDetails').style.display = 'flex';
    if (activeExpandedContent) {
        activeExpandedContent.remove();
        activeExpandedContent = null;
    }
    // Auto-select first block again on resize back to desktop
    const firstBlock = document.querySelector('.aroma-block');
    if (firstBlock) {
        selectAroma(firstBlock.dataset.category, firstBlock);
    }
} else {
    document.getElementById('aromaImage').style.display = 'none';
    document.getElementById('aromaDetails').style.display = 'none';
    if (activeExpandedContent) {
        activeExpandedContent.remove();
        activeExpandedContent = null;
    }
}

        });

        // Prevent mobile expanded content from closing on scroll
        document.addEventListener('scroll', function(e) {
            // Don't close expanded content on scroll
        }, { passive: true });

        // Prevent touch events from closing expanded content
        document.addEventListener('touchmove', function(e) {
            // Don't close expanded content on touch move
        }, { passive: true });
    </script>
</body>
</html>

