<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Select Aroma Interactive Section</title>
    <style>
        @font-face {
            font-family: 'PPEditorialNew Italic';
            src: url('https://cdn.shopify.com/s/files/1/0698/9398/0343/files/PPEditorialNew-Italic-BF644b214fb0c0a.otf?v=1751620955') format('opentype');
            font-weight: 900;
            font-style: italic;
        }
        
        @font-face {
            font-family: 'PPMori Regular';
            src: url('https://cdn.shopify.com/s/files/1/0698/9398/0343/files/PPMori-Regular.otf?v=1751621372') format('opentype');
            font-weight: 400;
            font-style: normal;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        .select-aroma-section {
            width: 100%;
            height: 70vh;
            position: relative;
            overflow: hidden;
        }

        .select-aroma-container {
            display: flex;
            height: 70vh;
            width: 100%;
            border-top: 1px solid #bfbec0;
            border-bottom: 1px solid #bfbec0;
        }

        .aroma-categories {
            width: 33.33%;
            height: 100%;
            display: flex;
            flex-direction: column;
        }

        .aroma-image {
            width: 33.33%;
            position: relative;
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #fff;
            border-right: 1px solid #bfbec0;
        }

        .aroma-details {
            width: 33.33%;
            padding: 40px 30px;
            background: #fff;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            overflow-y: auto;
            border-top: 1px solid #bfbec0;
        }

        .blocks-row {
            display: flex;
            height: 33.33%;
        }

        .blocks-row.row-1 .aroma-block,
        .blocks-row.row-2 .aroma-block {
            width: 25%;
            height: 100%;
        }

        .blocks-row.row-3 .aroma-block:nth-child(1),
        .blocks-row.row-3 .aroma-block:nth-child(2) {
            width: 25%;
            height: 100%;
        }

        .blocks-row.row-3 .aroma-block:nth-child(3) {
            width: 25%;
            height: 100%;
        }
         .blocks-row.row-3 .aroma-block:nth-child(4) {
            width: 25%;
            height: 100%;
        }

        .aroma-block {
            position: relative;
            cursor: pointer;
            border: 1px solid rgba(255, 255, 255, 0.2);
            display: flex;
            align-items: flex-start;
            justify-content: flex-start;
            padding: 20px;
            transition: all 0.3s ease;
            overflow: hidden;
            background-color: #888;
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
        }

        .aroma-block::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.3);
            transition: all 0.3s ease;
        }

        .aroma-block:hover::before {
            background: rgba(0, 0, 0, 0.1);
        }

        .aroma-block.active::before {
            background: rgba(0, 0, 0, 0.1);
        }

        .aroma-block h3 {
            color: white;
            font-size: 16px;
            font-weight: 400;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin: 0;
            position: relative;
            z-index: 2;
            font-family: 'PPMori Regular', sans-serif;
        }

        .product-title {
            color: white;
            font-size: 42px;
            font-weight: 300;
            letter-spacing: 4px;
            text-transform: uppercase;
            text-align: center;
            font-family: 'PPMori Regular', sans-serif;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
        }

        .aroma-image.default-state .product-title {
            color: #666;
            font-size: 42px;
            font-weight: 300;
            letter-spacing: 4px;
            text-transform: uppercase;
            text-align: center;
            font-family: 'PPMori Regular', sans-serif;
            text-shadow: none;
        }

        .aroma-image.default-state .pagination-numbers {
            display: none;
        }

        .fragrance-notes {
            margin-bottom: 30px;
        }

        .note-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            padding: 12px 0;
            border-bottom: 1px solid #ddd;
        }

        .note-row:last-child {
            border-bottom: none;
        }

        .note-label {
            font-size: 13px;
            font-weight: 600;
            color: #333;
            letter-spacing: 1px;
            text-transform: uppercase;
            font-family: 'PPMori Regular', sans-serif;
            width: 70px;
            flex-shrink: 0;
        }

        .note-value {
            font-size: 13px;
            color: #666;
            text-align: right;
            font-family: 'PPMori Regular', sans-serif;
            flex: 1;
            margin-left: 20px;
        }

        .mood-section {
            margin-bottom: 30px;
        }

        .mood-label {
            font-size: 13px;
            font-weight: 600;
            color: #333;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-bottom: 18px;
            font-family: 'PPMori Regular', sans-serif;
        }

        .mood-description {
            font-size: 15px;
            line-height: 1.5;
            color: #666;
            font-family: 'PPMori Regular', sans-serif;
        }

        .shop-button {
            border: 2px solid #333;
            background: transparent;
            color: #333;
            padding: 14px 28px;
            font-size: 13px;
            letter-spacing: 2px;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: 'PPMori Regular', sans-serif;
            text-decoration: none;
            display: inline-block;
            text-align: center;
            align-self: flex-start;
        }

        .shop-button:hover {
            background: #333;
            color: white;
        }

        /* Product Numbers in Center Image - Like Reference Image */
        .pagination-numbers {
            position: absolute;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 15px;
            z-index: 10;
        }

        .pagination-number {
            color: rgba(255, 255, 255, 0.6);
            font-size: 16px;
            font-weight: 400;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: 'PPMori Regular', sans-serif;
            letter-spacing: 1px;
        }

        .pagination-number.active {
            color: white;
            font-weight: 600;
        }

        .pagination-number:hover {
            color: white;
        }

        .pagination-dots {
            position: absolute;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 10px;
            z-index: 10;
        }

        .pagination-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.5);
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .pagination-dot.active {
            background: white;
        }

        /* Mobile Product Numbers */
        .mobile-pagination-numbers {
            position: absolute;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 15px;
            z-index: 10;
        }

        .mobile-pagination-number {
            color: rgba(255, 255, 255, 0.6);
            font-size: 16px;
            font-weight: 400;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: 'PPMori Regular', sans-serif;
            letter-spacing: 1px;
        }

        .mobile-pagination-number.active {
            color: white;
            font-weight: 600;
        }

        /* Mobile Styles */
        @media (max-width: 768px) {
            .select-aroma-section {
                height: auto;
            }

            .select-aroma-container {
                flex-direction: column;
                height: auto;
            }

            .aroma-categories {
                width: 100%;
                height: auto;
                min-height: auto;
                padding: 0;
                display: block;
            }

            .blocks-row {
                display: flex;
                flex-wrap: wrap;
                width: 100%;
                height: auto;
                border: none;
            }

            .aroma-block {
                width: 50%;
                flex-basis: 50%;
                max-width: 50%;
                flex-shrink: 0;
                flex-grow: 0;
                height: 200px;
                padding: 20px;
                border: 1px solid rgba(255, 255, 255, 0.2);
            }

           

            .aroma-block h3 {
                font-size: 14px;
                letter-spacing: 1px;
            }

            .aroma-image,
            .aroma-details {
                display: none;
            }

            .mobile-header {
                position: static;
                background: none;
                padding: 40px 20px 20px;
                text-align: left;
                z-index: auto;
            }

            .mobile-header h2 {
                font-size: 28px;
                font-weight: 300;
                letter-spacing: 3px;
                text-transform: uppercase;
                margin: 0;
                color: #333;
                font-family: 'PPMori Regular', sans-serif;
            }

            .back-button {
                display: none;
            }

            .aroma-expanded-content {
                width: 100%;
                display: flex;
                flex-direction: column;
                background: #f5f5f5;
                padding: 0;
                position: relative;
            }

            .aroma-expanded-content .product-image-container {
                width: 100%;
                height: 60vh;
                position: relative;
                background-size: cover;
                background-position: center;
                background-repeat: no-repeat;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .aroma-expanded-content .product-title {
                position: absolute;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
                color: white;
                font-size: 32px;
                letter-spacing: 2px;
                text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
                font-family: 'PPMori Regular', sans-serif;
                display: none;
            }

            .aroma-expanded-content .details-content {
                padding: 30px 20px;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
            }
        }
    </style>
</head>
