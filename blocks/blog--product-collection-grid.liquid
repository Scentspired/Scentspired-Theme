{% assign ai_gen_id = block.id | replace: "_", "" | downcase %}

{% style %}


  .ai-product-grid-container-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: clamp(24px, 3.5vw, 40px) clamp(20px, 4vw, 40px) clamp(64px, 8vw, 96px);
    margin: 0 auto;
    max-width: 1120px;
  }

  .ai-product-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    width: 100%;
    max-width: 100%;
  }

  .ai-product-card-{{ ai_gen_id }} {
    background-color: #FFFFFF;
    border-radius: 12px;
    border: 1px solid rgba(0, 0, 0, 0.07);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
    display: flex;
    flex-direction: row;
    align-items: center;
    text-decoration: none;
    color: inherit;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    overflow: hidden;
  }

  .ai-product-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.07);
    border-color: rgba(140, 109, 70, 0.35);
  }

  .ai-product-image-wrapper-{{ ai_gen_id }} {
    flex: 0 0 48%;
    width: 48%;
    aspect-ratio: 1 / 1;
    position: relative;
    padding: 10px;
    box-sizing: border-box;
  }

  .ai-product-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background-color: #FAF8F5;
    border-radius: 10px;
    box-sizing: border-box;
    display: block;
  }

  .ai-product-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #FAF8F5;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-product-details-{{ ai_gen_id }} {
    flex: 0 0 52%;
    width: 52%;
    padding: 16px 14px 16px 4px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-sizing: border-box;
  }

  .ai-product-title-{{ ai_gen_id }} {
    font-family: 'PPMori Regular', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 6px 0;
    color: #121212;
    letter-spacing: -0.01em;
  }

  .ai-product-vendor-{{ ai_gen_id }} {
    margin: 0;
    line-height: 1.35;
  }

  .ai-vendor-inspired-{{ ai_gen_id }} {
    font-family: 'PPEditorialNew Italic', Georgia, serif;
    font-size: 13.5px;
    font-style: italic;
    color: #8C6D46;
  }

  .ai-vendor-brand-{{ ai_gen_id }} {
    font-family: 'PPMori Regular', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 12.5px;
    font-weight: 400;
    color: #55514C;
  }

  .ai-empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666666;
    font-size: 16px;
  }

  @media screen and (max-width: 749px) {
    .ai-product-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 12px;
    }

      .ai-product-grid-container-{{ ai_gen_id }} {
    padding: 0 20px;
  }

    .ai-product-card-{{ ai_gen_id }} {
      flex-direction: row;
    }

    .ai-product-image-wrapper-{{ ai_gen_id }} {
      flex: 0 0 45%;
      width: 45%;
      padding: 6px;
    }

    .ai-product-details-{{ ai_gen_id }} {
      flex: 0 0 55%;
      width: 55%;
      padding: 12px 16px 12px 20px;
    }

    .ai-product-title-{{ ai_gen_id }} {
      font-size: 18px;
      margin: 0 0 6px 0;
    }

    .ai-vendor-inspired-{{ ai_gen_id }},
    .ai-vendor-brand-{{ ai_gen_id }} {
      font-size: 14px;
    }
  }
{% endstyle %}

<product-collection-grid-{{ ai_gen_id }}
  class="ai-product-grid-container-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}>
  {% if block.settings.collection != blank %}
    {% assign collection = block.settings.collection %}
    {% if collection.products.size > 0 %}
      <div class="ai-product-grid-{{ ai_gen_id }}">
        {% for product in collection.products limit: 3 %}
          <a href="{{ product.url }}" class="ai-product-card-{{ ai_gen_id }}">
            <div class="ai-product-image-wrapper-{{ ai_gen_id }}">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  class="ai-product-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="600"
                  height="600">
              {% else %}
                <div class="ai-product-image-placeholder-{{ ai_gen_id }}">
                  {{ "product-1" | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            <div class="ai-product-details-{{ ai_gen_id }}">
              <h3 class="ai-product-title-{{ ai_gen_id }}">{{ product.title }}</h3>
              {% if product.vendor %}
                <div class="ai-product-vendor-{{ ai_gen_id }}">
                  {% assign vendor_lower = product.vendor | downcase %}
                  {% if vendor_lower contains "inspired by" %}
                    {% assign parts = product.vendor | split: "Inspired By" %}
                    {% if parts.size == 1 %}
                      {% assign parts = product.vendor | split: "inspired by" %}
                    {% endif %}
                    {% if parts.size == 1 %}
                      {% assign parts = product.vendor | split: "Inspired by" %}
                    {% endif %}
                    {% if parts.size == 1 %}
                      {% assign parts = product.vendor | split: "INSPIRED BY" %}
                    {% endif %}

                    {% if parts.size > 1 %}
                      <span class="ai-vendor-inspired-{{ ai_gen_id }}">Inspired By<br></span>
                      <span class="ai-vendor-brand-{{ ai_gen_id }}">{{ parts[1] | strip }}</span>
                    {% else %}
                      <span class="ai-vendor-brand-{{ ai_gen_id }}">{{ product.vendor }}</span>
                    {% endif %}
                  {% else %}
                    <span class="ai-vendor-brand-{{ ai_gen_id }}">{{ product.vendor }}</span>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          </a>
        {% endfor %}
      </div>
    {% else %}
      <div class="ai-empty-state-{{ ai_gen_id }}">
        This collection has no products yet. Add products to see them here.
      </div>
    {% endif %}
  {% else %}
    <div class="ai-empty-state-{{ ai_gen_id }}">Select a collection to display products</div>
  {% endif %}
</product-collection-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductCollectionGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupAccessibility();
      }

      setupAccessibility() {
        const cards = this.querySelectorAll('.ai-product-card-{{ ai_gen_id }}');
        cards.forEach(card => {
          card.setAttribute('role', 'link');
        });
      }
    }

    customElements.define('product-collection-grid-{{ ai_gen_id }}', ProductCollectionGrid{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Product collection grid",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "paragraph",
      "content": "This block displays exactly 3 products from the selected collection. If the vendor name contains 'Inspired By', it will be split: 'Inspired By' in italic PPEditorialNew font, and the brand name in PPMori Regular font."
    }
  ],
  "presets": [
    {
      "name": "Product collection grid"
    }
  ]
}
{% endschema %}
