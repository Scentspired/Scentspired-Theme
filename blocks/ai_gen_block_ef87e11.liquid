{% doc %}
  @prompt
    1. Tabbed Layout

    Section has a heading (editable in theme editor).

    Under the heading, multiple tabs (up to 20).

    Each tab has a label and links to a Shopify collection (selectable in theme editor).

    When I click a tab, it shows the products from that collection without reloading the page.

    The first tab should be active by default.

    On mobile, tabs should scroll horizontally with smooth scrolling.

    2. Product Card Design

    Each product inside the tab should use the same design as my collection section.
    That means every product card must include:

    Image:

    Fixed portrait aspect ratio (square/rectangle, consistent height).

    Hover effect: zoom-in or show secondary image if available.

    Stock Badge:

    Small label in top-right corner of the product image.

    Shows “In Stock” (black/white) if available, hidden if sold out.

    Title:

    Product title below the image.

    2-line maximum, with ellipsis (…) if too long.

    Font: Nexa (weight 600).

    Price:

    Display currency + product price.

    If product has a discount: show sale price (red) and compare-at-price (gray, strikethrough).

    Stock Indicator (Optional):

    Small text below price showing quantity in stock (e.g., “12 in stock”).

    A colored dot (green for available, red for out of stock).

    Variant Options:

    If product has color options: show clickable color swatches (small circles).

    If product has size/options: show dropdowns or buttons depending on type.

    Quantity Selector:

    Plus (+) and minus (–) buttons with an input field between them.

    Add to Cart Button:

    Large, full-width, blue button with rounded corners.

    Shows “Add to cart” if available.

    Shows “Sold out” (gray, disabled) if unavailable.

    Must correctly add product to Shopify cart (with selected variant & quantity).

    3. Responsiveness

    Desktop/Laptop (≥1024px): 4 products per row.

    Mobile (≤767px): 2 products per row.

    Cards must have equal height for consistent layout.

    Section should be full width with only small side padding (around 20px) so it looks professional.

    4. Them
{% enddoc %}
{% assign ai_gen_id = block.id | replace: "_", "" | downcase %}

{% style %}
  .ai-tabbed-collection-{{ ai_gen_id }} {
    width: 100%;
    padding: 0 20px;
    max-width: 100%;
  }

  .ai-tabbed-collection__heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: 32px;
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    font-weight: 600;
  }

  .ai-tabbed-collection__tabs-container-{{ ai_gen_id }} {
    margin-bottom: 40px;
    position: relative;
  }

  .ai-tabbed-collection__tabs-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-behavior: smooth;
    padding-bottom: 8px;
  }

  .ai-tabbed-collection__tabs-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-tabbed-collection__tab-{{ ai_gen_id }} {
    flex-shrink: 0;
    padding: 12px 24px;
    background: transparent;
    border: 2px solid {{ block.settings.tab_border_color }};
    border-radius: {{ block.settings.tab_border_radius }}px;
    cursor: pointer;
    transition: all 0.3s ease;
    color: {{ block.settings.tab_text_color }};
    font-weight: 500;
    white-space: nowrap;
  }

  .ai-tabbed-collection__tab-{{ ai_gen_id }}:hover {
    border-color: {{ block.settings.tab_active_color }};
    color: {{ block.settings.tab_active_color }};
  }

  .ai-tabbed-collection__tab-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.tab_active_color }};
    border-color: {{ block.settings.tab_active_color }};
    color: {{ block.settings.tab_active_text_color }};
  }

  .ai-tabbed-collection__content-{{ ai_gen_id }} {
    min-height: 400px;
  }

  .ai-tabbed-collection__tab-content-{{ ai_gen_id }} {
    display: none;
  }

  .ai-tabbed-collection__tab-content-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-tabbed-collection__products-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .ai-tabbed-collection__product-card-{{ ai_gen_id }} {
    background: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .ai-tabbed-collection__product-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
  }

  .ai-tabbed-collection__product-image-container-{{ ai_gen_id }} {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .ai-tabbed-collection__product-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-tabbed-collection__product-card-{{ ai_gen_id }}:hover .ai-tabbed-collection__product-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-tabbed-collection__stock-badge-{{ ai_gen_id }} {
    position: absolute;
    top: 8px;
    right: 8px;
    background: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 500;
  }

  .ai-tabbed-collection__product-info-{{ ai_gen_id }} {
    padding: 16px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .ai-tabbed-collection__product-title-{{ ai_gen_id }} {
    font-family: 'Nexa', sans-serif;
    font-weight: 600;
    font-size: 16px;
    line-height: 1.3;
    margin-bottom: 8px;
    color: {{ block.settings.product_title_color }};
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ai-tabbed-collection__product-price-{{ ai_gen_id }} {
    margin-bottom: 12px;
  }

  .ai-tabbed-collection__price-regular-{{ ai_gen_id }} {
    font-weight: 600;
    color: {{ block.settings.price_color }};
  }

  .ai-tabbed-collection__price-sale-{{ ai_gen_id }} {
    color: {{ block.settings.sale_price_color }};
    font-weight: 600;
    margin-right: 8px;
  }

  .ai-tabbed-collection__price-compare-{{ ai_gen_id }} {
    color: {{ block.settings.compare_price_color }};
    text-decoration: line-through;
    font-size: 14px;
  }

  .ai-tabbed-collection__stock-indicator-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 12px;
    font-size: 14px;
    color: {{ block.settings.stock_text_color }};
  }

  .ai-tabbed-collection__stock-dot-{{ ai_gen_id }} {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .ai-tabbed-collection__stock-dot-{{ ai_gen_id }}.in-stock {
    background-color: {{ block.settings.in_stock_color }};
  }

  .ai-tabbed-collection__stock-dot-{{ ai_gen_id }}.out-of-stock {
    background-color: {{ block.settings.out_stock_color }};
  }

  .ai-tabbed-collection__variants-{{ ai_gen_id }} {
    margin-bottom: 12px;
  }

  .ai-tabbed-collection__color-swatches-{{ ai_gen_id }} {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 8px;
  }

  .ai-tabbed-collection__color-swatch-{{ ai_gen_id }} {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 2px solid #ddd;
    cursor: pointer;
    transition: transform 0.2s ease;
  }

  .ai-tabbed-collection__color-swatch-{{ ai_gen_id }}:hover {
    transform: scale(1.1);
  }

  .ai-tabbed-collection__color-swatch-{{ ai_gen_id }}.selected {
    border-color: {{ block.settings.tab_active_color }};
    transform: scale(1.1);
  }

  .ai-tabbed-collection__variant-select-{{ ai_gen_id }} {
    width: 100%;
    padding: 8px 12px;
    border: 1px solid #ddd;
    border-radius: 4px;
    margin-bottom: 8px;
  }

  .ai-tabbed-collection__quantity-selector-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
  }

  .ai-tabbed-collection__quantity-btn-{{ ai_gen_id }} {
    width: 32px;
    height: 32px;
    border: 1px solid #ddd;
    background: white;
    border-radius: 4px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
  }

  .ai-tabbed-collection__quantity-input-{{ ai_gen_id }} {
    width: 60px;
    text-align: center;
    border: 1px solid #ddd;
    border-radius: 4px;
    padding: 8px;
  }

  .ai-tabbed-collection__add-to-cart-{{ ai_gen_id }} {
    width: 100%;
    padding: 12px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.3s ease;
    margin-top: auto;
  }

  .ai-tabbed-collection__add-to-cart-{{ ai_gen_id }}:hover:not(:disabled) {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-tabbed-collection__add-to-cart-{{ ai_gen_id }}:disabled {
    background-color: {{ block.settings.button_disabled_color }};
    cursor: not-allowed;
  }

  .ai-tabbed-collection__empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666;
  }

  @media screen and (max-width: 767px) {
    .ai-tabbed-collection__products-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    .ai-tabbed-collection__product-info-{{ ai_gen_id }} {
      padding: 12px;
    }

    .ai-tabbed-collection__product-title-{{ ai_gen_id }} {
      font-size: 14px;
    }

    .ai-tabbed-collection__tabs-{{ ai_gen_id }} {
      gap: 6px;
    }

    .ai-tabbed-collection__tab-{{ ai_gen_id }} {
      padding: 10px 16px;
      font-size: 14px;
    }
  }
{% endstyle %}
<tabbed-collection-{{ ai_gen_id }}
  class="ai-tabbed-collection-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-tabbed-collection__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
  {% endif %}

  <div class="ai-tabbed-collection__tabs-container-{{ ai_gen_id }}">
    <div class="ai-tabbed-collection__tabs-{{ ai_gen_id }}">
      {% for i in (1..20) %}
        {% assign tab_label_key = "tab_" | append: i | append: "_label" %}
        {% assign tab_collection_key = "tab_" | append: i | append: "_collection" %}
        {% assign tab_label = block.settings[tab_label_key] %}
        {% assign tab_collection = block.settings[tab_collection_key] %}

        {% if tab_label != blank and tab_collection != blank %}
          <button
            class="ai-tabbed-collection__tab-{{ ai_gen_id }}{% if forloop.first %} active{% endif %}"
            data-tab-index="{{ forloop.index0 }}">
            {{ tab_label }}
          </button>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <div class="ai-tabbed-collection__content-{{ ai_gen_id }}">
    {% for i in (1..20) %}
      {% assign tab_label_key = "tab_" | append: i | append: "_label" %}
      {% assign tab_collection_key = "tab_" | append: i | append: "_collection" %}
      {% assign tab_label = block.settings[tab_label_key] %}
      {% assign tab_collection = block.settings[tab_collection_key] %}

      {% if tab_label != blank and tab_collection != blank %}
        <div
          class="ai-tabbed-collection__tab-content-{{ ai_gen_id }}{% if forloop.first %} active{% endif %}"
          data-tab-content="{{ forloop.index0 }}">
          {% if tab_collection.products.size > 0 %}
            <div class="ai-tabbed-collection__products-grid-{{ ai_gen_id }}">
              {% for product in tab_collection.products limit: block.settings.products_per_tab %}
                <div class="ai-tabbed-collection__product-card-{{ ai_gen_id }}">
                  <div class="ai-tabbed-collection__product-image-container-{{ ai_gen_id }}">
                    {% if product.featured_image %}
                      <img
                        src="{{ product.featured_image | image_url: width: 400 }}"
                        alt="{{ product.featured_image.alt | escape }}"
                        class="ai-tabbed-collection__product-image-{{ ai_gen_id }}"
                        loading="lazy"
                        width="400"
                        height="400">
                    {% else %}
                      <div class="ai-tabbed-collection__product-image-placeholder-{{ ai_gen_id }}">
                        {{ "product-1" | placeholder_svg_tag }}
                      </div>
                    {% endif %}

                    {% if product.available and block.settings.show_stock_badge %}
                      <div class="ai-tabbed-collection__stock-badge-{{ ai_gen_id }}">In Stock</div>
                    {% endif %}
                  </div>

                  <div class="ai-tabbed-collection__product-info-{{ ai_gen_id }}">
                    <h3 class="ai-tabbed-collection__product-title-{{ ai_gen_id }}">
                      {{ product.title }}
                    </h3>
                    <div class="ai-tabbed-collection__product-price-{{ ai_gen_id }}">
                      {% if product.compare_at_price > product.price %}
                        <span class="ai-tabbed-collection__price-sale-{{ ai_gen_id }}">
                          {{ product.price | money }}
                        </span>
                        <span class="ai-tabbed-collection__price-compare-{{ ai_gen_id }}">
                          {{ product.compare_at_price | money }}
                        </span>
                      {% else %}
                        <span class="ai-tabbed-collection__price-regular-{{ ai_gen_id }}">
                          {{ product.price | money }}
                        </span>
                      {% endif %}
                    </div>

                    {% if block.settings.show_stock_indicator %}
                      <div class="ai-tabbed-collection__stock-indicator-{{ ai_gen_id }}">
                        <span
                          class="ai-tabbed-collection__stock-dot-{{ ai_gen_id }} {% if product.available %}in-stock{% else %}out-of-stock{% endif %}"></span>
                        {% if product.available %}
                          {% assign total_inventory = 0 %}
                          {% for variant in product.variants %}
                            {% assign total_inventory = total_inventory | plus: variant.inventory_quantity %}
                          {% endfor %}
                          {{ total_inventory }} in stock
                        {% else %}
                          Out of stock
                        {% endif %}
                      </div>
                    {% endif %}

                    {% if product.has_only_default_variant == false %}
                      <div class="ai-tabbed-collection__variants-{{ ai_gen_id }}">
                        {% for option in product.options_with_values %}
                          {% if option.name == "Color" %}
                            <div class="ai-tabbed-collection__color-swatches-{{ ai_gen_id }}">
                              {% for value in option.values %}
                                <div
                                  class="ai-tabbed-collection__color-swatch-{{ ai_gen_id }}{% if forloop.first %} selected{% endif %}"
                                  style="background-color: {{ value | downcase }};"
                                  data-option-value="{{ value | escape }}"
                                  data-product-id="{{ product.id }}"></div>
                              {% endfor %}
                            </div>
                          {% else %}
                            <select
                              class="ai-tabbed-collection__variant-select-{{ ai_gen_id }}"
                              data-option-name="{{ option.name | escape }}"
                              data-product-id="{{ product.id }}">
                              {% for value in option.values %}
                                <option value="{{ value | escape }}">{{ value }}</option>
                              {% endfor %}
                            </select>
                          {% endif %}
                        {% endfor %}
                      </div>
                    {% endif %}

                    <div class="ai-tabbed-collection__quantity-selector-{{ ai_gen_id }}">
                      <button
                        class="ai-tabbed-collection__quantity-btn-{{ ai_gen_id }}"
                        data-action="decrease"
                        data-product-id="{{ product.id }}">
                        −
                      </button>
                      <input
                        type="number"
                        value="1"
                        min="1"
                        class="ai-tabbed-collection__quantity-input-{{ ai_gen_id }}"
                        data-product-id="{{ product.id }}">
                      <button
                        class="ai-tabbed-collection__quantity-btn-{{ ai_gen_id }}"
                        data-action="increase"
                        data-product-id="{{ product.id }}">
                        +
                      </button>
                    </div>

                    <button
                      class="ai-tabbed-collection__add-to-cart-{{ ai_gen_id }}"
                      data-product-id="{{ product.id }}"
                      data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                      {% unless product.available %}
                        disabled
                      {% endunless %}>
                      {% if product.available %}
                        Add to cart
                      {% else %}
                        Sold out
                      {% endif %}
                    </button>
                  </div>
                </div>
              {% endfor %}
            </div>
          {% else %}
            <div class="ai-tabbed-collection__empty-state-{{ ai_gen_id }}">
              <p>No products found in this collection.</p>
            </div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</tabbed-collection-{{ ai_gen_id }}>

<script>
  (function() {
    class TabbedCollection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.tabs = [];
        this.tabContents = [];
        this.productVariants = {};}

      connectedCallback() {
        this.tabs = this.querySelectorAll('.ai-tabbed-collection__tab-{{ ai_gen_id }}');
        this.tabContents = this.querySelectorAll('.ai-tabbed-collection__tab-content-{{ ai_gen_id }}');
        
        this.setupTabs();
        this.setupQuantitySelectors();
        this.setupVariantSelectors();
        this.setupAddToCart();
        this.loadProductVariants();
      }

      setupTabs() {
        this.tabs.forEach((tab, index) => {
          tab.addEventListener('click', () => {
            this.switchTab(index);
          });
        });
      }

      switchTab(activeIndex) {
        this.tabs.forEach((tab, index) => {
          tab.classList.toggle('active', index === activeIndex);
        });

        this.tabContents.forEach((content, index) => {
          content.classList.toggle('active', index === activeIndex);
        });
      }

      setupQuantitySelectors() {
        const quantityButtons = this.querySelectorAll('.ai-tabbed-collection__quantity-btn-{{ ai_gen_id }}');
        const quantityInputs = this.querySelectorAll('.ai-tabbed-collection__quantity-input-{{ ai_gen_id }}');

        quantityButtons.forEach(button => {
          button.addEventListener('click', (e) => {
            const action = e.target.dataset.action;
            const productId = e.target.dataset.productId;
            const input = this.querySelector(`[data-product-id="${productId}"].ai-tabbed-collection__quantity-input-{{ ai_gen_id }}`);
            
            let currentValue = parseInt(input.value);
            
            if (action === 'increase') {
              input.value = currentValue + 1;
            } else if (action === 'decrease' && currentValue > 1) {
              input.value = currentValue - 1;
            }
          });
        });

        quantityInputs.forEach(input => {
          input.addEventListener('change', (e) => {
            const value = parseInt(e.target.value);
            if (value < 1) {
              e.target.value = 1;
            }
          });
        });
      }

      setupVariantSelectors() {
        const colorSwatches = this.querySelectorAll('.ai-tabbed-collection__color-swatch-{{ ai_gen_id }}');
        const variantSelects = this.querySelectorAll('.ai-tabbed-collection__variant-select-{{ ai_gen_id }}');

        colorSwatches.forEach(swatch => {
          swatch.addEventListener('click', (e) => {
            const productId = e.target.dataset.productId;
            const swatches = this.querySelectorAll(`[data-product-id="${productId}"].ai-tabbed-collection__color-swatch-{{ ai_gen_id }}`);
            
            swatches.forEach(s => s.classList.remove('selected'));
            e.target.classList.add('selected');
            
            this.updateVariantId(productId);
          });
        });

        variantSelects.forEach(select => {
          select.addEventListener('change', (e) => {
            const productId = e.target.dataset.productId;
            this.updateVariantId(productId);
          });
        });
      }

      async loadProductVariants() {
        const productCards = this.querySelectorAll('.ai-tabbed-collection__product-card-{{ ai_gen_id }}');
        
        for (const card of productCards) {
          const addToCartBtn = card.querySelector('.ai-tabbed-collection__add-to-cart-{{ ai_gen_id }}');
          const productId = addToCartBtn.dataset.productId;
          
          try {
            const response = await fetch(`/products/${productId}.js`);
            const product = await response.json();
            this.productVariants[productId] = product.variants;
          } catch (error) {
            console.error('Failed to load product variants:', error);
          }
        }
      }

      updateVariantId(productId) {
        const card = this.querySelector(`[data-product-id="${productId}"].ai-tabbed-collection__add-to-cart-{{ ai_gen_id }}`).closest('.ai-tabbed-collection__product-card-{{ ai_gen_id }}');
        const selectedOptions = {};
        
        const selectedColor = card.querySelector('.ai-tabbed-collection__color-swatch-{{ ai_gen_id }}.selected');
        if (selectedColor) {
          selectedOptions['Color'] = selectedColor.dataset.optionValue;
        }
        
        const selects = card.querySelectorAll('.ai-tabbed-collection__variant-select-{{ ai_gen_id }}');
        selects.forEach(select => {
          selectedOptions[select.dataset.optionName] = select.value;
        });
        
        const variants = this.productVariants[productId];
        if (variants) {
          const matchingVariant = variants.find(variant => {
            return variant.options.every((option, index) => {
              const optionName = Object.keys(selectedOptions)[index];
              return selectedOptions[optionName] === option;
            });
          });
          
          if (matchingVariant) {
            const addToCartBtn = card.querySelector('.ai-tabbed-collection__add-to-cart-{{ ai_gen_id }}');
            addToCartBtn.dataset.variantId = matchingVariant.id;
          }
        }
      }

      setupAddToCart() {
        const addToCartButtons = this.querySelectorAll('.ai-tabbed-collection__add-to-cart-{{ ai_gen_id }}');
        
        addToCartButtons.forEach(button => {
          button.addEventListener('click', async (e) => {
            if (e.target.disabled) return;
            
            const productId = e.target.dataset.productId;
            const variantId = e.target.dataset.variantId;
            const quantityInput = this.querySelector(`[data-product-id="${productId}"].ai-tabbed-collection__quantity-input-{{ ai_gen_id }}`);
            const quantity = parseInt(quantityInput.value);
            
            try {
              const response = await fetch('/cart/add.js', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                  id: variantId,
                  quantity: quantity
                })
              });
              
              if (response.ok) {
                window.dispatchEvent(new CustomEvent('cart:updated'));
                e.target.textContent = 'Added!';
                setTimeout(() => {
                  e.target.textContent = 'Add to cart';
                }, 2000);
              } else {
                throw new Error('Failed to add to cart');
              }
            } catch (error) {
              console.error('Error adding to cart:', error);
              e.target.textContent = 'Error';
              setTimeout(() => {
                e.target.textContent = 'Add to cart';
              }, 2000);
            }
          });
        });
      }
    }

    customElements.define('tabbed-collection-{{ ai_gen_id }}', TabbedCollection{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Tabbed collections",
  "settings": [
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
