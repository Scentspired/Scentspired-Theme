            class="ai-instagram-image-{{ ai_gen_id }}">
        </a>
      </div>
    {% endif %}

    {% if section.settings.image_3 != blank %}
      <div class="ai-instagram-item-{{ ai_gen_id }}" style="animation-delay:0.6s">
        <a
          href="{{ section.settings.instagram_url }}"
          target="_blank"
          rel="noopener"
          class="ai-instagram-link-{{ ai_gen_id }}">
          <img
            src="{{ section.settings.image_3 | image_url: width: 600 }}"
