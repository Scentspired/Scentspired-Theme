      </div>
    {% endif %}

    {% if section.settings.image_5 != blank %}
      <div class="ai-instagram-item-{{ ai_gen_id }}" style="animation-delay:1.2s">
        <a
          href="{{ section.settings.instagram_url }}"
          target="_blank"
          rel="noopener"
          class="ai-instagram-link-{{ ai_gen_id }}">
          <img
            src="{{ section.settings.image_5 | image_url: width: 600 }}"
            alt="Instagram Image 5"
            class="ai-instagram-image-{{ ai_gen_id }}">
        </a>
      </div>
    {% endif %}

    {% if section.settings.image_6 != blank %}
      <div class="ai-instagram-item-{{ ai_gen_id }}" style="animation-delay:1.5s">
        <a
          href="{{ section.settings.instagram_url }}"
          target="_blank"
          rel="noopener"
          class="ai-instagram-link-{{ ai_gen_id }}">
          <img
            src="{{ section.settings.image_6 | image_url: width: 600 }}"
            alt="Instagram Image 6"
            class="ai-instagram-image-{{ ai_gen_id }}">
        </a>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Instagram feed",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Instagram profile"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram profile URL"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image 3"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "Image 4"
    },
    {
      "type": "image_picker",
      "id": "image_5",
      "label": "Image 5"
    },
    {
      "type": "image_picker",
      "id": "image_6",
      "label": "Image 6"
    }
  ],
  "presets": [
    {
      "name": "Instagram feed"
    }
  ]
}
{% endschema %}
