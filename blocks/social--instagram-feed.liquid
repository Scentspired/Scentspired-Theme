{% doc %}
  @prompt
    Create a Shopify custom section (Liquid + CSS + schema) for an Instagram feed identical to the SERVA reference (https://webflow.com/made-in-webflow/website/serva-7019aa
    ).

    Requirements:

    Layout & Responsiveness

    6 Instagram images in one row on large desktop.

    3 images per row on tablets.

    2 images per row on mobile.

    Fully optimized for all screen sizes (desktop, tablet, mobile, MacBook).

    Images & Link

    Admin can upload 6 images from the Shopify theme editor (image_picker).

    Each image should open a single Instagram profile link (url setting in schema).

    Animation (Bounce Effect)

    Each image bounces one-by-one in sequence, exactly like the SERVA reference.

    Timing example: first image bounces → pause → second image bounces → pause → third image bounces → … → sixth image bounces → loop restarts.

    The sequence must loop infinitely.

    Use CSS keyframes bounce animation, not JavaScript.

    Theme Editor Customization

    Upload images via theme editor (6 slots).

    Set Instagram profile link once (applied to all images).

    Code Output

    Provide complete Shopify section code (.liquid file).

    Must include:

    Liquid markup

    Responsive CSS grid

    Bounce animation with sequential delay

    JSON schema for theme editor
{% enddoc %}
{% assign ai_gen_id = section.id | replace: "_", "" | downcase %}

{% assign ai_gen_id = section.id | replace: "_", "" | downcase %}

{% style %}
  .ai-instagram-feed-{{ ai_gen_id }} {
    width: 100%;
    padding: 40px 20px;
  }

  .ai-instagram-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 16px;
    max-width: 1400px; /* keeps images centered */
    margin: 0 auto;
  }

  .ai-instagram-item-{{ ai_gen_id }} {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 8px;
    animation: ai-instagram-bounce-{{ ai_gen_id }} 2s ease-in-out infinite;
  }

  .ai-instagram-link-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
    transition: transform 0.3s ease;
  }

  .ai-instagram-link-{{ ai_gen_id }}:hover {
    transform: scale(1.05);
  }

  .ai-instagram-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-instagram-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-instagram-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-instagram-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 8px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 10px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @keyframes ai-instagram-bounce-{{ ai_gen_id }} {
    0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
    40% { transform: translateY(-12px); }
    60% { transform: translateY(-6px); }
  }

  @media screen and (max-width: 1024px) {
    .ai-instagram-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-instagram-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
    }
    .ai-instagram-feed-{{ ai_gen_id }} {
      padding: 20px 16px;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-instagram-empty-state-{{ ai_gen_id }} {
      font-size: 8px;
    }
  }
{% endstyle %}

<div class="ai-instagram-feed-{{ ai_gen_id }}" {{ section.shopify_attributes }}>
  <div class="ai-instagram-grid-{{ ai_gen_id }}">
    {% if section.settings.image_1 != blank %}
      <div class="ai-instagram-item-{{ ai_gen_id }}" style="animation-delay:0s">
        <a
          href="{{ section.settings.instagram_url }}"
          target="_blank"
          rel="noopener"
          class="ai-instagram-link-{{ ai_gen_id }}">
          <img
            src="{{ section.settings.image_1 | image_url: width: 600 }}"
            alt="Instagram Image 1"
            class="ai-instagram-image-{{ ai_gen_id }}">
        </a>
      </div>
    {% endif %}

    {% if section.settings.image_2 != blank %}
      <div class="ai-instagram-item-{{ ai_gen_id }}" style="animation-delay:0.3s">
        <a
          href="{{ section.settings.instagram_url }}"
          target="_blank"
          rel="noopener"
          class="ai-instagram-link-{{ ai_gen_id }}">
