        </a>
      </div>
    {% endif %}

    {% if section.settings.image_4 != blank %}
      <div class="ai-instagram-item-{{ ai_gen_id }}" style="animation-delay:0.9s">
        <a
          href="{{ section.settings.instagram_url }}"
          target="_blank"
          rel="noopener"
          class="ai-instagram-link-{{ ai_gen_id }}">
          <img
            src="{{ section.settings.image_4 | image_url: width: 600 }}"
            alt="Instagram Image 4"
            class="ai-instagram-image-{{ ai_gen_id }}">
