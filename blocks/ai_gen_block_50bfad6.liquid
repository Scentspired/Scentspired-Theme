{% doc %}
  @prompt
    create coming soon page, in email placeholder show enter you email address and i want different image of mobile background image, make background video , i dont want any overlay
{% enddoc %}
{% assign ai_gen_id = block.id | replace: "_", "" | downcase %}

{% style %}
  .ai-coming-soon-{{ ai_gen_id }} {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.background_color }};
    padding: 40px 20px;
    position: relative;
    overflow: hidden;
  }

  .ai-coming-soon-background-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-coming-soon-background-mobile-{{ ai_gen_id }} {
    display: none;
  }

  .ai-coming-soon-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    max-width: 800px;
    width: 100%;
    text-align: center;
  }

  .ai-coming-soon-logo-{{ ai_gen_id }} {
    margin-bottom: 40px;
  }

  .ai-coming-soon-logo-{{ ai_gen_id }} img {
    max-width: {{ block.settings.logo_width }}px;
    height: auto;
  }

  .ai-coming-soon-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 20px;
    font-weight: 700;
    line-height: 1.2;
  }

  .ai-coming-soon-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 50px;
    opacity: 0.9;
    line-height: 1.5;
  }

  .ai-coming-soon-countdown-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 30px;
    margin-bottom: 60px;
    flex-wrap: wrap;
  }

  .ai-coming-soon-countdown-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 80px;
  }

  .ai-coming-soon-countdown-number-{{ ai_gen_id }} {
    font-size: {{ block.settings.countdown_size }}px;
    font-weight: 700;
    color: {{ block.settings.countdown_color }};
    line-height: 1;
    margin-bottom: 10px;
  }

  .ai-coming-soon-countdown-label-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.text_color }};
    text-transform: uppercase;
    letter-spacing: 1px;
    opacity: 0.8;
  }

  .ai-coming-soon-form-wrapper-{{ ai_gen_id }} {
    max-width: 500px;
    margin: 0 auto 40px;
  }

  .ai-coming-soon-form-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-coming-soon-form-text-{{ ai_gen_id }} {
    font-size: 16px;
    color: {{ block.settings.text_color }};
    margin-bottom: 8px;
  }

  .ai-coming-soon-form-field-{{ ai_gen_id }} {
    display: flex;
    gap: 10px;
  }

  .ai-coming-soon-input-{{ ai_gen_id }} {
    flex: 1;
    padding: 14px 18px;
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    background-color: {{ block.settings.input_background_color }};
    color: {{ block.settings.text_color }};
    font-size: 16px;
  }

  .ai-coming-soon-input-{{ ai_gen_id }}::placeholder {
    color: {{ block.settings.text_color }};
    opacity: 0.6;
  }

  .ai-coming-soon-button-{{ ai_gen_id }} {
    padding: 14px 32px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.3s ease;
    white-space: nowrap;
  }

  .ai-coming-soon-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-coming-soon-success-{{ ai_gen_id }} {
    color: {{ block.settings.success_color }};
    margin-top: 12px;
    font-size: 14px;
  }

  .ai-coming-soon-error-{{ ai_gen_id }} {
    color: {{ block.settings.error_color }};
    margin-top: 12px;
    font-size: 14px;
  }

  .ai-coming-soon-social-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-top: 40px;
  }

  .ai-coming-soon-social-link-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: {{ block.settings.social_background_color }};
    color: {{ block.settings.social_icon_color }};
    transition: transform 0.3s ease;
  }

  .ai-coming-soon-social-link-{{ ai_gen_id }}:hover {
    transform: translateY(-3px);
  }

  .ai-coming-soon-social-link-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  @media screen and (max-width: 749px) {
    .ai-coming-soon-background-{{ ai_gen_id }} {
      display: none;
    }

    .ai-coming-soon-background-mobile-{{ ai_gen_id }} {
      display: block;
    }

    .ai-coming-soon-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-coming-soon-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.85 }}px;
    }

    .ai-coming-soon-countdown-{{ ai_gen_id }} {
      gap: 20px;
    }

    .ai-coming-soon-countdown-number-{{ ai_gen_id }} {
      font-size: {{ block.settings.countdown_size | times: 0.7 }}px;
    }

    .ai-coming-soon-form-field-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-coming-soon-button-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<coming-soon-{{ ai_gen_id }} class="ai-coming-soon-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.background_video %}
    <video
      class="ai-coming-soon-background-{{ ai_gen_id }}"
      autoplay
      muted
      loop
      playsinline>
      <source src="{{ block.settings.background_video }}" type="video/mp4">
    </video>
  {% elsif block.settings.background_image %}
    <img
      src="{{ block.settings.background_image | image_url: width: 2000 }}"
      alt="{{ block.settings.background_image.alt | escape }}"
      class="ai-coming-soon-background-{{ ai_gen_id }}"
      loading="lazy">
  {% endif %}

  {% if block.settings.background_video_mobile %}
    <video
      class="ai-coming-soon-background-{{ ai_gen_id }} ai-coming-soon-background-mobile-{{ ai_gen_id }}"
      autoplay
      muted
      loop
      playsinline>
      <source src="{{ block.settings.background_video_mobile }}" type="video/mp4">
    </video>
  {% elsif block.settings.background_image_mobile %}
    <img
      src="{{ block.settings.background_image_mobile | image_url: width: 1000 }}"
      alt="{{ block.settings.background_image_mobile.alt | escape }}"
      class="ai-coming-soon-background-{{ ai_gen_id }} ai-coming-soon-background-mobile-{{ ai_gen_id }}"
      loading="lazy">
  {% endif %}

  <div class="ai-coming-soon-content-{{ ai_gen_id }}">
    {% if block.settings.logo %}
      <div class="ai-coming-soon-logo-{{ ai_gen_id }}">
        <img
          src="{{ block.settings.logo | image_url: width: 600 }}"
          alt="{{ shop.name }}"
          width="{{ block.settings.logo_width }}"
          height="auto"
          loading="lazy">
      </div>
    {% endif %}

    {% if block.settings.heading != blank %}
      <h1 class="ai-coming-soon-heading-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </h1>
    {% endif %}

    {% if block.settings.subheading != blank %}
      <div class="ai-coming-soon-subheading-{{ ai_gen_id }}">
        {{ block.settings.subheading }}
      </div>
    {% endif %}

    {% if block.settings.show_countdown %}
      <div class="ai-coming-soon-countdown-{{ ai_gen_id }}" data-launch-date="{{ block.settings.launch_date }}">
        <div class="ai-coming-soon-countdown-item-{{ ai_gen_id }}">
          <div class="ai-coming-soon-countdown-number-{{ ai_gen_id }}" data-days>0</div>
          <div class="ai-coming-soon-countdown-label-{{ ai_gen_id }}">Days</div>
        </div>
        <div class="ai-coming-soon-countdown-item-{{ ai_gen_id }}">
          <div class="ai-coming-soon-countdown-number-{{ ai_gen_id }}" data-hours>0</div>
          <div class="ai-coming-soon-countdown-label-{{ ai_gen_id }}">Hours</div>
        </div>
        <div class="ai-coming-soon-countdown-item-{{ ai_gen_id }}">
          <div class="ai-coming-soon-countdown-number-{{ ai_gen_id }}" data-minutes>0</div>
          <div class="ai-coming-soon-countdown-label-{{ ai_gen_id }}">Minutes</div>
        </div>
        <div class="ai-coming-soon-countdown-item-{{ ai_gen_id }}">
          <div class="ai-coming-soon-countdown-number-{{ ai_gen_id }}" data-seconds>0</div>
          <div class="ai-coming-soon-countdown-label-{{ ai_gen_id }}">Seconds</div>
        </div>
      </div>
    {% endif %}

    {% if block.settings.show_email_signup %}
      <div class="ai-coming-soon-form-wrapper-{{ ai_gen_id }}">
        {%- form "contact" -%}
          <input type="hidden" name="contact[tags]" value="coming-soon-signup">
          <div class="ai-coming-soon-form-content-{{ ai_gen_id }}">
            {% if block.settings.form_text != blank %}
              <div class="ai-coming-soon-form-text-{{ ai_gen_id }}">
                {{ block.settings.form_text }}
              </div>
            {% endif %}

            <div class="ai-coming-soon-form-field-{{ ai_gen_id }}">
              <input
                type="email"
                name="contact[email]"
                class="ai-coming-soon-input-{{ ai_gen_id }}"
                value="{{ form.email }}"
                aria-required="true"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                {% if form.errors %}
                  aria-invalid="true"
                  aria-describedby="ai-coming-soon-error-{{ ai_gen_id }}"
                {% endif %}
                {% if form.posted_successfully? %}
                  aria-describedby="ai-coming-soon-success-{{ ai_gen_id }}"
                {% endif %}
                placeholder="{{ block.settings.email_placeholder }}"
                required>
              <button type="submit" class="ai-coming-soon-button-{{ ai_gen_id }}">
                {{ block.settings.button_text }}
              </button>
            </div>

            {%- if form.errors -%}
              <div id="ai-coming-soon-error-{{ ai_gen_id }}" class="ai-coming-soon-error-{{ ai_gen_id }}">
                {{ form.errors.messages.email }}
              </div>
            {%- endif -%}

            {%- if form.posted_successfully? -%}
              <div id="ai-coming-soon-success-{{ ai_gen_id }}" class="ai-coming-soon-success-{{ ai_gen_id }}">
                {{ block.settings.success_message }}
              </div>
            {%- endif -%}
          </div>
        {%- endform -%}
      </div>
    {% endif %}

    {% if block.settings.show_social_links %}
      <div class="ai-coming-soon-social-{{ ai_gen_id }}">
        {% if block.settings.facebook_url != blank %}
          <a
            href="{{ block.settings.facebook_url }}"
            class="ai-coming-soon-social-link-{{ ai_gen_id }}"
            target="_blank"
            rel="noopener"
            aria-label="Facebook">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
        {% endif %}

        {% if block.settings.instagram_url != blank %}
          <a
            href="{{ block.settings.instagram_url }}"
            class="ai-coming-soon-social-link-{{ ai_gen_id }}"
            target="_blank"
            rel="noopener"
            aria-label="Instagram">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
        {% endif %}

        {% if block.settings.twitter_url != blank %}
          <a
            href="{{ block.settings.twitter_url }}"
            class="ai-coming-soon-social-link-{{ ai_gen_id }}"
            target="_blank"
            rel="noopener"
            aria-label="Twitter">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
              <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
            </svg>
          </a>
        {% endif %}

        {% if block.settings.youtube_url != blank %}
          <a
            href="{{ block.settings.youtube_url }}"
            class="ai-coming-soon-social-link-{{ ai_gen_id }}"
            target="_blank"
            rel="noopener"
            aria-label="YouTube">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</coming-soon-{{ ai_gen_id }}>

<script>
  (function() {
    class ComingSoon{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.countdown = this.querySelector('.ai-coming-soon-countdown-{{ ai_gen_id }}');
        this.launchDate = null;
        this.interval = null;
      }

      connectedCallback() {
        if (this.countdown) {
          const launchDateStr = this.countdown.getAttribute('data-launch-date');
          if (launchDateStr) {
            this.launchDate = new Date(launchDateStr).getTime();
            this.updateCountdown();
            this.interval = setInterval(() => this.updateCountdown(), 1000);
          }
        }
      }

      disconnectedCallback() {
        if (this.interval) {
          clearInterval(this.interval);
        }
      }

      updateCountdown() {
        const now = new Date().getTime();
        const distance = this.launchDate - now;

        if (distance < 0) {
          if (this.interval) {
            clearInterval(this.interval);
          }
          this.setCountdownValues(0, 0, 0, 0);
          return;
        }

        const days = Math.floor(distance / (1000 * 60 * 60 * 24));
        const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((distance % (1000 * 60)) / 1000);

        this.setCountdownValues(days, hours, minutes, seconds);
      }

      setCountdownValues(days, hours, minutes, seconds) {
        const daysEl = this.countdown.querySelector('[data-days]');
        const hoursEl = this.countdown.querySelector('[data-hours]');
        const minutesEl = this.countdown.querySelector('[data-minutes]');
        const secondsEl = this.countdown.querySelector('[data-seconds]');

        if (daysEl) daysEl.textContent = days;
        if (hoursEl) hoursEl.textContent = hours;
        if (minutesEl) minutesEl.textContent = minutes;
        if (secondsEl) secondsEl.textContent = seconds;
      }
    }

    customElements.define('coming-soon-{{ ai_gen_id }}', ComingSoon{{ ai_gen_id }});
  })();
</script>

