  /* Smaller Desktop: Show 3 products */
  @media screen and (min-width: 991px) and (max-width: 1299px) {
    .ai-fragrance-item-{{ ai_gen_id }} {
      width: calc((100vw - 120px - 30px) / 3);
      min-width: 250px;
      max-width: 350px;
    }

    .ai-carousel-nav-button-{{ ai_gen_id }} {
      display: flex;
    }
  }

  /* Larger Desktop: Show 4 products */
  @media screen and (min-width: 1300px) {
    .ai-fragrance-item-{{ ai_gen_id }} {
      width: calc((100vw - 120px - 45px) / 4);
      min-width: 280px;
      max-width: 400px;
    }

    .ai-carousel-nav-button-{{ ai_gen_id }} {
      display: flex;
    }
  }

  /* Large Desktop: Ensure proper sizing */
  @media screen and (min-width: 1400px) {
    .ai-fragrance-carousel-wrapper-{{ ai_gen_id }} {
      width: calc(100vw - 160px);
      max-width: 1600px;
    }
    
    .ai-fragrance-item-{{ ai_gen_id }} {
      width: calc((100vw - 160px - 45px) / 4);
      max-width: 380px;
    }
  }

  /* Extra Large Desktop: Maximum constraints */
  @media screen and (min-width: 1800px) {
    .ai-fragrance-carousel-wrapper-{{ ai_gen_id }} {
      width: calc(100vw - 200px);
      max-width: 1720px;
    }
    
    .ai-fragrance-item-{{ ai_gen_id }} {
      width: calc((100vw - 200px - 45px) / 4);
      max-width: 420px;
    }
