      flex-shrink: 0;
      margin: 0 auto;
    }

    .ai-fragrance-cost-{{ ai_gen_id }} {
      top: 20px;
      font-family: 'PP MORI', sans-serif;
      font-weight: normal;
    }

    .ai-fragrance-info-{{ ai_gen_id }} {
      bottom: 7px;
    }

    .ai-fragrance-name-{{ ai_gen_id }} {
      font-size: 16px;
      width: 90%;
      margin: 0 auto 4px auto;
      margin-left: auto;
    }

    .ai-fragrance-brand-{{ ai_gen_id }} {
      margin: 0 auto 8px auto;
      font-size: 12px;
    }

    .ai-fragrance-rating-{{ ai_gen_id }} {
      margin: 0;
      font-size: 18px;
    }

    .ai-rating-star-{{ ai_gen_id }} {
      margin-right: 0px;
    }

    .ai-show-all-btn-{{ ai_gen_id }} {
      padding: 22px 40px;
      width: auto;
      height: auto;
      font-size: 13px;
      margin-top: 40px;
      margin-left: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      line-height: 1.2;
    }

    .ai-carousel-pagination-{{ ai_gen_id }} {
      margin-left: 0;
    }

    /* Ensure arrows stay visible on mobile */
    .ai-carousel-nav-button-{{ ai_gen_id }} {
      display: flex !important;
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-fragrance-item-{{ ai_gen_id }} {
      width: 280px;
      height: 400px;
    }
  }
{% endstyle %}

<fragrance-carousel-{{ ai_gen_id }}
  class="ai-fragrance-container-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.heading != blank %}
    <h2 class="ai-fragrance-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
  {% endif %}

  {% if block.settings.subheading != blank %}
    <div class="ai-fragrance-subtitle-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
  {% endif %}

  <div class="ai-fragrance-carousel-wrapper-{{ ai_gen_id }}">
    <div class="ai-fragrance-layout-{{ ai_gen_id }}" id="ai-fragrance-carousel-{{ ai_gen_id }}">
      {% assign products = collections[block.settings.collection].products %}
      {% for product in products limit: block.settings.products_to_show %}
        <div class="ai-fragrance-item-{{ ai_gen_id }}">
          <a href="{{ product.url }}" style="text-decoration: none; color: inherit;">
            <div class="ai-fragrance-image-wrapper-{{ ai_gen_id }}">
              <div class="ai-fragrance-cost-{{ ai_gen_id }}">{{ product.price | money }}</div>

              {% if product.featured_image %}
                <img 
                  class="primary-image" 
                  src="{{ product.featured_image | image_url: width: 600 }}" 
                  alt="{{ product.title | escape }}"
                  loading="lazy"
                >
              {% endif %}

              {% if product.images.size > 1 %}
                <img 
                  class="secondary-image" 
                  src="{{ product.images[1] | image_url: width: 600 }}" 
                  alt="{{ product.title | escape }}"
                  loading="lazy"
                >
              {% endif %}

              <div class="ai-fragrance-info-{{ ai_gen_id }}">
                <div class="ai-fragrance-name-{{ ai_gen_id }}">{{ product.title }}</div>
                <div class="ai-fragrance-brand-{{ ai_gen_id }}">{{ product.vendor }}</div>
                <div class="ai-fragrance-rating-{{ ai_gen_id }}">
                  {% for i in (1..5) %}
                    {% if i <= 4 %}
                      <span class="ai-rating-star-{{ ai_gen_id }} filled">&#9733;</span>
                    {% else %}
                      <span class="ai-rating-star-{{ ai_gen_id }}">&#9734;</span>
                    {% endif %}
                  {% endfor %}
                </div>
              </div>
            </div>
          </a>

          <div class="ai-fragrance-hover-{{ ai_gen_id }}">
            <div>
              <form method="post" action="/cart/add" class="ai-item-form-{{ ai_gen_id }}" data-product-id="{{ product.id }}">
                <input type="hidden" name="id" value="{{ product.variants.first.id }}">
                <button type="submit" class="ai-cart-button-{{ ai_gen_id }}">ADD TO CART</button>
              </form>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    <button class="ai-carousel-nav-button-{{ ai_gen_id }} left" aria-label="Previous products">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
        <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>
      </svg>
    </button>
    <button class="ai-carousel-nav-button-{{ ai_gen_id }} right" aria-label="Next products">
      <svg xmlns="http://www.w3.org/2000/24 24" viewBox="0 0 24 24" fill="currentColor">
        <path d="M8.59 16.59L10 18l6-6-6-6-1.41 1.41L13.17 12z"/>
      </svg>
    </button>
  </div>

  <div class="ai-carousel-pagination-{{ ai_gen_id }}"></div>

  {% if block.settings.view_all_link != blank %}
    <div style="text-align: center; margin-top: 30px;">
      <a href="{{ block.settings.view_all_link }}" class="ai-show-all-btn-{{ ai_gen_id }}">
        View All Products
      </a>
    </div>
  {% endif %}
</fragrance-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class FragranceCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.isDesktop = window.innerWidth > 990;
        this.itemsPerView = this.getItemsPerView();
      }

      connectedCallback() {
        this.carousel = this.querySelector('#ai-fragrance-carousel-{{ ai_gen_id }}');
        this.items = this.querySelectorAll('.ai-fragrance-item-{{ ai_gen_id }}');
        this.leftButton = this.querySelector('.ai-carousel-nav-button-{{ ai_gen_id }}.left');
        this.rightButton = this.querySelector('.ai-carousel-nav-button-{{ ai_gen_id }}.right');
        this.pagination = this.querySelector('.ai-carousel-pagination-{{ ai_gen_id }}');
        this.wrapper = this.querySelector('.ai-fragrance-carousel-wrapper-{{ ai_gen_id }}');

        this.totalItems = this.items.length;
        this.setupEventListeners();
        this.createPagination();
        this.updateCarousel();
        this.updateItemWidths();
      }

      getItemsPerView() {
        const width = window.innerWidth;
        if (width <= 990) return 1;
        if (width <= 1299) return 3;
        return 4;
      }

      setupEventListeners() {
        this.leftButton?.addEventListener('click', () => this.prevSlide());
        this.rightButton?.addEventListener('click', () => this.nextSlide());

        window.addEventListener('resize', () => {
          this.isDesktop = window.innerWidth > 990;
          this.itemsPerView = this.getItemsPerView();
          this.currentIndex = 0;
          this.updateItemWidths();
          this.createPagination();
          this.updateCarousel();
        });
      }

      updateItemWidths() {
        if (this.isDesktop) {
          const wrapperWidth = this.wrapper?.offsetWidth || 0;
          const gap = this.itemsPerView === 3 ? 30 : 45;
          const itemWidth = Math.floor((wrapperWidth - gap) / this.itemsPerView);
          this.items.forEach(item => {
            item.style.width = `${itemWidth}px`;
          });
        }
      }

      prevSlide() {
        if (this.currentIndex > 0) {
          this.currentIndex--;
          this.updateCarousel();
        }
      }

      nextSlide() {
        const maxIndex = Math.ceil(this.totalItems / this.itemsPerView) - 1;
        if (this.currentIndex < maxIndex) {
          this.currentIndex++;
          this.updateCarousel();
        }
      }

      updateCarousel() {
        if (!this.carousel) return;

        const itemWidth = this.items[0]?.offsetWidth || 0;
        const gap = 15;
        const translateX = -(this.currentIndex * this.itemsPerView * (itemWidth + gap));
        
        this.carousel.style.transform = `translateX(${translateX}px)`;
        this.updatePagination();
      }

      createPagination() {
        if (!this.pagination) return;
        
        this.pagination.innerHTML = '';
        const totalSlides = Math.ceil(this.totalItems / this.itemsPerView);
        
        for (let i = 0; i < totalSlides; i++) {
          const dot = document.createElement('div');
          dot.className = 'ai-carousel-dot-{{ ai_gen_id }}';
          dot.addEventListener('click', () => {
            this.currentIndex = i;
            this.updateCarousel();
          });
          this.pagination.appendChild(dot);
        }
        
        this.updatePagination();
      }

      updatePagination() {
        const dots = this.querySelectorAll('.ai-carousel-dot-{{ ai_gen_id }}');
        dots.forEach((dot, index) => {
          dot.classList.toggle('active', index === this.currentIndex);
        });
      }
    }

    customElements.define('fragrance-carousel-{{ ai_gen_id }}', FragranceCarousel{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Fragrance showcase",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Fragrances"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover Our Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 20,
      "step": 1,
      "label": "Products to show",
      "default": 8
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link"
    }
  ],
  "presets": [
    {
      "name": "Fragrance showcase"
    }
  ]
}
{% endschema %}