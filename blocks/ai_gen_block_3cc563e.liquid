    .ai-fragrance-subtitle-{{ ai_gen_id }} {
      font-size: 32px;
      text-align: left;
      margin-top: -10px;
      margin-left: 0;
      display: block;
    }

    .ai-fragrance-subtitle-{{ ai_gen_id }}::after {
      bottom: 8px;
      left: 29%;
      transform: translateX(-50%);
      width: 57%;
    }

    .ai-fragrance-carousel-wrapper-{{ ai_gen_id }} {
      margin-left: 0;
      width: 100vw;
      overflow: hidden;
      position: relative;
