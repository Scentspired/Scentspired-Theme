{% assign ai_gen_id = block.id | replace: "_", "" | downcase %}

{% style %}
  .ai-comparison-table-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 40px 20px;
  }

  .ai-comparison-table-wrapper-{{ ai_gen_id }} {
    width: 100%;
    overflow-x: auto;
  }

  .ai-comparison-table-element-{{ ai_gen_id }} {
    width: 100%;
    border-collapse: collapse;
    background-color: {{ block.settings.table_background }};
  }

  .ai-comparison-table-element-{{ ai_gen_id }} th,
  .ai-comparison-table-element-{{ ai_gen_id }} td {
    padding: {{ block.settings.cell_padding }}px;
    text-align: left;
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
  }

  .ai-comparison-table-element-{{ ai_gen_id }} thead th {
    background-color: {{ block.settings.header_background }};
    color: {{ block.settings.header_text_color }};
    font-weight: 600;
    font-size: {{ block.settings.header_font_size }}px;
        font-family: 'PPMori Regular', Arial, sans-serif;
  }

  .ai-comparison-table-element-{{ ai_gen_id }} thead th:first-child {
    width: {{ block.settings.first_column_width }}%;
  }

  .ai-comparison-table-element-{{ ai_gen_id }} thead th:last-child {
    width: {{ block.settings.second_column_width }}%;
  }

  .ai-comparison-table-element-{{ ai_gen_id }} tbody td {
    color: {{ block.settings.body_text_color }};
    font-size: {{ block.settings.body_font_size }}px;
        font-family: 'PPMori Regular', Arial, sans-serif;
  }

  .ai-comparison-table-element-{{ ai_gen_id }} tbody tr:nth-child(even) {
    background-color: {{ block.settings.row_alternate_background }};
  }
{% endstyle %}

<comparison-table-{{ ai_gen_id }}
  class="ai-comparison-table-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}>
  <div class="ai-comparison-table-wrapper-{{ ai_gen_id }}">
    <table class="ai-comparison-table-element-{{ ai_gen_id }}">
      <thead>
        <tr>
          <th>{{ block.settings.header_column_1 }}</th>
          <th>{{ block.settings.header_column_2 }}</th>
        </tr>
      </thead>
      <tbody>
        {% for i in (1..4) %}
          {% liquid
            assign row_label_key = "row_" | append: i | append: "_label"
            assign row_value_key = "row_" | append: i | append: "_value"
            assign row_label = block.settings[row_label_key]
            assign row_value = block.settings[row_value_key]
          %}
          <tr>
            <td>{{ row_label }}</td>
            <td>{{ row_value }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</comparison-table-{{ ai_gen_id }}>

<script>
  (function() {
    class ComparisonTable{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('comparison-table-{{ ai_gen_id }}', ComparisonTable{{ ai_gen_id }});
  })();
</script>

