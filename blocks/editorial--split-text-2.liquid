
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-split-editorial-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: 40px 0 35px;
  }

  .ai-split-editorial-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 {{ block.settings.horizontal_padding }}px;
  }

  .ai-split-editorial-wrapper-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: {{ block.settings.column_gap }}px;
  }

  .ai-split-editorial-left-{{ ai_gen_id }} {
    max-width: 45%;
  }

  .ai-split-editorial-right-{{ ai_gen_id }} {
    max-width: 72%;
  }

  .ai-split-editorial-heading-line1-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.heading_line_spacing }}px;
    line-height: {{ block.settings.heading_line_height }};
    letter-spacing: -0.02em;
  }

  .ai-split-editorial-prefix-{{ ai_gen_id }} {
    font-family: 'PP Editorial New', serif;
    font-weight: 400;
    font-style: normal;
    font-size: {{ block.settings.prefix_font_size }}px;
    color: {{ block.settings.heading_color }};
  }

  .ai-split-editorial-brand-scent-{{ ai_gen_id }} {
    font-family: 'PP Editorial New', serif;
    font-weight: 400;
    font-style: normal;
    font-size: {{ block.settings.brand_font_size }}px;
    color: {{ block.settings.heading_color }};
  }

  .ai-split-editorial-brand-spired-{{ ai_gen_id }} {
    font-family: 'PPEditorialNew Ultralight Italic';
    font-weight: 400;
    font-style: italic;
    font-size: {{ block.settings.brand_font_size }}px;
    color: {{ block.settings.heading_color }};
  }

  .ai-split-editorial-heading-line2-{{ ai_gen_id }} {
    margin: 0;
    line-height: {{ block.settings.heading_line_height }};
    letter-spacing: -0.02em;
  }

  .ai-split-editorial-start-{{ ai_gen_id }} {
    font-family: 'PP Editorial New', serif;
    font-weight: 400;
    font-style: normal;
    font-size: {{ block.settings.start_font_size }}px;
    color: {{ block.settings.heading_color }};
    margin-right: 5px;
  }

  .ai-split-editorial-bestsellers-{{ ai_gen_id }} {
    font-family: 'PPEditorialNew Italic', serif;
    font-weight: 400;
    font-style: italic;
    font-size: {{ block.settings.bestsellers_font_size }}px;
    color: {{ block.settings.heading_color }};
  }

  .ai-split-editorial-body-{{ ai_gen_id }} {
    font-family: 'PPMori Regular', Arial, sans-serif;
    font-weight: 400;
    font-style: normal;
    font-size: {{ block.settings.body_font_size }}px;
    line-height: {{ block.settings.body_line_height }};
    color: {{ block.settings.body_color }};
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-split-editorial-wrapper-{{ ai_gen_id }} {
      flex-direction: column;
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-split-editorial-left-{{ ai_gen_id }},
    .ai-split-editorial-right-{{ ai_gen_id }} {
      max-width: 100%;
    }

    .ai-split-editorial-prefix-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.prefix_font_size }}px * {{ block.settings.mobile_scale }});
    }

    .ai-split-editorial-brand-scent-{{ ai_gen_id }},
    .ai-split-editorial-brand-spired-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.brand_font_size }}px * {{ block.settings.mobile_scale }});
    }

    .ai-split-editorial-start-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.start_font_size }}px * {{ block.settings.mobile_scale }});
    }

    .ai-split-editorial-bestsellers-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.bestsellers_font_size }}px * {{ block.settings.mobile_scale }});
    }

    .ai-split-editorial-body-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.body_font_size }}px * 0.6);
    }
  }
{% endstyle %}

<div class="ai-split-editorial-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-split-editorial-container-{{ ai_gen_id }}">
    <div class="ai-split-editorial-wrapper-{{ ai_gen_id }}">
      <div class="ai-split-editorial-left-{{ ai_gen_id }}">
        <h2 class="ai-split-editorial-heading-line1-{{ ai_gen_id }}">
          <span class="ai-split-editorial-prefix-{{ ai_gen_id }}">{{ block.settings.prefix_text }}</span>
          <span class="ai-split-editorial-brand-scent-{{ ai_gen_id }}">{{ block.settings.brand_scent_text }}</span><span class="ai-split-editorial-brand-spired-{{ ai_gen_id }}">{{ block.settings.brand_spired_text }}</span>
        </h2>
        <p class="ai-split-editorial-heading-line2-{{ ai_gen_id }}">
          <span class="ai-split-editorial-start-{{ ai_gen_id }}">{{ block.settings.start_text }}</span>
          <span class="ai-split-editorial-bestsellers-{{ ai_gen_id }}">{{ block.settings.bestsellers_text }}</span>
        </p>
      </div>
      <div class="ai-split-editorial-right-{{ ai_gen_id }}">
        <p class="ai-split-editorial-body-{{ ai_gen_id }}">{{ block.settings.body_text }}</p>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Split text editorial",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Container width",
      "min": 800,
      "max": 1600,
      "step": 100,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "horizontal_padding",
      "label": "Horizontal padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 20,
      "max": 150,
      "step": 10,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Mobile gap",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "mobile_scale",
      "label": "Mobile font scale",
      "min": 0.5,
      "max": 1,
      "step": 0.1,
      "default": 0.8
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Left column - Line 1"
    },
    {
      "type": "text",
      "id": "prefix_text",
      "label": "Prefix text",
      "default": "New to"
    },
    {
      "type": "range",
      "id": "prefix_font_size",
      "label": "Prefix font size",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "text",
      "id": "brand_scent_text",
      "label": "Brand text (Scent)",
      "default": "Scent"
    },
    {
      "type": "text",
      "id": "brand_spired_text",
      "label": "Brand text (spired)",
      "default": "spired"
    },
    {
      "type": "range",
      "id": "brand_font_size",
      "label": "Brand font size",
      "min": 20,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Left column - Line 2"
    },
    {
      "type": "text",
      "id": "start_text",
      "label": "Start text",
      "default": "Start with the"
    },
    {
      "type": "range",
      "id": "start_font_size",
      "label": "Start font size",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "text",
      "id": "bestsellers_text",
      "label": "Bestsellers text",
      "default": "bestsellers."
    },
    {
      "type": "range",
      "id": "bestsellers_font_size",
      "label": "Bestsellers font size",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "heading_line_spacing",
      "label": "Line spacing",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "heading_line_height",
      "label": "Line height",
      "min": 0.8,
      "max": 2,
      "step": 0.1,
      "default": 1
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "Right column - Body text"
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body text"
    },
    {
      "type": "range",
      "id": "body_font_size",
      "label": "Body font size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "body_line_height",
      "label": "Body line height",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "default": 1.6
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body color",
      "default": "#121212"
    }
  ],
  "presets": [
    {
      "name": "Split text editorial"
    }
  ]
}
{% endschema %}
