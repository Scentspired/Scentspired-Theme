{% doc %}
  @prompt
    "Create a custom Shopify Liquid section that replicates the layout and typography shown in image_2055c8.png. The section should feature a center-aligned layout on a light cream background (approx. #F9F6F1). Use 'PP Editorial New', serif for the main headings, specifically ensuring the second heading uses 'PPEditorialNew Italic' to match the elegant serif style in the image. All body text must use 'PPMori Regular', Arial, sans-serif with appropriate line-height for readability.

    The top portion should consist of a heading followed by a large, deep red rectangular container (approx. #8B1D22) with heavily rounded corners (approx. 50px). Inside this red box, place three distinct paragraphs of white text, center-aligned, with generous internal padding. Below the red box, include a second italicized heading followed by a paragraph of dark text on the cream background. Ensure the section is fully responsive, maintaining the centered text alignment on mobile, and include a Liquid schema that allows me to edit the headings, body text, and colors directly from the Shopify Theme Editor."
{% enddoc %}
{% assign ai_gen_id = block.id | replace: "_", "" | downcase %}

{% style %}
    .ai-editorial-section-{{ ai_gen_id }} {
      display: block;
      width: {{ block.settings.desktop_width_percent }}%;
      max-width: 100%;
      background-color: {{ block.settings.background_color }};
      padding: {{ block.settings.section_padding }}px 20px;
      text-align: center;
    }

    .ai-editorial-section__container-{{ ai_gen_id }} {
      max-width: {{ block.settings.max_width }}px;
      margin: 0 auto;
    }

    .ai-editorial-section__heading-{{ ai_gen_id }} {
      font-family: 'PPEditorialNew Ultralight Italic';
      font-size: {{ block.settings.heading_size }}px;
      color: {{ block.settings.heading_color }};
      margin: 0 0 -34px 0;
      line-height: 1.2;
    }

    .ai-editorial-section__red-box-{{ ai_gen_id }} {
      background-color: {{ block.settings.box_color }};
      border-radius: {{ block.settings.box_radius }}px;
      padding: 30px 98px;
      margin: 0 0 -10px 0;
    }

    .ai-editorial-section__box-text-{{ ai_gen_id }} {
      font-family: 'PPMori Regular', Arial, sans-serif;
      font-size: {{ block.settings.box_text_size }}px;
      color: {{ block.settings.box_text_color }};
      line-height: {{ block.settings.box_text_line_height }};
      margin: 0 0 {{ block.settings.paragraph_spacing }}px 0;
    }

    a{
     color: #fff;
    }

    .ai-editorial-section__box-text-{{ ai_gen_id }}:last-child {
      margin-bottom: 0;
    }

    .ai-editorial-section__subheading-{{ ai_gen_id }} {
      font-family: 'PPEditorialNew Ultralight Italic';
      font-style: italic;
      font-size: {{ block.settings.subheading_size }}px;
      color: {{ block.settings.subheading_color }};
      margin: 0 0 -37px 0;
      line-height: 1.3;
    }

    .ai-editorial-section__bottom-text-{{ ai_gen_id }} {
      font-family: 'PPMori Regular', Arial, sans-serif;
      font-size: 24px;
      color: {{ block.settings.bottom_text_color }};
      line-height: {{ block.settings.bottom_text_line_height }};
      margin: 0 auto;
      max-width: 1000px;
    }

    .ai-editorial-section__bottom-text-{{ ai_gen_id }} a {
    color: #000;
  }

    @media screen and (max-width: 749px) {
      .ai-editorial-section-{{ ai_gen_id }} {
        padding: {{ block.settings.section_padding | times: 0.6 }}px 16px;
      }

      .ai-editorial-section__heading-{{ ai_gen_id }} {
        font-size: 32px;
      }

      .ai-editorial-section__red-box-{{ ai_gen_id }} {
        padding: {{ block.settings.box_padding | times: 0.6 }}px;
        border-radius: {{ block.settings.box_radius | times: 0.6 }}px;
      }

      .ai-editorial-section__box-text-{{ ai_gen_id }} {
        font-size: 12.6px;
      }

      .ai-editorial-section__subheading-{{ ai_gen_id }} {
        font-size: 34px;
      }

      .ai-editorial-section__bottom-text-{{ ai_gen_id }} {
        font-size: 12.6px;
      }
    }
{% endstyle %}

<div class="ai-editorial-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-editorial-section__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-editorial-section__heading-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </h2>
    {% endif %}

    <div class="ai-editorial-section__red-box-{{ ai_gen_id }}">
      {% if block.settings.box_paragraph_1 != blank %}
        <div class="ai-editorial-section__box-text-{{ ai_gen_id }}">
          {{ block.settings.box_paragraph_1 }}
        </div>
      {% endif %}

      {% if block.settings.box_paragraph_2 != blank %}
        <div class="ai-editorial-section__box-text-{{ ai_gen_id }}">
          {{ block.settings.box_paragraph_2 }}
        </div>
      {% endif %}

      {% if block.settings.box_paragraph_3 != blank %}
        <div class="ai-editorial-section__box-text-{{ ai_gen_id }}">
          {{ block.settings.box_paragraph_3 }}
        </div>
      {% endif %}
    </div>

    {% if block.settings.subheading != blank %}
      <h3 class="ai-editorial-section__subheading-{{ ai_gen_id }}">
        {{ block.settings.subheading }}
      </h3>
    {% endif %}

    {% if block.settings.bottom_text != blank %}
      <div class="ai-editorial-section__bottom-text-{{ ai_gen_id }}">
        {{ block.settings.bottom_text }}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Editorial content",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Content max width",
      "min": 600,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "default": 900
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section padding",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F9F6F1"
    },
    {
      "type": "header",
      "content": "Top heading"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Premium Fragrance Collection</p>"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Spacing below",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Red box"
    },
    {
      "type": "color",
      "id": "box_color",
      "label": "Box color",
      "default": "#8B1D22"
    },
    {
      "type": "range",
      "id": "box_radius",
      "label": "Border radius",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "box_padding",
      "label": "Padding",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "box_spacing",
      "label": "Spacing below",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "richtext",
      "id": "box_paragraph_1",
      "label": "Paragraph 1",
      "default": "<p>Discover our curated collection of premium-inspired scents, crafted with the finest ingredients to bring luxury within reach.</p>"
    },
    {
      "type": "richtext",
      "id": "box_paragraph_2",
      "label": "Paragraph 2",
      "default": "<p>Each fragrance tells a unique story, designed to evoke emotion and create lasting memories.</p>"
    },
    {
      "type": "richtext",
      "id": "box_paragraph_3",
      "label": "Paragraph 3",
      "default": "<p>Experience the art of perfumery with our accessible luxury line.</p>"
    },
    {
      "type": "color",
      "id": "box_text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "box_text_size",
      "label": "Text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "box_text_line_height",
      "label": "Line height",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "default": 1.6
    },
    {
      "type": "range",
      "id": "paragraph_spacing",
      "label": "Paragraph spacing",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 25
    },
    {
      "type": "header",
      "content": "Bottom section"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>The essence of elegance</p>"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Subheading size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "subheading_spacing",
      "label": "Spacing below",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
