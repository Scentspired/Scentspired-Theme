      width: 240px;
    }

    .products-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }
  }

  @media (max-width: 768px) {
    .bundle-container {
      flex-direction: column;
      gap: 30px;
      max-width: 100%;
    }

    .bundle-sidebar {
      width: 100%;
      max-width: 400px;
      margin: 0 auto;
    }

    .bundle-title {
      font-size: 36px;
    }

    .bundle-slider-container {
      flex-direction: column;
      align-items: stretch;
    }

    .bundle-nav-arrow {
      display: none;
    }

    .bundle-items-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
      overflow: visible;
      max-width: 100%;
    }

    .bundle-slot-wrapper {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
      max-width: none;
      min-width: 0;
    }

    .bundle-item {
      width: 100%;
      max-width: 90px;
      min-width: 70px;
      height: 100px;
      margin-bottom: 4px;
      flex-shrink: 0;
    }

    .bundle-product-name {
      width: 100%;
      max-width: 90px;
      min-width: 70px;
      font-size: 9px;
      text-align: center;
      color: #666;
      font-weight: 500;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      min-height: 14px;
      line-height: 1.2;
      word-break: break-all;
    }

    .filter-container {
      flex-direction: column;
      gap: 20px;
      align-items: stretch;
    }

    .search-input {
      width: 100%;
    }

    .products-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .product-card {
      height: 470px;
    }

    .filter-tabs {
      justify-content: center;
    }

    .products-grid-section,
    .product-filter-section {
      padding-left: 15px;
      padding-right: 15px;
    }
  }

  .add-to-bundle-btn.loading {
    background: #ccc;
    color: #999;
    border-color: #ccc;
  }

  .add-to-bundle-btn.success {
    background: #4caf50;
    color: white;
    border-color: #4caf50;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    class BundleManager {
      constructor() {
        this.bundleItems = [];
        this.maxItems = 5;
        this.selectedCollection = document.getElementById('products-grid').dataset.selectedCollection;
        console.log('[v0] Selected collection:', this.selectedCollection);
        console.log('[v0] Total product cards found:', document.querySelectorAll('.product-card').length);
        this.init();
      }

      init() {
        this.setupEventListeners();
        this.updateUI();
        this.updatePricing();
      }

      setupEventListeners() {
        document.querySelectorAll('.add-to-bundle-btn').forEach(btn => {
          btn.addEventListener('click', e => {
            const card = e.target.closest('.product-card');
            this.addProductToBundle(card);
          });
        });

        document.getElementById('checkout-btn').addEventListener('click', e => {
          e.preventDefault();
          this.proceedToCheckout();
        });

        document.getElementById('product-search').addEventListener('input', e => {
          this.searchProducts(e.target.value);
        });

        if (window.innerWidth > 768) {
          document.getElementById('scroll-left').addEventListener('click', () => {
            this.scrollBundleItems('left');
          });

          document.getElementById('scroll-right').addEventListener('click', () => {
            this.scrollBundleItems('right');
          });
        }

        document.querySelectorAll('.bundle-item.empty-slot').forEach(slot => {
          slot.addEventListener('click', () => {
            this.scrollToProducts();
          });
        });
      }

      addProductToBundle(card) {
        if (this.bundleItems.length >= this.maxItems) {
          alert('You have reached the maximum of ' + this.maxItems + ' items');
          return;
        }

        const productId = card.dataset.productId;

        const product = {
          id: productId,
          title: card.dataset.productTitle,
          price: parseInt(card.dataset.productPrice),
          image: card.dataset.productImage,
          handle: card.dataset.productHandle,
        };

        this.bundleItems.push(product);
        this.updateUI();
        this.updatePricing();
        this.showAddedFeedback(card);
      }

      removeProductFromBundle(index) {
        this.bundleItems.splice(index, 1);
        this.updateUI();
        this.updatePricing();
      }

      updateUI() {
        const slotWrappers = document.querySelectorAll('.bundle-slot-wrapper');

        slotWrappers.forEach((wrapper, index) => {
          const slotIndex = parseInt(wrapper.dataset.slot);
          const bundleItem = wrapper.querySelector('.bundle-item');
          const productName = wrapper.querySelector('.bundle-product-name');

          if (slotIndex < this.bundleItems.length) {
            const item = this.bundleItems[slotIndex];
            bundleItem.className = 'bundle-item filled';
            bundleItem.innerHTML = `
            <button class="remove-item" onclick="bundleManager.removeProductFromBundle(${slotIndex})">×</button>
            <div class="item-image">
              <img src="${item.image}" alt="${item.title}">
            </div>
          `;
            productName.textContent = item.title;
          } else {
            productName.textContent = '';
            bundleItem.className = 'bundle-item empty-slot';
            bundleItem.innerHTML = `<button class="add-button">+</button><span class="slot-number">${slotIndex + 1}</span>`;
            bundleItem.addEventListener('click', () => {
              this.scrollToProducts();
            });
          }
        });

        this.updateProductButtons();
      }

      updateProductButtons() {
        document.querySelectorAll('.product-card').forEach(card => {
          const button = card.querySelector('.add-to-bundle-btn');

          if (this.bundleItems.length >= this.maxItems) {
            button.textContent = 'BUNDLE FULL';
            button.disabled = true;
          } else {
            button.textContent = 'ADD TO BUNDLE';
            button.disabled = false;
          }
        });
      }

      updatePricing() {
        const itemCount = this.bundleItems.length;
        let subtotal = this.bundleItems.reduce((sum, item) => sum + item.price / 100, 0);

        document.getElementById('initial-price').textContent = subtotal.toFixed(2);
        document.getElementById('subtotal-amount').textContent = subtotal.toFixed(2);

        const savingsMessage = document.getElementById('savings-message');
        const checkoutBtn = document.getElementById('checkout-btn');

        if (itemCount === this.maxItems) {
          checkoutBtn.disabled = false;
          savingsMessage.textContent = 'Your bundle is complete!';
        } else {
          checkoutBtn.disabled = true;
          const remaining = this.maxItems - itemCount;
          savingsMessage.textContent = `Add ${remaining} more item${remaining !== 1 ? 's' : ''} to checkout`;
        }
      }

      showAddedFeedback(card) {
        const button = card.querySelector('.add-to-bundle-btn');
        button.textContent = 'ADDED!';
        button.classList.add('success');
        setTimeout(() => {
          button.classList.remove('success');
          this.updateProductButtons();
        }, 2000);
      }

      async proceedToCheckout() {
        if (this.bundleItems.length !== this.maxItems) {
          alert('Please add all 5 items to your bundle');
          return;
        }

        const checkoutBtn = document.getElementById('checkout-btn');
        checkoutBtn.textContent = 'ADDING TO CART...';
        checkoutBtn.disabled = true;

        try {
          await fetch('/cart/clear.js', { method: 'POST' });

          const cartItems = this.bundleItems.map(item => ({
            id: item.id,
            quantity: 1,
          }));

          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ items: cartItems }),
          });

          if (!response.ok) throw new Error('Cart add failed');

          checkoutBtn.textContent = 'REDIRECTING...';
          window.location.href = '/checkout';
        } catch (error) {
          console.error('Checkout error:', error);
          alert('There was an error processing your bundle. Please try again.');
          checkoutBtn.textContent = 'CHECKOUT';
          checkoutBtn.disabled = false;
        }
      }

      // Removed filterProducts function as filter tabs are removed
      // Modified searchProducts to filter by text only, not collection
      searchProducts(query) {
        const searchTerm = query.toLowerCase();
        document.querySelectorAll('.product-card').forEach(product => {
          const title = product.dataset.productTitle.toLowerCase();
          const tags = product.dataset.tags.toLowerCase();
          const matchesSearch = title.includes(searchTerm) || tags.includes(searchTerm);
          product.style.display = matchesSearch ? 'block' : 'none';
        });
      }

      scrollBundleItems(direction) {
        if (window.innerWidth > 768) {
          const container = document.getElementById('bundle-items-row');
          const scrollAmount = direction === 'right' ? 150 : -150;
          container.scrollLeft += scrollAmount;
        }
      }

      scrollToProducts() {
        document.querySelector('.products-grid-section').scrollIntoView({ behavior: 'smooth' });
      }
    }

    window.bundleManager = new BundleManager();

    if (window.innerWidth > 768) {
      const bundleRow = document.getElementById('bundle-items-row');
      const scrollRight = document.getElementById('scroll-right');
      const scrollLeft = document.getElementById('scroll-left');

      if (scrollRight) {
        scrollRight.addEventListener('click', () => {
          bundleRow.scrollBy({ left: 150, behavior: 'smooth' });
        });
      }

      if (scrollLeft) {
        scrollLeft.addEventListener('click', () => {
          bundleRow.scrollBy({ left: -150, behavior: 'smooth' });
        });
      }
    }
  });
</script>

