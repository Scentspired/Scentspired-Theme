  }

  /* Product Filter Section - RESTORED LAYOUT */
  .product-filter-section {
    background: white;
    padding: 30px 20px;
    width: 100%;
  }

  .filter-container {
    max-width: 1000px;
    margin: 0 auto;
    display: flex;
    justify-content: flex-end;
    align-items: center;
