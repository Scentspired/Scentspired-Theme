{% doc %}
  @prompt
    "Create a custom Shopify Liquid section that replicates the layout and typography of image_f8fe61.png. The section should be set on a light cream background (approx. #F9F6F1). At the top, place a large, left-aligned heading that spans the full width of the content area; use 'PPEditorialNew Italic' for this entire heading ('What makes us Different from the other lot') with a tight line-height and large font size. Below the heading, create a two-column grid layout for the body text. Both columns should use 'PPMori Regular', Arial, sans-serif with a smaller font size and a clean, left-aligned orientation. Ensure there is a generous gutter (gap) between the two columns on desktop so the text is easy to read. On mobile, the two columns should stack vertically while the heading remains italicized and prominent. Include a Liquid schema so that the heading and both columns of body text can be edited from the Shopify Theme Editor, and hardcode the font families to ensure the editorial style is preserved regardless of theme settings."
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
  }

  .ai-editorial-container-{{ ai_gen_id }} {
    max-width: 80%;
    margin: 0 auto;
  }

  .ai-editorial-heading-{{ ai_gen_id }} {
    font-family: 'PPEditorialNew Italic', Georgia, serif;
    font-style: italic;
    font-size: {{ block.settings.heading_size }}px;
    line-height: {{ block.settings.heading_line_height }};
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_margin_bottom }}px 0;
    text-align: left;
    width: 100%;
  }

  .ai-editorial-columns-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
  }

  .ai-editorial-column-{{ ai_gen_id }} {
    font-family: 'PPMori Regular', Arial, sans-serif;
    font-size: {{ block.settings.body_size }}px;
    line-height: {{ block.settings.body_line_height }};
    color: {{ block.settings.body_color }};
    text-align: left;
  }

  .ai-editorial-column-{{ ai_gen_id }} p {
    margin: 0 0 {{ block.settings.paragraph_spacing }}px 0;
  }

  .ai-editorial-column-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-editorial-section-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top_mobile }}px {{ block.settings.padding_horizontal_mobile }}px {{ block.settings.padding_bottom_mobile }}px;
    }

    .ai-editorial-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
      margin-bottom: {{ block.settings.heading_margin_bottom_mobile }}px;
    }

    .ai-editorial-columns-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.column_gap_mobile }}px;
    }

    .ai-editorial-column-{{ ai_gen_id }} {
      font-size: {{ block.settings.body_size_mobile }}px;
    }
    
  }
{% endstyle %}

<editorial-section-{{ ai_gen_id }} class="ai-editorial-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-editorial-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-editorial-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-editorial-columns-{{ ai_gen_id }}">
      <div class="ai-editorial-column-{{ ai_gen_id }}">
        {{ block.settings.column_1_text }}
      </div>
      <div class="ai-editorial-column-{{ ai_gen_id }}">
        {{ block.settings.column_2_text }}
      </div>
    </div>
  </div>
</editorial-section-{{ ai_gen_id }}>

<script>
  (function() {
    class EditorialSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('editorial-section-{{ ai_gen_id }}', EditorialSection{{ ai_gen_id }});
  })();
</script>

