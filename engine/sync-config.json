      "mainBranch": "main",
      "remote": "origin"
    },
    {
      "name": "Scentspired-UK",
      "id": "uk",
      "path": "../Scentspired-UK",
      "branch": "develop",
      "mainBranch": "main",
      "remote": "origin"
    }
  ]
}
