{
  "name": "scentspired-theme",
  "version": "1.0.0",
  "description": "Central Upstream Core Theme Engine for Scentspired Global Stores",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node runner.cjs --scope=core",
    "test:core": "node runner.cjs --scope=core",
    "test:uk": "node runner.cjs --scope=uk --target=dist/uk",
    "test:usa": "node runner.cjs --scope=usa --target=dist/usa",
    "test:uae": "node runner.cjs --scope=uae --target=dist/uae",
    "test:all": "node runner.cjs --scope=all",
    "test:region": "node runner.cjs --force --scope",
    "test:on": "node scripts/toggle-testing.cjs --on",
    "test:off": "node scripts/toggle-testing.cjs --off",
    "test:toggle": "node scripts/toggle-testing.cjs --toggle",
    "test:status": "node scripts/toggle-testing.cjs --status",
    "test:scanner": "node tests/static/static-analysis.cjs",
    "test:syntax": "node tests/static/syntax-validator.cjs",
    "test:flows": "node tests/dynamic/critical-flow-simulator.cjs",
    "test:integration": "node tests/dynamic/rigorous-integration-tests.cjs",
    "test:chaos": "node tests/dynamic/chaos-simulation-tests.cjs",
    "test:clarity": "node tests/dynamic/verify-clarity-detection.cjs",
    "test:parity": "node tests/dynamic/verify-live-output-parity.cjs",
    "release:today": "node tests/release/daily-release-manager.cjs",
    "release:queue": "node tests/release/daily-release-manager.cjs --list-queue",
    "release:rebuild-queue": "node tests/release/build-remediation-queue.cjs",
    "report:catalog": "node tests/reporting/generate-master-catalog.cjs",
    "report:scan": "node tests/reporting/generate-report.cjs",
    "report:all": "node tests/reporting/generate-report.cjs && node tests/reporting/generate-master-catalog.cjs",
    "compile:uk": "node scripts/compile-region.cjs uk",
    "compile:usa": "node scripts/compile-region.cjs usa",
    "compile:uae": "node scripts/compile-region.cjs uae",
    "compile:all": "node scripts/compile-all.cjs",
    "compile": "node scripts/compile-region.cjs",
    "dev:uk": "node scripts/dev-region.cjs uk",
    "dev:usa": "node scripts/dev-region.cjs usa",
    "dev:uae": "node scripts/dev-region.cjs uae",
    "check": "node tests/static/theme-check-runner.cjs",
    "check:theme": "node tests/static/theme-check-runner.cjs",
    "lint:css": "node tests/static/stylelint-runner.cjs",
    "lint": "npm run check:theme && npm run lint:css",
    "format": "prettier --write \"**/*.{liquid,json,js,css,md}\"",
    "format:check": "prettier --check .",
    "prepare": "node scripts/install-git-hooks.cjs",
    "guard": "node scripts/guard-live-repos.cjs",
    "theme:package": "shopify theme package --path=.",
    "theme:list:uae": "shopify theme list --store=scentspiredae.myshopify.com",
    "theme:info:uae": "shopify theme info --store=scentspiredae.myshopify.com",
    "theme:push:uae:dev": "node scripts/guard-live-repos.cjs --store scentspiredae.myshopify.com && npm test && shopify theme push --development --store=scentspiredae.myshopify.com",
    "sync:uae": "node engine/sync-regions.cjs --target=uae --skip-push",
    "sync:uae:dry": "node engine/sync-regions.cjs --target=uae --dry-run",
    "sync:pull:uk": "node engine/sync-regions.cjs --pull --target=uk",
    "sync:pull:usa": "node engine/sync-regions.cjs --pull --target=usa",
    "sync:pull:uae": "node engine/sync-regions.cjs --pull --target=uae",
    "region:sync": "node scripts/region-engine.cjs --sync",
    "region:list": "node scripts/region-engine.cjs",
    "region:show": "node scripts/show-region.cjs",
    "region:new": "node scripts/new-region.cjs",
    "region:prune": "node scripts/prune-region-overlays.cjs",
    "dead:check": "node scripts/find-dead-files.cjs",
    "content:extract": "node scripts/extract-content.cjs",
    "content:restore": "node scripts/restore-inline.cjs",
    "data:extract-js": "node scripts/extract-js-data.cjs",
    "dev:uk:live": "node scripts/dev-region.cjs uk",
    "dev:usa:live": "node scripts/dev-region.cjs usa",
    "shopify:logout": "shopify auth logout",
    "shopify:whoami": "shopify theme list --store=scentspireduk.myshopify.com",
    "fonts:baseline": "node scripts/font-inventory.cjs",
    "fonts:check": "node scripts/font-inventory.cjs --check",
    "fonts:report": "node scripts/font-inventory.cjs --report",
    "parity:check": "node scripts/render-snapshot.cjs --check",
    "parity:baseline": "node scripts/render-snapshot.cjs",
    "guard:literals": "node tests/static/guard--region-literals.cjs",
    "guard:literals:list": "node tests/static/guard--region-literals.cjs --list",
    "guard:literals:update": "node tests/static/guard--region-literals.cjs --update",
    "guard:fixtures": "node tests/static/run-guard-fixtures.cjs",
    "guard:imageurl": "node tests/static/guard--image-url.cjs",
    "guard:headings": "node tests/static/guard--headings.cjs",
    "guard:all": "node tests/static/guard--region-literals.cjs && node tests/static/guard--image-url.cjs && node tests/static/guard--headings.cjs && node tests/static/guard--section-refs.cjs && node tests/static/run-guard-fixtures.cjs",
    "stores:check": "node scripts/check-stores.cjs",
    "dev": "node scripts/dev-region.cjs",
    "guard:refs": "node tests/static/guard--section-refs.cjs",
    "parity:baseline:usa": "node scripts/render-snapshot.cjs --region=usa --url=http://127.0.0.1:9293 --country=US",
    "parity:check:usa": "node scripts/render-snapshot.cjs --check --region=usa --url=http://127.0.0.1:9293 --country=US",
    "links:check": "node scripts/check-links.cjs",
    "links:check:usa": "node scripts/check-links.cjs --region=usa",
    "looks:refresh": "node scripts/looks-refresh.cjs"
  },
  "devDependencies": {
    "@shopify/cli": "^3.94.0",
    "@shopify/prettier-plugin-liquid": "^1.11.0",
    "@shopify/theme-check-node": "^3.29.0",
    "prettier": "^3.5.0",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Scentspired",
  "license": "UNLICENSED"
}
