/*
 * Template layout, shared by every region: structure and design only.
 * Its words, images, links and lists are each region's regions/<id>/content/page-blog.json:
 *   "@content:<page>.<path>"   a value from that file
 *   "@shown": "<path>"         the section appears where that file says "shown": true
 *   "@list:<page>.<path>"      one block per item of that list, styled by "block_designs"
 * The build fills these in (scripts/compile-region.cjs). Edit design here, content there.
 */
{
  "sections": {
    "image_banner_JEHqic": {
      "type": "media--image-banner",
      "name": "t:sections.image-banner.presets.name",
      "settings": {
        "image": "@content:page-blog.image_banner.image",
        "image_overlay_opacity": 0,
        "image_height": "medium",
        "image_behavior": "none",
        "desktop_content_position": "middle-center",
        "desktop_content_alignment": "center",
        "show_text_box": true,
        "color_scheme": "",
        "stack_images_on_mobile": true,
        "mobile_content_alignment": "center",
        "show_text_below": true
      },
      "blocks": {},
      "block_order": []
    },
    "zigzag_blog_mXUTrf": {
      "type": "editorial--zigzag-blog",
      "name": "Zigzag Blog",
      "settings": {
        "heading_label": "@content:page-blog.zigzag_blog.heading_label",
        "heading_title": "@content:page-blog.zigzag_blog.heading_title",
        "heading_subtitle": "@content:page-blog.zigzag_blog.heading_subtitle"
      },
      "blocks": "@list:page-blog.zigzag_blog.items",
      "block_designs": {
        "blog_item": {
          "settings": {}
        }
      }
    }
  },
  "order": [
    "image_banner_JEHqic",
    "zigzag_blog_mXUTrf"
  ]
}
