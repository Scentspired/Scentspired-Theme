/*
 * Template layout, shared by every region: structure and design only.
 * Its words, images, links and lists are each region's regions/<id>/content/password.json:
 *   "@content:<page>.<path>"   a value from that file
 *   "@shown": "<path>"         the section appears where that file says "shown": true
 *   "@list:<page>.<path>"      one block per item of that list, styled by "block_designs"
 * The build fills these in (scripts/compile-region.cjs). Edit design here, content there.
 */
{
  "layout": "password",
  "sections": {
    "main": {
      "type": "marketing--email-signup",
      "settings": {
        "show_background_image": true,
        "image": "@content:password.email_signup.image",
        "image_overlay_opacity": 0,
        "image_height": "adapt-image",
        "desktop_content_position": "middle-center",
        "desktop_content_alignment": "center",
        "show_text_box": true,
        "color_scheme": "scheme-1",
        "mobile_content_alignment": "center",
        "show_text_below": true
      },
      "custom_css": [
        ".link,.customer a {cursor: pointer; display: inline-block; border: none; box-shadow: none; text-decoration: underline; text-underline-offset: 0.3rem; color: rgb(var(--color-link)); background-color: transparent; font-size: 2.4rem; font-family: inherit;}",
        ".password__footer-text {display: none;}"
      ],
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "@content:password.email_signup.heading.heading",
            "heading_size": "h1"
          }
        },
        "paragraph": {
          "type": "paragraph",
          "settings": {
            "text": "@content:password.email_signup.paragraph.text",
            "text_style": "body"
          }
        },
        "email_form": {
          "type": "email_form"
        }
      },
      "block_order": [
        "heading",
        "paragraph",
        "email_form"
      ]
    }
  },
  "order": [
    "main"
  ]
}
