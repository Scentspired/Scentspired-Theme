/*
 * Template layout, shared by every region: structure and design only.
 * Its words, images, links and lists are each region's regions/<id>/content/collection-without-name.json:
 *   "@content:<page>.<path>"   a value from that file
 *   "@shown": "<path>"         the section appears where that file says "shown": true
 *   "@list:<page>.<path>"      one block per item of that list, styled by "block_designs"
 * The build fills these in (scripts/compile-region.cjs). Edit design here, content there.
 */
{
  "sections": {
    "image_banner_bqAp3f": {
      "type": "media--image-banner",
      "name": "t:sections.image-banner.presets.name",
      "settings": {
        "image": "@content:collection-without-name.image_banner_1.image",
        "image_overlay_opacity": 0,
        "image_height": "adapt",
        "image_behavior": "none",
        "desktop_content_position": "middle-left",
        "desktop_content_alignment": "left",
        "show_text_box": false,
        "color_scheme": "",
        "stack_images_on_mobile": false,
        "mobile_content_alignment": "center",
        "show_text_below": false,
        "banner_link": "@content:collection-without-name.image_banner_1.banner_link",
        "banner_link_label": "@content:collection-without-name.image_banner_1.banner_link_label"
      },
      "custom_css": [
        ".banner__heading {margin-bottom: 0; margin-left: -80px; color: #fff; font-family: \"PPEditorialNew Ultralight Italic\", serif; font-weight: 500; font-style: italic;}",
        ".banner__text {margin-bottom: 0; margin-left: -80px; color: #fff; font-family: \"PPMori\", serif; font-weight: 500; max-width: 400px;}",
        "@media screen and (min-width: 750px) {.page-width {margin: unset; padding: 1.5rem; }}",
        "@media screen and (min-width: 750px) {.banner--desktop-transparent .banner__box {padding: 3rem 150px; }}",
        "@media (max-width: 768px) {.banner {display: none; }}"
      ],
      "blocks": {
        "heading_kjrnRQ": {
          "type": "heading",
          "settings": {
            "heading": "@content:collection-without-name.image_banner_1.heading.heading",
            "heading_size": "h1"
          }
        },
        "text_YFpgtq": {
          "type": "text",
          "settings": {
            "text": "@content:collection-without-name.image_banner_1.text.text",
            "text_style": "subtitle"
          }
        }
      },
      "block_order": [
        "heading_kjrnRQ",
        "text_YFpgtq"
      ]
    },
    "image_banner_iWpd34": {
      "type": "media--image-banner",
      "name": "t:sections.image-banner.presets.name",
      "settings": {
        "image": "@content:collection-without-name.image_banner_2.image",
        "image_overlay_opacity": 0,
        "image_height": "adapt",
        "image_behavior": "none",
        "desktop_content_position": "top-left",
        "desktop_content_alignment": "center",
        "show_text_box": false,
        "color_scheme": "",
        "stack_images_on_mobile": false,
        "mobile_content_alignment": "left",
        "show_text_below": false,
        "banner_link": "@content:collection-without-name.image_banner_2.banner_link",
        "banner_link_label": "@content:collection-without-name.image_banner_2.banner_link_label"
      },
      "custom_css": [
        ".banner__heading {margin-bottom: 0; margin-left: 15px !important; color: #fff !important; font-family: \"PPEditorialNew Ultralight Italic\", serif; font-weight: 500; font-style: italic; margin-top: 290px !important; font-size: 26px;}",
        ".banner__text {margin-bottom: 0; margin-left: 15px; color: #fff; font-family: \"PPMori\", serif; font-weight: 500; max-width: 400px;}",
