      "custom_css": [
        "@media only screen and (max-width: 1023px) {.collection-title {font-family: Unbounded; font-size: 26px; font-weight: 500; margin: 30px 0 10px; text-align: center; } .scent-grid {gap: 10px !important; width: 100%; }}",
        "@media only screen and (min-width: 1024px) {.collection-title {font-size: 35px; margin: 10px 0 10px; text-align: left; margin-left: 300px; }}",
        ".scent-stars {margin-top: 0px;}",
        ".hover-variant-wrapper {margin-bottom: -5px;}",
        ".product-badge {color: #fff !important;}",
        ".product-badges {position: absolute !important;}",
        ".scent-main-title {display: none;}"
      ]
    },
    "collapsible_content_dak9pg": {
      "type": "content--collapsible",
      "name": "t:sections.collapsible_content.presets.name",
      "@shown": "collection-without-name.collapsible.shown",
      "settings": {
        "caption": "@content:collection-without-name.collapsible.caption",
        "heading": "@content:collection-without-name.collapsible.heading",
        "heading_size": "h1",
        "heading_alignment": "center",
        "layout": "none",
        "container_color_scheme": "",
        "color_scheme": "",
        "open_first_collapsible_row": false,
        "image_ratio": "adapt",
        "desktop_layout": "image_second",
        "padding_top": 36,
        "padding_bottom": 36
      },
      "blocks": "@list:collection-without-name.collapsible.items",
      "block_designs": {
        "collapsible_row": {
          "settings": {
            "icon": "question_mark"
          }
        }
      }
    },
    "newsletter_banner_nbnazx": {
      "type": "marketing--newsletter-banner",
      "name": "Newsletter Banner",
      "settings": {
        "background_image": "@content:collection-without-name.newsletter_banner.background_image",
        "heading": "@content:collection-without-name.newsletter_banner.heading",
        "subheading": "@content:collection-without-name.newsletter_banner.subheading",
        "description": "@content:collection-without-name.newsletter_banner.description"
      },
      "custom_css": [
        "@media only screen and (min-width: 1024px) and (max-width: 1439px) {.newsletter-banner .newsletter-content {margin-right: 0px !important; }}",
        "@media (max-width: 1023px) {.newsletter-banner button {width: 240px; height: 48px; margin-left: -323px; margin-top: 90px; } .newsletter-banner small {display: block; margin-top: 150px; font-size: 12px; color: #000; text-align: center; font-family: \"PPMori Regular\", sans-serif; line-height: 120%; } .newsletter-banner {height: 790px; } .newsletter-banner .newsletter-content {margin-bottom: 175px !important; }}"
      ]
    },
    "featuredscent_cUHiJf": {
      "type": "catalog--featured-scent",
      "name": "Scent Collection",
      "settings": {
        "heading": "@content:collection-without-name.featured_scent.heading",
        "subheading": "@content:collection-without-name.featured_scent.subheading",
        "collection": "@content:collection-without-name.featured_scent.collection",
        "view_all_link": "@content:collection-without-name.featured_scent.view_all_link"
      },
      "custom_css": [
        ".fragrance-item:hover .fragrance-info {transform: none; color: black;}",
        ".product-badge {color: #fff !important;}",
        ".mobile-only {display: flex !important;}",
        ".fragrance-container {display: none;}"
      ]
