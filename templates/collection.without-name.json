      "blocks": {
        "heading_LMpdEE": {
          "type": "heading",
          "settings": {
            "heading": "@content:collection-without-name.image_banner_2.heading.heading",
            "heading_size": "h1"
          }
        },
        "text_B9Xny6": {
          "type": "text",
          "settings": {
            "text": "@content:collection-without-name.image_banner_2.text.text",
            "text_style": "body"
          }
        }
      },
      "block_order": [
        "heading_LMpdEE",
        "text_B9Xny6"
      ]
    },
    "product-grid": {
      "type": "catalog--collection-grid",
      "settings": {
        "brand_collection_handles": "@content:collection-without-name.collection_grid.brand_collection_handles",
