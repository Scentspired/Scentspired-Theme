      "blocks": {
        "ai_gen_block_5c54be2_9Wtw4b": {
          "type": "ai_gen_block_5c54be2",
          "settings": {
            "heading": "<p>EDT, EDP, Parfum:</p>",
            "heading_size": 48,
            "mobile_heading_size": 16,
            "heading_line_height": 1.1,
            "heading_color": "#000000",
            "paragraph": "<p> The label nobody explains, the question nobody asks, and the reason you smell incredible at 9am and of absolutely nothing by lunch</p>",
            "paragraph_size": 44,
            "mobile_paragraph_size": 16,
            "paragraph_line_height": 1,
            "paragraph_color": "#000000",
            "desktop_image": "shopify://shop_images/EDT_EDP_OR_PARFUM.jpg_1.jpg",
            "image_aspect_ratio": "16/9",
