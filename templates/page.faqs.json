/*
 * Template layout, shared by every region: structure and design only.
 * Its words, images, links and lists are each region's regions/<id>/content/page-faqs.json:
 *   "@content:<page>.<path>"   a value from that file
 *   "@shown": "<path>"         the section appears where that file says "shown": true
 *   "@list:<page>.<path>"      one block per item of that list, styled by "block_designs"
 * The build fills these in (scripts/compile-region.cjs). Edit design here, content there.
 */
{
  "sections": {
    "faq_section_CBTw8b": {
      "type": "content--faq",
      "name": "FAQ Section",
      "settings": {
        "page_title": "@content:page-faqs.faq.page_title"
      },
      "custom_css": [
        "@media screen and (min-width: 1441px) {.faq-sidebar a:hover {color: #000; background-color: #efff31; width: 433px; } .faq-sidebar a.active {color: #000; background-color: #efff31; width: 433px !important; }}",
        "@media screen and (min-width: 1024px) and (max-width: 1440px) {.faq-sidebar a:hover {color: #000; background-color: #efff31; width: 299px; } .faq-sidebar a.active {color: #000; background-color: #efff31; width: 299px; }}",
        "@media screen and (max-width: 1024px) {.faq-container {margin-top: -100px; }}",
        ".faq-category {margin-left: 20px;}"
      ],
      "blocks": "@list:page-faqs.faq.items",
      "block_designs": {
        "category": {
          "settings": {}
        },
        "question": {
          "settings": {}
        }
      }
    },
    "newsletter_banner_LTEX3c": {
      "type": "marketing--newsletter-banner",
      "name": "Newsletter Banner",
      "settings": {
        "background_image": "@content:page-faqs.newsletter_banner.background_image",
        "heading": "@content:page-faqs.newsletter_banner.heading",
        "subheading": "@content:page-faqs.newsletter_banner.subheading",
        "description": "@content:page-faqs.newsletter_banner.description"
      },
      "custom_css": [
        "@media only screen and (min-width: 1024px) and (max-width: 1439px) {.newsletter-banner .newsletter-content {margin-right: 0px !important; }}",
        "@media (max-width: 1023px) {.newsletter-banner button {width: 240px; height: 48px; margin-left: -323px; margin-top: 90px; } .newsletter-banner small {display: block; margin-top: 150px; font-size: 12px; color: #000; text-align: center; font-family: \"PPMori Regular\", sans-serif; line-height: 120%; } .newsletter-banner {height: 790px; } .newsletter-banner .newsletter-content {margin-bottom: 175px !important; }}"
      ]
    }
  },
  "order": [
    "faq_section_CBTw8b",
    "newsletter_banner_LTEX3c"
  ]
}
