/*
 * Template layout, shared by every region: structure and design only.
 * Its words, images, links and lists are each region's regions/<id>/content/customers-login.json:
 *   "@content:<page>.<path>"   a value from that file
 *   "@shown": "<path>"         the section appears where that file says "shown": true
 *   "@list:<page>.<path>"      one block per item of that list, styled by "block_designs"
 * The build fills these in (scripts/compile-region.cjs). Edit design here, content there.
 */
{
  "sections": {
    "main": {
      "type": "account--login",
      "settings": {
        "enable_shop_login_button": "true",
        "padding_top": 36,
        "padding_bottom": 36
      }
    }
  },
  "order": [
    "main"
  ]
}
