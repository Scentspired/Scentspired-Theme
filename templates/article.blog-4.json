        "ai_gen_block_0232e4c_37U8Va": {
          "type": "ai_gen_block_0232e4c",
          "settings": {
            "heading": "<p>HOW TO MAKE YOUR FRAGRANCE LAST ALL DAY:</p>",
            "heading_size": 48,
            "mobile_heading_size": 24,
            "heading_line_height": 1.1,
            "heading_color": "#1a1a1a",
            "paragraph": "<p>the science of skin moisture, pulse points, and stopping olfactory fatigue before it starts</p>",
            "paragraph_size": 18,
            "mobile_paragraph_size": 16,
            "paragraph_line_height": 1.4,
            "paragraph_color": "#332F2B",
            "desktop_image": "shopify://shop_images/How_to_make_your_fragrance_last_all_day.png",
