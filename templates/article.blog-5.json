          "settings": {
            "heading": "<p>THE COACHELLA FRAGRANCE SURVIVAL KIT:</p>",
            "heading_size": 48,
            "mobile_heading_size": 24,
            "heading_line_height": 1.1,
            "heading_color": "#1a1a1a",
            "paragraph": "<p>how to smell incredible in 95-degree desert heat, dust, and all-night festival sets</p>",
            "paragraph_size": 18,
            "mobile_paragraph_size": 16,
            "paragraph_line_height": 1.4,
            "paragraph_color": "#332F2B",
            "desktop_image": "shopify://shop_images/magnific__photo-a-clear-glass-perfume-bottle-with-a-silver-c__9615_copy_jpg.jpg",
