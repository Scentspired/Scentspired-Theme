          "type": "editorial--luxury-perfume-banner",
          "settings": {
            "heading": "<p>HOW LUXURY UNISEX PERFUMES BECAME THE MOST SEARCHED SCENT CATEGORY IN THE UK:</p>",
            "heading_size": 48,
            "mobile_heading_size": 24,
            "heading_line_height": 1.1,
            "heading_color": "#1a1a1a",
            "paragraph": "<p>and why traditional gendered fragrance marketing is officially a relic of the past</p>",
            "paragraph_size": 18,
            "mobile_paragraph_size": 16,
            "paragraph_line_height": 1.4,
            "paragraph_color": "#332F2B",
