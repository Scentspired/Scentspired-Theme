/*
 * The layout of every box page (Five Favourites, Signature Trio, Discovery Set,
 * and any box added later). Layout and styling only: the words, images and
 * product come from each box's entry in regions/<id>/content/boxes.json.
 *
 * The build writes one page template per box — templates/page.<page_template>.json —
 * so a new entry in boxes.json becomes a template to pick in Shopify, with no
 * file to add here. See scripts/compile-region.cjs.
 *
 *   "@box"              the box's key in boxes.json (e.g. "signature_trio")
 *   "@box.<field>"      a field of that box        (e.g. "@box.banner.heading")
 *   "@content:<path>"   any region content value   (e.g. "@content:global.newsletter_banner.heading")
 */
{
  "sections": {
    "banner_desktop": {
      "type": "media--image-banner",
      "name": "Banner (desktop)",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "@box.banner.heading",
            "heading_size": "h0"
          }
        },
        "subheading": {
          "type": "text",
          "settings": {
            "text": "@box.banner.subheading",
            "text_style": "body"
          }
        }
      },
      "block_order": ["heading", "subheading"],
      "custom_css": [
        ".banner__heading {margin-bottom: 0; margin-left: -80px; color: #fff; font-family: \"PPEditorialNew Ultralight Italic\", serif; font-weight: 500; font-style: italic;}",
        ".banner__text {margin-bottom: 0; margin-left: -80px; color: #fff; font-family: \"PPMori\", serif; font-weight: 500; max-width: 400px; font-size: 20px;}",
        "@media screen and (min-width: 750px) {.page-width {margin: unset; padding: 1.5rem; }}",
        "@media screen and (min-width: 750px) {.banner--desktop-transparent .banner__box {padding: 3rem 150px; }}",
        "@media (max-width: 768px) {.banner {display: none; }}"
      ],
      "settings": {
        "image": "@box.banner.image_desktop",
        "image_overlay_opacity": 0,
        "image_height": "adapt",
        "image_behavior": "none",
        "desktop_content_position": "middle-left",
        "desktop_content_alignment": "left",
        "show_text_box": false,
        "color_scheme": "",
        "stack_images_on_mobile": false,
        "mobile_content_alignment": "center",
        "show_text_below": false
      }
    },
    "banner_mobile": {
      "type": "media--image-banner",
      "name": "Banner (mobile)",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "@box.banner.heading",
            "heading_size": "h2"
          }
        },
        "subheading": {
          "type": "text",
          "settings": {
            "text": "@box.banner.subheading",
            "text_style": "body"
          }
        }
      },
      "block_order": ["heading", "subheading"],
      "custom_css": [
        ".banner__heading {margin-bottom: 0; margin-left: 15px !important; color: #fff !important; font-family: \"PPEditorialNew Ultralight Italic\", serif !important; font-weight: 500 !important; font-style: italic !important; margin-top: 300px !important;}",
        ".banner__text {margin-bottom: 0; margin-left: 15px; color: #fff; font-family: \"PPMori\", serif !important; font-weight: 500; max-width: 400px;}",
        "@media (min-width: 768px) {.banner {display: none; }}",
        ".banner__content {padding-top: 40px;}",
        ".banner__media {height: auto;}",
        ".banner__text {line-height: 23px;}"
      ],
      "settings": {
        "image": "@box.banner.image_mobile",
        "image_overlay_opacity": 0,
        "image_height": "adapt",
        "image_behavior": "none",
        "desktop_content_position": "middle-left",
        "desktop_content_alignment": "left",
        "show_text_box": false,
        "color_scheme": "",
        "stack_images_on_mobile": false,
        "mobile_content_alignment": "left",
        "show_text_below": false
      }
    },
    "builder": {
      "type": "bundle--box",
      "name": "Box builder",
      "custom_css": [
        ".savings-row {padding: 4px 0 20px 0px; text-align: center; font-size: 14px; color: #666; background: #f3f3f3;}"
      ],
      "settings": {
        "box": "@box"
      }
    },
    "newsletter": {
      "type": "marketing--newsletter-banner",
      "name": "Newsletter",
      "custom_css": [
        "@media only screen and (min-width: 1024px) and (max-width: 1439px) {.newsletter-banner .newsletter-content {margin-right: 0px !important; }}",
        "@media (max-width: 1023px) {.newsletter-banner button {width: 240px; height: 48px; margin-left: -323px; margin-top: 90px; } .newsletter-banner small {display: block; margin-top: 150px; font-size: 12px; color: #000; text-align: center; font-family: \"PPMori Regular\", sans-serif; line-height: 120%; } .newsletter-banner {height: 790px; } .newsletter-banner .newsletter-content {margin-bottom: 175px !important; }}"
      ],
      "settings": {
        "background_image": "@content:global.newsletter_banner.background_image",
        "heading": "@content:global.newsletter_banner.heading",
        "subheading": "@content:global.newsletter_banner.subheading",
        "description": "@content:global.newsletter_banner.description"
      }
    }
  },
  "order": ["banner_desktop", "banner_mobile", "builder", "newsletter"]
}
