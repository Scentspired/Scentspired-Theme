{{ 'catalog--card-slider.css' | asset_url | stylesheet_tag }}

<div class="featured-collections-section" data-card-slider>
  <div class="mobile-arrows">
    <button class="arrow-btn" type="button" data-card-slider-prev>&#10094;</button>
    <button class="arrow-btn" type="button" data-card-slider-next>&#10095;</button>
  </div>
  <div class="featured-collections-wrapper" data-card-slider-track>
    {% for block in section.blocks %}
      {% assign collection = collections[block.settings.collection] %}
      {% if collection != blank %}
        <div class="collection-card">
          <a
            href="{{ block.settings.button_link }}"
            aria-label="Shop {{ block.settings.title | default: collection.title }}"
            style="text-decoration: none; color: inherit;">
            {% if block.settings.video_url != blank %}
              <video
                class="collection-video"
                src="{{ block.settings.video_url }}"
                autoplay
                muted
                loop
                playsinline></video>
            {% else %}
              <!-- Fallback image if video not added -->
              <img src="{{ collection.image | img_url: 'master' }}" alt="{{ collection.title }}">
            {% endif %}
          </a>
          <div class="collection-content">{{ block.settings.title }}</div>
          <a href="{{ block.settings.button_link }}" class="collection-button">
            {{ block.settings.button_text }}
          </a>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>



<script src="{{ 'catalog--card-slider.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Featured Collections",
  "settings": [],
  "blocks": [
    {
      "type": "collection_block",
      "name": "Collection Block",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select collection"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "Collection Video URL",
          "info": "Upload MP4 in Content → Files and paste the link here"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile Image",
          "info": "Upload a different image for mobile view. If not provided, the collection's default image will be used."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Collection title",
          "default": "Women"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Featured Collections",
      "blocks": [
        { "type": "collection_block" },
        { "type": "collection_block" },
        { "type": "collection_block" },
        { "type": "collection_block" }
      ]
    }
  ]
}
{% endschema %}
