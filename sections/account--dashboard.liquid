{{ "account--customer.css" | asset_url | stylesheet_tag }}

{%- style -%}
  .customer.account {
    max-width: 1000px;
    margin: 0 auto;
    padding: 155px 20px;
    font-family: 'Unbounded', sans-serif;
    color: #012169;
  }
  .customer.account h1,
  .customer.account h2,
  .customer.account h3 {
    margin-bottom: 20px;
  }
  .customer.account .welcome {
    font-size: 28px;
    font-weight: 600;
    margin-bottom: 30px;
  }
  .customer.account .section {
    margin-bottom: 50px;
    border-bottom: 1px solid #eee;
    padding-bottom: 30px;
  }
  .customer.account table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 15px;
  }
  .customer.account table th,
  .customer.account table td {
    border: 1px solid #eee;
    padding: 10px;
    text-align: left;
  }
  .customer.account a {
    color: #1a73e8;
    text-decoration: none;
  }
  .customer.account a:hover {
    text-decoration: underline;
  }
{%- endstyle -%}

<div class="customer account">
  <div class="welcome">{{ 'sections.account_dashboard.welcome' | t: name: customer.first_name }}</div>

  <!-- Orders Section -->
  <div class="section orders">
    <h2>{{ 'sections.account_dashboard.orders' | t }}</h2>
    {% if customer.orders_count > 0 %}
      <table>
        <thead>
          <tr>
            <th>{{ 'sections.account_dashboard.order_number' | t }}</th>
            <th>{{ 'sections.account_dashboard.date' | t }}</th>
            <th>{{ 'sections.account_dashboard.payment' | t }}</th>
            <th>{{ 'sections.account_dashboard.fulfillment' | t }}</th>
            <th>{{ 'sections.account_dashboard.total' | t }}</th>
          </tr>
        </thead>
        <tbody>
          {% for order in customer.orders %}
            <tr>
              <td>
                <a href="{{ order.customer_url }}">#{{ order.name }}</a>
              </td>
              <td>{{ order.created_at | date: "%b %d, %Y" }}</td>
              <td>{{ order.financial_status_label }}</td>
              <td>{{ order.fulfillment_status_label }}</td>
              <td>{{ order.total_price | money_with_currency }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    {% else %}
      <p>{{ 'sections.account_dashboard.no_orders' | t }}</p>
    {% endif %}
  </div>

  <!-- Account Details Section -->
  <div class="section account-details">
    <h2>{{ 'sections.account_dashboard.account_details' | t }}</h2>
    <p><strong>{{ 'sections.account_dashboard.email' | t }}</strong> {{ customer.email }}</p>
    <p><strong>{{ 'sections.account_dashboard.first_name' | t }}</strong> {{ customer.first_name }}</p>
    <p><strong>{{ 'sections.account_dashboard.last_name' | t }}</strong> {{ customer.last_name }}</p>

    <a href="{{ routes.account_edit_url }}">{{ 'sections.account_dashboard.edit_account' | t }}</a>
  </div>

  <!-- Addresses Section -->
  <div class="section addresses">
    <h2>{{ 'sections.account_dashboard.addresses' | t }}</h2>
    {% if customer.addresses_count > 0 %}
      <ul>
        {% for address in customer.addresses %}
          <li>
            {{ address.name }} — {{ address.address1 }}, {{ address.city }}, {{ address.country }}
            {% if address.default %}{{ 'sections.account_dashboard.default_address' | t }}{% endif %}
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <p>{{ 'sections.account_dashboard.no_addresses' | t }}</p>
    {% endif %}

    <a href="{{ routes.account_addresses_url }}">{{ 'sections.account_dashboard.manage_addresses' | t }}</a>
  </div>

  <!-- Logout -->
  <div class="section logout">
    <a href="{{ routes.account_logout_url }}">{{ 'sections.account_dashboard.log_out' | t }}</a>
  </div>
</div>
