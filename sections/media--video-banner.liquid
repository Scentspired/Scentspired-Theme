{% schema %}
{
  "name": "Video Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Upload Logo"
    },
    {
      "type": "text",
      "id": "main_title_part1",
      "label": "Main Title Part 1 (Editorial Font)",
      "default": "Scents"
    },
    {
      "type": "text",
      "id": "main_title_part2",
      "label": "Main Title Part 2 (Sans Font)",
      "default": "that linger"
    },
    {
      "type": "text",
      "id": "subtitle_part1",
      "label": "Subtitle Part 1 (Sans Font)",
      "default": "It's a"
    },
    {
      "type": "text",
      "id": "subtitle_part2",
      "label": "Subtitle Part 2 (Editorial Font)",
      "default": "Vibe."
    },
    {
      "type": "text",
      "id": "side_text",
      "label": "Side Text",
      "default": "Feel Powerful"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "EXPLORE ALL PRODUCTS"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "default": "/collections/all"
    }
  ],
  "presets": [
    {
      "name": "Video Banner",
      "category": "Custom"
    }
  ]
}
{% endschema %}

<div class="video-banner-wrapper">
  <!-- Desktop Banner -->
  <div class="banner-desktop" id="banner-desktop">
    <!-- Video Container with poster image as background -->
    <div class="video-container">
      <!-- Poster Image - Inline data URI loads instantly with 0 delay -->
      <img
        id="poster-desktop"
        src="data:image/jpeg;base64,/9j/4AAQSkZJRgABAQEAYABgAAD/2wBDAAIBAQIBAQICAgICAgICAwUDAwwUAxMTAwMRBBMTExMRBxcTExcTGxsbGxsbGxsbGxsbGxsbGxsbGxsbGxsbGxsBAQICAgICAwUDAwwUAxMTAwMRBBMTExMRBxcTExcTGxsbGxsbGxsbGxsbGxsbGxsbGxsbGxsbGxsBAQICAgICAwUDAwwUAxMTAwMRBBMTExMRBxcTExcTGxsbGxsbGxsbGxsbGxsbGxsbGxsbGxsbGxs"
        alt="Banner"
        class="poster-image"
        width="1920"
        height="1080"
        style="background: linear-gradient(135deg, #1a1a1a 0%, #000000 100%); display: block;">
      <!-- Video - Overlays on top when loaded -->
      <video
        id="main-video-desktop"
        muted
        loop
        playsinline
        preload="none"
        class="video-element">
        <source src="https://cdn.shopify.com/videos/c/o/v/01ece0dcb8c947ec83bd05667497d987.mp4" type="video/mp4">
      </video>
    </div>
  </div>

  <!-- Mobile Banner -->
  <div class="banner-mobile" id="banner-mobile">
    <!-- Video Container with poster image as background -->
    <div class="video-container">
      <!-- Poster Image - Inline data URI loads instantly with 0 delay -->
      <img
        id="poster-mobile"
        src="data:image/jpeg;base64,/9j/4AAQSkZJRgABAQEAYABgAAD/2wBDAAIBAQIBAQICAgICAgICAwUDAwwUAxMTAwMRBBMTExMRBxcTExcTGxsbGxsbGxsbGxsbGxsbGxsbGxsbGxsbGxsBAQICAgICAwUDAwwUAxMTAwMRBBMTExMRBxcTExcTGxsbGxsbGxsbGxsbGxsbGxsbGxsbGxsbGxsBAQICAgICAwUDAwwUAxMTAwMRBBMTExMRBxcTExcTGxsbGxsbGxsbGxsbGxsbGxsbGxsbGxsbGxs"
        alt="Banner Mobile"
        class="poster-image"
        width="750"
        height="800"
        style="background: linear-gradient(135deg, #1a1a1a 0%, #000000 100%); display: block;">
      <!-- Video - Overlays on top when loaded -->
      <video
        id="main-video-mobile"
        muted
        loop
        playsinline
        preload="none"
        class="video-element">
        <source src="https://cdn.shopify.com/videos/c/o/v/01ece0dcb8c947ec83bd05667497d987.mp4" type="video/mp4">
      </video>
    </div>
  </div>

  <div class="video-content">
    {% if section.settings.logo_image != blank %}
      <img src="{{ section.settings.logo_image | image_url }}" alt="Logo" class="custom-logo">
    {% endif %}

    <div class="main-title-container">
      <h2 class="main-title">
        <span class="title-editorial">{{ section.settings.main_title_part1 }}</span>
        <span class="title-sans">{{ section.settings.main_title_part2 }}</span>
      </h2>
      <p class="subtitle-line">
        <span class="subtitle-sans">{{ section.settings.subtitle_part1 }}</span>
        <span class="subtitle-editorial">{{ section.settings.subtitle_part2 }}</span>
      </p>
    </div>

    <div class="curved-line">
      <img
        src="https://hebbkx1anhila5yf.public.blob.vercel-storage.com/Vector%202-C6ze3HVovCJ3KMe0mS0Mr7hUlPTkYh.png"
        alt="Curved Line"
        class="curve-image">
    </div>

    {% if section.settings.button_text != blank %}
      <a href="{{ section.settings.button_link }}" class="video-button-rounded">
        <span class="button-text">{{ section.settings.button_text }}</span>
        <div class="button-arrow-circle">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
            <path d="M5 12H19M13 6L19 12L13 18"
                  stroke="white"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"/>
          </svg>
        </div>
      </a>
    {% endif %}
  </div>

  <div class="side-text-container">
    <p class="side-text">{{ section.settings.side_text }}</p>
  </div>
</div>

<script>
  // Smart video loading based on device and network
  function initializeVideoBanners() {
    const isMobile = window.innerWidth < 768;
    const videoId = isMobile ? 'main-video-mobile' : 'main-video-desktop';
    const posterId = isMobile ? 'poster-mobile' : 'poster-desktop';
    const video = document.getElementById(videoId);
    const poster = document.getElementById(posterId);

    if (!video) return;

    video.muted = true;

    // Desktop: Autoplay immediately
    if (!isMobile) {
      video.preload = 'auto';
      // Slight delay to ensure poster is visible first
      setTimeout(() => {
        video.play().catch(e => {
          console.warn('[v0] Desktop autoplay skipped');
        });
      }, 100);
    }
    // Mobile: Load on first interaction to save bandwidth
    else {
      video.preload = 'none';

      const playVideoOnInteraction = () => {
        // Add loading state
        video.style.opacity = '0';
        video.preload = 'auto';
        video.load();

        video.addEventListener(
          'canplay',
          () => {
            video.style.opacity = '1';
            video.play().catch(e => {
              console.warn('[v0] Mobile play failed');
            });
          },
          { once: true }
        );

        document.removeEventListener('click', playVideoOnInteraction);
        document.removeEventListener('touchstart', playVideoOnInteraction);
      };

      document.addEventListener('click', playVideoOnInteraction, { once: true });
      document.addEventListener('touchstart', playVideoOnInteraction, { once: true });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeVideoBanners);
  } else {
    initializeVideoBanners();
  }

  let resizeTimeout;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(initializeVideoBanners, 300);
  });
</script>

