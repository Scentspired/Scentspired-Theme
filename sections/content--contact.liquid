{% comment %}
  The `contact-section` is a customizable section for displaying contact information, policies, or FAQ content.
  It includes a sidebar for navigation and dynamic content blocks.
{% endcomment %}
{{ 'content--contact.css' | asset_url | stylesheet_tag }}

<div class="faq-section">
  <div class="faq-container">
    <div class="faq-header">
      <div class="faq-title-line"></div>
      <h1 class="faq-title">{{ section.settings.page_title | default: "CONTACT" }}</h1>
      <div class="faq-title-line"></div>
    </div>
    <div class="faq-content">
      {% render 'content--info-sidebar' %}
      <main class="faq-main">
        <div class="contact-form-wrapper">
          {%- comment -%}
            "CONTACT US" above is this page's heading. This one sits beneath it
            and ships empty in every region, so as an h1 it was a second, blank
            main heading. As an h2 it is a subheading, and .contact-main-heading
            sets its own font-size, so nothing about it renders differently.
          {%- endcomment -%}
          <h2 class="contact-main-heading">{{ section.settings.main_heading | default: "" }}</h2>
          <div class="contact-description">
            {{ section.settings.main_description }}
          </div>

          {%- form "contact", id: "ContactForm", class: "contact-form" -%}
            {%- if form.posted_successfully? -%}
              <p class="form-status form-status-list form__message" tabindex="-1" autofocus>
                {{ "templates.contact.form.post_success" | t }}
              </p>
            {%- elsif form.errors -%}
              <div class="form__message">
                <h2 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
                  {{ "templates.contact.form.error_heading" | t }}
                </h2>
              </div>
            {%- endif -%}

            <div class="contact-form-field">
              <label for="ContactForm-name">{{ 'sections.contact_form.name' | t }}</label>
              <input
                type="text"
                id="ContactForm-name"
                name="contact[name]"
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                placeholder="{{ 'sections.contact_form.name' | t }}">
            </div>

            <div class="contact-form-field">
              <label for="ContactForm-email">{{ 'sections.contact_form.email' | t }}</label>
              <input
                autocomplete="email"
                type="email"
                id="ContactForm-email"
                name="contact[email]"
                spellcheck="false"
                autocapitalize="off"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                aria-required="true"
                {% if form.errors contains "email" %}
                  aria-invalid="true"
                  aria-describedby="ContactForm-email-error"
                {% endif %}
                placeholder="{{ 'sections.contact_form.email' | t }}"
                required>
            </div>

            <div class="contact-form-field">
              <label for="ContactForm-phone">{{ 'sections.contact_form.phone' | t }}</label>
              <input
                type="tel"
                id="ContactForm-phone"
                autocomplete="tel"
                name="contact[phone]"
                pattern="[0-9\-]*"
                value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                placeholder="{{ 'sections.contact_form.phone_placeholder' | t }}">
            </div>

            <div class="contact-form-field">
              <label for="ContactForm-body">{{ 'sections.contact_form.message' | t }}</label>
              <textarea
                rows="10"
                id="ContactForm-body"
                name="contact[body]"
                placeholder="{{ 'sections.contact_form.message_placeholder' | t }}">
                {{- form.body -}}
              </textarea>
            </div>

            <div class="contact-form-submit">
              <button type="submit" class="contact-submit-btn">{{ 'sections.contact_form.send' | t }}</button>
            </div>
          {%- endform -%}
        </div>
      </main>
    </div>
  </div>
</div>


{% schema %}
{
  "name": "Contact Section",
  "settings": [
    {
      "type": "text",
      "id": "page_title",
      "label": "Page Title",
      "default": "CONTACT"
    },
    {
      "type": "paragraph",
      "content": "The sidebar links are the region's content/info-pages.json (sidebar_links), shared by all the info pages."
    },
    {
      "type": "text",
      "id": "main_heading",
      "label": "Main Content Heading",
      "default": "Contact Us"
    },
    {
      "type": "richtext",
      "id": "main_description",
      "label": "Main Content Description",
      "default": "<p>If, for any reason, you have any issues or simply just have some questions for us, please do not think twice about contacting our support team at;</p><p>help@theessencevault.co.uk</p><p>We aim to respond to all questions within 24 hours.</p><p>Speak soon!</p>"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "Contact Section",
      "blocks": []
    }
  ]
}
{% endschema %}
