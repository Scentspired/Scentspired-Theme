{% schema %}
{
  "name": "Video With Text",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    {
      "type": "url",
      "id": "video_url",
      "label": "Video MP4 URL"
    },
    {
      "type": "richtext",
      "id": "text_content",
      "label": "Text Content",
      "default": "<p>From dusky oud trails that echo the mystery of Arabian nights, to fresh citrus notes that dance like sunlit Mediterranean mornings, our fragrances are crafted with intention, emotion, and purpose. Each blend begins with ethically sourced ingredients, chosen not just for their purity, but for the stories they carry — stories of distant lands, ancient rituals, and timeless elegance.</p><p>We pour obsessive attention into every detail — from the balance of each accord to the design of each bottle — ensuring that what touches your skin is nothing short of extraordinary.</p>"
    }
  ],
  "presets": [
    {
      "name": "Video with Text Section"
    }
  ]
}
{% endschema %}

{{ 'media--video-text.css' | asset_url | stylesheet_tag }}

<section class="video-text-section">
  <div class="video-text-wrapper">
    <div class="video-box">
      <video autoplay muted loop playsinline>
        <source src="{{ section.settings.video_url }}" type="video/mp4">
        {{ 'sections.video_text.video_unsupported' | t }}
      </video>
    </div>
    <div class="text-box">
      <h2 class="main-heading">{{ section.settings.heading }}</h2>
      {{ section.settings.text_content }}
    </div>
  </div>
</section>
