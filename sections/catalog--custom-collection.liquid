{% comment %}
  Custom Collection Browse Section
{% endcomment %}

{{ 'catalog--custom-collection.css' | asset_url | stylesheet_tag }}

<div class="collection-browse-section">
  {% if section.settings.section_heading != blank %}
    <h2 class="section-heading">{{ section.settings.section_heading }}</h2>
  {% endif %}

  <!-- Desktop/Laptop View -->
  <div class="collections-container">
    {% for block in section.blocks limit: 4 %}
      {% assign collection = collections[block.settings.collection] %}
      <div class="collection-item" {{ block.shopify_attributes }}>
        {% if block.settings.collection_image != blank %}
          <img
            src="{{ block.settings.collection_image | img_url: '1920x1080' }}"
            alt="{{ collection.title | default: block.settings.collection_title }}"
            class="collection-image"
            loading="lazy">
        {% elsif collection.featured_image %}
          <img
            src="{{ collection.featured_image | img_url: '1920x1080' }}"
            alt="{{ collection.title }}"
            class="collection-image"
            loading="lazy">
        {% else %}
          <div
            class="collection-image"
            style="background: {{ block.settings.background_color | default: '#f5f5f5' }};"></div>
        {% endif %}

        <div class="collection-overlay">
          <h3 class="collection-title">
            {{ block.settings.collection_title | default: collection.title | upcase }}
          </h3>

          <div class="collection-content">
            {% if block.settings.collection_description != blank %}
              <p class="collection-description">{{ block.settings.collection_description }}</p>
            {% elsif collection.description != blank %}
              <p class="collection-description">{{ collection.description | truncate: 150 }}</p>
            {% endif %}

            <a
              href="{{ collection.url | default: block.settings.collection_url | default: '#' }}"
              class="collection-button">
              {{ block.settings.button_text | default: "Shop Now" }}
            </a>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>

  <!-- Mobile Slider -->
  <div class="mobile-slider">
    <div class="mobile-slides" id="mobileSlides">
      {% for block in section.blocks limit: 4 %}
        {% assign collection = collections[block.settings.collection] %}
        <div class="collection-item">
          {% if block.settings.collection_image != blank %}
            <img
              src="{{ block.settings.collection_image | img_url: '1080x720' }}"
              alt="{{ collection.title | default: block.settings.collection_title }}"
              class="collection-image"
              loading="lazy">
          {% elsif collection.featured_image %}
            <img
              src="{{ collection.featured_image | img_url: '1080x720' }}"
              alt="{{ collection.title }}"
              class="collection-image"
              loading="lazy">
          {% else %}
            <div
              class="collection-image"
              style="background: {{ block.settings.background_color | default: '#f5f5f5' }};"></div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    <button class="slider-arrows arrow-left" onclick="previousSlide()">‹</button>
    <button class="slider-arrows arrow-right" onclick="nextSlide()">›</button>
  </div>

  <!-- Mobile Content (only visible on mobile) -->
  {% for block in section.blocks limit: 4 %}
    {% assign collection = collections[block.settings.collection] %}
    <div
      class="mobile-content"
      id="mobileContent{{ forloop.index0 }}"
      style="{% unless forloop.first %}display: none;{% endunless %}">
      <h3 class="collection-title">
        {{ block.settings.collection_title | default: collection.title | upcase }}
      </h3>

      {% if block.settings.collection_description != blank %}
        <p class="collection-description">{{ block.settings.collection_description }}</p>
      {% elsif collection.description != blank %}
        <p class="collection-description">{{ collection.description | truncate: 150 }}</p>
      {% endif %}

      <a
        href="{{ collection.url | default: block.settings.collection_url | default: '#' }}"
        class="collection-button">
        {{ block.settings.button_text | default: "Shop Now" }}
      </a>
    </div>
  {% endfor %}
</div>

<script>
  let currentSlide = 0;
  const totalSlides = {{ section.blocks.size }};

  function updateSlide() {
    const slides = document.getElementById('mobileSlides');
    if (slides) {
      const translateX = -currentSlide * (100 / totalSlides);
      slides.style.transform = `translateX(${translateX}%)`;

      // Update content
      for (let i = 0; i < totalSlides; i++) {
        const content = document.getElementById(`mobileContent${i}`);
        if (content) {
          content.style.display = i === currentSlide ? 'block' : 'none';
        }
      }
    }
  }

  function nextSlide() {
    currentSlide = (currentSlide + 1) % totalSlides;
    updateSlide();
  }

  function previousSlide() {
    currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
    updateSlide();
  }

  // Touch/swipe support for mobile
  let startX = 0;
  let endX = 0;

  const mobileSlider = document.querySelector('.mobile-slider');
  if (mobileSlider) {
    mobileSlider.addEventListener('touchstart', function(e) {
      startX = e.touches[0].clientX;
    });

    mobileSlider.addEventListener('touchend', function(e) {
      endX = e.changedTouches[0].clientX;
      handleSwipe();
    });
  }

  function handleSwipe() {
    const threshold = 50;
    const diff = startX - endX;

    if (Math.abs(diff) > threshold) {
      if (diff > 0) {
        nextSlide();
      } else {
        previousSlide();
      }
    }
  }

  // Initialize on page load
  document.addEventListener('DOMContentLoaded', function() {
    updateSlide();
  });
</script>

{% schema %}
{
  "name": "Custom Collection Browse",
  "settings": [
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section Heading",
      "default": "Browse by Product Type"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "collection_title",
          "label": "Custom Collection Title",
          "info": "Leave blank to use collection title"
        },
        {
          "type": "textarea",
          "id": "collection_description",
          "label": "Custom Description",
          "info": "Leave blank to use collection description"
        },
        {
          "type": "image_picker",
          "id": "collection_image",
          "label": "Custom Collection Image",
          "info": "Leave blank to use collection featured image"
        },
        {
          "type": "url",
          "id": "collection_url",
          "label": "Custom URL",
          "info": "Leave blank to use collection URL"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Shop Now"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Background Color",
          "default": "#f5f5f5",
          "info": "Used when no image is selected"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Collection Browse",
      "blocks": [
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        }
      ]
    }
  ]
}
{% endschema %}
