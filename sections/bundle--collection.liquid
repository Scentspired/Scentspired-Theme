{%- comment -%}
  The homepage's bundles slider: one card per box in
  regions/<id>/content/boxes.json that has a "homepage_card", in the file's
  order. A new box gets its card by its entry alone.

    "homepage_card": {
      "title":         "The Signature Trio",     under the image
      "button_text":   "Shop Now",
      "image_mobile":  "https://…/4_5.jpg",       the card's image on mobile
      "image_desktop": "https://…/Tri_Box.webp",  the card's image on desktop
      "video_desktop": "https://…/x.mp4"          optional: a video instead, on desktop
    }

  The card links to the box's page_url.
{%- endcomment -%}
{{ 'catalog--card-slider.css' | asset_url | stylesheet_tag }}

<div class="featured-collections-section featured-collections-section--dim-images" data-card-slider>
  <div class="mobile-arrows">
    <button class="arrow-btn" type="button" data-card-slider-prev>&#10094;</button>
    <button class="arrow-btn" type="button" data-card-slider-next>&#10095;</button>
  </div>
  <div class="featured-collections-wrapper" data-card-slider-track>
    {%- liquid
      capture box_ids
        render 'region--content', key: 'boxes.__keys'
      endcapture
      assign box_ids = box_ids | strip | split: ','
    -%}
    {%- for box_id in box_ids -%}
      {%- liquid
        assign card_key = 'boxes.' | append: box_id | append: '.homepage_card.'
        assign k = card_key | append: 'title'
        capture card_title
          render 'region--content', key: k
        endcapture
        assign card_title = card_title | strip
        assign k = 'boxes.' | append: box_id | append: '.page_url'
        capture card_link
          render 'region--content', key: k
        endcapture
        assign k = card_key | append: 'button_text'
        capture card_button
          render 'region--content', key: k
        endcapture
        assign k = card_key | append: 'image_mobile'
        capture card_image_mobile
          render 'region--content', key: k
        endcapture
        assign k = card_key | append: 'image_desktop'
        capture card_image_desktop
          render 'region--content', key: k
        endcapture
        assign k = card_key | append: 'video_desktop'
        capture card_video_desktop
          render 'region--content', key: k
        endcapture
        assign card_link = card_link | strip
        assign card_button = card_button | strip
        assign card_image_mobile = card_image_mobile | strip
        assign card_image_desktop = card_image_desktop | strip
        assign card_video_desktop = card_video_desktop | strip
      -%}
      {%- comment -%} A box without a homepage_card has no card. {%- endcomment -%}
      {%- if card_title != blank -%}
      <div class="collection-card">
        <a href="{{ card_link | escape }}" style="text-decoration: none; color: inherit;">
          {%- if card_image_mobile != blank -%}
            <!-- Mobile Image -->
            <img
              src="{{ card_image_mobile | escape }}"
              alt="{{ card_title | escape }}"
              class="collection-img mobile-only">
          {%- endif -%}
          <!-- Desktop Media -->
          {%- if card_video_desktop != blank -%}
            <video
              class="collection-video desktop-only"
              src="{{ card_video_desktop | escape }}"
              autoplay
              muted
              loop
              playsinline></video>
          {%- else -%}
            <img
              src="{{ card_image_desktop | escape }}"
              alt="{{ card_title | escape }}"
              class="collection-img desktop-only">
          {%- endif -%}
        </a>

        <div class="collection-content">{{ card_title | escape }}</div>
        <a href="{{ card_link | escape }}" class="collection-button">
          {{ card_button | escape }}
        </a>
      </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

<script src="{{ 'catalog--card-slider.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Bundle Collections",
  "settings": [
    {
      "type": "paragraph",
      "content": "One card per box in the region's content/boxes.json that has a homepage_card. Edit the cards there."
    }
  ],
  "presets": [{ "name": "Bundle Collections" }]
}
{% endschema %}
