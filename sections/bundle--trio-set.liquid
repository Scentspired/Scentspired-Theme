{%- liquid
  # Prices below used to be prefixed with a hardcoded currency symbol, which
  # shipped one region's currency to every storefront.
  capture region_currency_symbol
    render 'region--active', key: 'currency_symbol'
  endcapture
  assign region_currency_symbol = region_currency_symbol | strip
-%}
{% comment %}
  Discovery Box Builder
  - 5 slots with dynamic progress timeline
  - Desktop: Auto-open first slot, sequential product filling, auto-advance to next slot
  - Mobile: Original flexible behavior (no auto-select, manual slot selection)
  - Direct to checkout redirect
  - Selection flow: Brand -> Product
  - Requires exactly 5 items to checkout
{% endcomment %}

{{ 'bundle--trio-set.css' | asset_url | stylesheet_tag }}

<div class="perfume-bundle-section">
  <div class="builder-layout">
    
    <!-- LEFT SIDEBAR: BUNDLE STATUS -->
    <div class="bundle-sidebar">
      <div class="sidebar-header">
        <h2>{% render 'region--content', key: 'trio-box.builder.title' %}</h2>
        <p id="BundleStatusText">{% render 'region--content', key: 'trio-box.builder.subtitle' %}</p>
      </div>

      <div class="slots-wrapper">
        <div class="progress-timeline">
          <div class="progress-line"></div>
          <div class="progress-marker" style="top: 0%" id="Marker-0"></div>
          <div class="progress-label" style="top: 0%" id="Label-1"></div>
          <div class="progress-marker" style="top: 46%" id="Marker-1"></div>
          <div class="progress-label" style="top: 46%" id="Label-2"></div>
          <div class="progress-marker" style="top: 98%" id="Marker-4"></div>
          <div class="progress-label" style="top: 98%;" id="Label-3"></div>
        </div>

        <div class="slot-list" id="BundleSlots">
          {% for i in (1..3) %}
            <div class="slot-item empty" data-index="{{ forloop.index0 }}" onclick="openSelector({{ forloop.index0 }})">
              <div class="slot-placeholder-icon">+</div>
              <div class="slot-placeholder-text">
                <span class="primary">Select a product</span>
                <span class="unlock"> {{ 3 | minus: forloop.index | plus: 1 }} Selections Remaining</span>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>

      <div class="sidebar-footer">
      <div class="cart">
<button class="add-to-cart-btn" id="MainActionBtn" disabled onclick="handleCheckout()">
          <span>Add to Cart</span>
          <span id="TotalDisplay">{{ region_currency_symbol }} 0</span>
        </button>
      </div>
      <div class="savings-row">
         Standard Price: <span class="saving">{{ region_currency_symbol }}0</span>
      </div>
      <div class="save-row">
        Total Saving <span>{{ region_currency_symbol }}0</span>
      </div>
      </div>
    </div>

    <!-- RIGHT CONTENT: SELECTION DRAWER -->
    <div class="selection-drawer" id="SelectionDrawer">
      <div class="drawer-title">
        <div class="drawer-title-content">
        <button onclick="goBackToStep()" class="back-arrow-btn" id="BackArrowBtn" title="Go back">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
        <span class="drawer-title-text" id="DrawerHeadline">Select Brand</span>
        </div>
        <button onclick="closeSelector()" style="background: none; border: none; cursor: pointer; font-size: 25px;">×</button>
       </div>

       <div id="Step-Size" class="step-container">
        <div class="option-list">
          <div class="option-item" onclick="selectSize('50ml')">
            <span>{% render 'region--content', key: 'trio-box.builder.sizes.small' %}</span>
          </div>
          <div class="option-item" onclick="selectSize('100ml')">
            <span>{% render 'region--content', key: 'trio-box.builder.sizes.large' %}</span>
          </div>
        </div>
      </div>

      <div id="Step-Brand" class="step-container">
        <div class="option-list" id="BrandGrid">
          <!-- Brands injected here -->
        </div>
      </div>

      <div id="Step-Product" class="step-container" style="display: none;">
        <div class="search-bar-wrapper">
          <div class="search-input-container">
            <input type="text" id="ProductSearch" placeholder="Search" />
            <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.35-4.35"></path>
            </svg>
          </div>
        </div>
        <div class="option-list" id="ProductGrid">
          <!-- Products injected here -->
        </div>
      </div>
    </div>

  </div>
</div>

<script>
  // var, not const: several sections declare this and a top-level const is a
  // global lexical binding, so the second one on the page throws and takes the
  // rest of its script with it.
  var currSym = (window.__STORE_CONFIG && window.__STORE_CONFIG.currencySymbol) || '{{ cart.currency.symbol }}' || '$';
  let activeSize = null;
let currentStep = 'Step-Size';        // Tracks which step is open
let hasAddedFirstProduct = false;     // Becomes true after first product is added


const PRICING = {
  "50ml": {
    total: 42.99,
    standard: 77.97,
    saving: 34.98
  },
  "100ml": {
    total: 62.99,
    standard: 119.97,
    saving: 56.98
  }
};

  // Load all products from the 'shop' collection
  const PRODUCTS_BY_SIZE = {
  "50ml": [
    {% paginate collections['bundle-50ml'].products by 100 %}
      {% for product in collections['bundle-50ml'].products %}
        {
          id: {{ product.id }},
          title: {{ product.title | json }},
          vendor: {{ product.vendor | json }},
          image: {{ product.featured_image | img_url: '300x300' | json }},
          tags: {{ product.tags | json }},
          variants: [
  {% for variant in product.variants %}
    {
      id: {{ variant.id }},
      title: {{ variant.title | json }},
      price: {{ variant.price }},
      sku: {{ variant.sku | json }},
      available: {{ variant.available | json }}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    {% endpaginate %}
  ],

  "100ml": [
    {% paginate collections['bundle-100ml'].products by 100 %}
      {% for product in collections['bundle-100ml'].products %}
        {
          id: {{ product.id }},
          title: {{ product.title | json }},
          vendor: {{ product.vendor | json }},
          image: {{ product.featured_image | img_url: '300x300' | json }},
          tags: {{ product.tags | json }},
          variants: [
  {% for variant in product.variants %}
    {
      id: {{ variant.id }},
      title: {{ variant.title | json }},
      price: {{ variant.price }},
       sku: {{ variant.sku | json }},
      available: {{ variant.available | json }}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    {% endpaginate %}
  ]
};


 
  const brands = {% render 'region--data', name: 'bundle-brands' %};

  let bundle = [null, null, null];
  let currentSlot = null;
  let activeBrand = null;

// ---- FIRST PRODUCT CHECK (RUNS ONLY ONCE) ----
// ---- FIRST PRODUCT CHECK (RUNS ONLY ONCE) ----


  function isDesktop() {
    return window.innerWidth > 1024;
  }

  window.addEventListener('DOMContentLoaded', function() {
    if (isDesktop()) {
      openSelector(0);
    }
  });

  function openSelector(index) {
  currentSlot = index;
  document.getElementById('SelectionDrawer').classList.add('visible');

  document.querySelectorAll('.slot-item').forEach(s => s.classList.remove('active'));
  document.querySelector(`.slot-item[data-index="${index}"]`).classList.add('active');

  if (activeSize) {
    showStep('Step-Product');
  } else {
    showStep('Step-Size');
  }
}



  function closeSelector() {
    const drawer = document.getElementById('SelectionDrawer');
    if (drawer) {
      drawer.classList.remove('visible');
    }
    document.querySelectorAll('.slot-item').forEach(s => s.classList.remove('active'));
  }

function showStep(id) {
  document.querySelectorAll('.step-container').forEach(c => c.style.display = 'none');
  document.getElementById(id).style.display = 'block';

  currentStep = id;

  const backArrowBtn = document.getElementById('BackArrowBtn');
  if (!backArrowBtn) return;

  /* ============================
     STEP: SIZE
  ============================ */
  if (id === 'Step-Size') {
    document.getElementById('DrawerHeadline').innerText = 'Select Size';
    backArrowBtn.style.display = 'none';
  }

  /* ============================
     STEP: PRODUCT
  ============================ */
  if (id === 'Step-Product') {
    document.getElementById('DrawerHeadline').innerText = 'Select Product';

    // ✅ Show back arrow ONLY before first product
    backArrowBtn.style.display = hasAddedFirstProduct ? 'none' : 'flex';

    renderProducts();
    initSearchListener();
  }
}



  function goBackToStep() {
  if (currentStep === 'Step-Product' && !hasAddedFirstProduct) {
    showStep('Step-Size');
  }
}


  function selectSize(size) {
  activeSize = size;
  showStep('Step-Product');
}



  // Render brands in the drawer
  function renderBrands() {
    const grid = document.getElementById('BrandGrid');
    grid.innerHTML = brands.map(b => `
      <div class="option-item" onclick="selectBrand('${b.tag}')">
        <span>${b.name}</span>
      </div>
    `).join('');
  }

  function selectBrand(tag) {
    activeBrand = tag;
    showStep('Step-Product');
  }

  // Store filtered products for search
  let allFilteredProducts = [];

  // Render products matching ONLY the tag
  // Render products matching the active brand and size
function renderProducts(searchQuery = '') {
  const grid = document.getElementById('ProductGrid');
  if (!activeSize) return;

  const products = PRODUCTS_BY_SIZE[activeSize] || [];

  const filtered = products.filter(p =>
    Array.isArray(p.variants) &&
    p.variants.some(v => v.available === true)
  );

  allFilteredProducts = filtered;

  let displayProducts = filtered;

  // Apply search filter if query exists
  if (searchQuery.trim()) {
    const query = searchQuery.toLowerCase();
    displayProducts = filtered.filter(p => {
      const matchesTitle = p.title.toLowerCase().includes(query);
      const matchesVendor = p.vendor.toLowerCase().includes(query);
      const matchesTags = p.tags.some(tag => tag.toLowerCase().includes(query));
      
      return matchesTitle || matchesVendor || matchesTags;
    });
  }

  if (displayProducts.length === 0) {
    grid.innerHTML = '<div class="no-results-message">No products found matching your search.</div>';
    return;
  }

  grid.innerHTML = displayProducts.map(p => `
    <div class="option-item" onclick="addProductToBundle(${p.id}, '${activeSize}')">
      <div class="item-thumb"><img src="${p.image}" alt=""></div>
      <span>${p.title} (${p.vendor})</span>
    </div>
  `).join('');
}

  // Handle search input
  function handleSearch(event) {
    const searchQuery = event.target.value;
    renderProducts(searchQuery);
  }

  // Initialize search listener when Step-Product is shown
  function initSearchListener() {
    const searchInput = document.getElementById('ProductSearch');
    if (searchInput) {
      searchInput.value = '';
      searchInput.addEventListener('input', handleSearch);
    }
  }



// Add product to bundle
// Add product to bundle
function addProductToBundle(id, size) {
  const product = PRODUCTS_BY_SIZE[size].find(p => p.id === id);
  if (!product) return alert('Product not found');

  const variant = product.variants.find(v => v.title.toLowerCase().includes(size.toLowerCase())) || product.variants[0];

  const isDesktopView = isDesktop();

  // Add to current slot
  bundle[currentSlot] = {
    variantId: variant.id,
    title: product.title,
    sku: variant.sku,
    image: product.image,
    price: variant.price
  };
   if (!hasAddedFirstProduct) {
  hasAddedFirstProduct = true;
}

  updateUI();

  // Check for next empty slot
  const nextEmptyIndex = bundle.findIndex(item => item === null);

  if (nextEmptyIndex !== -1) {
    // If desktop, open next empty slot
    if (isDesktopView) {
      currentSlot = nextEmptyIndex; // set the next slot
      setTimeout(() => openSelector(nextEmptyIndex), 100);
    } else {
      // On mobile, just close drawer after selection
      closeSelector();
    }
  } else {
    // No empty slots left → close drawer
    bundleCompleted = true;
    setTimeout(() => closeSelector(), 100);
  }
}




  function removeItem(index) {
    bundle[index] = null;
    updateUI();
  }

  function updateUI() {
    const count = bundle.filter(x => x).length;

    // Update slots
    bundle.forEach((item, i) => {
      const el = document.querySelector(`.slot-item[data-index="${i}"]`);
      if (item) {
        el.classList.remove('empty');
        el.innerHTML = `
          <div class="slot-filled-content">
            <div class="slot-img"><img src="${item.image}" alt=""></div>
            <div class="slot-info">
              <h4>${item.title}</h4>
            </div>
            <button class="remove-item" onclick="event.stopPropagation(); removeItem(${i})">×</button>
          </div>
        `;
      } else {
        el.classList.add('empty');
        el.innerHTML = `
          <div class="slot-placeholder-icon">+</div>
          <div class="slot-placeholder-text">
            <span class="primary">Select a product</span>
            <span class="unlock"> ${3 - i} Selections Remaining</span>
          </div>
        `;
      }
    });

    const totalDisplay = document.getElementById('TotalDisplay');
const mainBtn = document.getElementById('MainActionBtn');

/* Enable button only when exactly 3 items are selected */
mainBtn.disabled = count !== 3;

/* Show price ONLY when bundle is complete */
if (count === 3 && activeSize) {
  const pricing = PRICING[activeSize];

  totalDisplay.innerText = `${currSym} ${pricing.total}`;
  totalDisplay.style.visibility = 'visible';

  document.querySelector('.savings-row .saving').innerText = `${currSym} ${pricing.standard}`;
  document.querySelector('.save-row span').innerText = `${currSym} ${pricing.saving}`;
} else {
  totalDisplay.innerText = '';
  totalDisplay.style.visibility = 'hidden';
}



    const statusText = count < 3 ? `Add ${3 - count} more items to complete your signature trio set` : `Your signature trio set is complete!`;
    document.getElementById('BundleStatusText').innerText = statusText;

    // Update progress markers
    document.querySelectorAll('.progress-marker, .progress-label').forEach(el => el.classList.remove('active'));
    for (let i = 0; i < count; i++) {
      if (document.getElementById(`Marker-${i}`)) document.getElementById(`Marker-${i}`).classList.add('active');
    }
    if (count >= 1) document.getElementById('Label-1').classList.add('active');
    if (count >= 2) document.getElementById('Label-2').classList.add('active');
    if (count >= 3) document.getElementById('Label-3').classList.add('active');
  }

  const TRIO_SET_VARIANT = {
  "50ml": 57083186086233,  // 50ml Trio variant ID
  "100ml": 57083186119001  // 100ml Trio variant ID
};

async function handleCheckout() {
  const btn = document.getElementById('MainActionBtn');
  const priceSpan = btn.querySelector('span:nth-child(2)');
  // The price the button showed before Adding.../ADDED!, which is rendered
  // from the product's real price. It used to reset to a typed "$29.99" /
  // "$44.99" whatever the storefront's currency and price.
  const originalPrice = priceSpan ? priceSpan.innerText : '';

  if (window.isProcessingCartAction) {
    console.warn('Cart action already in progress');
    return;
  }

  if (!activeSize) {
    alert('Please select a size first.');
    return;
  }

  const variantId = TRIO_SET_VARIANT[activeSize];
  if (!variantId) {
    alert('Variant not found.');
    return;
  }

  window.isProcessingCartAction = true;
  btn.disabled = true;
  priceSpan.innerText = "Adding...";

  // Build line item properties
const properties = {};
bundle.forEach((item, index) => {
  if (!item) return;

  properties[`Product ${index + 1}`] = item.title;
  properties[`SKU ${index + 1}`] = item.sku;
  properties[`Variant ID ${index + 1}`] = item.variantId; // ADD THIS
});


  try {
    const response = await fetch('/cart/add.js', {
      method: 'POST',
      headers: { 
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      },
      body: JSON.stringify({
        id: variantId,
        quantity: 1,
        properties: properties
      })
    });

    if (!response.ok) throw new Error('Add to cart failed');

    console.log('Trio set added successfully');

    // ✅ Reset everything: bundle, size, brand, and UI
    bundle = bundle.map(() => null);
    activeSize = null;
    activeBrand = null;

    if (typeof updateUI === 'function') updateUI();

    // Go back to first step (Step-Size)
    openSelector(0);

    btn.disabled = false;
    priceSpan.innerText = "ADDED!";

    const cartResponse = await fetch('/cart.js');
    const cart = await cartResponse.json();

    if (typeof updateDossierCartUI === 'function') updateDossierCartUI(cart);
    if (typeof openDossierCart === 'function') openDossierCart();

    setTimeout(() => {
      priceSpan.innerText = originalPrice;
      window.isProcessingCartAction = false;
    }, 2000);

  } catch (err) {
    console.error('Add to cart error:', err);
    alert('Error adding Trio set to cart. Please try again.');
    btn.disabled = false;
    priceSpan.innerText = originalPrice;
    window.isProcessingCartAction = false;
  }
}



</script>

{% schema %}
{
  "name": "Trio",
  "settings": [],
  "presets": [
    {
      "name": "Trio"
    }
  ]
}
{% endschema %}
