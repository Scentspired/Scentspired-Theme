{% comment %}
AI-Powered Perfume Recommendation Quiz Section - REDESIGNED
Premium card-based interface with user name personalization
{% endcomment %}

<div class="perfume-quiz-wrapper">
  <div class="hero-section">
    <div class="hero-content-wrapper">
      <div class="hero-image-container">
        <img src="https://cdn.shopify.com/s/files/1/0698/9398/0343/files/Website_-_ScentFinder_Footer_01.png?v=1767001740" class="hero-image" alt="Fragrance">
      </div>
      <div class="hero-text-container">
        <p class="fragrance-finder-text">Fragrance Finder</p>
        <h2 class="hero-heading">Discover the Scent That Defines You — Scentspired</h2>
        <button id="quiz-trigger-btn" class="show-all-btn">START THE QUIZ</button>
      </div>
    </div>
    <div class="hero-bottom-nav">
      <a href="#" class="nav-item">NURTURE</a>
      <a href="#" class="nav-item">BLACK ANISE</a>
      <a href="#" class="nav-item">CYAN NORI</a>
      <a href="#" class="nav-item">THE APARTMENT</a>
      <a href="#" class="nav-item">PINK IRIS</a>
      <a href="#" class="nav-item">PAUSE</a>
    </div>
  </div>

  {% comment %} Premium Quiz Modal {% endcomment %}
  <div id="quiz-modal" class="quiz-modal hidden">
    <div class="quiz-modal-overlay"></div>
    <div class="quiz-modal-content">
      <button id="close-quiz-btn" class="close-btn">&times;</button>
      
      <div id="quiz-container">
        {% comment %} Step 0: User Name Input {% endcomment %}
        <div class="quiz-step" data-step="0">
          <div class="quiz-progress">
            <div class="progress-bar" style="width: 14%"></div>
          </div>
          <div class="quiz-step-content">
            <div class="quiz-step-header">
              <span class="quiz-step-number">1 of 5</span>
              <h3 class="quiz-title-main">What's your name?</h3>
              <p class="quiz-subtitle">Let us personalize your fragrance journey</p>
            </div>
            <div class="quiz-input-group">
              <input type="text" id="user-name-input" class="quiz-name-input" placeholder="Enter your name..." maxlength="50">
            </div>
            <button class="quiz-next-btn" id="name-next-btn">CONTINUE</button>
          </div>
        </div>

        {% comment %} Question 1: Gender {% endcomment %}
        <div class="quiz-step hidden" data-step="1">
          <div class="quiz-progress">
            <div class="progress-bar" style="width: 28%"></div>
          </div>
          <div class="quiz-step-content">
            <div class="quiz-step-header">
              <span class="quiz-step-number">2 of 5</span>
              <h3 class="quiz-title-main">What's your gender preference?</h3>
              <p class="quiz-subtitle">This helps us narrow down your perfect match</p>
            </div>
            <div class="quiz-cards-grid">
              <button class="quiz-card" data-answer="Men">
                <div class="card-inner">
                  <div class="card-content">Men</div>
                </div>
              </button>
              <button class="quiz-card" data-answer="Women">
                <div class="card-inner">
                  <div class="card-content">Women</div>
                </div>
              </button>
              <button class="quiz-card" data-answer="Unisex">
                <div class="card-inner">
                  <div class="card-content">Unisex</div>
                </div>
              </button>
            </div>
            <div class="quiz-nav">
              <button class="quiz-back-btn" data-back="true">GO BACK</button>
            </div>
          </div>
        </div>

        {% comment %} Question 2: Scent Family {% endcomment %}
        <div class="quiz-step hidden" data-step="2">
          <div class="quiz-progress">
            <div class="progress-bar" style="width: 42%"></div>
          </div>
          <div class="quiz-step-content">
            <div class="quiz-step-header">
              <span class="quiz-step-number">3 of 5</span>
              <h3 class="quiz-title-main">What's your preferred scent family?</h3>
              <p class="quiz-subtitle">Choose the fragrance profile that speaks to you</p>
            </div>
            <div class="quiz-cards-grid">
              <button class="quiz-card" data-answer="Fresh">
                <div class="card-inner">
                  <div class="card-content">Fresh</div>
                </div>
              </button>
              <button class="quiz-card" data-answer="Flowery">
                <div class="card-inner">
                  <div class="card-content">Flowery</div>
                </div>
              </button>
              <button class="quiz-card" data-answer="Warm">
                <div class="card-inner">
                  <div class="card-content">Warm</div>
                </div>
              </button>
              <button class="quiz-card" data-answer="Earthy">
                <div class="card-inner">
                  <div class="card-content">Earthy</div>
                </div>
              </button>
              <button class="quiz-card" data-answer="Gourmand">
                <div class="card-inner">
                  <div class="card-content">Gourmand</div>
                </div>
              </button>
              <button class="quiz-card" data-answer="Herbal">
                <div class="card-inner">
                  <div class="card-content">Herbal</div>
                </div>
              </button>
            </div>
            <div class="quiz-nav">
              <button class="quiz-back-btn" data-back="true">GO BACK</button>
            </div>
          </div>
        </div>

        {% comment %} Question 3: Intensity {% endcomment %}
        <div class="quiz-step hidden" data-step="3">
          <div class="quiz-progress">
            <div class="progress-bar" style="width: 56%"></div>
          </div>
          <div class="quiz-step-content">
            <div class="quiz-step-header">
              <span class="quiz-step-number">4 of 5</span>
              <h3 class="quiz-title-main">What's your desired intensity?</h3>
              <p class="quiz-subtitle">Select how bold or subtle you prefer your scent</p>
            </div>
            <div class="quiz-cards-grid">
              <button class="quiz-card" data-answer="Light">
                <div class="card-inner">
                  <div class="card-content">Light & Fresh</div>
                </div>
              </button>
              <button class="quiz-card" data-answer="Medium">
                <div class="card-inner">
                  <div class="card-content">Balanced & Elegant</div>
                </div>
              </button>
              <button class="quiz-card" data-answer="Strong">
                <div class="card-inner">
                  <div class="card-content">Bold & Intense</div>
                </div>
              </button>
            </div>
            <div class="quiz-nav">
              <button class="quiz-back-btn" data-back="true">GO BACK</button>
            </div>
          </div>
        </div>

        {% comment %} Question 4: Occasion {% endcomment %}
        <div class="quiz-step hidden" data-step="4">
          <div class="quiz-progress">
            <div class="progress-bar" style="width: 70%"></div>
          </div>
          <div class="quiz-step-content">
            <div class="quiz-step-header">
              <span class="quiz-step-number">5 of 5</span>
              <h3 class="quiz-title-main">What's your preferred occasion?</h3>
              <p class="quiz-subtitle">Tell us when you'll wear your signature scent</p>
            </div>
            <div class="quiz-cards-grid">
              <button class="quiz-card" data-answer="Daily">
                <div class="card-inner">
                  <div class="card-content">Daily Wear</div>
                </div>
              </button>
              <button class="quiz-card" data-answer="Evening">
                <div class="card-inner">
                  <div class="card-content">Evening & Special</div>
                </div>
              </button>
              <button class="quiz-card" data-answer="Versatile">
                <div class="card-inner">
                  <div class="card-content">Versatile & All-Time</div>
                </div>
              </button>
            </div>
            <div class="quiz-nav">
              <button class="quiz-back-btn" data-back="true">GO BACK</button>
            </div>
          </div>
        </div>

        {% comment %} Loading State {% endcomment %}
        <div class="quiz-step hidden" data-step="loading">
          <div class="loading-container">
            <div class="spinner"></div>
            <p class="loading-text">Finding your perfect fragrance...</p>
          </div>
        </div>

        {% comment %} Results State {% endcomment %}
        <div class="quiz-step hidden" data-step="results">
          <div class="results-container">
            <div class="results-header">
              <h3 class="results-title">Your Perfect Match,</h3>
              <p class="results-name" id="result-user-name"></p>
            </div>
            <div id="result-card" class="result-card">
              <h2 id="result-perfume-name" class="perfume-name"></h2>
              <p id="result-inspired-by" class="inspired-by"></p>
              <div class="result-details">
                <div class="detail-section">
                  <p class="detail-label">HEAD NOTES</p>
                  <p id="result-head-notes" class="detail-content"></p>
                </div>
                <div class="detail-section">
                  <p class="detail-label">HEART NOTES</p>
                  <p id="result-heart-notes" class="detail-content"></p>
                </div>
                <div class="detail-section">
                  <p class="detail-label">BASE NOTES</p>
                  <p id="result-base-notes" class="detail-content"></p>
                </div>
              </div>
              <p id="result-ai-reason" class="ai-reason"></p>
            </div>
            <div class="result-actions">
              <a id="view-product-btn" href="#" class="view-product-btn">EXPLORE FRAGRANCE</a>
              <button id="restart-quiz-btn" class="restart-quiz-btn">TRY AGAIN</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  @font-face {
    font-family: "PPMori Regular";
    src: url("https://cdn.shopify.com/s/files/1/0698/9398/0343/files/PPMori-Regular.otf?v=1751621372") format("opentype");
    font-weight: 400;
    font-style: normal;
  }

  * {
    box-sizing: border-box;
  }

  .perfume-quiz-wrapper {
    width: 100%;
  }

  /* ... existing code ... */
  .hero-section {
    width: 100%;
    display: flex;
    flex-direction: column;
    min-height: 90vh;
    overflow: hidden;
  }

  .hero-content-wrapper {
    display: flex;
    flex-grow: 1;
  }

  .hero-image-container {
    flex: 1;
    position: relative;
    overflow: hidden;
    background-color: #fff;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-text-container {
    flex: 1;
    background-color: #f8f7f4;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 80px;
    box-sizing: border-box;
  }

  .fragrance-finder-text {
    font-family: "PPMori Regular", sans-serif;
    font-size: 14px;
    color: #333;
    margin-bottom: 10px;
  }

  .hero-heading {
    font-family: "PPMori Regular", sans-serif;
    font-size: 40px;
    line-height: 1.1;
    font-weight: 400;
    color: #000;
    margin-bottom: 40px;
    max-width: 400px;
  }

  .show-all-btn {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 16px 94px;
    background: #f4ff41;
    color: #000;
    text-decoration: none;
    font-weight: 500;
    font-size: 14px;
    border-radius: 999px;
    transition: background 0.3s ease;
    font-family: "PPMori Regular", sans-serif;
    text-transform: uppercase;
    width: 359px;
    height: 67px;
    margin-top: 97px;
    box-sizing: border-box;
    border: none;
    cursor: pointer;
  }

  .show-all-btn:hover {
    background: #e0f030;
  }

  .hero-bottom-nav {
    background-color: #000;
    color: #fff;
    display: flex;
    justify-content: space-around;
    align-items: center;
    padding: 20px 0;
    font-family: "PPMori Regular", sans-serif;
    font-size: 14px;
    text-transform: uppercase;
    flex-shrink: 0;
  }

  .nav-item {
    color: #fff;
    text-decoration: none;
    padding: 0 15px;
    white-space: nowrap;
  }

  .nav-item:hover {
    text-decoration: underline;
  }

  /* <CHANGE> REDESIGNED Quiz Modal Styles - Premium Card-Based UI */
  .quiz-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    font-family: "PPMori Regular", sans-serif;
  }

  .quiz-modal.hidden {
    display: none;
  }

  .quiz-modal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(4px);
  }

  .quiz-modal-content {
    position: relative;
    background: #ffffff;
    border-radius: 24px;
    width: 90%;
    max-width: 700px;
    max-height: 85vh;
    overflow-y: auto;
    padding: 50px 45px;
    z-index: 10000;
    box-shadow: 0 25px 80px rgba(0, 0, 0, 0.25);
    animation: slideUp 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes slideUp {
    from {
      transform: translateY(40px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .close-btn {
    position: absolute;
    top: 20px;
    right: 20px;
    background: none;
    border: none;
    font-size: 32px;
    cursor: pointer;
    color: #999;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s ease;
  }

  .close-btn:hover {
    color: #000;
  }

  .quiz-step {
    animation: fadeIn 0.3s ease;
  }

  .quiz-step.hidden {
    display: none;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* <CHANGE> Premium progress bar styling */
  .quiz-progress {
    width: 100%;
    height: 3px;
    background: #e8e8e8;
    border-radius: 2px;
    margin-bottom: 40px;
    overflow: hidden;
  }

  .progress-bar {
    height: 100%;
    background: linear-gradient(90deg, #000 0%, #333 100%);
    transition: width 0.4s ease;
  }

  /* <CHANGE> Quiz step content layout */
  .quiz-step-content {
    display: flex;
    flex-direction: column;
    gap: 35px;
  }

  .quiz-step-header {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .quiz-step-number {
    font-size: 12px;
    font-weight: 600;
    color: #999;
    text-transform: uppercase;
    letter-spacing: 0.8px;
  }

  .quiz-title-main {
    font-size: 28px;
    font-weight: 500;
    color: #000;
    line-height: 1.3;
    margin: 0;
  }

  .quiz-subtitle {
    font-size: 15px;
    color: #888;
    line-height: 1.5;
    margin: 0;
  }

  /* <CHANGE> Card-based grid layout for options */
  .quiz-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 16px;
  }

  .quiz-card {
    padding: 0;
    border: 2px solid #e0e0e0;
    background: #ffffff;
    border-radius: 16px;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    min-height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  .card-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 20px;
    text-align: center;
  }

  .card-content {
    font-size: 16px;
    font-weight: 500;
    color: #333;
    transition: color 0.3s ease;
  }

  .quiz-card:hover {
    border-color: #ccc;
    background: #f5f5f5;
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
  }

  .quiz-card.selected {
    background: #000;
    border-color: #000;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15);
  }

  .quiz-card.selected .card-content {
    color: #fff;
  }

  /* <CHANGE> Name input field styling */
  .quiz-input-group {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .quiz-name-input {
    padding: 14px 18px;
    border: 2px solid #e0e0e0;
    border-radius: 12px;
    font-family: "PPMori Regular", sans-serif;
    font-size: 16px;
    color: #000;
    background: #ffffff;
    transition: all 0.3s ease;
  }

  .quiz-name-input:focus {
    outline: none;
    border-color: #000;
    background: #fafafa;
  }

  .quiz-name-input::placeholder {
    color: #999;
  }

  /* Navigation buttons */
  .quiz-nav {
    display: flex;
    justify-content: flex-start;
  }

  .quiz-back-btn {
    font-size: 13px;
    font-weight: 600;
    color: #666;
    background: none;
    border: none;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: color 0.2s ease;
    padding: 0;
  }

  .quiz-back-btn:hover {
    color: #000;
  }

  /* <CHANGE> Action buttons - continue/next styling */
  .quiz-next-btn {
    padding: 14px 32px;
    background: #000;
    color: #fff;
    border: none;
    border-radius: 12px;
    font-family: "PPMori Regular", sans-serif;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.3s ease;
    width: 100%;
  }

  .quiz-next-btn:hover {
    background: #333;
  }

  .quiz-next-btn:active {
    transform: scale(0.98);
  }

  /* Loading State */
  .loading-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 60px 20px;
    gap: 20px;
  }

  .spinner {
    width: 48px;
    height: 48px;
    border: 3px solid #e8e8e8;
    border-top: 3px solid #000;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  .loading-text {
    font-size: 16px;
    color: #666;
    font-weight: 400;
  }

  /* <CHANGE> Premium results display with user name */
  .results-container {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .results-header {
    text-align: center;
  }

  .results-title {
    font-size: 18px;
    font-weight: 500;
    color: #999;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0 0 8px 0;
  }

  .results-name {
    font-size: 32px;
    font-weight: 600;
    color: #000;
    margin: 0;
  }

  .result-card {
    background: #f9f9f9;
    border: 1px solid #e5e5e5;
    border-radius: 16px;
    padding: 32px;
    margin: 0;
  }

  .perfume-name {
    font-size: 26px;
    font-weight: 600;
    color: #000;
    margin: 0 0 8px 0;
  }

  .inspired-by {
    font-size: 13px;
    color: #999;
    margin: 0 0 24px 0;
    font-style: italic;
  }

  .result-details {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin: 24px 0;
    padding: 24px 0;
    border-top: 1px solid #e5e5e5;
    border-bottom: 1px solid #e5e5e5;
  }

  .detail-section {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .detail-label {
    font-size: 11px;
    font-weight: 700;
    color: #999;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .detail-content {
    font-size: 14px;
    color: #444;
    line-height: 1.5;
    margin: 0;
  }

  .ai-reason {
    font-size: 14px;
    color: #666;
    line-height: 1.6;
    margin: 0;
    font-weight: 400;
  }

  /* Result Actions */
  .result-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .view-product-btn {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 15px 24px;
    background: #000;
    border: none;
    border-radius: 12px;
    font-family: "PPMori Regular", sans-serif;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    color: #fff;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 0.8px;
  }

  .view-product-btn:hover {
    background: #333;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
  }

  .restart-quiz-btn {
    padding: 15px 24px;
    border: 2px solid #e0e0e0;
    background: #ffffff;
    border-radius: 12px;
    font-family: "PPMori Regular", sans-serif;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    text-align: center;
    color: #333;
    text-transform: uppercase;
    letter-spacing: 0.8px;
  }

  .restart-quiz-btn:hover {
    border-color: #000;
    background: #f5f5f5;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .hero-section {
      min-height: auto;
    }

    .hero-content-wrapper {
      flex-direction: column;
    }

    .hero-image-container {
      height: 60vh;
      min-height: 400px;
    }

    .hero-text-container {
      padding: 40px 20px;
      text-align: center;
      align-items: center;
    }

    .hero-heading {
      font-size: 32px;
      max-width: 100%;
      margin-bottom: 30px;
    }

    .show-all-btn {
      width: 100%;
      max-width: 300px;
      margin-top: 40px;
    }

    .hero-bottom-nav {
      flex-wrap: wrap;
      justify-content: center;
      padding: 15px 10px;
      gap: 10px;
    }

    .nav-item {
      padding: 5px 10px;
    }

    .quiz-modal-content {
      width: 95%;
      padding: 35px 20px;
      border-radius: 20px;
    }

    .quiz-title-main {
      font-size: 22px;
    }

    .quiz-subtitle {
      font-size: 14px;
    }

    .quiz-cards-grid {
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .result-details {
