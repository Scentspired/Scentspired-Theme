<link rel="stylesheet" href="{{ 'header--list-menu.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'search--form.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'header--menu-drawer.css' | asset_url }}" media="print" onload="this.media='all'">
{%- if section.settings.menu_type_desktop == "mega" -%}
  <link rel="stylesheet" href="{{ 'header--mega-menu.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}

{%- comment -%} The only header rules that depend on section settings. They stay inline;
  everything static is in assets/header--main.css, linked below in the same cascade position. {%- endcomment -%}
<style>
    {%- if section.settings.sticky_header_type == 'reduce-logo-size' -%}
      .scrolled-past-header .header__heading-logo-wrapper {
        width: 75%;
      }
    {%- endif -%}

    {%- if section.settings.menu_type_desktop != "drawer" -%}
      @media screen and (min-width: 1025) {
        header-drawer {
          display: none;
        }
      }
    {%- endif -%}
</style>
{{ 'header--main.css' | asset_url | stylesheet_tag }}

{%- style -%}
    .header {
      padding: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px 3rem {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px 3rem;
    }

    .section-header {
      position: sticky;
      margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 1025px) {
      .section-header {
        margin-bottom: {{ section.settings.margin_bottom }}px;
      }
    }

    @media screen and (min-width: 1025px) {
      .header {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
    .col-button {
    position: absolute;
    top: 80%;
    left: 50% !important;
    transform: translate(-50%, -50%);

    background: #f4ff41;
    color: black;
    border: none;
      padding: 4px 26px;
    font-weight: 200;
    font-size: 13px;
    border-radius: 40px;
    z-index: 2;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    font-family: var(--font-body);
    white-space: nowrap; /* prevents line break */
  }
{%- endstyle -%}

{%- liquid
  for block in section.blocks
    if block.type == "@app"
      assign has_app_block = true
    endif
  endfor
-%}

{% liquid
  assign header_tag = "div"
  if section.settings.sticky_header_type != "none"
    assign header_tag = "sticky-header"
  endif
%}

<{{ header_tag }}
  {% if header_tag == "sticky-header" %}
    data-sticky-type="{{ section.settings.sticky_header_type }}"
  {% endif %}
  class="header-wrapper color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator %} header-wrapper--border-bottom{% endif %}">
  {%- liquid
    assign social_links = false
    assign localization_forms = false

    if settings.social_twitter_link != blank or settings.social_facebook_link != blank or settings.social_pinterest_link != blank or settings.social_instagram_link != blank or settings.social_youtube_link != blank or settings.social_vimeo_link != blank or settings.social_tiktok_link != blank or settings.social_tumblr_link != blank
      assign social_links = true
    endif

    if localization.available_countries.size > 1 and section.settings.enable_country_selector or section.settings.enable_language_selector and localization.available_languages.size > 1
      assign localization_forms = true
    endif
  -%}

  <header class="header header--{{ section.settings.logo_position }} header--mobile-{{ section.settings.mobile_logo_position }} page-width{% if section.settings.menu != blank %} header--has-menu{% endif %}{% if has_app_block %} header--has-app{% endif %}{% if social_links %} header--has-social{% endif %}{% if shop.customer_accounts_enabled %} header--has-account{% endif %}{% if localization_forms %} header--has-localizations{% endif %}">
    {%- liquid
      if section.settings.menu != blank
        render "header--drawer"
      endif

      if section.settings.logo_position == "top-center" or section.settings.menu == blank
        render "header--search", input_id: "Search-In-Modal-1"
      endif
    -%}

    {%- if section.settings.logo_position != "middle-center" -%}
      {%- comment -%}
        The logo is the site name, not the page's heading. It was an <h1> on the
        homepage, which gave that page two H1s and pushed the real heading down
        the outline. A div carries the same class, and .header__heading already
        sets margin and line-height, so nothing moves.
      {%- endcomment -%}
      {%- if request.page_type == "index" -%}
        <div class="header__heading">
      {%- endif -%}
      <a href="{{ routes.root_url }}" class="header__heading-link link link--text focus-inset">
        {%- if settings.logo != blank -%}
          <div class="header__heading-logo-wrapper">
            {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
            {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio -%}
            {% capture sizes %}(max-width: {{ settings.logo_width | times: 2 }}px) 50vw, {{ settings.logo_width }}px{% endcapture %}
            {% capture widths %}{{ settings.logo_width }}, {{ settings.logo_width | times: 1.5 | round }}, {{ settings.logo_width | times: 2 }}{% endcapture %}
            {{
              settings.logo
              | image_url: width: 600
              | image_tag:
                class: "header__heading-logo motion-reduce",
                widths: widths,
                height: logo_height,
                width: settings.logo_width,
                alt: logo_alt,
                sizes: sizes,
                preload: true
            }}
          </div>
        {%- else -%}
          <span class="h2">{{ shop.name }}</span>
        {%- endif -%}
      </a>
      {%- if request.page_type == "index" -%}
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- liquid
      if section.settings.menu != blank
        if section.settings.menu_type_desktop == "dropdown"
          # Custom Dossier-style dropdown menu - ONLY FOR FIRST MENU ITEM
          echo '<nav class="header__inline-menu">'
          echo '<ul class="list-menu list-menu--inline" role="list">'

          assign first_menu_item = true
          for link in linklists[section.settings.menu].links
            if link.links != blank and first_menu_item
              echo '<li class="header__menu-item header__menu-item--has-dropdown">'
              echo '<a href="' | append: link.url | append: '" class="header__menu-item-link list-menu__item list-menu__item--link">' | append: link.title | append: "</a>"

              # Custom Dossier dropdown - ONLY FOR FIRST MENU ITEM
              echo '<div class="dossier-dropdown">'
              echo '<div class="dossier-dropdown-content">'

              # Sections, links and images: regions/<id>/content/global.json (header.shop_dropdown)
              render 'header--shop-menu-sections', sections: 'global.header.shop_dropdown.sections', style: 'desktop'

              # Discover Section
              echo "</div>"
              echo "</li>"
              assign first_menu_item = false

            elsif forloop.index == 6
              # 6th menu item with dropdown arrow
              echo '<li class="header__menu-item header__menu-item--has-dropdown">'
              echo '<a href="' | append: link.url | append: '" class="header__menu-item-link list-menu__item list-menu__item--link">' | append: link.title | append: "</a>"
              echo '<div class="dossier-dropdown">'
              echo '<div class="dossier-dropdown-content">'

              # <-- Add your 6th menu dropdown content here -->
              echo '<div class="dropdown-section-title"></div>'
              echo '<div class="dropdown-section">'

              # Boxes: from regions/<id>/content/boxes.json (menu.shown_in)
              render 'header--box-menu-items', place: 'bundles_menu', style: 'desktop'

              echo "</div>"

              echo "</div>"
              echo "</div>"
              echo "</li>"

            else
              # Regular menu items without dropdown
              echo '<li class="header__menu-item">'
              echo '<a href="' | append: link.url | append: '" class="header__menu-item-link list-menu__item list-menu__item--link">' | append: link.title | append: "</a>"
              echo "</li>"
            endif
          endfor

          echo "</ul>"
          echo "</nav>"
        elsif section.settings.menu_type_desktop != "drawer"
          render "header--mega-menu"
        endif
      endif
    %}

    {%- if section.settings.logo_position == "middle-center" -%}
      {%- if request.page_type == "index" -%}
        <h2 class="header__heading">
      {%- endif -%}
      <a href="{{ routes.root_url }}" class="header__heading-link link link--text focus-inset">
        {%- if settings.logo != blank -%}
          <div class="header__heading-logo-wrapper">
            {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
            {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio -%}
            {% capture sizes %}(min-width: 750px) {{ settings.logo_width }}px, 50vw{% endcapture %}
            {% capture widths %}{{ settings.logo_width }}, {{ settings.logo_width | times: 1.5 | round }}, {{ settings.logo_width | times: 2 }}{% endcapture %}
            {{
              settings.logo
              | image_url: width: 600
              | image_tag:
                class: "header__heading-logo",
                widths: widths,
                height: logo_height,
                width: settings.logo_width,
                alt: logo_alt,
                sizes: sizes,
                preload: true
            }}
          </div>
        {%- else -%}
          <span class="h2">{{ shop.name }}</span>
        {%- endif -%}
      </a>
      {%- if request.page_type == "index" -%}
        </h2>
      {%- endif -%}
    {%- endif -%}

    <div class="header__icons{% if section.settings.enable_country_selector or section.settings.enable_language_selector %} header__icons--localization header-localization{% endif %}">
      <div class="desktop-localization-wrapper">
        {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
          <localization-form class="small-hide medium-hide" data-prevent-hide>
            {%- form "localization", id: "HeaderCountryForm", class: "localization-form" -%}
              <div>
                <h2 class="visually-hidden" id="HeaderCountryLabel">{{ "localization.country_label" | t }}</h2>
                {%- render "core--localization-country", localPosition: "HeaderCountry" -%}
              </div>
            {%- endform -%}
          </localization-form>
        {% endif %}

        {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
          <localization-form class="small-hide medium-hide" data-prevent-hide>
            {%- form "localization", id: "HeaderLanguageForm", class: "localization-form" -%}
              <div>
                <h2 class="visually-hidden" id="HeaderLanguageLabel">{{ "localization.language_label" | t }}</h2>
                {%- render "core--localization-language", localPosition: "HeaderLanguage" -%}
              </div>
            {%- endform -%}
          </localization-form>
        {%- endif -%}
      </div>

      {% render "header--search", input_id: "Search-In-Modal" %}

      <a href="{{ routes.cart_url }}" class="header__icon header__icon--cart link focus-inset" id="cart-icon-bubble">
        {% if cart == empty %}
          <span class="svg-wrapper">{{ "ui--icon-cart-empty.svg" | inline_asset_content }}</span>
        {% else %}
          <span class="svg-wrapper">{{ "ui--icon-cart.svg" | inline_asset_content }}</span>
        {% endif %}
        <span class="visually-hidden">{{ "templates.cart.cart" | t }}</span>
        {%- if cart != empty -%}
          <div class="cart-count-bubble">
            {%- if cart.item_count < 100 -%}
              <span aria-hidden="true">{{ cart.item_count }}</span>
            {%- endif -%}
            <span class="visually-hidden">{{ "sections.header.cart_count" | t: count: cart.item_count }}</span>
          </div>
        {%- endif -%}
      </a>

      {%- if shop.customer_accounts_enabled -%}
        <a
          href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
          class="header__icon header__icon--account link focus-inset{% if section.settings.menu != blank %} small-hide{% endif %}"
          rel="nofollow">
          {%- if section.settings.enable_customer_avatar -%}
            <account-icon>
              {%- if customer and customer.has_avatar? -%}
                {{ customer | avatar }}
              {%- else -%}
                <span class="svg-wrapper">{{ "ui--icon-account.svg" | inline_asset_content }}</span>
              {%- endif -%}
            </account-icon>
          {%- else -%}
            <span class="svg-wrapper">{{ "ui--icon-account.svg" | inline_asset_content }}</span>
          {%- endif -%}
          <span class="visually-hidden">
            {%- liquid
              if customer
                echo "customer.account_fallback" | t
              else
                echo "customer.log_in" | t
              endif
            -%}
          </span>
        </a>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when "@app" -%}
            {% render block %}
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <!-- Mobile Bottom Navigation - EXACT MATCH TO REFERENCE -->
    <div class="mobile-bottom-nav">
      <div class="mobile-nav-item">
        <div class="mobile-nav-ic" id="mobileMenuTrigger">
          <img
            src="{{ 'ui--icon-nav-menu.png' | asset_url }}"
            alt="{{ 'sections.header.menu' | t }}"
            class="nav-ic-img">
        </div>
      </div>
      <div class="mobile-nav-separator"></div>
      <div class="mobile-nav-item">
        <div class="mobile-nav-icon" id="mobileAccountTrigger">
          <img
            src="{{ 'ui--icon-nav-account.svg' | asset_url }}"
            alt="{{ 'customer.account_fallback' | t }}"
            class="nav-icon-img">
        </div>
      </div>
      <div class="mobile-nav-separator"></div>
      <div class="mobile-nav-item">
        <div class="mobile-nav-icon" id="mobileSearchTrigger">
          <img
            src="{{ 'ui--icon-nav-search.png' | asset_url }}"
            alt="{{ 'general.search.search' | t }}"
            class="nav-icon-img">
        </div>
      </div>
      <div class="mobile-nav-separator"></div>
      <a href="{{ routes.cart_url }}" class="header__icon header__icon--cart link focus-inset" id="cart-icon-bubble">
        {% if cart == empty %}
          <span class="svg-wrapper">{{ "ui--icon-cart-empty.svg" | inline_asset_content }}</span>
        {% else %}
          <span class="svg-wrapper">{{ "ui--icon-cart.svg" | inline_asset_content }}</span>
        {% endif %}
        <span class="visually-hidden">{{ "templates.cart.cart" | t }}</span>
        {%- if cart != empty -%}
          <div class="cart-count-bubble">
            {%- if cart.item_count < 100 -%}
              <span aria-hidden="true">{{ cart.item_count }}</span>
            {%- endif -%}
            <span class="visually-hidden">{{ "sections.header.cart_count" | t: count: cart.item_count }}</span>
          </div>
        {%- endif -%}
      </a>
    </div>

    <!-- Mobile Menu Drawer: items from regions/<id>/content/global.json (header.mobile_menu) -->
    <div class="mobile-menu-drawer" id="mobileMenuDrawer">
      <div class="mobile-menu-header">
        <div class="menu-drawer-title ui-label" style="margin: 0; font-family: var(--font-body);">{{ 'sections.header.menu' | t }}</div>
        <button class="mobile-menu-close" id="mobileMenuClose">
          <svg viewBox="0 0 24 24" stroke-width="2" fill="none" stroke="currentColor">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <div class="mobile-menu-content">
        <!-- SHOP - WITH DROPDOWN -->
        <div class="mobile-menu-item-wrapper">
          <div class="mobile-menu-item-header">
            <a href="{% render 'region--content', key: 'global.header.mobile_menu.shop.url' %}" class="mobile-menu-item">{% render 'region--content', key: 'global.header.mobile_menu.shop.label' %}</a>
            <button class="mobile-menu-toggle" onclick="toggleMobileSubmenu(this)">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round">
                <polyline points="6,9 12,15 18,9"></polyline>
              </svg>
            </button>
          </div>
          <div class="mobile-submenu">
            {%- render 'header--shop-menu-sections', sections: 'global.header.mobile_menu.shop.sections', style: 'mobile' -%}
          </div>
        </div>

        {%- capture menu_link_keys -%}{%- render 'region--content', key: 'global.header.mobile_menu.links.__keys' -%}{%- endcapture -%}
        {%- assign menu_link_keys = menu_link_keys | strip | split: ',' -%}
        {%- for i in menu_link_keys -%}
          {%- liquid
            assign k = 'global.header.mobile_menu.links.' | append: i | append: '.url'
            capture menu_link_url
              render 'region--content', key: k
            endcapture
            assign k = 'global.header.mobile_menu.links.' | append: i | append: '.label'
            capture menu_link_label
              render 'region--content', key: k
            endcapture
          -%}
          <div class="mobile-menu-item-wrapper">
            <div class="mobile-menu-item-header">
              <a href="{{ menu_link_url | strip | escape }}" class="mobile-menu-item">{{ menu_link_label | strip | escape }}</a>
            </div>
          </div>
        {% endfor %}

        {%- comment -%} Boxes: from regions/<id>/content/boxes.json (menu.shown_in) {%- endcomment -%}
        {%- render 'header--box-menu-items', place: 'mobile_menu_own_link', style: 'mobile_top_level' -%}

        <div class="mobile-menu-item-wrapper">
          <div class="mobile-menu-item-header">
            <a href="#" class="mobile-menu-item">{% render 'region--content', key: 'global.header.mobile_menu.bundles.label' %}</a>
            <button class="mobile-menu-toggle" onclick="toggleMobileSubmenu(this)">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round">
                <polyline points="6,9 12,15 18,9"></polyline>
              </svg>
            </button>
          </div>
          <div class="mobile-submenu">
            <!-- Shop All Section -->
            <div class="mobile-submenu-section">
              {%- comment -%} Boxes: from regions/<id>/content/boxes.json (menu.shown_in) {%- endcomment -%}
              {%- render 'header--box-menu-items', place: 'bundles_menu', style: 'mobile' -%}
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Move the closing dynamic header tag to after all header content -->
</{{ header_tag }}>

<!-- Custom Search Overlay -->
<div id="customSearchOverlay" class="custom-search-overlay">
  <div class="custom-search-container">
    <!-- Search Header - Fixed at top -->
    <div class="custom-search-header">
      <div class="custom-search-input-wrapper">
        <svg class="custom-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
        <input
          type="text"
          id="customSearchInput"
          placeholder="{{ 'sections.header.search_placeholder' | t }}"
          class="custom-search-input">
        <button id="customCloseBtn" class="custom-close-btn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>

    <!-- Scrollable Content Area -->
    <div class="custom-search-scrollable-content">
      <!-- Category Filter Pills -->
      <div id="customSearchFilters" class="custom-search-filters">
        <div class="custom-filter-pills" id="customFilterPills">
          <!-- Pills will be dynamically generated here -->
        </div>
      </div>

      <!-- Search Results Section -->
      <div id="customSearchResults" class="custom-search-results">
        <div class="custom-search-results-header">
          <div class="custom-search-results-count" id="searchResultsCount">
            {{ 'sections.header.search_all_results_html' | t | replace: '[term]', '<span id="searchTerm"></span>' | replace: '[count]', '0' }}
          </div>
        </div>
        <div class="custom-search-results-grid" id="searchResultsGrid"></div>
      </div>

      <!-- Loading State -->
      <div id="customSearchLoading" class="custom-search-loading">
        <p>{{ 'sections.header.searching' | t }}</p>
      </div>

      <!-- No Results State -->
      <div id="customSearchNoResults" class="custom-search-no-results">
        <p>{{ 'sections.header.search_no_results' | t }}</p>
      </div>

      <!-- Main Content -->
      <div class="custom-search-content" id="customSearchMainContent">
        <!-- Left Side -->
        <div class="custom-search-left">
          <!-- Recent Searches -->
          <div class="custom-search-section">
            <div class="custom-section-header">
              <div class="custom-section-title">
                <svg class="custom-section-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12,6 12,12 16,14"></polyline>
                </svg>
                <div class="search-recent-title ui-label">{{ 'sections.header.recent_searches' | t }}</div>
              </div>
            </div>
            <div class="custom-pill-container" id="customRecentSearches">
              {%- capture suggested_keys -%}{%- render 'region--content', key: 'global.header.search.suggested_searches.__keys' -%}{%- endcapture -%}
              {%- assign suggested_keys = suggested_keys | strip | split: ',' -%}
              {%- for i in suggested_keys -%}
                {%- assign k = 'global.header.search.suggested_searches.' | append: i %}
              <button class="custom-pill" onclick="customSearchOverlay.handlePillClick('{% render 'region--content', key: k, js: true %}')">{% render 'region--content', key: k %}</button>
              {%- endfor %}
            </div>
          </div>

          <!-- Gender -->
          <div class="custom-search-section">
            <div class="custom-section-header">
              <div class="custom-section-title">
                <svg class="custom-section-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>

                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
                <h3>{{ 'sections.header.search_genders' | t }}</h3>
              </div>
              <div class="custom-nav-arrows" style="display:none !important;">
                <button class="custom-nav-arrow" id="customGenderPrev">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="15,18 9,12 15,6"></polyline>
                  </svg>
                </button>
                <button class="custom-nav-arrow" id="customGenderNext">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="9,18 15,12 9,6"></polyline>
                  </svg>
                </button>
              </div>
            </div>
            <div class="custom-pill-container" id="customGender"></div>
          </div>

          <!-- Trending Search -->
          <div class="custom-search-section">
            <div class="custom-section-header">
              <div class="custom-section-title">
                <svg class="custom-section-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="23,6 13.5,15.5 8.5,10.5 1,18"></polyline>
                  <polyline points="17,6 23,6 23,12"></polyline>
                </svg>
                <h3>{{ 'sections.header.search_scent_families' | t }}</h3>
              </div>
              <div class="custom-nav-arrows" style="display:none !important;">
                <button class="custom-nav-arrow" id="customTrendingPrev">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="15,18 9,12 15,6"></polyline>
                  </svg>
                </button>
                <button class="custom-nav-arrow" id="customTrendingNext">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="9,18 15,12 9,6"></polyline>
                  </svg>
                </button>
              </div>
            </div>
            <div class="custom-pill-container" id="customTrendingSearches"></div>
          </div>

          <!-- Scent Notes -->
          <div class="custom-search-section">
            <div class="custom-section-header">
              <div class="custom-section-title">
                <svg class="custom-section-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
                <h3>{{ 'sections.header.search_scent_notes' | t }}</h3>
              </div>
              <div class="custom-nav-arrows">
                <button class="custom-nav-arrow" id="customScentNotesPrev">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="15,18 9,12 15,6"></polyline>
                  </svg>
                </button>
                <button class="custom-nav-arrow" id="customScentNotesNext">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="9,18 15,12 9,6"></polyline>
                  </svg>
                </button>
              </div>
            </div>
            <div class="custom-pill-container" id="customScentNotes"></div>
          </div>
        </div>

        <!-- Right Side -->
        <div class="custom-search-right">
          <!-- Featured Products -->
          <div class="custom-products-section">
            <div class="custom-section-header">
              <div class="custom-section-title">
                <svg class="custom-section-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"></polygon>
                </svg>
                <h3>{{ 'sections.header.popular_products' | t }}</h3>
              </div>
              <div class="custom-nav-arrows">
                <button class="custom-nav-arrow" id="customProductsPrev">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="15,18 9,12 15,6"></polyline>
                  </svg>
                </button>
                <button class="custom-nav-arrow" id="customProductsNext">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="9,18 15,12 9,6"></polyline>
                  </svg>
                </button>
              </div>
            </div>
            <div class="custom-products-grid" id="customProductsGrid"></div>
          </div>
        </div>
      </div>

      <!-- Collections Section - Full Width -->
      <div class="custom-collections-section" id="customCollectionsSection">
        <h3>{{ 'sections.header.season_collections' | t }}</h3>
        <div class="custom-collections-grid" id="customCollectionsGrid"></div>
      </div>
    </div>
  </div>
</div>

{%- comment -%}
  The search overlay's lists (regions/<id>/content/global.json, header.search)
  and interface wording (locale, sections.header), for the script below.
{%- endcomment -%}
<script type="application/json" id="headerSearchData">
  {%- render 'region--content', key: 'global.header.search.__json' -%}
</script>
<script type="application/json" id="headerStrings">
  {
    "allResults": {{ 'sections.header.search_all_results_html' | t | json }},
    "filterAll": {{ 'sections.header.search_filter_all' | t | json }},
    "addToCart": {{ 'sections.header.add_to_cart' | t | json }},
    "adding": {{ 'sections.header.adding_to_cart' | t | json }},
    "added": {{ 'sections.header.added_to_cart' | t | json }}
  }
</script>

<script src="{{ 'header--main.js' | asset_url }}" defer="defer"></script>

{%- if request.page_type == "index" -%}
  {% assign potential_action_target = request.origin | append: routes.search_url | append: "?q={search_term_string}" %}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ request.origin | append: page.url | json }}
    }
  </script>
{%- endif -%}

