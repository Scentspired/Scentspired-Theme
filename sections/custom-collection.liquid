{% comment %}
Custom Collection Browse Section
{% endcomment %}

<style>
  @font-face {
    font-family: 'PPEditorialNew Italic';
    src: url('https://cdn.shopify.com/s/files/1/0698/9398/0343/files/PPEditorialNew-Italic-BF644b214fb0c0a.otf?v=1751620955') format('opentype');
    font-weight: 900;
    font-style: italic;
  }

  @font-face {
    font-family: 'PPMori Regular';
    src: url('https://cdn.shopify.com/s/files/1/0698/9398/0343/files/PPMori-Regular.otf?v=1751621372') format('opentype');
    font-weight: 400;
    font-style: normal;
  }

  .collection-browse-section {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    position: relative;
  }

  .section-heading {
    font-family: 'PPEditorialNew Italic', serif;
    font-weight: 900;
    font-style: italic;
    font-size: 37px !important;
    color: #333;
    text-align: left;
    padding: 40px 40px 20px;
    margin: 0;
    background: #fff;
    text-decoration: underline;
    text-decoration-color: #FADB95;
    text-decoration-thickness: 2px;
    text-underline-offset: 2px;
  }

  .collections-container {
    display: flex;
    width: 100%;
    height: 600px;
    position: relative;
  }

  .collection-item {
    flex: 1;
    position: relative;
    overflow: hidden;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .collection-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  /* Ensure all collection overlays have consistent positioning */
  .collection-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.3);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    padding: 40px;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  /* Apply hover effect to ALL collection items */
  .collection-item:hover .collection-overlay {
    opacity: 1;
  }

  .collection-item:hover .collection-image {
    transform: scale(1.05);
  }

  .collection-title {
    font-family: 'PPEditorialNew Italic', serif;
    font-weight: 900;
    font-style: italic;
    font-size: 32px;
    color: white;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin: 0;
    line-height: 1.1;
  }

  .collection-content {
    display: flex;
    flex-direction: column;
    gap: 25px;
    width: 100%;
  }

  .collection-description {
    font-family: 'PPMori Regular', sans-serif;
    font-weight: 500;
    font-size: 16px;
    color: #000;
    line-height: 1.5;
    margin: 0;
  }

  .collection-button {
  background: #EFFC00;
  color: #000;
  border: none;
  padding: 18px 40px;
  font-family: 'PPMori Regular', sans-serif;
  font-weight: 400;
  font-size: 14px;
  text-transform: uppercase;
  letter-spacing: 1px;
  cursor: pointer;
  transition: background 0.3s ease;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  border-radius: 0;
  min-width: 160px;
  height: 40px; /* Set to desired height */
}


  /* Hide mobile content on desktop/laptop */
  .mobile-slider,
  .mobile-content {
    display: none;
  }

  /* Laptop specific adjustments - maintain exact same structure as desktop */
  @media (min-width: 769px) and (max-width: 1024px) {
    .section-heading {
      font-size: 22px;
      padding: 35px 35px 18px;
    }

    .collection-overlay {
      padding: 35px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      align-items: flex-start;
    }

    .collection-title {
      font-size: 28px;
      line-height: 1.1;
    }

    .collection-description {
      font-size: 15px;
    }

    .collection-content {
      display: flex;
      flex-direction: column;
      gap: 20px;
      width: 100%;
      top: 230px !important;
    }

    .collection-button {
      padding: 16px 35px;
      font-size: 13px;
      min-width: 140px;
    }
    .mobile-content .collection-button {
      display: none;
    }
  }
  @media screen and (min-width: 1024px) and (max-width: 1440px) {
  .collection-description {
    font-size: 15px;
    margin-top: 440px;
    width: 380px;
  }
  .collection-button {
    padding: 16px 35px;
    font-size: 13px;
    min-width: 140px;
    top: 510px;
    width: 280px;
    left: -40px;
  }
  .mobile-content .collection-button {
      display: none;
    }
    .mobile-content .collection-description {
    display: none;
}
}

  /* Large desktop adjustments - maintain exact same structure */
  @media (min-width: 1299px) {
    .section-heading {
      font-size: 26px;
      padding: 45px 45px 22px;
    }
    .collection-browse-section{
    width: 99%;
}
       .collections-container {
    display: flex;
    width: 100%;
    height: 860px;
    position: relative;
  }
    .collection-overlay {
      padding: 45px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      align-items: flex-start;
    }

    .collection-title {
      font-size: 36px;
      line-height: 1.1;
    }

    .collection-description {
      font-size: 17px;
    }

    .collection-content {
      gap: 25px;
    }

    .collection-button {
      padding: 30px 45px;
      font-size: 15px;
      min-width: 180px;
    }
     .mobile-content .collection-button {
      display: none;
    }
  }

  /* Mobile Styles */
  @media (max-width: 768px) {
    .section-heading {
      font-size: 20px !important;
      padding: 30px 20px 15px;
      text-align: center;
    }

    .collections-container {
      display: none;
    }

    .mobile-slider {
      display: block;
      position: relative;
      overflow: hidden;
    }

    .mobile-slides {
      display: flex;
      transition: transform 0.3s ease;
      width: 300%;
    }

    .mobile-slider .collection-item {
      width: 33.333%;
      height: 400px;
      flex: none;
    }

    .collection-overlay {
      opacity: 0;
      pointer-events: none;
    }

    .mobile-content {
      display: block;
      padding: 30px 20px;
      background: #f5f5f5;
    }

    .mobile-content .collection-title {
      color: #333;
      font-size: 24px;
      margin-bottom: 15px;
    }

    .mobile-content .collection-description {
      color: #666;
      margin-bottom: 20px;
    }

    .mobile-content .collection-button {
      background: #EFFC00;
      color: #000;
      width: 100%;
      padding: 18px;
    }

    .slider-arrows {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      background: rgba(255, 255, 255, 0.9);
      border: none;
      width: 50px;
      height: 50px;
      border-radius: 50%;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      color: #333;
      z-index: 10;
      transition: background 0.3s ease;
    }

    .slider-arrows:hover {
      background: white;
    }

    .arrow-left {
      left: 20px;
    }

    .arrow-right {
      right: 20px;
    }
  }
</style>

<div class="collection-browse-section">
  {% if section.settings.section_heading != blank %}
    <h2 class="section-heading">{{ section.settings.section_heading }}</h2>
  {% endif %}

  <!-- Desktop/Laptop View -->
  <div class="collections-container">
    {% for block in section.blocks limit: 4 %}
      {% assign collection = collections[block.settings.collection] %}
      <div class="collection-item" {{ block.shopify_attributes }}>
        {% if block.settings.collection_image != blank %}
          <img src="{{ block.settings.collection_image | img_url: '1920x1080' }}" 
               alt="{{ collection.title | default: block.settings.collection_title }}"
               class="collection-image"
               loading="lazy">
        {% elsif collection.featured_image %}
          <img src="{{ collection.featured_image | img_url: '1920x1080' }}" 
               alt="{{ collection.title }}"
               class="collection-image"
               loading="lazy">
        {% else %}
          <div class="collection-image" style="background: {{ block.settings.background_color | default: '#f5f5f5' }};"></div>
        {% endif %}

        <div class="collection-overlay">
          <h3 class="collection-title">
            {{ block.settings.collection_title | default: collection.title | upcase }}
          </h3>
          
          <div class="collection-content">
            {% if block.settings.collection_description != blank %}
              <p class="collection-description">{{ block.settings.collection_description }}</p>
            {% elsif collection.description != blank %}
              <p class="collection-description">{{ collection.description | truncate: 150 }}</p>
            {% endif %}
            
            <a href="{{ collection.url | default: block.settings.collection_url | default: '#' }}" 
               class="collection-button">
              {{ block.settings.button_text | default: 'Shop Now' }}
            </a>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>

  <!-- Mobile Slider -->
  <div class="mobile-slider">
    <div class="mobile-slides" id="mobileSlides">
      {% for block in section.blocks limit: 4 %}
        {% assign collection = collections[block.settings.collection] %}
        <div class="collection-item">
          {% if block.settings.collection_image != blank %}
            <img src="{{ block.settings.collection_image | img_url: '1080x720' }}" 
                 alt="{{ collection.title | default: block.settings.collection_title }}"
                 class="collection-image"
                 loading="lazy">
          {% elsif collection.featured_image %}
            <img src="{{ collection.featured_image | img_url: '1080x720' }}" 
                 alt="{{ collection.title }}"
                 class="collection-image"
                 loading="lazy">
          {% else %}
            <div class="collection-image" style="background: {{ block.settings.background_color | default: '#f5f5f5' }};"></div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    <button class="slider-arrows arrow-left" onclick="previousSlide()">‹</button>
    <button class="slider-arrows arrow-right" onclick="nextSlide()">›</button>
  </div>

  <!-- Mobile Content (only visible on mobile) -->
  {% for block in section.blocks limit: 4 %}
    {% assign collection = collections[block.settings.collection] %}
    <div class="mobile-content" id="mobileContent{{ forloop.index0 }}" style="{% unless forloop.first %}display: none;{% endunless %}">
      <h3 class="collection-title">
        {{ block.settings.collection_title | default: collection.title | upcase }}
      </h3>
      
      {% if block.settings.collection_description != blank %}
        <p class="collection-description">{{ block.settings.collection_description }}</p>
      {% elsif collection.description != blank %}
        <p class="collection-description">{{ collection.description | truncate: 150 }}</p>
      {% endif %}
      
      <a href="{{ collection.url | default: block.settings.collection_url | default: '#' }}" 
         class="collection-button">
        {{ block.settings.button_text | default: 'Shop Now' }}
      </a>
    </div>
  {% endfor %}
</div>

<script>
  let currentSlide = 0;
  const totalSlides = {{ section.blocks.size }};

  function updateSlide() {
    const slides = document.getElementById('mobileSlides');
    if (slides) {
      const translateX = -currentSlide * (100 / totalSlides);
      slides.style.transform = `translateX(${translateX}%)`;

      // Update content
      for (let i = 0; i < totalSlides; i++) {
        const content = document.getElementById(`mobileContent${i}`);
        if (content) {
          content.style.display = i === currentSlide ? 'block' : 'none';
        }
      }
    }
  }

  function nextSlide() {
    currentSlide = (currentSlide + 1) % totalSlides;
    updateSlide();
  }

  function previousSlide() {
    currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
    updateSlide();
  }

  // Touch/swipe support for mobile
  let startX = 0;
  let endX = 0;

  const mobileSlider = document.querySelector('.mobile-slider');
  if (mobileSlider) {
    mobileSlider.addEventListener('touchstart', function(e) {
      startX = e.touches[0].clientX;
    });

    mobileSlider.addEventListener('touchend', function(e) {
      endX = e.changedTouches[0].clientX;
      handleSwipe();
    });
  }

  function handleSwipe() {
    const threshold = 50;
    const diff = startX - endX;

    if (Math.abs(diff) > threshold) {
      if (diff > 0) {
        nextSlide();
      } else {
        previousSlide();
      }
    }
  }

  // Initialize on page load
  document.addEventListener('DOMContentLoaded', function() {
    updateSlide();
  });
</script>

{% schema %}
{
  "name": "Custom Collection Browse",
  "settings": [
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section Heading",
      "default": "Browse by Product Type"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "collection_title",
          "label": "Custom Collection Title",
          "info": "Leave blank to use collection title"
        },
        {
          "type": "textarea",
          "id": "collection_description",
          "label": "Custom Description",
          "info": "Leave blank to use collection description"
        },
        {
          "type": "image_picker",
          "id": "collection_image",
          "label": "Custom Collection Image",
          "info": "Leave blank to use collection featured image"
        },
        {
          "type": "url",
          "id": "collection_url",
          "label": "Custom URL",
          "info": "Leave blank to use collection URL"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Shop Now"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Background Color",
          "default": "#f5f5f5",
          "info": "Used when no image is selected"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Collection Browse",
      "blocks": [
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        }
      ]
    }
  ]
}
{% endschema %}