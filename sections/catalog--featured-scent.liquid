{{ 'catalog--featured-scent.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  The heading level is composition, not code: this section is the page's main
  heading on the homepage and a secondary one on collection and product pages.
  Which it is belongs in the template data, so the same component can be placed
  anywhere without a page-type conditional here. Defaults to h2.
{%- endcomment -%}
{%- assign fragrance_heading_level = section.settings.heading_level | default: 'h2' -%}

<div class="fragrance-container">
  <{{ fragrance_heading_level }} class="fragrance-heading">{{ section.settings.heading }}</{{ fragrance_heading_level }}>
  <div class="fragrance-subtitle">{{ section.settings.subheading }}</div>

  <div class="fragrance-carousel-wrapper">
    <div class="fragrance-layout" id="fragrance-carousel">
      {% assign products = collections[section.settings.collection].products %}
      {% for product in products limit: 4 %}
        {% render 'card--product-carousel', product: product %}
      {% endfor %}
    </div>
      <div class="fragrance-dots mobile-only">
    {% for product in products limit: 4 %}
      <span class="fragrance-dot {% if forloop.first %}active{% endif %}"></span>
    {% endfor %}
  </div>
  </div>

  {% if section.settings.view_all_link != blank %}
    <div style="text-align: center;">
      <a href="{{ section.settings.view_all_link }}" class="show-all-btn">
        {{ 'sections.product_list.view_all' | t }}
      </a>
    </div>
  {% endif %}
</div>

{% # theme-check-disable ParserBlockingScript %}
<script src="{{ 'catalog--featured-scent.js' | asset_url }}"></script>
{% # theme-check-enable ParserBlockingScript %}

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Collection"
    },
    {
      "type": "select",
      "id": "heading_level",
      "label": "Heading level",
      "info": "Use H1 only where this section carries the page's main heading. A page must have exactly one H1.",
      "options": [
        { "value": "h1", "label": "H1 — the page's main heading" },
        { "value": "h2", "label": "H2 — a section heading" },
        { "value": "h3", "label": "H3 — a sub-section heading" }
      ],
      "default": "h2"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Premium Scents"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Button Link"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
