{% schema %}
{
  "name": "Product Info Tabs",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "about_image",
      "label": "About Section Image"
    },
    {
      "type": "image_picker",
      "id": "ingredients_image",
      "label": "Ingredients Section Image"
    },
    {
      "type": "image_picker",
      "id": "usage_image",
      "label": "Usage Section Image"
    },
    {
      "type": "image_picker",
      "id": "faq_image",
      "label": "FAQ Section Image"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer"
        }
      ]
    },
    {
      "type": "icon",
      "name": "Icon",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Info Tabs",
      "blocks": []
    }
  ]
}
{% endschema %}
{%- comment -%}
  The product's About, Ingredients, Notes and FAQ tabs. Each tab's copy and
  image is the product's (custom.* metafields), else the section's setting;
  a product with neither shows none. The demo copy that stood in (skin-care
  text, a sample FAQ, images from another store) showed only on the size
  products (-5ml, -50ml, -100ml) that layout/theme.liquid redirects to their
  main product, and to search engines reading those pages.
  Interface wording is the locale's, sections.product_info_tab.
{%- endcomment -%}
{%- assign icon_blocks = section.blocks | where: 'type', 'icon' -%}

{{ 'catalog--product-info-tab.css' | asset_url | stylesheet_tag }}

<div class="product-tabs-wrapper">
  <div class="tab-nav">
    <button class="active" data-tab="about">{{ 'sections.product_info_tab.about' | t }}</button>
    <button data-tab="ingredients">{{ 'sections.product_info_tab.ingredients' | t }}</button>
    <button data-tab="usage">{{ 'sections.product_info_tab.notes' | t }}</button>
    <button data-tab="faq">{{ 'sections.product_info_tab.faqs' | t }}</button>
  </div>

  <div class="tab-panel active" id="about">
    <div class="image-side">
      {%- comment -%}
        Use metafield for about image with fallback to section settings
      {%- endcomment -%}
      {% if product.metafields.custom.about_image %}
        <img src="{{ product.metafields.custom.about_image | image_url }}" alt="{{ 'sections.product_info_tab.about_image_alt' | t }}" width="600" height="600" loading="lazy">
      {% elsif section.settings.about_image %}
        <img src="{{ section.settings.about_image | image_url }}" alt="{{ 'sections.product_info_tab.about_image_alt' | t }}" width="600" height="600" loading="lazy">
      {% endif %}
    </div>
    <div class="content-side">
      <h4>{{ 'sections.product_info_tab.about_heading' | t }}</h4>

      {% assign about_mf = product.metafields.custom.about %}
      {% if about_mf != blank %}
        {% capture about_html %}{{ about_mf | metafield_tag }}{% endcapture %}
        {% assign paragraphs = about_html | split: "</p>" %}

        {% assign about_p1 = "" %}
        {% assign about_p2 = "" %}
        {% assign about_p3 = "" %}

        {% if paragraphs.size > 0 and paragraphs[0] != blank %}
          {% assign about_p1 = paragraphs[0] | append: "</p>" %}
        {% endif %}
        {% if paragraphs.size > 1 and paragraphs[1] != blank %}
          {% assign about_p2 = paragraphs[1] | append: "</p>" %}
        {% endif %}
        {% if paragraphs.size > 2 and paragraphs[2] != blank %}
          {% assign about_p3 = paragraphs[2] | append: "</p>" %}
        {% endif %}

        {% if about_p1 != "" %}
          {{ about_p1 }}
        {% endif %}

        {% if about_p2 != "" or about_p3 != "" %}
          <div class="two-column-section">
            {% if about_p2 != "" %}
              <div class="column">
                {{ about_p2 }}
              </div>
            {% endif %}
            {% if about_p3 != "" %}
              <div class="column">
                {{ about_p3 }}
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endif %}

      {%- comment -%}
        Use metafield for icon images with fallback to section settings
      {%- endcomment -%}
      <div class="icon-row">
        {%- for block in icon_blocks -%}
          {%- liquid
            assign position = forloop.index
            assign icon_image_field = 'icon_' | append: position | append: '_image'
            assign icon_text_field = 'icon_' | append: position | append: '_text'
          -%}
          <div class="icon-item" {{ block.shopify_attributes }}>
            {% if product.metafields.custom[icon_image_field] %}
              <img src="{{ product.metafields.custom[icon_image_field] | image_url }}" alt="{{ 'sections.product_info_tab.icon_alt' | t: number: position }}" width="48" height="48" loading="lazy">
            {% elsif block.settings.image %}
              <img src="{{ block.settings.image | image_url }}" alt="{{ 'sections.product_info_tab.icon_alt' | t: number: position }}" width="48" height="48" loading="lazy">
            {% endif %}
            <span>
              {% if product.metafields.custom[icon_text_field] %}
                {{ product.metafields.custom[icon_text_field] }}
              {% else %}
                {{ block.settings.text }}
              {% endif %}
            </span>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>

  <div class="tab-panel" id="ingredients">
    <div class="image-side">
      {%- comment -%}
        Use metafield for ingredients image with fallback to section settings
      {%- endcomment -%}
      {% if product.metafields.custom.ingredients_image %}
        <img src="{{ product.metafields.custom.ingredients_image | image_url }}" alt="{{ 'sections.product_info_tab.ingredients_image_alt' | t }}" width="600" height="600" loading="lazy">
      {% elsif section.settings.ingredients_image %}
        <img src="{{ section.settings.ingredients_image | image_url }}" alt="{{ 'sections.product_info_tab.ingredients_image_alt' | t }}" width="600" height="600" loading="lazy">
      {% endif %}
    </div>
    <div class="content-side">
      <div class="usage-content">
        {%- comment -%}
          Use metafield for usage content (rich text) with fallback to static content
        {%- endcomment -%}
        {% if product.metafields.custom.ingriedient_content %}
          {{ product.metafields.custom.ingriedient_content | metafield_tag }}
        {% endif %}
      </div>
    </div>
  </div>

<div class="tab-panel" id="usage">
  <div class="image-side">
    {%- comment -%}
      Use metafield for usage image with fallback to section settings
    {%- endcomment -%}
    {% if product.metafields.custom.usage_image %}
      <img src="{{ product.metafields.custom.usage_image | image_url }}" alt="{{ 'sections.product_info_tab.usage_image_alt' | t }}" width="600" height="600" loading="lazy">
    {% elsif section.settings.usage_image %}
      <img src="{{ section.settings.usage_image | image_url }}" alt="{{ 'sections.product_info_tab.usage_image_alt' | t }}" width="600" height="600" loading="lazy">
    {% endif %}
  </div>

  <div class="content-side">
    <div class="usage-content">
      {%- comment -%}
        Use metafield for usage content (rich text) with fallback to static content
      {%- endcomment -%}
      {% if product.metafields.custom.usage_content %}
        {{ product.metafields.custom.usage_content | metafield_tag }}
      {% endif %}

      <h4>{{ 'sections.product_info_tab.highlight_notes' | t }}</h4>

      {%- comment -%}
        Determine if there are any metafield icons
      {%- endcomment -%}
      {%- liquid
        assign has_meta_icons = false
        if product.metafields.custom.nicon_1_image or product.metafields.custom.nicon_2_image or product.metafields.custom.nicon_3_image or product.metafields.custom.nicon_4_image
          assign has_meta_icons = true
        endif
      -%}

      <div class="icon-row">
        {% if has_meta_icons %}
          {%- comment -%} Show only metafield icons {%- endcomment -%}
          {%- for n in (1..6) -%}
            {%- liquid
              assign icon_image_field = 'nicon_' | append: n | append: '_image'
              assign icon_text_field = 'nicon_' | append: n | append: '_text'
            -%}
            {% if product.metafields.custom[icon_image_field] %}
            <div class="icon-item">
              <img src="{{ product.metafields.custom[icon_image_field] | image_url }}" alt="{{ 'sections.product_info_tab.icon_alt' | t: number: n }}" width="48" height="48" loading="lazy">
              {% if product.metafields.custom[icon_text_field] %}
                <span>{{ product.metafields.custom[icon_text_field] }}</span>
              {% endif %}
            </div>
            {% endif %}
          {%- endfor %}

        {% else %}
          {%- comment -%} Fallback: the first four of the section's icons {%- endcomment -%}
          {% for block in icon_blocks limit: 4 %}
            {% if block.settings.image %}
              <div class="icon-item">
                <img src="{{ block.settings.image | image_url }}" alt="{{ 'sections.product_info_tab.icon_alt' | t: number: forloop.index }}" width="48" height="48" loading="lazy">
                {% if block.settings.text %}
                  <span>{{ block.settings.text }}</span>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </div>
</div>

<div class="tab-panel" id="faq">
  <div class="image-side">
    {% comment %}
      Use product metafield for FAQ image with fallback to section setting or default
    {% endcomment %}
    {% if product.metafields.custom.faq_image %}
      <img src="{{ product.metafields.custom.faq_image | image_url }}" alt="{{ 'sections.product_info_tab.faq_image_alt' | t }}" width="600" height="600" loading="lazy">
    {% elsif section.settings.faq_image %}
      <img src="{{ section.settings.faq_image | image_url }}" alt="{{ 'sections.product_info_tab.faq_image_alt' | t }}" width="600" height="600" loading="lazy">
    {% endif %}
  </div>
  <div class="content-side">
    <div class="faq-content">
      <h4 class="faq-header">{{ 'sections.product_info_tab.faq_heading' | t }}</h4>
      <div class="faq-list">
        {% for block in section.blocks %}
          {% if block.type == "faq" %}
            <div class="faq-item">
              <div class="faq-question">{{ block.settings.question }}</div>
              <div class="faq-answer">{{ block.settings.answer }}</div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<div class="mobile-accordion">
  <div class="mobile-accordion-item">
    <button class="mobile-accordion-header" data-mobile-tab="about">{{ 'sections.product_info_tab.about' | t }}</button>
    <div class="mobile-accordion-content" id="mobile-about"></div>
  </div>

  <div class="mobile-accordion-item">
    <button class="mobile-accordion-header" data-mobile-tab="ingredients">{{ 'sections.product_info_tab.ingredients' | t }}</button>
    <div class="mobile-accordion-content" id="mobile-ingredients"></div>
  </div>

  <div class="mobile-accordion-item">
    <button class="mobile-accordion-header" data-mobile-tab="usage">{{ 'sections.product_info_tab.notes' | t }}</button>
    <div class="mobile-accordion-content" id="mobile-usage"></div>
  </div>

  <div class="mobile-accordion-item">
    <button class="mobile-accordion-header" data-mobile-tab="faq">{{ 'sections.product_info_tab.faqs_mobile' | t }}</button>
    <div class="mobile-accordion-content" id="mobile-faq"></div>
  </div>
</div>
</div>

<script src="{{ 'catalog--product-info-tab.js' | asset_url }}"></script>
