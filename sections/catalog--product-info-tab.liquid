{% schema %}
{
  "name": "Product Info Tabs",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "about_image",
      "label": "About Section Image"
    },
    {
      "type": "image_picker",
      "id": "ingredients_image",
      "label": "Ingredients Section Image"
    },
    {
      "type": "image_picker",
      "id": "usage_image",
      "label": "Usage Section Image"
    },
    {
      "type": "image_picker",
      "id": "faq_image",
      "label": "FAQ Section Image"
    },
    {
      "type": "image_picker",
      "id": "icon_1",
      "label": "Icon 1"
    },
    {
      "type": "text",
      "id": "icon_1_text",
      "label": "Icon 1 Text",
      "default": "Skin Brightening"
    },
    {
      "type": "image_picker",
      "id": "icon_2",
      "label": "Icon 2"
    },
    {
      "type": "text",
      "id": "icon_2_text",
      "label": "Icon 2 Text",
      "default": "Deep Cleanse"
    },
    {
      "type": "image_picker",
      "id": "icon_3",
      "label": "Icon 3"
    },
    {
      "type": "text",
      "id": "icon_3_text",
      "label": "Icon 3 Text",
      "default": "Anti-Oxidant"
    },
    {
      "type": "image_picker",
      "id": "icon_4",
      "label": "Icon 4"
    },
    {
      "type": "text",
      "id": "icon_4_text",
      "label": "Icon 4 Text",
      "default": "Exfoliating"
    },
    {
      "type": "image_picker",
      "id": "icon_5",
      "label": "Icon 5"
    },
    {
      "type": "text",
      "id": "icon_5_text",
      "label": "Icon 5 Text",
      "default": "Vegan"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer"
        }
      ]
    },
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "text",
          "id": "ingredient_name",
          "label": "Ingredient Name"
        },
        {
          "type": "text",
          "id": "safety_rating",
          "label": "EWG Safety Rating"
        },
        {
          "type": "text",
          "id": "concentration",
          "label": "Concentration"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Info Tabs",
      "blocks": []
    }
  ]
}
{% endschema %}

{{ 'catalog--product-info-tab.css' | asset_url | stylesheet_tag }}

<div class="product-tabs-wrapper">
  <div class="tab-nav">
    <button class="active" data-tab="about">About</button>
    <button data-tab="ingredients">Ingredients</button>
    <button data-tab="usage">Notes</button>
    <button data-tab="faq">FAQ's</button>
  </div>

  <div class="tab-panel active" id="about">
    <div class="image-side">
      {%- comment -%}
        Use metafield for about image with fallback to section settings
      {%- endcomment -%}
      {% if product.metafields.custom.about_image %}
        <img src="{{ product.metafields.custom.about_image | image_url }}" alt="About Image" width="600" height="600" loading="lazy">
      {% elsif section.settings.about_image %}
        <img src="{{ section.settings.about_image | image_url }}" alt="About Image" width="600" height="600" loading="lazy">
      {% else %}
        <img
          src="https://cdn.shopify.com/s/files/1/0680/4150/7113/files/perfume.jpg?v=1666767765"
          alt="Default About Image"
          width="600"
          height="600"
          loading="lazy">
      {% endif %}
    </div>
    <div class="content-side">
      <h4>About the product</h4>

      {% assign about_mf = product.metafields.custom.about %}
      {% if about_mf != blank %}
        {% capture about_html %}{{ about_mf | metafield_tag }}{% endcapture %}
        {% assign paragraphs = about_html | split: "</p>" %}

        {% assign about_p1 = "" %}
        {% assign about_p2 = "" %}
        {% assign about_p3 = "" %}

        {% if paragraphs.size > 0 and paragraphs[0] != blank %}
          {% assign about_p1 = paragraphs[0] | append: "</p>" %}
        {% endif %}
        {% if paragraphs.size > 1 and paragraphs[1] != blank %}
          {% assign about_p2 = paragraphs[1] | append: "</p>" %}
        {% endif %}
        {% if paragraphs.size > 2 and paragraphs[2] != blank %}
          {% assign about_p3 = paragraphs[2] | append: "</p>" %}
        {% endif %}

        {% if about_p1 != "" %}
          {{ about_p1 }}
        {% endif %}

        {% if about_p2 != "" or about_p3 != "" %}
          <div class="two-column-section">
            {% if about_p2 != "" %}
              <div class="column">
                {{ about_p2 }}
              </div>
            {% endif %}
            {% if about_p3 != "" %}
              <div class="column">
                {{ about_p3 }}
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% else %}
        <p>
          A boost of antioxidant-rich nourishing renewal for dull, dry and tired skin. This super-absorbable oil helps
          clear dark spots & blemishes and creates a brighter complexion.
        </p>

        <div class="two-column-section">
          <div class="column">
            <h4>Recommended for</h4>
            <ul>
              <li>Dull Skin</li>
              <li>Hyper Pigmentation</li>
              <li>Uneven Skin Tone</li>
              <li>Excess Oil</li>
              <li>Enlarged Pores</li>
            </ul>
          </div>
          <div class="column">
            <h4>Suitable for</h4>
            <ul>
              <li>Unisex skin care for all Skin Types</li>
              <li>Pregnancy Safe</li>
            </ul>
          </div>
        </div>
      {% endif %}

      {%- comment -%}
        Use metafield for icon images with fallback to section settings
      {%- endcomment -%}
      <div class="icon-row">
        <div class="icon-item">
          {% if product.metafields.custom.icon_1_image %}
            <img src="{{ product.metafields.custom.icon_1_image | image_url }}" alt="Icon 1" width="48" height="48" loading="lazy">
          {% elsif section.settings.icon_1 %}
            <img src="{{ section.settings.icon_1 | image_url }}" alt="Icon 1" width="48" height="48" loading="lazy">
          {% endif %}
          <span>
            {% if product.metafields.custom.icon_1_text %}
              {{ product.metafields.custom.icon_1_text }}
            {% else %}
              {{ section.settings.icon_1_text }}
            {% endif %}
          </span>
        </div>
        <div class="icon-item">
          {% if product.metafields.custom.icon_2_image %}
            <img src="{{ product.metafields.custom.icon_2_image | image_url }}" alt="Icon 2" width="48" height="48" loading="lazy">
          {% elsif section.settings.icon_2 %}
            <img src="{{ section.settings.icon_2 | image_url }}" alt="Icon 2" width="48" height="48" loading="lazy">
          {% endif %}
          <span>
            {% if product.metafields.custom.icon_2_text %}
              {{ product.metafields.custom.icon_2_text }}
            {% else %}
              {{ section.settings.icon_2_text }}
            {% endif %}
          </span>
        </div>
        <div class="icon-item">
          {% if product.metafields.custom.icon_3_image %}
