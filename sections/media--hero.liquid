{% comment %}
  AI-Powered Perfume Recommendation Quiz Section - REDESIGNED
  Premium card-based interface with user name personalization
{% endcomment %}

<div class="perfume-quiz-wrapper">
  <div class="hero-section">
    <div class="hero-content-wrapper">
      <div class="hero-image-container">
        <img
          src="https://cdn.shopify.com/s/files/1/0698/9398/0343/files/Website_-_ScentFinder_Footer_01.png?v=1767001740"
          class="hero-image"
          alt="Fragrance">
      </div>
      <div class="hero-text-container">
        <p class="fragrance-finder-text">Fragrance Finder</p>
        {%- comment -%}
          This is the page's main heading and the page had no h1 at all.
          .hero-heading sets its own font-size, weight, colour and spacing, so
          the tag change is semantic only.
        {%- endcomment -%}
        <h1 class="hero-heading">Discover the Scent That Defines You — Scentspired</h1>
        <button id="quiz-trigger-btn" class="show-all-btn">START THE QUIZ</button>
      </div>
    </div>
    <div class="hero-bottom-nav">
      <a href="#" class="nav-item">NURTURE</a>
      <a href="#" class="nav-item">BLACK ANISE</a>
      <a href="#" class="nav-item">CYAN NORI</a>
      <a href="#" class="nav-item">THE APARTMENT</a>
      <a href="#" class="nav-item">PINK IRIS</a>
      <a href="#" class="nav-item">PAUSE</a>
    </div>
  </div>

  {% comment %} Premium Quiz Modal {% endcomment %}
  <div id="quiz-modal" class="quiz-modal hidden">
    <div class="quiz-modal-overlay"></div>
    <div class="quiz-modal-content">
      <button id="close-quiz-btn" class="close-btn">&times;</button>

      <div id="quiz-container">
        {% comment %} Step 0: User Name Input {% endcomment %}
        <div class="quiz-step" data-step="0">
          <div class="quiz-progress">
            <div class="progress-bar" style="width: 14%"></div>
          </div>
          <div class="quiz-step-content">
            <div class="quiz-step-header">
              <span class="quiz-step-number">1 of 5</span>
              <h3 class="quiz-title-main">What's your name?</h3>
              <p class="quiz-subtitle">Let us personalize your fragrance journey</p>
            </div>
            <div class="quiz-input-group">
              <input
                type="text"
                id="user-name-input"
                class="quiz-name-input"
                placeholder="Enter your name..."
                maxlength="50">
            </div>
            <button class="quiz-next-btn" id="name-next-btn">CONTINUE</button>
          </div>
        </div>

        {% comment %} Question 1: Gender {% endcomment %}
        <div class="quiz-step hidden" data-step="1">
          <div class="quiz-progress">
            <div class="progress-bar" style="width: 28%"></div>
          </div>
          <div class="quiz-step-content">
            <div class="quiz-step-header">
              <span class="quiz-step-number">2 of 5</span>
              <h3 class="quiz-title-main">What's your gender preference?</h3>
              <p class="quiz-subtitle">This helps us narrow down your perfect match</p>
            </div>
            <div class="quiz-cards-grid">
              <button class="quiz-card" data-answer="Men">
                <div class="card-inner">
                  <div class="card-content">Men</div>
                </div>
              </button>
              <button class="quiz-card" data-answer="Women">
                <div class="card-inner">
                  <div class="card-content">Women</div>
                </div>
              </button>
              <button class="quiz-card" data-answer="Unisex">
                <div class="card-inner">
                  <div class="card-content">Unisex</div>
                </div>
              </button>
            </div>
            <div class="quiz-nav">
              <button class="quiz-back-btn" data-back="true">GO BACK</button>
            </div>
          </div>
        </div>

        {% comment %} Question 2: Scent Family {% endcomment %}
        <div class="quiz-step hidden" data-step="2">
          <div class="quiz-progress">
            <div class="progress-bar" style="width: 42%"></div>
          </div>
          <div class="quiz-step-content">
            <div class="quiz-step-header">
              <span class="quiz-step-number">3 of 5</span>
              <h3 class="quiz-title-main">What's your preferred scent family?</h3>
              <p class="quiz-subtitle">Choose the fragrance profile that speaks to you</p>
            </div>
            <div class="quiz-cards-grid">
              <button class="quiz-card" data-answer="Fresh">
                <div class="card-inner">
                  <div class="card-content">Fresh</div>
                </div>
              </button>
              <button class="quiz-card" data-answer="Flowery">
                <div class="card-inner">
                  <div class="card-content">Flowery</div>
                </div>
              </button>
              <button class="quiz-card" data-answer="Warm">
                <div class="card-inner">
                  <div class="card-content">Warm</div>
                </div>
              </button>
              <button class="quiz-card" data-answer="Earthy">
                <div class="card-inner">
                  <div class="card-content">Earthy</div>
                </div>
              </button>
              <button class="quiz-card" data-answer="Gourmand">
                <div class="card-inner">
                  <div class="card-content">Gourmand</div>
                </div>
              </button>
              <button class="quiz-card" data-answer="Herbal">
                <div class="card-inner">
                  <div class="card-content">Herbal</div>
                </div>
              </button>
            </div>
            <div class="quiz-nav">
              <button class="quiz-back-btn" data-back="true">GO BACK</button>
            </div>
          </div>
        </div>

        {% comment %} Question 3: Intensity {% endcomment %}
        <div class="quiz-step hidden" data-step="3">
          <div class="quiz-progress">
            <div class="progress-bar" style="width: 56%"></div>
          </div>
          <div class="quiz-step-content">
            <div class="quiz-step-header">
              <span class="quiz-step-number">4 of 5</span>
              <h3 class="quiz-title-main">What's your desired intensity?</h3>
              <p class="quiz-subtitle">Select how bold or subtle you prefer your scent</p>
            </div>
            <div class="quiz-cards-grid">
              <button class="quiz-card" data-answer="Light">
                <div class="card-inner">
                  <div class="card-content">Light & Fresh</div>
                </div>
              </button>
              <button class="quiz-card" data-answer="Medium">
                <div class="card-inner">
                  <div class="card-content">Balanced & Elegant</div>
                </div>
              </button>
              <button class="quiz-card" data-answer="Strong">
                <div class="card-inner">
                  <div class="card-content">Bold & Intense</div>
                </div>
              </button>
            </div>
            <div class="quiz-nav">
              <button class="quiz-back-btn" data-back="true">GO BACK</button>
            </div>
          </div>
        </div>

        {% comment %} Question 4: Occasion {% endcomment %}
        <div class="quiz-step hidden" data-step="4">
          <div class="quiz-progress">
            <div class="progress-bar" style="width: 70%"></div>
          </div>
          <div class="quiz-step-content">
            <div class="quiz-step-header">
              <span class="quiz-step-number">5 of 5</span>
              <h3 class="quiz-title-main">What's your preferred occasion?</h3>
              <p class="quiz-subtitle">Tell us when you'll wear your signature scent</p>
            </div>
            <div class="quiz-cards-grid">
              <button class="quiz-card" data-answer="Daily">
                <div class="card-inner">
                  <div class="card-content">Daily Wear</div>
                </div>
              </button>
              <button class="quiz-card" data-answer="Evening">
                <div class="card-inner">
                  <div class="card-content">Evening & Special</div>
                </div>
              </button>
              <button class="quiz-card" data-answer="Versatile">
                <div class="card-inner">
                  <div class="card-content">Versatile & All-Time</div>
                </div>
              </button>
            </div>
            <div class="quiz-nav">
              <button class="quiz-back-btn" data-back="true">GO BACK</button>
            </div>
          </div>
        </div>

        {% comment %} Loading State {% endcomment %}
        <div class="quiz-step hidden" data-step="loading">
          <div class="loading-container">
            <div class="spinner"></div>
            <p class="loading-text">Finding your perfect fragrance...</p>
          </div>
        </div>

        {% comment %} Results State {% endcomment %}
        <div class="quiz-step hidden" data-step="results">
          <div class="results-container">
            <div class="results-header">
              <h3 class="results-title">Your Perfect Match,</h3>
              <p class="results-name" id="result-user-name"></p>
            </div>
            <div id="result-card" class="result-card">
              <h2 id="result-perfume-name" class="perfume-name"></h2>
              <p id="result-inspired-by" class="inspired-by"></p>
              <div class="result-details">
                <div class="detail-section">
                  <p class="detail-label">HEAD NOTES</p>
                  <p id="result-head-notes" class="detail-content"></p>
                </div>
                <div class="detail-section">
                  <p class="detail-label">HEART NOTES</p>
                  <p id="result-heart-notes" class="detail-content"></p>
                </div>
                <div class="detail-section">
                  <p class="detail-label">BASE NOTES</p>
                  <p id="result-base-notes" class="detail-content"></p>
                </div>
              </div>
              <p id="result-ai-reason" class="ai-reason"></p>
            </div>
            <div class="result-actions">
              <a id="view-product-btn" href="#" class="view-product-btn">EXPLORE FRAGRANCE</a>
              <button id="restart-quiz-btn" class="restart-quiz-btn">TRY AGAIN</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{{ 'media--hero.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Where the finder's perfumes come from is the region's choice, made by data:
    regions/<id>/data/hero-perfumes.json present -> that file (UK, USA today)
    absent                                       -> this store's live products (UAE)
  The live path knows stock and each product's real address; see
  snippets/catalog--finder-products.liquid.
{%- endcomment -%}
{%- capture perfume_data -%}{%- render 'region--data', name: 'hero-perfumes', optional: true -%}{%- endcapture -%}
{%- if perfume_data == 'null' -%}
  {%- capture perfume_data -%}{%- render 'catalog--finder-products', collection: section.settings.finder_collection -%}{%- endcapture -%}
{%- endif -%}
<script>
  const perfumeDatabase = {{ perfume_data }};

  /*
   * Live store data (a region without a hero-perfumes data file): gender and
   * scent family come from metafields where set, otherwise from the tag that
   * matches one of this quiz's own answers. Sold-out perfumes, and products
   * that are not finder perfumes (no scent family), are left out.
   * For a data file this changes nothing: every entry already has both, and
   * none carries `available`.
   */
  (function useLiveCatalogue() {
    const answers = (step) =>
      [...document.querySelectorAll(`.quiz-step[data-step="${step}"] [data-answer]`)].map((b) => b.dataset.answer);
    const genders = answers(1);
    const families = answers(2);
    for (let i = perfumeDatabase.length - 1; i >= 0; i--) {
      const p = perfumeDatabase[i];
      const tags = p.tags || [];
      if (!p.category) p.category = genders.find((g) => tags.includes(g)) || '';
      if (!p.scent_family) p.scent_family = families.find((f) => tags.includes(f)) || '';
      if (p.available === false || !p.scent_family) perfumeDatabase.splice(i, 1);
    }
  })();

  // <CHANGE> UPDATED QUIZ LOGIC - Name input + personalized results
  let quizAnswers = {
    userName: '',
    gender: null,
    scent_family: null,
    intensity: null,
    occasion: null,
  };

  let currentStep = 0;
  let recommendedPerfume = null;

  const quizTriggerBtn = document.getElementById('quiz-trigger-btn');
  const closeQuizBtn = document.getElementById('close-quiz-btn');
  const quizModal = document.getElementById('quiz-modal');
  const quizCards = document.querySelectorAll('.quiz-card');
  const restartBtn = document.getElementById('restart-quiz-btn');
  const viewProductBtn = document.getElementById('view-product-btn');
  const nameInput = document.getElementById('user-name-input');
  const nameNextBtn = document.getElementById('name-next-btn');
  const backBtns = document.querySelectorAll('.quiz-back-btn');

  // Open modal
  quizTriggerBtn.addEventListener('click', e => {
    e.preventDefault();
    quizModal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    currentStep = 0;
    showStep(0);
  });

  // Close modal
  closeQuizBtn.addEventListener('click', closeModal);
  quizModal.addEventListener('click', e => {
    if (e.target === quizModal.querySelector('.quiz-modal-overlay')) closeModal();
  });

  function closeModal() {
    quizModal.classList.add('hidden');
    document.body.style.overflow = 'auto';
  }

  // <CHANGE> Name input handler
  nameNextBtn.addEventListener('click', () => {
    if (nameInput.value.trim()) {
      quizAnswers.userName = nameInput.value.trim();
      currentStep = 1;
      showStep(1);
    }
  });

  nameInput.addEventListener('keypress', e => {
    if (e.key === 'Enter' && nameInput.value.trim()) {
      quizAnswers.userName = nameInput.value.trim();
      currentStep = 1;
      showStep(1);
    }
  });

  // Handle quiz card clicks
  quizCards.forEach(card => {
    card.addEventListener('click', () => {
      const step = card.closest('.quiz-step');
      const siblings = step.querySelectorAll('.quiz-card');

      siblings.forEach(s => s.classList.remove('selected'));
      card.classList.add('selected');

      const answer = card.getAttribute('data-answer');

      if (currentStep === 1) quizAnswers.gender = answer;
      if (currentStep === 2) quizAnswers.scent_family = answer;
      if (currentStep === 3) quizAnswers.intensity = answer;
      if (currentStep === 4) quizAnswers.occasion = answer;

      setTimeout(() => {
        if (currentStep < 4) {
          currentStep++;
          showStep(currentStep);
        } else {
          showStep('loading');
          setTimeout(() => getRecommendation(), 1500);
        }
      }, 300);
    });
  });

  // Back button
  backBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      if (currentStep > 1) {
        currentStep--;
        showStep(currentStep);
      }
    });
  });

  function showStep(stepNum) {
    document.querySelectorAll('.quiz-step').forEach(s => s.classList.add('hidden'));
    const targetStep = document.querySelector(`[data-step="${stepNum}"]`);
    if (targetStep) targetStep.classList.remove('hidden');
  }

  function getRecommendation() {
    recommendedPerfume = findBestMatch(quizAnswers);
    displayRecommendation(recommendedPerfume);
  }

  function findBestMatch(answers) {
    let scores = perfumeDatabase.map(perfume => {
      let score = 0;

      // Gender matching
      if (perfume.category === 'Unisex') score += 30;
      else if (perfume.category === answers.gender) score += 30;

      // Scent family matching
      if (perfume.scent_family === answers.scent_family) score += 40;

      // Intensity preference
      if (answers.intensity === 'Light' && ['Fresh', 'Herbal'].includes(perfume.scent_family)) score += 5;
      else if (answers.intensity === 'Strong' && ['Warm', 'Earthy'].includes(perfume.scent_family)) score += 5;
      else if (answers.intensity === 'Medium') score += 3;

      // Occasion preference
      if (answers.occasion === 'Daily' && perfume.scent_family === 'Fresh') score += 5;
      else if (answers.occasion === 'Evening' && ['Warm', 'Earthy'].includes(perfume.scent_family)) score += 5;
      else if (answers.occasion === 'Versatile') score += 3;

      return { perfume, score };
    });

    scores.sort((a, b) => b.score - a.score);
    return scores[0].perfume;
  }

  // <CHANGE> Display recommendation with user name
  function displayRecommendation(perfume) {
    if (!perfume) return;
    const reasons = {% render 'region--data', name: 'hero-reasons' %};

    const uName = document.getElementById('result-user-name');
    if (uName) uName.textContent = quizAnswers.userName;
    const pName = document.getElementById('result-perfume-name');
    if (pName) pName.textContent = perfume.name;
    const pInsp = document.getElementById('result-inspired-by');
    if (pInsp) pInsp.textContent = perfume.originalName ? `Inspired by: ${perfume.originalName}` : '';
    const pHead = document.getElementById('result-head-notes');
    if (pHead) pHead.textContent = perfume.head_notes;
    const pHeart = document.getElementById('result-heart-notes');
    if (pHeart) pHeart.textContent = perfume.heart_notes;
    const pBase = document.getElementById('result-base-notes');
    if (pBase) pBase.textContent = perfume.base_notes;
    const pAi = document.getElementById('result-ai-reason');
    if (pAi) {
      pAi.textContent =
        reasons[perfume.scent_family] ||
        `Based on your preferences for ${perfume.scent_family} scents and ${perfume.gender} fragrances, ${perfume.name} is your perfect match.`;
    }

    if (viewProductBtn) {
      // The live catalogue carries each product's real address. The data file
      // does not, so its link is still derived from the name — which is why
      // "Heaven's Pour" and "L'Infini" 404 there and not on the live path.
      const productHandle = (perfume.name || '').toLowerCase().replace(/\s+/g, '-');
      viewProductBtn.href = perfume.url || `/products/${productHandle}`;
    }

    showStep('results');
  }

  if (restartBtn) {
    restartBtn.addEventListener('click', () => {
      quizAnswers = { userName: '', gender: null, scent_family: null, intensity: null, occasion: null };
      currentStep = 0;
      if (nameInput) nameInput.value = '';
      document.querySelectorAll('.quiz-card').forEach(card => card.classList.remove('selected'));
      showStep(0);
    });
  }
</script>

{% schema %}
{
  "name": "Hero Section",
  "settings": [
    {
      "type": "collection",
      "id": "finder_collection",
      "label": "Fragrance finder: products",
      "info": "Used only when the region has no hero-perfumes data file, so the finder reads the store live. Pick the collection of main perfume products (not bundle or sample listings). Blank = all products."
    }
  ],
  "presets": [
    {
      "name": "Hero Section",
      "category": "Image"
    }
  ]
}
{% endschema %}
