{% comment %}
  Fragrance finder: a hero, then a quiz that recommends a perfume.
  Words, image and the quiz itself (its questions, answers and how each answer
  scores) come from the region's content/page-fragrance-finder.json; interface
  wording (Continue, Go back, the result labels) from the locale,
  sections.fragrance_finder. A question or answer added to the file is asked
  and scored with no code change.
{% endcomment %}
{%- liquid
  capture hero_label
    render 'region--content', key: 'page-fragrance-finder.hero.label'
  endcapture
  capture hero_heading
    render 'region--content', key: 'page-fragrance-finder.hero.heading'
  endcapture
  capture hero_start_button
    render 'region--content', key: 'page-fragrance-finder.hero.start_button'
  endcapture
  capture hero_image
    render 'region--content', key: 'page-fragrance-finder.hero.image'
  endcapture
  capture hero_image_alt
    render 'region--content', key: 'page-fragrance-finder.hero.image_alt'
  endcapture
  capture name_title
    render 'region--content', key: 'page-fragrance-finder.quiz.name_question.title'
  endcapture
  capture name_subtitle
    render 'region--content', key: 'page-fragrance-finder.quiz.name_question.subtitle'
  endcapture
  capture name_placeholder
    render 'region--content', key: 'page-fragrance-finder.quiz.name_question.placeholder'
  endcapture
  capture question_keys
    render 'region--content', key: 'page-fragrance-finder.quiz.questions.__keys'
  endcapture
  assign question_keys = question_keys | strip | split: ','
  assign step_total = question_keys.size | plus: 1
-%}

<div class="perfume-quiz-wrapper">
  <div class="hero-section">
    <div class="hero-content-wrapper">
      <div class="hero-image-container">
        <img
          src="{{ hero_image | strip | escape }}"
          class="hero-image"
          alt="{{ hero_image_alt | strip | escape }}">
      </div>
      <div class="hero-text-container">
        <p class="fragrance-finder-text">{{ hero_label }}</p>
        {%- comment -%}
          This is the page's main heading and the page had no h1 at all.
          .hero-heading sets its own font-size, weight, colour and spacing, so
          the tag change is semantic only.
        {%- endcomment -%}
        <h1 class="hero-heading">{{ hero_heading }}</h1>
        <button id="quiz-trigger-btn" class="show-all-btn">{{ hero_start_button }}</button>
      </div>
    </div>
  </div>

  {% comment %} Premium Quiz Modal {% endcomment %}
  <div id="quiz-modal" class="quiz-modal hidden">
    <div class="quiz-modal-overlay"></div>
    <div class="quiz-modal-content">
      <button id="close-quiz-btn" class="close-btn">&times;</button>

      <div id="quiz-container">
        {% comment %} Step 0: User Name Input {% endcomment %}
        <div class="quiz-step" data-step="0">
          <div class="quiz-progress">
            <div class="progress-bar" style="width: 14%"></div>
          </div>
          <div class="quiz-step-content">
            <div class="quiz-step-header">
              <span class="quiz-step-number">{{ 'sections.fragrance_finder.step_count' | t | replace: '[current]', '1' | replace: '[total]', step_total }}</span>
              <h3 class="quiz-title-main">{{ name_title }}</h3>
              <p class="quiz-subtitle">{{ name_subtitle }}</p>
            </div>
            <div class="quiz-input-group">
              <input
                type="text"
                id="user-name-input"
                class="quiz-name-input"
                placeholder="{{ name_placeholder | strip | escape }}"
                maxlength="50">
            </div>
            <button class="quiz-next-btn" id="name-next-btn">{{ 'general.continue' | t }}</button>
          </div>
        </div>

        {%- for q in question_keys -%}
          {%- liquid
            assign question_key = 'page-fragrance-finder.quiz.questions.' | append: q
            assign k = question_key | append: '.title'
            capture question_title
              render 'region--content', key: k
            endcapture
            assign k = question_key | append: '.subtitle'
            capture question_subtitle
              render 'region--content', key: k
            endcapture
            assign k = question_key | append: '.matches_perfume_field'
            capture matches_perfume_field
              render 'region--content', key: k
            endcapture
            assign matches_perfume_field = matches_perfume_field | strip
            assign k = question_key | append: '.points_for_match'
            capture points_for_match
              render 'region--content', key: k
            endcapture
            assign k = question_key | append: '.answers.__keys'
            capture answer_keys
              render 'region--content', key: k
            endcapture
            assign answer_keys = answer_keys | strip | split: ','
            assign step_number = forloop.index | plus: 1
          -%}
          <div
            class="quiz-step hidden"
            data-step="{{ forloop.index }}"
            data-question
            {%- if matches_perfume_field != blank %}
              data-matches-perfume-field="{{ matches_perfume_field | escape }}"
              data-points-for-match="{{ points_for_match | strip | escape }}"
            {%- endif %}>
            <div class="quiz-progress">
              <div class="progress-bar" style="width: {{ step_number | times: 14 }}%"></div>
            </div>
            <div class="quiz-step-content">
              <div class="quiz-step-header">
                <span class="quiz-step-number">{{ 'sections.fragrance_finder.step_count' | t | replace: '[current]', step_number | replace: '[total]', step_total }}</span>
                <h3 class="quiz-title-main">{{ question_title }}</h3>
                <p class="quiz-subtitle">{{ question_subtitle }}</p>
              </div>
              <div class="quiz-cards-grid">
                {%- for a in answer_keys -%}
                  {%- liquid
                    assign answer_key = question_key | append: '.answers.' | append: a
                    assign k = answer_key | append: '.label'
                    capture answer_label
                      render 'region--content', key: k
                    endcapture
                    assign k = answer_key | append: '.value'
                    capture answer_value
                      render 'region--content', key: k
                    endcapture
                    assign k = answer_key | append: '.suits_every_answer'
                    capture suits_every_answer
                      render 'region--content', key: k
                    endcapture
                    assign k = answer_key | append: '.points'
                    capture answer_points
                      render 'region--content', key: k
                    endcapture
                    assign k = answer_key | append: '.for_scent_families.__keys'
                    capture family_keys
                      render 'region--content', key: k
                    endcapture
                    assign family_keys = family_keys | strip | split: ','
                    assign for_scent_families = ''
                    for f in family_keys
                      assign k = answer_key | append: '.for_scent_families.' | append: f
                      capture family
                        render 'region--content', key: k
                      endcapture
                      unless forloop.first
                        assign for_scent_families = for_scent_families | append: ','
                      endunless
                      assign for_scent_families = for_scent_families | append: family
                    endfor
                  -%}
                  <button
                    class="quiz-card"
                    data-answer="{{ answer_value | strip | escape }}"
                    {%- if suits_every_answer contains 'true' %} data-suits-every-answer{% endif %}
                    {%- if answer_points != blank %}
                      data-points="{{ answer_points | strip | escape }}"
                      data-for-scent-families="{{ for_scent_families | escape }}"
                    {%- endif %}>
                    <div class="card-inner">
                      <div class="card-content">{{ answer_label }}</div>
                    </div>
                  </button>
                {%- endfor %}
              </div>
              <div class="quiz-nav">
                <button class="quiz-back-btn" data-back="true">{{ 'general.go_back' | t }}</button>
              </div>
            </div>
          </div>
        {%- endfor %}

        {% comment %} Loading State {% endcomment %}
        <div class="quiz-step hidden" data-step="loading">
          <div class="loading-container">
            <div class="spinner"></div>
            <p class="loading-text">{{ 'sections.fragrance_finder.loading' | t }}</p>
          </div>
        </div>

        {% comment %} Results State {% endcomment %}
        <div class="quiz-step hidden" data-step="results">
          <div class="results-container">
            <div class="results-header">
              <h3 class="results-title">{{ 'sections.fragrance_finder.results_title' | t }}</h3>
              <p class="results-name" id="result-user-name"></p>
            </div>
            <div id="result-card" class="result-card">
              <h2 id="result-perfume-name" class="perfume-name"></h2>
              <p id="result-inspired-by" class="inspired-by"></p>
              <div class="result-details">
                <div class="detail-section">
                  <p class="detail-label">{{ 'sections.fragrance_finder.head_notes' | t }}</p>
                  <p id="result-head-notes" class="detail-content"></p>
                </div>
                <div class="detail-section">
                  <p class="detail-label">{{ 'sections.fragrance_finder.heart_notes' | t }}</p>
                  <p id="result-heart-notes" class="detail-content"></p>
                </div>
                <div class="detail-section">
                  <p class="detail-label">{{ 'sections.fragrance_finder.base_notes' | t }}</p>
                  <p id="result-base-notes" class="detail-content"></p>
                </div>
              </div>
              <p id="result-ai-reason" class="ai-reason"></p>
            </div>
            <div class="result-actions">
              <a id="view-product-btn" href="#" class="view-product-btn">{{ 'sections.fragrance_finder.explore' | t }}</a>
              <button id="restart-quiz-btn" class="restart-quiz-btn">{{ 'sections.fragrance_finder.try_again' | t }}</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script type="application/json" id="finderStrings">
  {
    "inspiredBy": {{ 'sections.fragrance_finder.inspired_by' | t | json }},
    "reasonFallback": {{ 'sections.fragrance_finder.reason_fallback' | t | json }}
  }
</script>

{{ 'media--hero.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Where the finder's perfumes come from is the region's choice, made by data:
    regions/<id>/data/hero-perfumes.json present -> that file (UK, USA today)
    absent                                       -> this store's live products (UAE)
  The live path knows stock and each product's real address; see
  snippets/catalog--finder-products.liquid.
{%- endcomment -%}
{%- capture perfume_data -%}{%- render 'region--data', name: 'hero-perfumes', optional: true -%}{%- endcapture -%}
{%- if perfume_data == 'null' -%}
  {%- capture perfume_data -%}{%- render 'catalog--finder-products', collection: section.settings.finder_collection -%}{%- endcapture -%}
{%- endif -%}
<script type="application/json" id="finderPerfumes">{{ perfume_data }}</script>
<script type="application/json" id="finderReasons">{% render 'region--data', name: 'hero-reasons' %}</script>
{% # theme-check-disable ParserBlockingScript %}
<script src="{{ 'media--hero.js' | asset_url }}"></script>
{% # theme-check-enable ParserBlockingScript %}

{% schema %}
{
  "name": "Hero Section",
  "settings": [
    {
      "type": "collection",
      "id": "finder_collection",
      "label": "Fragrance finder: products",
      "info": "Used only when the region has no hero-perfumes data file, so the finder reads the store live. Pick the collection of main perfume products (not bundle or sample listings). Blank = all products."
    }
  ],
  "presets": [
    {
      "name": "Hero Section",
      "category": "Image"
    }
  ]
}
{% endschema %}
