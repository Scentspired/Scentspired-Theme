{%- liquid
  # Prices below used to be prefixed with a hardcoded currency symbol, which
  # shipped one region's currency to every storefront.
  capture region_currency_symbol
    render 'region--active', key: 'currency_symbol'
  endcapture
  assign region_currency_symbol = region_currency_symbol | strip
-%}
{% schema %}
{
  "name": "Custom Product Section",
  "settings": [],
  "presets": [{
    "name": "Custom Product Section"
  }]
}
{% endschema %}

<!-- HTML MARKUP -->
<div class="ps-wrapper">
  <div class="ps-container">
    <!-- Left: Product Gallery -->
    <div class="ps-gallery-left">
      <!-- Grid layout: first image full-width, then 2 per row -->
      <!-- Mobile: converted to horizontal scrollable carousel without thumbnails -->
      <div class="ps-gallery-grid" id="psProductGallery">
  {% for media in product.media %}
    {% if forloop.first %}
      <div class="ps-gallery-item ps-gallery-item-large">
        {% if media.media_type == 'video' %}
          {{ media | video_tag: autoplay: true, muted: true, loop: true, playsinline: true, controls: false }}
        {% elsif media.media_type == 'external_video' %}
          {{ media | external_video_tag }}
        {% else %}
          <img
            class="ps-gallery-media"
            src="{{ media | image_url: width: 1000 }}"
            alt="{{ media.alt }}"
            data-full="{{ media | image_url: width: 2000 }}"
          >
        {% endif %}
      </div>
    {% else %}
      <div class="ps-gallery-item ps-gallery-item-small">
        {% if media.media_type == 'video' %}
          {{ media | video_tag: autoplay: true, muted: true, loop: true, playsinline: true, controls: false }}
        {% elsif media.media_type == 'external_video' %}
          {{ media | external_video_tag }}
        {% else %}
          <img
            class="ps-gallery-media"
            src="{{ media | image_url: width: 500 }}"
            alt="{{ media.alt }}"
            data-full="{{ media | image_url: width: 2000 }}"
          >
        {% endif %}
      </div>
    {% endif %}
  {% endfor %}
</div>

      <!-- Mobile: pagination dots -->
      <div class="ps-pagination-dots" id="psPaginationDots"></div>
    </div>

    <!-- Sticky right sidebar that scrolls with content -->
    <div class="ps-info-right">
      <div class="ps-top-row">
        <span class="ps-vendor">{{ product.vendor }}</span>
      </div>
     <div class="ps-top-row">
  <h1 class="ps-title">{{ product.title }}</h1>
  
  <div class="ps-price-container">
    {% assign variant = product.selected_or_first_available_variant %}
    <span class="ps-price" id="psPriceDisplay" data-price>
      {{ region_currency_symbol }}{{ variant.price | divided_by: 100.0 | round: 2 }}
    </span>

    {%- liquid
      # The theme's one sale rule (snippets/sale--badge.liquid): Shopify's prices.
      capture sale_badge
        render 'sale--badge', price: variant.price, compare_at_price: variant.compare_at_price
      endcapture
      assign sale_badge = sale_badge | strip
    -%}
    {% if variant.compare_at_price > variant.price %}
      <span class="ps-original-price" data-compare-price>
        {{ region_currency_symbol }}{{ variant.compare_at_price | divided_by: 100.0 | round: 2 }}
      </span>
    {% endif %}
    {% if sale_badge != blank %}<span class="ps-price-badge" data-sale-badge>{{ sale_badge }}</span>{% endif %}
  </div>

</div>

      
      <!-- Variant Options -->
      {% if product.variants.size > 1 %}
        <div class="ps-variant ps-variant-options" data-variant-options>
          {% for variant in product.variants %}
          <button
  class="ps-variant ps-variant-btn{% if forloop.first %} active{% endif %}"
  data-variant-id="{{ variant.id }}"
  data-variant-price="{{ variant.price }}"
  data-variant-compare="{% if variant.compare_at_price %}{{ variant.compare_at_price }}{% else %}0{% endif %}"
  data-available="{{ variant.available | json }}"
  data-inventory="{{ variant.inventory_quantity | default: 0 }}"
  data-inventory-policy="{{ variant.inventory_policy }}"
  data-inventory-management="{{ variant.inventory_management }}"
>
  {{ variant.title }}
</button>


          {% endfor %}
        </div>
      {% endif %}

      <!-- Quantity Control -->
      <form method="post" action="/cart/add" class="ps-form" data-product-id="{{ product.id }}">

  <!-- Quantity (NOW INSIDE FORM) -->
  <div class="ps-quantity-wrapper">
    <span class="ps-qty-label">{{ 'sections.product_page.quantity' | t }}</span>
<button type="button" class="ps-qty-circle ps-qty-minus">−</button>
<span id="psQuantityDisplay">1</span>
<button type="button" class="ps-qty-circle ps-qty-plus">+</button>
  </div>

  <!-- REQUIRED hidden inputs -->
  <input type="hidden" name="id" class="ps-variant-id-input" value="{{ product.variants.first.id }}">
  <input type="hidden" name="quantity" id="psQuantityInput" value="1">

  <button type="submit" class="ps-cart ps-cart-btn">{{ 'products.product.add_to_cart' | t }}</button>

</form>


      <!-- Product Description -->
      <div class="ps-description">{{ product.description }}</div> 

      <!-- Product Icons: the region's promises (content/product.json, promises) -->
      <div class="product-icons">
        {%- capture promise_keys -%}{%- render 'region--content', key: 'product.promises.__keys' -%}{%- endcapture -%}
        {%- assign promise_keys = promise_keys | strip | split: ',' -%}
        {%- for i in promise_keys %}
          {%- liquid
            assign promise_key = 'product.promises.' | append: i
            assign k = promise_key | append: '.text'
            capture promise_text
              render 'region--content', key: k
            endcapture
            assign k = promise_key | append: '.icon_asset'
            capture promise_icon_asset
              render 'region--content', key: k
            endcapture
            assign promise_icon_asset = promise_icon_asset | strip
            assign k = promise_key | append: '.icon_url'
            capture promise_icon_url
              render 'region--content', key: k
            endcapture
            if promise_icon_asset != blank
              assign promise_icon_url = promise_icon_asset | asset_url
            endif
          -%}
        <div class="icon-item">
          <div class="icon-wrapper">
            <img src="{{ promise_icon_url | strip }}" alt="">
          </div>
          <p>{{ promise_text | strip }}</p>
        </div>
        {%- endfor %}
      </div>
    </div>
  </div>
</div>

<!-- Image popup modal -->
<div id="psImageModal" class="ps-image-modal">
  <div class="ps-modal-content">
    <button class="ps-modal-close">&times;</button>

    <img id="psModalImage" style="display:none;" />

    <video
      id="psModalVideo"
      controls
      autoplay
      muted
      playsinline
      loop
      style="display:none;"
    ></video>

  </div>
</div>


<!-- CSS STYLES -->
{{ 'catalog--product-custom.css' | asset_url | stylesheet_tag }}

<!-- JAVASCRIPT -->
{% # theme-check-disable ParserBlockingScript %}
<script src="{{ 'catalog--product-custom-variants.js' | asset_url }}"></script>
{% # theme-check-enable ParserBlockingScript %}
{% # theme-check-disable ParserBlockingScript %}
<script src="{{ 'catalog--product-custom-cart.js' | asset_url }}"></script>
{% # theme-check-enable ParserBlockingScript %}
{% # theme-check-disable ParserBlockingScript %}
<script src="{{ 'catalog--product-custom-gallery.js' | asset_url }}"></script>
{% # theme-check-enable ParserBlockingScript %}
