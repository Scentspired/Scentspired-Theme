{%- liquid
  # Prices below used to be prefixed with a hardcoded currency symbol, which
  # shipped one region's currency to every storefront.
  capture region_currency_symbol
    render 'region--active', key: 'currency_symbol'
  endcapture
  assign region_currency_symbol = region_currency_symbol | strip
-%}
{% comment %}
  Bundle Builder Section - 5 Products Only, No Discounts, Checkout Enabled Only When 5 Items Added
{% endcomment %}

<div class="bundle-builder-section">
  <!-- Bundle Header Section -->
  <div class="bundle-header-outer">
    <div class="bundle-header-area">
      <div class="bundle-container">
        <div class="bundle-main-content">
          <div class="bundle-intro">
            <h1 class="bundle-title">Bundle.</h1>
            <p class="bundle-description">Choose 5 fragrances to complete your bundle and checkout.</p>
          </div>

          <div class="bundle-selector">
            <div class="bundle-slider-container">
              <button class="bundle-nav-arrow left" id="scroll-left">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                  <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2"/>
                </svg>
              </button>

              <div class="bundle-content-wrapper">
                <div class="bundle-items-row" id="bundle-items-row">
                  {% for i in (1..5) %}
                    <div class="bundle-slot-wrapper" data-slot="{{ forloop.index0 }}">
                      <div class="bundle-item empty-slot">
                        <button class="add-button">+</button>
                        <span class="slot-number">{{ forloop.index }}</span>
                      </div>
                      <div class="bundle-product-name"></div>
                    </div>
                  {% endfor %}
                </div>
              </div>

              <button class="bundle-nav-arrow right" id="scroll-right">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                  <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2"/>
                </svg>
              </button>
            </div>
          </div>
        </div>

        <!-- Pricing Sidebar -->
        <div class="bundle-sidebar">
          <div class="pricing-section">
            <div class="initial-price-row">
              <span>Total Price</span>
              <span>$<span id="initial-price">0</span></span>
            </div>
            <p class="savings-text" id="savings-message">Add 5 items to checkout</p>
          </div>

          <div class="checkout-section">
            <div class="subtotal-row">
              <span>SUBTOTAL</span>
              <span>$<span id="subtotal-amount">0</span></span>
            </div>
            <button class="checkout-button" id="checkout-btn" disabled>CHECKOUT</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Product Filter Tabs -->
  <div class="product-filter-section">
    <div class="filter-container">
      <div class="filter-tabs">
        <button class="filter-tab active" data-filter="all">All Perfumes</button>
        <button class="filter-tab" data-filter="bestsellers">Bestsellers</button>
      </div>

      <div class="search-box">
        <input type="text" placeholder="Search" class="search-input" id="product-search">
        <button class="search-button">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
            <circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="2"/>
            <path d="m21 21-4.35-4.35" stroke="currentColor" stroke-width="2"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Products Grid -->
  <div class="products-grid-section">
    <div class="products-container">
      <div class="products-grid" id="products-grid">
        {% assign collection_handle = section.settings.collection | default: "all" %}
        {% assign bestsellers_handle = section.settings.bestsellers_collection | default: "bestsellers" %}

        {% if collections[collection_handle] %}
          {% assign all_products = collections[collection_handle].products %}
        {% else %}
          {% assign all_products = collections.all.products %}
        {% endif %}

        {% if collections[bestsellers_handle] %}
          {% assign bestseller_products = collections[bestsellers_handle].products %}
        {% else %}
          {% assign bestseller_products = collections.all.products | where: "tags", "Bestseller" %}
        {% endif %}

        {% for product in all_products limit: 20 %}
          {% assign is_bestseller = false %}
          {% if product.tags contains "Bestseller" %}
            {% assign is_bestseller = true %}
          {% endif %}

          {% for bestseller_product in bestseller_products %}
            {% if bestseller_product.id == product.id %}
              {% assign is_bestseller = true %}
              {% break %}
            {% endif %}
          {% endfor %}

          <div
            class="product-card"
            data-product-id="{{ product.variants.first.id }}"
            data-product-handle="{{ product.handle }}"
            data-product-title="{{ product.title | escape }}"
            data-product-price="{{ product.price }}"
            data-product-image="{{ product.featured_image | img_url: '100x100' }}"
            data-tags="{{ product.tags | join: ',' | downcase }}"
            data-bestseller="{{ is_bestseller }}"
            style="background-image: url('{{ product.featured_image | img_url: '400x400' }}');">
            <!-- Product Badges -->
            <div class="product-badges">
              {% for tag in product.tags %}
                {% case tag %}
                  {% when "Women" %}
                    <span class="badge category-badge">Women</span>
                  {% when "Men" %}
                    <span class="badge category-badge">Men</span>
                  {% when "Unisex" %}
                    <span class="badge category-badge">Unisex</span>
                  {% when "Bestseller" %}
                    <span class="badge bestseller-badge">Bestseller</span>
                {% endcase %}
              {% endfor %}
            </div>

            <!-- Price Overlay in Top Right -->
            <div class="product-price-overlay">{{ region_currency_symbol }}{{ product.price | money_without_currency }}</div>

            <!-- Product Info Overlay at Bottom -->
            <div class="product-info-overlay">
              <!-- Product Title -->
              <h3 class="product-title">{{ product.title | upcase }}</h3>

              <!-- Inspired By / Vendor -->
              <p class="product-subtitle">
                {{ product.metafields.custom.inspired_by.value | default: "Luxury Designer Fragrance" }}
              </p>

              <!-- Stars -->
              <div class="product-rating">
                {% assign rating = product.metafields.reviews.rating.value | default: 4.5 %}
                {% assign review_count = product.metafields.reviews.count.value | default: 1000 %}
                <div class="stars">
                  {% for i in (1..5) %}
                    {% assign star_value = i %}
                    {% if rating >= star_value %}
                      <span class="star filled">★</span>
                    {% else %}
                      <span class="star empty">★</span>
                    {% endif %}
                  {% endfor %}
                </div>
              </div>

              <!-- Add to Bundle Button -->
              <button class="add-to-bundle-btn">ADD TO BUNDLE</button>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{{ 'bundle--discovery-set.css' | asset_url | stylesheet_tag }}

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const bundleItemsRow = document.getElementById('bundle-items-row');
    const scrollLeftBtn = document.getElementById('scroll-left');
    const scrollRightBtn = document.getElementById('scroll-right');
    const checkoutBtn = document.getElementById('checkout-btn');
    const productsGrid = document.getElementById('products-grid');
    const filterTabs = document.querySelectorAll('.filter-tab');
    const searchInput = document.getElementById('product-search');
    const initialPriceSpan = document.getElementById('initial-price');
    const subtotalSpan = document.getElementById('subtotal-amount');
    const savingsMessage = document.getElementById('savings-message');

    let bundledProducts = [];
    const REQUIRED_ITEMS = 5;

    // Bundle slot management
    const bundleSlots = document.querySelectorAll('.bundle-slot-wrapper');
    bundleSlots.forEach(slot => {
      const addBtn = slot.querySelector('.add-button');
      if (addBtn) {
        addBtn.addEventListener('click', openProductSelector);
      }
    });

    function openProductSelector(e) {
      e.stopPropagation();
      const slot = e.target.closest('.bundle-slot-wrapper');
      const slotIndex = parseInt(slot.dataset.slot);

      // Highlight products for selection
      productsGrid.querySelectorAll('.product-card').forEach(card => {
        card.onclick = e => selectProductForBundle(e, slotIndex);
      });
    }

    function selectProductForBundle(e, slotIndex) {
      e.preventDefault();
      const card = e.currentTarget;
      const productData = {
        id: card.dataset.productId,
        title: card.dataset.productTitle,
        price: parseFloat(card.dataset.productPrice),
        image: card.dataset.productImage,
        handle: card.dataset.productHandle,
      };

      bundledProducts[slotIndex] = productData;
      updateBundleDisplay(slotIndex, productData);
      updateBundlePrice();
      updateCheckoutButton();
    }

    function updateBundleDisplay(slotIndex, product) {
      const slot = bundleSlots[slotIndex];
      if (!slot) return;
      const bundleItem = slot.querySelector('.bundle-item');
      const bundleName = slot.querySelector('.bundle-product-name');
      if (!bundleItem) return;

      bundleItem.classList.remove('empty-slot');
      bundleItem.classList.add('filled-slot');
      bundleItem.style.backgroundImage = `url('${product.image}')`;

      let removeBtn = bundleItem.querySelector('.remove-btn');
      if (!removeBtn) {
        removeBtn = document.createElement('button');
        removeBtn.className = 'remove-btn';
        removeBtn.innerHTML = '×';
        removeBtn.onclick = () => removeProductFromBundle(slotIndex);
        bundleItem.innerHTML = '';
        bundleItem.appendChild(removeBtn);
      }

      if (bundleName) bundleName.textContent = product.title;
    }

    function removeProductFromBundle(slotIndex) {
      bundledProducts[slotIndex] = null;
      const slot = bundleSlots[slotIndex];
      if (!slot) return;
      const bundleItem = slot.querySelector('.bundle-item');
      const bundleName = slot.querySelector('.bundle-product-name');
      const slotNum = slotIndex + 1;

      if (bundleItem) {
        bundleItem.classList.add('empty-slot');
        bundleItem.classList.remove('filled-slot');
        bundleItem.innerHTML = `<button class="add-button">+</button><span class="slot-number">${slotNum}</span>`;
        const addBtn = bundleItem.querySelector('.add-button');
        if (addBtn) addBtn.addEventListener('click', openProductSelector);
      }
      if (bundleName) bundleName.textContent = '';

      updateBundlePrice();
      updateCheckoutButton();
    }

    function updateBundlePrice() {
      let totalPrice = 0;
      bundledProducts.forEach(product => {
        if (product) {
          totalPrice += product.price;
        }
      });

      initialPriceSpan.textContent = totalPrice.toFixed(2);
      subtotalSpan.textContent = totalPrice.toFixed(2);
    }

    function updateCheckoutButton() {
      const addedCount = bundledProducts.filter(p => p !== null && p !== undefined).length;

      if (addedCount === REQUIRED_ITEMS) {
        checkoutBtn.disabled = false;
        savingsMessage.textContent = 'Your bundle is ready!';
      } else {
        checkoutBtn.disabled = true;
        const remaining = REQUIRED_ITEMS - addedCount;
        savingsMessage.textContent = `Add ${remaining} more item${remaining !== 1 ? 's' : ''} to checkout`;
      }
    }

    // Scroll functionality
    scrollLeftBtn.addEventListener('click', () => {
      bundleItemsRow.scrollBy({ left: -140, behavior: 'smooth' });
    });

    scrollRightBtn.addEventListener('click', () => {
      bundleItemsRow.scrollBy({ left: 140, behavior: 'smooth' });
    });

    // Checkout
    checkoutBtn.addEventListener('click', () => {
      const bundleData = bundledProducts
        .filter(p => p)
        .map(p => ({
          id: p.id,
          quantity: 1,
        }));
      console.log('Checkout with bundle:', bundleData);
      // Add your checkout logic here
    });

    // Filter functionality
    filterTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        filterTabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        filterProducts(tab.dataset.filter);
      });
    });

    function filterProducts(filter) {
      productsGrid.querySelectorAll('.product-card').forEach(card => {
        if (filter === 'all') {
          card.style.display = '';
        } else if (filter === 'bestsellers') {
          card.style.display = card.dataset.bestseller === 'true' ? '' : 'none';
        }
      });
    }

    // Search functionality
    searchInput.addEventListener('input', e => {
      const query = e.target.value.toLowerCase();
      productsGrid.querySelectorAll('.product-card').forEach(card => {
        const title = card.dataset.productTitle.toLowerCase();
        card.style.display = title.includes(query) ? '' : 'none';
      });
    });
  });
</script>

{% schema %}
{
  "name": "Discovery Set",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "collection",
      "id": "bestsellers_collection",
      "label": "Bestsellers Collection"
    }
  ]
}
{% endschema %}
