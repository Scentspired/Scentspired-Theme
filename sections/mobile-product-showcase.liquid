{%- comment -%}
  Scent Families Video Banner Section
  Mobile-first design with video background, collection dropdown, and product display
{%- endcomment -%}

<style>
  .scent-families-section {
    display: block;
    position: relative;
    width: 100%;
    min-height: 100vh;
    background: #000;
    overflow: hidden;
  }

  /* Hide on desktop */
  @media (min-width: 768px) {
    .scent-families-section {
      display: none;
    }
  }

  .video-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  .content-overlay {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    background: rgba(0, 0, 0, 0.3);
    padding: 2rem 1.5rem;
  }

  /* Updated header section to be centered at top */
  .header-section {
    text-align: center;
    margin-bottom: 2rem;
  }

  .inspired-range {
    color: #fff;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 1rem;
    opacity: 0.9;
  }

  .collection-dropdown {
    position: relative;
    display: inline-block;
  }

  .dropdown-button {
    background: transparent;
    border: none;
    color: #fff;
    font-size: 2.5rem;
    font-weight: 300;
    font-style: italic;
    cursor: pointer;
    padding: 0.5rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .dropdown-arrow {
    width: 0;
    height: 0;
    border-left: 8px solid transparent;
    border-right: 8px solid transparent;
    border-top: 8px solid #fff;
    transition: transform 0.3s ease;
  }

  .dropdown-button.active .dropdown-arrow {
    transform: rotate(180deg);
  }

  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0, 0, 0, 0.9);
    border-radius: 8px;
    padding: 1rem;
    min-width: 200px;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
    z-index: 10;
  }

  .dropdown-menu.active {
    opacity: 1;
    visibility: visible;
  }

  .dropdown-item {
    display: block;
    color: #fff;
    text-decoration: none;
    padding: 0.75rem 1rem;
    font-size: 1.25rem;
    font-style: italic;
    transition: background-color 0.2s ease;
    border-radius: 4px;
  }

  .dropdown-item:hover,
  .dropdown-item.active {
    background: rgba(255, 255, 255, 0.1);
  }

  /* Updated products section to be centered below header */
  .products-section {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  /* Modified grid to show single product card like reference image */
  .products-grid {
    display: flex;
    justify-content: center;
    margin-bottom: 2rem;
    width: 100%;
    max-width: 300px;
  }

  /* Updated product card styling to match reference with white background */
  .product-card {
    background: rgba(255, 255, 255, 0.95);
    border-radius: 12px;
    padding: 1.5rem;
    text-align: center;
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    width: 100%;
    color: #333;
    position: relative;
  }

  .product-image {
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-radius: 8px;
    margin-bottom: 1rem;
  }

  /* Updated product title styling */
  .product-title {
    color: #333;
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    line-height: 1.3;
    text-transform: uppercase;
  }

  /* Added product subtitle styling */
  .product-subtitle {
    color: #666;
    font-size: 0.75rem;
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  /* Added star rating styling */
  .product-rating {
    display: flex;
    justify-content: center;
    gap: 2px;
    margin-bottom: 0.75rem;
  }

  .star {
    color: #ffd700;
    font-size: 0.875rem;
  }

  /* Updated price positioning to top-right corner like reference */
  .product-price {
    color: #333;
    font-size: 1.25rem;
    font-weight: 600;
    position: absolute;
    top: 1rem;
    right: 1rem;
  }

  .pagination-dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    padding: 1rem 0;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.4);
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .dot.active {
    background: #fff;
  }

  .shop-button {
    background: #f4d03f;
    color: #000;
    border: none;
    padding: 0.75rem 2rem;
    border-radius: 25px;
    font-weight: 600;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    margin: 1rem auto 0;
    display: block;
    transition: transform 0.2s ease;
  }

  .shop-button:hover {
    transform: translateY(-2px);
  }
</style>

<div class="scent-families-section" id="scent-families-{{ section.id }}">
  {%- if section.settings.video_url != blank -%}
    <video 
      class="video-background" 
      autoplay 
      muted 
      loop 
      playsinline
      poster="{{ section.settings.video_poster | img_url: '1920x1080' }}"
    >
      <source src="{{ section.settings.video_url }}" type="video/mp4">
    </video>
  {%- endif -%}

  <div class="content-overlay">
     Moved header section to top with centered layout 
    <div class="header-section">
      <div class="inspired-range">{{ section.settings.subtitle | default: 'SCENT FAMILIES' }}</div>
      
      <div class="collection-dropdown">
        <button class="dropdown-button" id="collection-dropdown-{{ section.id }}">
          <span id="current-collection-{{ section.id }}">{{ section.blocks.first.settings.heading | default: 'Flowery' }}</span>
          <div class="dropdown-arrow"></div>
        </button>
        
        <div class="dropdown-menu" id="dropdown-menu-{{ section.id }}">
          {%- for block in section.blocks -%}
            {%- if block.type == 'collection_item' -%}
              <a href="#" 
                 class="dropdown-item" 
                 data-collection="{{ block.settings.collection.handle }}"
                 data-heading="{{ block.settings.heading }}"
                 data-block-id="{{ block.id }}">
                {{ block.settings.heading }}
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>

     Products section now shows single product below header 
    <div class="products-section">
      <div class="products-grid" id="products-grid-{{ section.id }}">
        {%- assign first_collection = section.blocks.first.settings.collection -%}
        {%- if first_collection != blank -%}
          {%- assign first_product = first_collection.products.first -%}
          {%- if first_product -%}
            <div class="product-card">
              <div class="product-price">{{ first_product.price | money }}</div>
              {%- if first_product.featured_image -%}
                <img src="{{ first_product.featured_image | img_url: '400x400' }}" 
                     alt="{{ first_product.title }}" 
                     class="product-image">
              {%- endif -%}
              <div class="product-title">{{ first_product.title }}</div>
              <div class="product-subtitle">Inspired by MFK's Baccarat Rouge 540</div>
              <div class="product-rating">
                <span class="star">★</span>
                <span class="star">★</span>
                <span class="star">★</span>
                <span class="star">★</span>
                <span class="star">★</span>
              </div>
            </div>
          {%- endif -%}
        {%- endif -%}
      </div>

      <div class="pagination-dots">
        <div class="dot active"></div>
        <div class="dot"></div>
        <div class="dot"></div>
      </div>

      {%- if section.settings.button_text != blank -%}
        <button class="shop-button" onclick="window.location.href='{{ section.settings.button_url | default: '/collections/all' }}'">
          {{ section.settings.button_text | default: 'SHOP VERSACE' }}
        </button>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const sectionId = '{{ section.id }}';
  const dropdownButton = document.getElementById(`collection-dropdown-${sectionId}`);
  const dropdownMenu = document.getElementById(`dropdown-menu-${sectionId}`);
  const currentCollection = document.getElementById(`current-collection-${sectionId}`);
  const productsGrid = document.getElementById(`products-grid-${sectionId}`);
  
  if (!dropdownButton || !dropdownMenu) return;
  
  const firstDropdownItem = dropdownMenu.querySelector('.dropdown-item');
  if (firstDropdownItem) {
    firstDropdownItem.classList.add('active');
  }
  
  // Toggle dropdown
  dropdownButton.addEventListener('click', function() {
    dropdownButton.classList.toggle('active');
    dropdownMenu.classList.toggle('active');
  });

  // Close dropdown when clicking outside
  document.addEventListener('click', function(event) {
    if (!dropdownButton.contains(event.target) && !dropdownMenu.contains(event.target)) {
      dropdownButton.classList.remove('active');
      dropdownMenu.classList.remove('active');
    }
  });

  // Handle collection selection
  const dropdownItems = dropdownMenu.querySelectorAll('.dropdown-item');
  dropdownItems.forEach(item => {
    item.addEventListener('click', function(e) {
      e.preventDefault();
      
      const collectionHandle = this.dataset.collection;
      const heading = this.dataset.heading;
      
      // Update current selection
      if (currentCollection) currentCollection.textContent = heading;
      
      // Remove active class from all items
      dropdownItems.forEach(i => i.classList.remove('active'));
      this.classList.add('active');
      
      // Close dropdown
      dropdownButton.classList.remove('active');
      dropdownMenu.classList.remove('active');
      
      // Load products for selected collection
      loadCollectionProducts(collectionHandle);
    });
  });

  function loadCollectionProducts(collectionHandle) {
    if (!collectionHandle) return;
    
    fetch(`/collections/${collectionHandle}/products.json?limit=1`)
      .then(response => {
        if (!response.ok) throw new Error('Failed to load products');
        return response.json();
      })
      .then(data => {
        if (data && data.products) updateProductsGrid(data.products);
      })
      .catch(error => {
        console.error('Error loading products:', error);
      });
  }

  function updateProductsGrid(products) {
    if (!productsGrid) return;
    productsGrid.innerHTML = '';
    
    if (products.length > 0) {
      const product = products[0];
      const productCard = document.createElement('div');
      productCard.className = 'product-card';
      
      const imageUrl = product.images[0] ? product.images[0].src : '';
      const price = new Intl.NumberFormat('en-US', {
        style: 'currency',
        currency: 'USD'
      }).format(product.variants[0].price / 100);
      
      productCard.innerHTML = `
        <div class="product-price">${price}</div>
        ${imageUrl ? `<img src="${imageUrl}" alt="${product.title}" class="product-image">` : ''}
        <div class="product-title">${product.title}</div>
        <div class="product-subtitle">Inspired by MFK's Baccarat Rouge 540</div>
        <div class="product-rating">
          <span class="star">★</span>
          <span class="star">★</span>
          <span class="star">★</span>
          <span class="star">★</span>
          <span class="star">★</span>
        </div>
      `;
      
      productsGrid.appendChild(productCard);
    }
  }

  // Pagination dots functionality (placeholder)
  const dots = document.querySelectorAll('.dot');
  dots.forEach((dot, index) => {
    dot.addEventListener('click', function() {
      dots.forEach(d => d.classList.remove('active'));
      this.classList.add('active');
      // Add pagination logic here
    });
  });
});
</script>

 Updated schema default subtitle to SCENT FAMILIES 
{% schema %}
{
  "name": "Scent Families Video ",
  "tag": "section",
  "class": "scent-families-section",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "SCENT FAMILIES"
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "Video URL",
      "info": "Upload your video to Files in Shopify admin and paste the URL here"
    },
    {
      "type": "image_picker",
      "id": "video_poster",
      "label": "Video Poster Image",
      "info": "Fallback image shown before video loads"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "SHOP VERSACE"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL",
      "default": "/collections/all"
    }
  ],
  "blocks": [
    {
      "type": "collection_item",
      "name": "Collection Item",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Flowery"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scent Families Video -Banner-",
      "blocks": [
        {
          "type": "collection_item",
          "settings": {
            "heading": "Flowery"
          }
        },
        {
          "type": "collection_item",
          "settings": {
            "heading": "Fresh"
          }
        },
        {
          "type": "collection_item",
          "settings": {
            "heading": "Earthy"
          }
        },
        {
          "type": "collection_item",
          "settings": {
            "heading": "Herbal"
          }
        },
        {
          "type": "collection_item",
          "settings": {
            "heading": "Warm"
          }
        }
      ]
    }
  ]
}
{% endschema %}
