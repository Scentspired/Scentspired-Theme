<style>
  @import url('https://fonts.googleapis.com/css2?family=PP+Editorial+New:ital,wght@0,200;0,400;1,400&display=swap');
  @import url('https://fonts.googleapis.com/css2?family=PP+Mori:wght@400;600&display=swap');

  .perfume-story-section {
    background-color: #efff31;
    width: 100%;
    min-height: 100vh;
    padding: 0;
    margin: 0;
  }

  .perfume-story-container {
    width: 100%;
    max-width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 100%;
    align-items: center;
    min-height: 100vh;
    gap: 0;
  }

  .perfume-story-content {
    padding: 80px 4rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100%;
    width: 100%;
    box-sizing: border-box;
  }

  .perfume-story-image {
    height: 100%;
    overflow: hidden;
    position: relative;
  }

  .perfume-story-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .main-headline {
    font-family: 'PP Editorial New', serif;
    font-size: 78px;
    line-height: 1.1;
    color: #000;
    margin-bottom: 90px;
    letter-spacing: -0.02em;
    width: 700px;
    margin-top: -40px;
  }

  .story-text {
    font-family: 'PP Mori', sans-serif;
    font-weight: 400;
    font-size: clamp(16px, 1.2vw, 18px);
    line-height: 1.4;
    color: #000;
    margin-bottom: 30px;
    max-width: 500px;
  }

  .get-scentspired {
    font-family: 'PP Editorial New', serif;
    font-weight: 400;
    font-style: italic;
    font-size: clamp(24px, 2.5vw, 32px);
    color: #000;
    margin-bottom: 40px;
    letter-spacing: -0.01em;
  }

  .shop-button {
    background-color: #000;
    color: #fff;
    font-family: 'PP Mori', sans-serif;
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 18px 40px;
    border: none;
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-block;
    text-align: center;
    max-width: 500px;
  }

  .shop-button:hover {
    background-color: #333;
    transform: translateY(-2px);
  }

  /* Mobile Styles */
  @media (max-width: 1024px) {
    .perfume-story-container {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto;
      min-height: auto;
      padding-left: 0px;
    }

    .perfume-story-content {
      padding: 60px 0px 60px 20px;
      order: 2;
    }

    .perfume-story-image {
      height: 60vh;
      order: 1;
    }

    .main-headline {
      font-size: clamp(36px, 8vw, 48px);
      margin-bottom: 30px;
    }

    .story-text {
      font-size: 16px;
      margin-bottom: 25px;
    }

    .get-scentspired {
      font-size: clamp(20px, 5vw, 24px);
      margin-bottom: 30px;
    }

    .shop-button {
      padding: 16px 35px;
      font-size: 13px;
    }
  }

  /* Tablet Styles */
  @media (max-width: 1024px) and (min-width: 769px) {
    .perfume-story-content {
      padding: 60px 20px;
    }

    .main-headline {
      font-size: clamp(42px, 5vw, 56px);
    }

    .story-text {
      font-size: 17px;
    }
  }

  /* Large Desktop Styles */
  @media (min-width: 1400px) {
    .main-headline {
      font-size: 80px;
    }

    .story-text {
      font-size: 20px;
    }

    .get-scentspired {
      font-size: 36px;
    }
  }
</style>

<section class="perfume-story-section">
  <div class="perfume-story-container">
    <div class="perfume-story-content">
      <h1 class="main-headline">
        {{ section.settings.main_headline | default: "We are not just a perfume house." }}
      </h1>

      <p class="story-text">
        {{
          section.settings.story_text
          | default: "We are storytellers of scent. And we invite you to find the fragrance that tells your story. Whether it's bold and daring, soft and nostalgic, or vibrant and unexpected—your signature scent is out there, waiting to be discovered. Let your senses lead the way, and begin your journey through our curated collection designed to speak to your soul."
        }}
      </p>

      <p class="get-scentspired">
        {{ section.settings.tagline | default: "Get Scentspired." }}
      </p>

      <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="shop-button">
        {{ section.settings.button_text | default: "SHOP PRODUCTS" }}
      </a>
    </div>

    <div class="perfume-story-image">
      {% if section.settings.hero_image %}
        <img
          src="{{ section.settings.hero_image | img_url: '1200x' }}"
          alt="{{ section.settings.hero_image.alt | default: 'Perfume Story' }}"
          loading="lazy">
      {% else %}
        <img
          src="/images/image.png"
          alt="Woman holding perfume bottle"
          loading="lazy">
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Perfume Story Section",
  "settings": [
    {
      "type": "text",
      "id": "main_headline",
      "label": "Main Headline",
      "default": "We are not just a perfume house."
    },
    {
      "type": "textarea",
      "id": "story_text",
      "label": "Story Text",
      "default": "We are storytellers of scent. And we invite you to find the fragrance that tells your story. Whether it's bold and daring, soft and nostalgic, or vibrant and unexpected—your signature scent is out there, waiting to be discovered. Let your senses lead the way, and begin your journey through our curated collection designed to speak to your soul."
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Get Scentspired."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "SHOP PRODUCTS"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "default": "/collections/all"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    }
  ],
  "presets": [
    {
      "name": "Perfume Story Section"
    }
  ]
}
{% endschema %}
