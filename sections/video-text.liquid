{% schema %}
{
  "name": "Video With Text",
  "settings": [
    {
      "type": "url",
      "id": "video_url",
      "label": "Video MP4 URL"
    },
    {
      "type": "richtext",
      "id": "text_content",
      "label": "Text Content",
      "default": "<p>From dusky oud trails that echo the mystery of Arabian nights, to fresh citrus notes that dance like sunlit Mediterranean mornings, our fragrances are crafted with intention, emotion, and purpose. Each blend begins with ethically sourced ingredients, chosen not just for their purity, but for the stories they carry — stories of distant lands, ancient rituals, and timeless elegance.</p><p>We pour obsessive attention into every detail — from the balance of each accord to the design of each bottle — ensuring that what touches your skin is nothing short of extraordinary.</p>"
    }
  ],
  "presets": [
    {
      "name": "Video with Text Section"
    }
  ]
}
{% endschema %}

<style>
.video-text-section {
  width: 100%;
  padding: 20px;
  margin: 0;
  background-color: #ffffff;
}

.video-text-wrapper {
  display: flex;
  flex-wrap: wrap;
  max-width: 2100px;
  margin: 0 auto;
  box-sizing: border-box;
  padding-left: 2rem;
  padding-right: 2rem;
}

.video-text-section .video-box,
.video-text-section .text-box {
  box-sizing: border-box;
}

.video-text-section .video-box {
  width: 70%;
  position: relative;
  border-radius: 20px;
  overflow: hidden;
}

.video-text-section .video-box video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.video-text-section .text-box {
  width: 30%;
  padding: 50px 40px;
  font-family: 'PP Mori', sans-serif;
  font-weight: 400;
  font-size: 20px;
  line-height: 1.6;
  display: flex;
  flex-direction: column;
  justify-content: center;
  color: #000;
}

@media screen and (max-width: 1023px) {
  .video-text-wrapper {
    flex-direction: column;
    padding: 0 5px;
  }
    .video-text-section .video-box{
      height: 500px;
    }

  .video-text-section .video-box,
  .video-text-section .text-box {
    width: 100%;
  }

  .video-text-section .text-box {
    padding: 30px 0;
    font-size: 16px;
  }
}
</style>

<section class="video-text-section">
  <div class="video-text-wrapper">
    <div class="video-box">
      <video autoplay muted loop playsinline>
        <source src="{{ section.settings.video_url }}" type="video/mp4">
        Your browser does not support the video tag.
      </video>
    </div>
    <div class="text-box">
      <h2 class="main-heading">Who We Are?</h2>
      {{ section.settings.text_content }}
    </div>
  </div>
</section>
