{%- comment -%}
  Scent notes to explore: pick a note, see the perfumes built on it. The notes
  (label, and the category of regions/<id>/data/aroma-selector.json they show)
  and the heading are the region's content/page-scent-families.json,
  aroma_selector; a note added there gets its block and dot. Four blocks to a
  row. Interface wording is the locale's, sections.aroma_selector.
{%- endcomment -%}
{%- liquid
  capture aroma_heading
    render 'region--content', key: 'page-scent-families.aroma_selector.heading'
  endcapture
  capture note_keys
    render 'region--content', key: 'page-scent-families.aroma_selector.notes.__keys'
  endcapture
  assign note_keys = note_keys | strip | split: ','
  assign note_categories = ''
-%}
{{ 'catalog--aroma-selector.css' | asset_url | stylesheet_tag }}
    <section class="select-aroma-section">
      <div class="mobile-header">
        <h2>{{ aroma_heading }}</h2>
      </div>
      <div class="select-aroma-container">
        <div class="aroma-categories" id="aromaCategories">
          {%- for i in note_keys -%}
            {%- liquid
              assign k = 'page-scent-families.aroma_selector.notes.' | append: i | append: '.category'
              capture note_category
                render 'region--content', key: k
              endcapture
              assign note_category = note_category | strip
              assign k = 'page-scent-families.aroma_selector.notes.' | append: i | append: '.label'
              capture note_label
                render 'region--content', key: k
              endcapture
              assign row = forloop.index0 | divided_by: 4 | plus: 1
              assign column = forloop.index0 | modulo: 4
            -%}
            {%- if column == 0 %}
          <div class="blocks-row row-{{ row }}">
            {%- endif %}
            <div class="aroma-block{% if forloop.first %} active{% endif %}" data-category="{{ note_category | escape }}" onclick="selectAroma(this.dataset.category, this)">
              <h3>{{ note_label }}</h3>
            </div>
            {%- if column == 3 or forloop.last %}
          </div>
            {%- endif %}
          {%- endfor %}
        </div>
        <div class="aroma-image default-state" id="aromaImage">
          <h1 class="product-title" id="productTitle" data-default-title="{{ aroma_heading | strip | escape }}">{{ aroma_heading }}</h1>
          <div class="pagination-numbers" id="paginationNumbers" style="display: none;"></div>
          <div class="pagination-dots" id="categoryDots">
            {%- for i in note_keys -%}
              {%- assign k = 'page-scent-families.aroma_selector.notes.' | append: i | append: '.category' -%}
              {%- capture note_category -%}{%- render 'region--content', key: k -%}{%- endcapture %}
            <div class="pagination-dot{% if forloop.first %} active{% endif %}" data-category="{{ note_category | strip | escape }}" onclick="selectAroma(this.dataset.category)"></div>
            {%- endfor %}
          </div>
        </div>
        <div class="aroma-details" id="aromaDetails"></div>
      </div>
    </section>

    <!-- Added modal overlay for mobile popup -->
    <div class="modal-overlay" id="modalOverlay">
      <div class="modal-content" id="modalContent">
        <button class="modal-close-btn" onclick="closeModal()">×</button>
      </div>
    </div>

    <script type="application/json" id="aromaStrings">
      {
        "top": {{ 'sections.aroma_selector.top' | t | json }},
        "heart": {{ 'sections.aroma_selector.heart' | t | json }},
        "base": {{ 'sections.aroma_selector.base' | t | json }},
        "mood": {{ 'sections.aroma_selector.mood' | t | json }},
        "shop": {{ 'sections.aroma_selector.shop' | t | json }}
      }
    </script>
    <script type="application/json" id="aromaData">{% render 'region--data', name: 'aroma-selector' %}</script>
    {% # theme-check-disable ParserBlockingScript %}
    <script src="{{ 'catalog--aroma-selector.js' | asset_url }}"></script>
    {% # theme-check-enable ParserBlockingScript %}
