{% comment %}  The `faq-section` is a customizable section for displaying privacy policies or FAQ content.  It includes a sidebar for navigation and dynamic content blocks.{% endcomment %}
<style>
/* Custom Fonts */
@font-face {
  font-family: 'PPMori Regular';
  src: url('https://cdn.shopify.com/s/files/1/0698/9398/0343/files/PPMori-Regular.otf?v=1751621372') format('opentype');
  font-weight: 400;
  font-style: normal;
}
@font-face {
  font-family: 'PPEditorialNew Italic';
  src: url('https://cdn.shopify.com/s/files/1/0698/9398/0343/files/PPEditorialNew-Italic-BF644b214fb0c0a.otf?v=1751620955') format('opentype');
  font-weight: 900;
  font-style: italic;
}
/* Base Styles */
.faq-section {
  font-family: 'PPMori Regular', sans-serif;
  background-color: white;
  padding: 40px 0;
  margin-top: 100px; /* Added from your global CSS */
}
.faq-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 10px;
}
.faq-header {
  margin-bottom: 40px;
  border-top: 1px solid #bfbec0; /* Moved border-top here to span full width */
  padding-top: 3px; /* Space between border and title */
}
.faq-title {
  font-size: 24px;
  font-weight: 600;
  margin-bottom: -30px !important; /* Adjusted for positive space below title */
  text-transform: uppercase;
  letter-spacing: 1px;
  color: #333;
  /* border-top: 1px solid #bfbec0; */ /* Removed from here */
  /* margin-left: 2px; */ /* Removed for centering */
  text-align: center; /* Centered the heading */
  font-family: 'PPEditorialNew Italic', serif;
}
.faq-content {
  display: grid;
  grid-template-columns: 200px 1fr;
  gap: 0;
  position: relative;
  border-top: 1px solid #bfbec0 !important; 
}
.faq-content::after {
  content: '';
  position: absolute;
  left: 600px;
  top: 0;
  bottom: 0;
  width: 1px;
  background-color: #e5e5e5;
}
.faq-sidebar {
  padding-right: 0;
  position: sticky;
  margin-top: 20px;
  height: fit-content;
}
.faq-sidebar ul {
  list-style: none;
  padding: 0;
  margin: 0;
}
.faq-sidebar li {
  margin-bottom: 15px;
}
.faq-sidebar a {
  color: #666;
  text-decoration: none;
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  transition: color 0.3s ease, background-color 0.3s ease; /* Added background-color to transition */
  display: block; /* Ensures the background covers the full width */
  padding: 4px 8px; /* Adds padding around the text within the block */
  border-radius: 4px; /* Adds slight rounded corners to the background */
  font-family: 'PPMori Regular', sans-serif;
}
.faq-sidebar a:hover {
  color: #000;
  background-color: #EFFF31; /* Yellow background on hover */
}
.faq-sidebar a.active {
  color: #000;
  background-color: #EFFF31; /* Yellow background for active state */
}
.faq-main {
  padding-left: 40px;
  padding-right: 20px; /* Add some padding to the right of the content */
}
.faq-category {
  margin-bottom: 40px; /* Spacing between policy sections */
}
.faq-category:last-child {
  margin-bottom: 0;
}
.faq-category-title {
  font-size: 16px;
  font-weight: 600;
  margin-bottom: 20px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: #333;
  font-family: 'PPMori Regular', sans-serif;
}
.privacy-policy-content {
  font-size: 14px;
  line-height: 1.5;
  color: #000;
  font-family: 'PPMori Regular', sans-serif;
}
.privacy-policy-content p {
  margin-bottom: 1em; /* Spacing between paragraphs */
}
.privacy-policy-content ul {
  list-style: disc;
  margin-left: 20px;
  margin-bottom: 1em;
}
.privacy-policy-content li {
  margin-bottom: 0.5em;
}
.privacy-policy-content h3 {
  font-size: 14px;
  font-weight: 600;
  margin-top: 1.5em;
  margin-bottom: 0.5em;
  color: #333;
}
/* Styling for bold text within rich text */
.privacy-policy-content strong {
  font-weight: 600; /* Ensure strong text is bold */
  font-size: 16px; /* Set font size to 16px */
  text-decoration: underline;
  text-decoration-color: #FADB95; /* Underline color */
  text-decoration-thickness: 2px; /* Adjust thickness if needed */
  text-underline-offset: 2px; /* Adjust offset if needed */
}
/* Responsive Styles */
@media (max-width: 768px) {
  .faq-content {
    grid-template-columns: 1fr;
    gap: 30px;
  }
  .faq-content::after {
    display: none;
  }
  .faq-sidebar {
    position: static;
    order: 1;
    overflow-x: auto;
    padding-bottom: 10px;
  }
  .faq-sidebar ul {
    display: flex;
    gap: 20px;
    white-space: nowrap;
    padding-bottom: 10px;
  }
  .faq-sidebar li {
    margin-bottom: 0;
    flex-shrink: 0;
  }
  .faq-main {
    padding-left: 0;
    order: 2;
    border-right: none; /* Remove right border on mobile */
    padding-right: 0;
  }
  .faq-title {
    font-size: 20px;
  }
  .faq-category-title {
    font-size: 14px;
  }
  .privacy-policy-content {
    font-size: 12px;
  }
}
/* Custom scrollbar for mobile sidebar */
.faq-sidebar::-webkit-scrollbar {
  height: 3px;
}
.faq-sidebar::-webkit-scrollbar-track {
  background: #f1f1f1;
}
.faq-sidebar::-webkit-scrollbar-thumb {
  background: #ccc;
  border-radius: 3px;
}
.faq-sidebar::-webkit-scrollbar-thumb:hover {
  background: #999;
}
/* Your additional global CSS for padding */
@media screen and (min-width: 1441px) {
  .faq-container {
    max-width: 1900px;
    margin: 0 auto;
    padding: 0 5px;
  }
  .faq-main {
    padding-left: 240px;
  }
  .faq-content::after {
    left: 433px;
  }
}
@media screen and (min-width: 1024px) and (max-width: 1440px) {
  .faq-main {
    padding-left: 100px;
  }
  .faq-container {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 10px;
  }
  .faq-content::after {
    left: 298px;
  }
}
@media screen and (min-width: 700px) and (max-width: 1024px) {
.faq-content::after {
    content: '';
    position: absolute;
    left: 200px;
    top: 0;
    bottom: 0;
    width: 1px;
    background-color: #e5e5e5;
}
}
</style>
<div class="faq-section">
<div class="faq-container">
  <div class="faq-header">
    <h1 class="faq-title">{{ section.settings.page_title | default: 'Privacy Policy' }}</h1>
  </div>
  <div class="faq-content">
    <aside class="faq-sidebar">
      <ul>
        {% comment %}
          Removed the Liquid 'active' class logic here.
          The active class will now be added by JavaScript based on the current URL.
        {% endcomment %}
        {% if section.settings.link_1_text != blank %}
          <li><a href="{{ section.settings.link_1_url }}">{{ section.settings.link_1_text }}</a></li>
        {% endif %}
        {% if section.settings.link_2_text != blank %}
          <li><a href="{{ section.settings.link_2_url }}">{{ section.settings.link_2_text }}</a></li>
        {% endif %}
        {% if section.settings.link_3_text != blank %}
          <li><a href="{{ section.settings.link_3_url }}">{{ section.settings.link_3_text }}</a></li>
        {% endif %}
        {% if section.settings.link_4_text != blank %}
          <li><a href="{{ section.settings.link_4_url }}">{{ section.settings.link_4_text }}</a></li>
        {% endif %}
        {% if section.settings.link_5_text != blank %}
          <li><a href="{{ section.settings.link_5_url }}">{{ section.settings.link_5_text }}</a></li>
        {% endif %}
        {% if section.settings.link_6_text != blank %}
          <li><a href="{{ section.settings.link_6_url }}">{{ section.settings.link_6_text }}</a></li>
        {% endif %}
        {% if section.settings.link_7_text != blank %}
          <li><a href="{{ section.settings.link_7_url }}">{{ section.settings.link_7_text }}</a></li>
        {% endif %}
        {% if section.settings.link_8_text != blank %}
          <li><a href="{{ section.settings.link_8_url }}">{{ section.settings.link_8_text }}</a></li>
        {% endif %}
      </ul>
    </aside>
    <main class="faq-main">
      {% for block in section.blocks %}
        <div class="faq-category">
          <h2 class="faq-category-title">{{ block.settings.section_title }}</h2>
          <div class="privacy-policy-content">
            {{ block.settings.section_content }}
          </div>
        </div>
      {% endfor %}
    </main>
  </div>
</div>
</div>
<script>
document.addEventListener('DOMContentLoaded', function() {
  const sidebarLinks = document.querySelectorAll('.faq-sidebar a');
  const currentPath = window.location.pathname;
  sidebarLinks.forEach(link => {
    // Normalize href to match pathname (remove domain, query params, hash)
    const linkPath = new URL(link.href).pathname;
    // Check if the link's path matches the current page's path
    if (linkPath === currentPath) {
      link.classList.add('active');
    }
  });
});
</script>
