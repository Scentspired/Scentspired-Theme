{% schema %}
{
  "name": "Newsletter Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Hear More"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "From Us"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Get the latest news about skincare tips and new products."
    }
  ],
  "presets": [
    {
      "name": "Newsletter Banner",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}

{{ 'marketing--newsletter-banner.css' | asset_url | stylesheet_tag }}

<section
  class="newsletter-banner"
  style="
    {% if section.settings.background_image != blank %}
      background-image: url('{{ section.settings.background_image | img_url: 'master' }}');
    {% else %}
      background-color: #eaeaea;
    {% endif %}
  ">
  <div class="newsletter-content">
    {% if section.settings.heading != blank %}
      <h2>{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <h3>{{ section.settings.subheading }}</h3>
    {% endif %}
    {% if section.settings.description != blank %}
      <p>{{ section.settings.description }}</p>
    {% endif %}

    <form
      id="newsletterForm"
      class="mt-3 flex w-full max-w-[345px] rounded-full border border-black pr-1 items-center h-10 bg-white">
      <input
        id="emailNews"
        type="email"
        name="email"
        placeholder="{{ 'sections.newsletter_banner.placeholder' | t }}"
        required
        class="py-1 rounded-[20px] h-full w-full border-none !bg-transparent focus:outline-none focus:ring-0 pl-4 placeholder:text-[14px] placeholder:text-[#727272]">

      <button
        id="newsletterBtn"
        type="submit"
        class="w-auto px-5 rounded-[100px] bg-yellow-300 flex items-center justify-center border border-transparent h-10">
        <span id="newsletterBtnText" class="tracking-[0.7px] text-sm text-black">{{ 'sections.newsletter_banner.submit' | t }}</span>
      </button>
    </form>

    <p id="newsletterMessage" class="mt-2 text-sm text-black hidden"></p>

    <small>{{ 'sections.newsletter_banner.note' | t }}</small>
  </div>
</section>
<script type="application/json" id="newsletterBannerStrings">
  {
    "submit": {{ 'sections.newsletter_banner.submit' | t | json }},
    "submitting": {{ 'sections.newsletter_banner.submitting' | t | json }},
    "thanks": {{ 'sections.newsletter_banner.thanks' | t | json }},
    "tryAgain": {{ 'sections.newsletter_banner.try_again' | t | json }}
  }
</script>
{%- capture klaviyo_list_id -%}{%- render 'region--active', key: 'newsletter.klaviyo_list_id' -%}{%- endcapture -%}
<script type="application/json" id="newsletterBannerConfig">
  {
    "klaviyoListId": {{ klaviyo_list_id | strip | json }}
  }
</script>
<script src="{{ 'marketing--newsletter-banner.js' | asset_url }}"></script>
