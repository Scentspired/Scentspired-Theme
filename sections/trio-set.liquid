{% comment %}
  Discovery Box Builder
  - 5 slots with dynamic progress timeline
  - Desktop: Auto-open first slot, sequential product filling, auto-advance to next slot
  - Mobile: Original flexible behavior (no auto-select, manual slot selection)
  - Direct to checkout redirect
  - Selection flow: Brand -> Product
  - Requires exactly 5 items to checkout
{% endcomment %}

{{ "section-bundle-builder.css" | asset_url | stylesheet_tag }}

<div class="perfume-bundle-section">
  <div class="builder-layout">
    {%
      render 'bundle-sidebar',
      title: section.settings.heading | default: 'Build Your Own Signature Trio Set',
      subtitle: section.settings.subheading | default: 'Add 3 items to complete your Signature Trio Set',
      capacity: 3,
      show_savings: true
    %}

    {% render "bundle-product-grid", show_size_step: true %}
  </div>
</div>

{% assign trio_parent = section.settings.bundle_product | default: all_products["the-signature-trio"] %}
{% assign trio_50 = 57083186086233 %}
{% assign trio_100 = 57083186119001 %}
{% assign trio_price_50 = 39.99 %}
{% assign trio_price_100 = 59.99 %}
{% assign trio_std_50 = 59.97 %}
{% assign trio_std_100 = 89.97 %}
{% assign trio_saving_50 = 19.98 %}
{% assign trio_saving_100 = 29.98 %}
{% assign trio_curr_sym = "£" %}

{% if cart.currency.iso_code == "USD" or shop.currency == "USD" %}
  {% assign trio_50 = 45733933154487 %}
  {% assign trio_100 = 45733933187255 %}
  {% assign trio_price_50 = 79.99 %}
  {% assign trio_price_100 = 119.99 %}
  {% assign trio_std_50 = 119.97 %}
  {% assign trio_std_100 = 179.97 %}
  {% assign trio_saving_50 = 39.98 %}
  {% assign trio_saving_100 = 59.98 %}
  {% assign trio_curr_sym = "$" %}
{% endif %}

{% for variant in trio_parent.variants %}
  {% if variant.title contains "50" %}
    {% assign trio_50 = variant.id %}
    {% if variant.price > 0 %}
      {% assign trio_price_50 = variant.price | divided_by: 100.0 %}
    {% endif %}
  {% elsif variant.title contains "100" %}
    {% assign trio_100 = variant.id %}
    {% if variant.price > 0 %}
      {% assign trio_price_100 = variant.price | divided_by: 100.0 %}
    {% endif %}
  {% endif %}
{% endfor %}

<script>
  let activeSize = null;
let currentStep = 'Step-Size';        // Tracks which step is open
let hasAddedFirstProduct = false;     // Becomes true after first product is added

const CURRENCY_SYMBOL = {{ trio_curr_sym | json }};

const PRICING = {
  "50ml": {
    total: {{ trio_price_50 | json }},
    standard: {{ trio_std_50 | json }},
    saving: {{ trio_saving_50 | json }}
  },
  "100ml": {
    total: {{ trio_price_100 | json }},
    standard: {{ trio_std_100 | json }},
    saving: {{ trio_saving_100 | json }}
  }
};

  // Load all products from the 'shop' collection
  const PRODUCTS_BY_SIZE = {
  "50ml": [
    {% paginate collections['bundle-50ml'].products by 100 %}
      {% for product in collections['bundle-50ml'].products %}
        {
          id: {{ product.id }},
          title: {{ product.title | json }},
          vendor: {{ product.vendor | json }},
          image: {{ product.featured_image | img_url: '300x300' | json }},
          tags: {{ product.tags | json }},
          variants: [
  {% for variant in product.variants %}
    {
      id: {{ variant.id }},
      title: {{ variant.title | json }},
      price: {{ variant.price }},
      sku: {{ variant.sku | json }},
      available: {{ variant.available | json }}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    {% endpaginate %}
  ],

  "100ml": [
    {% paginate collections['bundle-100ml'].products by 100 %}
      {% for product in collections['bundle-100ml'].products %}
        {
          id: {{ product.id }},
          title: {{ product.title | json }},
          vendor: {{ product.vendor | json }},
          image: {{ product.featured_image | img_url: '300x300' | json }},
          tags: {{ product.tags | json }},
          variants: [
  {% for variant in product.variants %}
    {
      id: {{ variant.id }},
      title: {{ variant.title | json }},
      price: {{ variant.price }},
       sku: {{ variant.sku | json }},
      available: {{ variant.available | json }}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    {% endpaginate %}
  ]
};


 
  const brands = [
    { tag: "tomford", name: "Tom Ford" },
    { tag: "chanel", name: "Chanel" },
    { tag: "lv", name: "Louis Vuitton" },
    { tag: "bykillian", name: "By Killian" },
    { tag: "byredo", name: "Byredo" },
    { tag: "dior", name: "Dior" },
    { tag: "maisoncrivelli", name: "Maison Crivelli" },
    { tag: "creed", name: "Creed" },
    { tag: "lelabo", name: "Le Labo" },
    { tag: "ysl", name: "YSL" },
    { tag: "burberry", name: "Burberry" },
    { tag: "exnihilos", name: "Ex Nihilo's" },
    { tag: "parfums", name: "Parfums" },
    { tag: "bvlgari", name: "Bvlgari" },
    { tag: "carolinaherrera", name: "Carolina Herrera" },
    { tag: "diptyque", name: "Diptyque" },
    { tag: "giorgioarmani", name: "Giorgio Armani" },
    { tag: "gucci", name: "Gucci" },
    { tag: "herm", name: "Hermès" },
    { tag: "initio", name: "Initio" },
    { tag: "lancôme", name: "Lancôme" },
    { tag: "mfk", name: "MFK" },
    { tag: "narciso", name: "Narciso" },
    { tag: "nasomattos", name: "Nasomatto's" },
    { tag: "nishane", name: "Nishane" },
    { tag: "pacorabanne", name: "Paco Rabanne" }
  ];

  let bundle = [null, null, null];
  let currentSlot = null;
  let activeBrand = null;

// ---- FIRST PRODUCT CHECK (RUNS ONLY ONCE) ----
// ---- FIRST PRODUCT CHECK (RUNS ONLY ONCE) ----


  function isDesktop() {
    return window.innerWidth > 1024;
  }

  window.addEventListener('DOMContentLoaded', function() {
    if (isDesktop()) {
      openSelector(0);
    }
  });

  function openSelector(index) {
    currentSlot = index;
    const drawer = document.getElementById('SelectionDrawer');
    if (drawer) drawer.classList.add('visible');

    document.querySelectorAll('.slot-item').forEach(s => s.classList.remove('active'));
    const activeSlot = document.querySelector(`.slot-item[data-index="${index}"]`);
    if (activeSlot) activeSlot.classList.add('active');

    if (activeSize) {
      showStep('Step-Product');
    } else {
      showStep('Step-Size');
    }
  }

  function closeSelector() {
    const drawer = document.getElementById('SelectionDrawer');
    if (drawer) {
      drawer.classList.remove('visible');
    }
    document.querySelectorAll('.slot-item').forEach(s => s.classList.remove('active'));
  }

  function showStep(id) {
    document.querySelectorAll('.step-container').forEach(c => c.style.display = 'none');
    const stepEl = document.getElementById(id);
    if (stepEl) stepEl.style.display = 'block';

    currentStep = id;

    const backArrowBtn = document.getElementById('BackArrowBtn');
    const drawerHeadline = document.getElementById('DrawerHeadline');

    if (id === 'Step-Size') {
      if (drawerHeadline) drawerHeadline.innerText = 'Select Size';
      if (backArrowBtn) backArrowBtn.style.display = 'none';
    }

    if (id === 'Step-Product') {
      if (drawerHeadline) drawerHeadline.innerText = 'Select Product';
      if (backArrowBtn) backArrowBtn.style.display = hasAddedFirstProduct ? 'none' : 'flex';
      renderProducts();
      initSearchListener();
    }
  }

  function goBackToStep() {
    if (currentStep === 'Step-Product' && !hasAddedFirstProduct) {
      showStep('Step-Size');
    }
  }

  function selectSize(size) {
    activeSize = size;
    showStep('Step-Product');
  }

  // Render brands in the drawer
  function renderBrands() {
    const grid = document.getElementById('BrandGrid');
    if (!grid) return;
    grid.innerHTML = brands.map(b => `
      <div class="option-item" data-tag="${b.tag}" onclick="selectBrand(this.dataset.tag)">
        <span>${b.name}</span>
      </div>
    `).join('');
  }

  function selectBrand(tag) {
    activeBrand = tag;
    showStep('Step-Product');
  }

  // Store filtered products for search
  let allFilteredProducts = [];

  function renderProducts(searchQuery = '') {
    const grid = document.getElementById('ProductGrid');
    if (!grid || !activeSize) return;

    const products = PRODUCTS_BY_SIZE[activeSize] || [];

    const filtered = products.filter(p =>
      Array.isArray(p.variants) &&
      p.variants.some(v => v.available === true)
    );

    allFilteredProducts = filtered;

    let displayProducts = filtered;

    // Apply search filter if query exists
    if (searchQuery.trim()) {
      const query = searchQuery.toLowerCase();
      displayProducts = filtered.filter(p => {
        const matchesTitle = p.title.toLowerCase().includes(query);
        const matchesVendor = p.vendor.toLowerCase().includes(query);
        const matchesTags = p.tags && p.tags.some(tag => tag.toLowerCase().includes(query));
        
        return matchesTitle || matchesVendor || matchesTags;
      });
    }

    if (displayProducts.length === 0) {
      grid.innerHTML = '<div class="no-results-message">No products found matching your search.</div>';
      return;
    }

    grid.innerHTML = displayProducts.map(p => {
      const variant = (p.variants && p.variants.find(v => v.title.toLowerCase().includes(activeSize.toLowerCase()))) || (p.variants && p.variants[0]);
      const isAvailable = variant && variant.available !== false;
      if (!isAvailable) {
        return `
          <div class="option-item is-sold-out" style="opacity: 0.5; cursor: not-allowed; filter: grayscale(0.8);" onclick="alert('Sorry, &quot;${p.title}&quot; (${activeSize}) is currently out of stock. Please select another fragrance.')">
            <div class="item-thumb"><img src="${p.image}" alt=""></div>
            <span>${p.title} (${p.vendor}) <small style="display:inline-block; background:#d32f2f; color:#fff; font-size:9px; padding:2px 5px; border-radius:3px; font-weight:700; margin-left:4px;">SOLD OUT</small></span>
          </div>
        `;
      }
      return `
        <div class="option-item" onclick="addProductToBundle(${p.id}, '${activeSize}')">
          <div class="item-thumb"><img src="${p.image}" alt=""></div>
          <span>${p.title} (${p.vendor})</span>
        </div>
      `;
    }).join('');
  }

  // Handle search input
  function handleSearch(event) {
    if (!event || !event.target) return;
    const searchQuery = event.target.value || '';
    renderProducts(searchQuery);
  }

  // Initialize search listener when Step-Product is shown
  function initSearchListener() {
    const searchInput = document.getElementById('ProductSearch');
    if (searchInput) {
      searchInput.value = '';
      searchInput.addEventListener('input', handleSearch);
    }
  }

  // Add product to bundle
  function addProductToBundle(id, size) {
    if (!PRODUCTS_BY_SIZE[size]) return alert('Size not configured');
    const product = PRODUCTS_BY_SIZE[size].find(p => p.id === id);
    if (!product) return alert('Product not found');

    const variant = product.variants.find(v => v.title.toLowerCase().includes(size.toLowerCase())) || product.variants[0];
    if (!variant || variant.available === false) {
      alert(`Sorry, "${product.title}" (${size}) is currently out of stock. Please choose an in-stock fragrance.`);
      return;
    }

    const isDesktopView = typeof isDesktop === 'function' ? isDesktop() : window.innerWidth >= 768;

    // Add to current slot
    bundle[currentSlot] = {
      variantId: variant.id,
      title: product.title,
      sku: variant.sku,
      image: product.image,
      price: variant.price,
      available: variant.available
    };
    if (!hasAddedFirstProduct) {
      hasAddedFirstProduct = true;
    }

    updateUI();

    // Check for next empty slot
    const nextEmptyIndex = bundle.findIndex(item => item === null);

    if (nextEmptyIndex !== -1) {
      if (isDesktopView) {
        currentSlot = nextEmptyIndex;
        setTimeout(() => openSelector(nextEmptyIndex), 100);
      } else {
        closeSelector();
      }
    } else {
      bundleCompleted = true;
      setTimeout(() => closeSelector(), 100);
    }
  }

  function removeItem(index) {
    bundle[index] = null;
    updateUI();
  }

  function updateUI() {
    const count = bundle.filter(x => x).length;

    // Update slots
    bundle.forEach((item, i) => {
      const el = document.querySelector(`.slot-item[data-index="${i}"]`);
      if (!el) return;
      if (item) {
        el.classList.remove('empty');
        el.innerHTML = `
          <div class="slot-filled-content">
            <div class="slot-img"><img src="${item.image}" alt=""></div>
            <div class="slot-info">
              <h4>${item.title}</h4>
            </div>
            <button class="remove-item" onclick="event.stopPropagation(); removeItem(${i})">×</button>
          </div>
        `;
      } else {
        el.classList.add('empty');
        el.innerHTML = `
          <div class="slot-placeholder-icon">+</div>
          <div class="slot-placeholder-text">
            <span class="primary">Select a product</span>
            <span class="unlock"> ${3 - i} Selections Remaining</span>
          </div>
        `;
      }
    });

    const totalDisplay = document.getElementById('TotalDisplay');
    const mainBtn = document.getElementById('MainActionBtn');

    if (mainBtn) {
      mainBtn.disabled = count !== 3;
    }

    if (count === 3 && activeSize) {
      const pricing = PRICING[activeSize];
      if (pricing && totalDisplay) {
        totalDisplay.innerText = `${CURRENCY_SYMBOL}${pricing.total}`;
        totalDisplay.style.visibility = 'visible';
      }
      const savingEl = document.querySelector('.savings-row .saving');
      if (savingEl && pricing) savingEl.innerText = `${CURRENCY_SYMBOL}${pricing.standard}`;
      const saveSpan = document.querySelector('.save-row span');
      if (saveSpan && pricing) saveSpan.innerText = `${CURRENCY_SYMBOL}${pricing.saving}`;
    } else if (totalDisplay) {
      totalDisplay.innerText = '';
      totalDisplay.style.visibility = 'hidden';
    }

    const statusText = count < 3 ? `Add ${3 - count} more items to complete your signature trio set` : `Your signature trio set is complete!`;
    const bundleStatusText = document.getElementById('BundleStatusText');
    if (bundleStatusText) bundleStatusText.innerText = statusText;

    // Update progress markers
    document.querySelectorAll('.progress-marker, .progress-label').forEach(el => el.classList.remove('active'));
    for (let i = 0; i < count; i++) {
      const marker = document.getElementById(`Marker-${i}`);
      if (marker) marker.classList.add('active');
    }
    const label1 = document.getElementById('Label-1');
    if (label1) {
      if (count >= 1) label1.classList.add('active');
    }
    const label2 = document.getElementById('Label-2');
    if (label2) {
      if (count >= 2) label2.classList.add('active');
    }
    const label3 = document.getElementById('Label-3');
    if (label3) {
      if (count >= 3) label3.classList.add('active');
    }
  }

  // 🔑 Signature Trio main product variants (US & UK)
  const TRIO_SET_VARIANT = {
    "50ml": {{ trio_50 | json }},
    "100ml": {{ trio_100 | json }}
  };

  async function handleCheckout() {
    const btn = document.getElementById('MainActionBtn');
    if (!btn) return;
    const priceSpan = btn.querySelector('span:nth-child(2)');

    if (window.isProcessingCartAction) {
      console.warn('Cart action already in progress');
      return;
    }

    if (!activeSize) {
      alert('Please select a size first.');
      return;
    }

    const variantId = TRIO_SET_VARIANT && TRIO_SET_VARIANT[activeSize] ? TRIO_SET_VARIANT[activeSize] : null;

    window.isProcessingCartAction = true;
    btn.disabled = true;
    if (priceSpan) priceSpan.innerText = "Adding...";

    const properties = {};
    bundle.forEach((item, index) => {
      if (!item) return;
      properties[`Product ${index + 1}`] = item.title;
      if (item.sku) properties[`SKU ${index + 1}`] = item.sku;
      properties[`Variant ID ${index + 1}`] = item.variantId;
    });

    try {
      if (!variantId) {
        throw new Error('Please select a valid size (50ml or 100ml).');
      }

      const response = await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({
          id: variantId,
          quantity: 1,
          properties: properties
        })
      });

      if (!response.ok) {
        const errorData = await response.json().catch(() => ({}));
        throw new Error(errorData.description || errorData.message || 'Failed to add Signature Trio to cart');
      }

      console.log('Trio set added successfully');

      bundle = bundle.map(() => null);
      activeSize = null;
      activeBrand = null;

      if (typeof updateUI === 'function') updateUI();

      openSelector(0);

      btn.disabled = false;
      if (priceSpan) priceSpan.innerText = "ADDED!";

      const cartResponse = await fetch('/cart.js');
      if (cartResponse.ok) {
        const cart = await cartResponse.json();
        if (typeof updateDossierCartUI === 'function') updateDossierCartUI(cart);
        if (typeof openDossierCart === 'function') openDossierCart();
      }

      setTimeout(() => {
        const defaultPrice = (activeSize && PRICING[activeSize]) ? `${CURRENCY_SYMBOL}${PRICING[activeSize].total}` : '';
        if (priceSpan) priceSpan.innerText = defaultPrice;
        window.isProcessingCartAction = false;
      }, 2000);

    } catch (err) {
      console.error('Add to cart error:', err);
      alert(err.message || 'Error adding Trio set to cart. Please try again.');
      btn.disabled = false;
      const defaultPrice = (activeSize && PRICING[activeSize]) ? `${CURRENCY_SYMBOL}${PRICING[activeSize].total}` : '';
      if (priceSpan) priceSpan.innerText = defaultPrice;
      window.isProcessingCartAction = false;
    }
  }
</script>

{% schema %}
{
  "name": "Trio",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Build Your Own Signature Trio Set",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "default": "Add 3 items to complete your Signature Trio Set",
      "label": "Subheading"
    },
    {
      "type": "product",
      "id": "bundle_product",
      "label": "Bundle Parent Product (Optional Override)",
      "info": "Leave empty to automatically resolve by product handle ('the-signature-trio') and currency."
    }
  ],
  "presets": [
    {
      "name": "Trio"
    }
  ]
}
{% endschema %}
