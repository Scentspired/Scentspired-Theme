{%- comment -%}
  Box builder — one component for every "build your own box": Five Favourites,
  Signature Trio, Discovery Set, and any box added later. It replaces
  bundle--five-box, bundle--trio-set and bundle--discovery, three copies of the
  same builder that typed their prices and variant IDs into the code.

  Each box is one entry in regions/<id>/content/boxes.json. The page around it
  (banners, newsletter) is page-layouts/box.json, and the build writes one page
  per entry. Its other fields: page_template, page_url and banner (the page),
  menu (the header menus: snippets/header--box-menu-items.liquid). The fields
  this section reads:

    "signature_trio": {
      "builder_heading":  "Build Your Own Signature Trio Set",  this section's H1
      "box_name":         "Signature Trio Set",                 in "Add 3 items to complete your …"
      "product_handle":   "the-signature-trio",                 the Shopify product added to the cart
      "perfumes_per_box": 3,                                    how many perfumes the shopper picks
      "perfume_collection_per_size": {                          per size of that product: the
        "50ml":  "bundle-50ml",                                 collection the perfumes come from
        "100ml": "bundle-100ml"
      },
      "standard_price_per_size": { "50ml": 77.97, … }           optional, see below
    }

  Sizes are the product's own variants: "50ml" must be the variant's name in
  Shopify. A box sold in one size has no size step. When every size draws on
  the same collection, "perfume_collection": "discovery" replaces the map.

  Read from the store, never typed: each size's variant ID and price, formatted
  by the store. The standard price a saving is shown against is the variant's
  compare-at price; until the store sets one, "standard_price_per_size" states
  it. With neither, no saving is shown. "perfumes_per_box" drives the slots,
  the progress markers, the messages and the logic — change it and all follow.
{%- endcomment -%}
{%- liquid
  assign box_prefix = 'boxes.' | append: section.settings.box | append: '.'
  assign k = box_prefix | append: 'builder_heading'
  capture box_heading
    render 'region--content', key: k
  endcapture
  assign k = box_prefix | append: 'box_name'
  capture box_name
    render 'region--content', key: k
  endcapture
  assign k = box_prefix | append: 'product_handle'
  capture product_handle
    render 'region--content', key: k
  endcapture
  assign k = box_prefix | append: 'perfumes_per_box'
  capture perfumes_per_box
    render 'region--content', key: k
  endcapture
  assign box_name = box_name | strip
  assign product_handle = product_handle | strip
  assign box_product = all_products[product_handle]
  assign perfumes_per_box = perfumes_per_box | strip | plus: 0
  assign last_marker = perfumes_per_box | minus: 1

  # One collection for every size, when the box names one rather than one per size.
  assign k = box_prefix | append: 'perfume_collection'
  capture perfume_collection
    render 'region--content', key: k
  endcapture
  assign perfume_collection = perfume_collection | strip

  # Per size: the price the store charges and, where one exists, the standard
  # price a saving is measured against (see above). Formatted by the store, so
  # every region shows its own currency with no symbol written here.
  assign box_sizes = box_product.variants.size
  assign has_standard = false
  capture box_variants_json
    for variant in box_product.variants
      assign k = box_prefix | append: 'standard_price_per_size.' | append: variant.title
      capture reference_price
        render 'region--content', key: k
      endcapture
      assign reference_price = reference_price | strip
      assign standard = nil
      if variant.compare_at_price > variant.price
        assign standard = variant.compare_at_price
      elsif reference_price != blank
        assign standard = reference_price | times: 100 | round
      endif
      echo variant.title | json
      echo ': { "id": '
      echo variant.id
      echo ', "price": '
      echo variant.price | money | strip_html | json
      echo ', "standard": '
      if standard
        assign has_standard = true
        echo standard | money | strip_html | json
        echo ', "saving": '
        echo standard | minus: variant.price | money | strip_html | json
      else
        echo 'null, "saving": null'
      endif
      echo ', "available": '
      echo variant.available | json
      echo ' }'
      unless forloop.last
        echo ', '
      endunless
    endfor
  endcapture
-%}

{{ 'bundle--box.css' | asset_url | stylesheet_tag }}

<div class="perfume-bundle-section">
  <div class="builder-layout">

    <!-- LEFT SIDEBAR: BUNDLE STATUS -->
    <div class="bundle-sidebar">
      <div class="sidebar-header">
        {%- comment -%} The page's one H1: the banners above it are H2s. {%- endcomment -%}
        <h1>{{ box_heading }}</h1>
        <p id="BundleStatusText">{{ 'sections.bundle.status_start' | t | replace: '[count]', perfumes_per_box | replace: '[box]', box_name }}</p>
      </div>

      <div class="slots-wrapper">
        <div class="progress-timeline">
          <div class="progress-line"></div>
          {%- for i in (0..last_marker) -%}
            {%- liquid
              if forloop.last and perfumes_per_box > 1
                assign top = 98
              elsif last_marker > 0
                assign top = i | times: 100 | divided_by: last_marker
              else
                assign top = 0
              endif
            -%}
            <div class="progress-marker" style="top: {{ top }}%" id="Marker-{{ i }}"></div>
            <div class="progress-label" style="top: {{ top }}%" id="Label-{{ i | plus: 1 }}"></div>
          {%- endfor -%}
        </div>

        <div class="slot-list" id="BundleSlots">
          {% for i in (1..perfumes_per_box) %}
            <div class="slot-item empty" data-index="{{ forloop.index0 }}" onclick="openSelector({{ forloop.index0 }})">
              <div class="slot-placeholder-icon">+</div>
              <div class="slot-placeholder-text">
                {%- assign remaining = perfumes_per_box | minus: forloop.index | plus: 1 %}
                <span class="primary">{{ 'sections.bundle.select_a_product' | t }}</span>
                <span class="unlock"> {{ 'sections.bundle.selections_remaining' | t | replace: '[count]', remaining }}</span>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>

      <div class="sidebar-footer">
        <div class="cart">
          <button class="add-to-cart-btn" id="MainActionBtn" disabled onclick="handleCheckout()">
            <span>{{ 'sections.bundle.add_to_cart' | t }}</span>
            <span id="TotalDisplay">{{ 0 | money_without_trailing_zeros | strip_html }}</span>
          </button>
        </div>
        {%- comment -%} No standard price for any size: no saving to show. {%- endcomment -%}
        <div class="savings-row"{% unless has_standard %} style="display: none;"{% endunless %}>
          {{ 'sections.bundle.standard_price' | t }} <span class="saving">{{ 0 | money_without_trailing_zeros | strip_html }}</span>
        </div>
        <div class="save-row"{% unless has_standard %} style="display: none;"{% endunless %}>
          {{ 'sections.bundle.total_saving' | t }} <span>{{ 0 | money_without_trailing_zeros | strip_html }}</span>
        </div>
      </div>
    </div>

    <!-- RIGHT CONTENT: SELECTION DRAWER -->
    <div class="selection-drawer" id="SelectionDrawer">
      <div class="drawer-title">
        <div class="drawer-title-content">
          <button onclick="goBackToStep()" class="back-arrow-btn" id="BackArrowBtn" title="{{ 'sections.bundle.go_back' | t }}">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          <span class="drawer-title-text" id="DrawerHeadline">{% if box_sizes > 1 %}{{ 'sections.bundle.select_size' | t }}{% else %}{{ 'sections.bundle.select_product' | t }}{% endif %}</span>
        </div>
        <button onclick="closeSelector()" style="background: none; border: none; cursor: pointer; font-size: 25px;">×</button>
      </div>

      {%- comment -%} A box sold in one size has no size to choose. {%- endcomment -%}
      {%- if box_sizes > 1 %}
      <div id="Step-Size" class="step-container">
        <div class="option-list">
          {%- for variant in box_product.variants %}
          <div class="option-item" onclick="selectSize({{ variant.title | json | escape }})">
            <span>{{ variant.title }}</span>
          </div>
          {%- endfor %}
        </div>
      </div>
      {%- endif %}

      <div id="Step-Product" class="step-container"{% if box_sizes > 1 %} style="display: none;"{% endif %}>
        <div class="search-bar-wrapper">
          <div class="search-input-container">
            <input type="text" id="ProductSearch" placeholder="{{ 'sections.bundle.search' | t }}" />
            <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.35-4.35"></path>
            </svg>
          </div>
        </div>
        <div class="option-list" id="ProductGrid">
          <!-- Products injected here -->
        </div>
      </div>
    </div>

  </div>
</div>

{% render 'bundle--strings' %}
{%- comment -%}
  The box for the script: how many perfumes it holds, its name, per size the box
  product's variant (the one added to the cart), the price the store charges, and
  the standard price and saving where one exists (see the top of this file); and
  the perfumes to choose from, per size, from the collection the box names.
{%- endcomment -%}
<script type="application/json" id="bundleBoxData">
  {
    "perfumesPerBox": {{ perfumes_per_box }},
    "boxName": {{ box_name | json }},
    "variants": { {{ box_variants_json }} },
    "productsBySize": {
    {%- for variant in box_product.variants %}
      {%- liquid
        assign k = box_prefix | append: 'perfume_collection_per_size.' | append: variant.title
        capture size_collection_handle
          render 'region--content', key: k
        endcapture
        assign size_collection_handle = size_collection_handle | strip | default: perfume_collection
        assign size_collection = collections[size_collection_handle]
      %}
      {{ variant.title | json }}: [
      {% paginate size_collection.products by 100 %}
      {%- for product in size_collection.products %}
        {
          "id": {{ product.id }},
          "title": {{ product.title | json }},
          "vendor": {{ product.vendor | json }},
          "image": {{ product.featured_image | img_url: '300x300' | json }},
          "tags": {{ product.tags | json }},
          "variants": [
          {%- for v in product.variants %}
            { "id": {{ v.id }}, "title": {{ v.title | json }}, "price": {{ v.price }}, "sku": {{ v.sku | json }}, "available": {{ v.available | json }} }{% unless forloop.last %},{% endunless %}
          {%- endfor %}
          ]
        }{% unless forloop.last %},{% endunless %}
      {%- endfor %}
      {% endpaginate %}
      ]{% unless forloop.last %},{% endunless %}
    {%- endfor %}
    }
  }
</script>
{% # theme-check-disable ParserBlockingScript %}
<script src="{{ 'bundle--box.js' | asset_url }}"></script>
{% # theme-check-enable ParserBlockingScript %}

{% schema %}
{
  "name": "Box builder",
  "settings": [
    {
      "type": "text",
      "id": "box",
      "label": "Box",
      "info": "Which box this builds, from the region's content/boxes.json. The build turns this into a list of that region's boxes; everything about a box is set in its entry there."
    }
  ],
  "presets": [{ "name": "Box builder" }]
}
{% endschema %}
