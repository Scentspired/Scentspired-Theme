{% comment %}
  The blog list: one zigzag timeline row per block (image, badge, title,
  excerpt, link), a scroll-drawn spine and side dots. Used by page.blog and
  page.blogs; editorial--blog-section was a copy of it.
{% endcomment %}

{{ 'editorial--zigzag-blog.css' | asset_url | stylesheet_tag }}

<section class="prf-section" id="prf-section-{{ section.id }}">
  <div class="prf-container">

    {% if section.settings.heading_label != blank or section.settings.heading_title != blank %}
    <header class="prf-header">
      {% if section.settings.heading_label != blank %}
        <div class="prf-header__eyebrow">{{ section.settings.heading_label }}</div>
      {% endif %}
      {% if section.settings.heading_title != blank %}
        <h2 class="prf-header__title">{{ section.settings.heading_title }}</h2>
      {% endif %}
      {% if section.settings.heading_subtitle != blank %}
        <p class="prf-header__subtitle">{{ section.settings.heading_subtitle }}</p>
      {% endif %}
    </header>
    {% endif %}

    {{- '' -}}
    {{- '<!-- Spine SVG lives INSIDE .prf-items so top=0 aligns with list start -->' -}}

    <ul class="prf-items" id="prf-items-{{ section.id }}">

      <!-- Spine SVG: absolute child of .prf-items, starts at top of first item -->
      <svg class="prf-spine" id="prf-spine-{{ section.id }}" aria-hidden="true">
        <path class="prf-spine-track" id="prf-track-{{ section.id }}" />
        <path class="prf-spine-fill"  id="prf-fill-{{ section.id }}"  />
      </svg>

      {% for block in section.blocks %}
        {% assign n = forloop.index %}
        <li class="prf-item" data-index="{{ n }}" {{ block.shopify_attributes }}>

          <div class="prf-item__media">
            {% if block.settings.image != blank %}
              <img
                src="{{ block.settings.image | image_url: width: 900, height: 720, crop: 'center' }}"
                alt="{{ block.settings.title | escape }}"
                loading="lazy" width="900" height="720"
              >
            {% else %}
              <div class="prf-placeholder">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#8c7b6b" stroke-width="0.8">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                </svg>
              </div>
            {% endif %}
          </div>

          <div class="prf-item__node">
            <div class="prf-mobile-stem"></div>
            <div class="prf-badge">{{ n }}</div>
            <div class="prf-mobile-stem"></div>
          </div>

          <div class="prf-item__body">
            {% if block.settings.tag != blank %}
              <span class="prf-item__tag">{{ block.settings.tag }}</span>
            {% endif %}
            {% if block.settings.title != blank %}
              <h3 class="prf-item__title">{{ block.settings.title }}</h3>
            {% endif %}
            <div class="prf-item__divider"></div>
            {% if block.settings.excerpt != blank %}
              <p class="prf-item__excerpt">{{ block.settings.excerpt }}</p>
            {% endif %}
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}" class="prf-item__link">
                {{ block.settings.link_label }}
                <span class="prf-link-line"></span>
              </a>
            {% endif %}
          </div>

        </li>
      {% endfor %}

    </ul>
  </div>
</section>

<nav class="prf-progress" id="prf-progress-{{ section.id }}" aria-label="{{ 'sections.zigzag_blog.navigation' | t }}">
  {% for block in section.blocks %}
    <div class="prf-pdot" data-target="{{ forloop.index }}" title="{{ block.settings.title }}"></div>
  {% endfor %}
</nav>

{% # theme-check-disable ParserBlockingScript %}
<script src="{{ 'editorial--zigzag-blog.js' | asset_url }}" data-section-id="{{ section.id }}"></script>
{% # theme-check-enable ParserBlockingScript %}

{% schema %}
{
  "name": "Zigzag Blog",
  "tag": "section",
  "class": "prf-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading_label",
      "label": "Eyebrow Label",
      "default": "From the Journal"
    },
    {
      "type": "text",
      "id": "heading_title",
      "label": "Section Title",
      "default": "The Art of Fragrance"
    },
    {
      "type": "text",
      "id": "heading_subtitle",
      "label": "Section Subtitle",
      "default": "Curated stories for the discerning nose"
    }
  ],
  "blocks": [
    {
      "type": "blog_item",
      "name": "Blog Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Category",
          "default": "Guide"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "How to Find Your Signature Scent"
        },
        {
          "type": "textarea",
          "id": "excerpt",
          "label": "Excerpt",
          "default": "A complete guide to discovering a fragrance that truly reflects who you are."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Article URL"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link Text",
          "default": "Read Article"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Zigzag Blog",
      "blocks": [
        {
          "type": "blog_item",
          "settings": {
            "tag": "Guide",
            "title": "How to Find Your Signature Scent",
            "excerpt": "A complete guide to discovering a fragrance that truly reflects who you are.",
            "link_label": "Read Article"
          }
        },
        {
          "type": "blog_item",
          "settings": {
            "tag": "Inspiration",
            "title": "The Art of Layering Fragrances",
            "excerpt": "Layering is an art — when done right, it creates a scent that is uniquely yours.",
            "link_label": "Read Article"
          }
        },
        {
          "type": "blog_item",
          "settings": {
            "tag": "Ingredients",
            "title": "Key Notes in Perfumery You Should Know",
            "excerpt": "From top to base notes, understand the building blocks of your favourite fragrances.",
            "link_label": "Read Article"
          }
        },
        {
          "type": "blog_item",
          "settings": {
            "tag": "Trends",
            "title": "Fragrance Trends To Watch This Season",
            "excerpt": "Stay ahead with the top fragrance trends shaping the world of scent right now.",
            "link_label": "Read Article"
          }
        }
      ]
    }
  ]
}
{% endschema %}