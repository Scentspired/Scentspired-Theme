
<style>
@keyframes seamless-marquee {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(-50%);
  }
}


.running-text-wrapper {
  overflow: hidden;
  width: 100%;
  background-color: transparent;
  padding: 0px 0;
  margin-bottom: 0px !important;
}

.running-text-track {
  display: flex;
  width: fit-content;
  animation: seamless-marquee 15s linear infinite;
}

.running-text-content {
  display: flex;
  align-items: center;
  white-space: nowrap;
  font-family: 'PPEditorialNew Ultralight Italic', serif;
  font-style: italic;
  font-weight: 600;
  font-size: 60px;
  color: #000;
  gap: 160px; /* 👈 controls ALL spacing evenly */
}
.running-text-content {
  display: flex;
  align-items: center;
  white-space: nowrap;
  gap: 40px;
  margin-left: 150px;
}

.marquee-spacer {
  width: 0px;
  flex-shrink: 0;
}

.running-text-content span,
.running-text-content img {
  margin: 0;
}


@media screen and (max-width: 768px) {
  .running-text-content {
    font-size: 20px;
     margin-left: 60px;
  }
  .running-text-content {
  gap: 10px !important;
}

  .running-text-content img {
    width: 20px;
    height: 20px;
    margin: 0 20px;
  }
}
</style>

<div class="running-text-wrapper">
  <div class="running-text-track">
    {% for i in (1..2) %}
      <div class="running-text-content">
        <span class="marquee-spacer"></span>
        <span>{{ section.settings.text_left }}</span>
        {% if section.settings.icon_image != blank %}
          <img src="{{ section.settings.icon_image | image_url: width: 60 }}" alt="icon" />
        {% endif %}
        <span>{{ section.settings.text_center }}</span>
        {% if section.settings.icon_image != blank %}
          <img src="{{ section.settings.icon_image | image_url: width: 60 }}" alt="icon" />
        {% endif %}
        <span>{{ section.settings.text_right }}</span>
        <img src="{{ section.settings.icon_image | image_url: width: 60 }}" alt="icon" />
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Running Text Marquee",
  "settings": [
    {
      "type": "text",
      "id": "text_left",
      "label": "Left Text",
      "default": "Daily Dew"
    },
    {
      "type": "text",
      "id": "text_center",
      "label": "Center Text",
      "default": "Pure Brilliance"
    },
    {
      "type": "image_picker",
      "id": "icon_image",
      "label": "Icon Image"
    },
    {
      "type": "text",
      "id": "text_right",
      "label": "Right Text",
      "default": "Varnava Blends"
    }
  ],
  "presets": [
    {
      "name": "Running Text Marquee"
    }
  ]
}
{% endschema %}