{% schema %}
{
  "name": "Custom Product Section",
  "settings": [],
  "presets": [{
    "name": "Custom Product Section"
  }]
}
{% endschema %}

<link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@400;600&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Monument+Extended&display=swap" rel="stylesheet">

<!-- HTML MARKUP -->
<div class="ps-wrapper">
  <div class="ps-container">
    <!-- Left: Product Gallery -->
    <div class="ps-gallery-left">
      <!-- Grid layout: first image full-width, then 2 per row -->
      <!-- Mobile: converted to horizontal scrollable carousel without thumbnails -->
      <div class="ps-gallery-grid" id="psProductGallery">
  {% for media in product.media %}
    {% if forloop.first %}
      <div class="ps-gallery-item ps-gallery-item-large">
        {% if media.media_type == 'video' %}
          {{ media | video_tag: autoplay: true, muted: true, loop: true, playsinline: true, controls: false }}
        {% elsif media.media_type == 'external_video' %}
          {{ media | external_video_tag }}
        {% else %}
          <img
            class="ps-gallery-media"
            src="{{ media | image_url: width: 1000 }}"
            alt="{{ media.alt }}"
            data-full="{{ media | image_url: width: 2000 }}"
          >
        {% endif %}
      </div>
    {% else %}
      <div class="ps-gallery-item ps-gallery-item-small">
        {% if media.media_type == 'video' %}
          {{ media | video_tag: autoplay: true, muted: true, loop: true, playsinline: true, controls: false }}
        {% elsif media.media_type == 'external_video' %}
          {{ media | external_video_tag }}
        {% else %}
          <img
            class="ps-gallery-media"
            src="{{ media | image_url: width: 500 }}"
            alt="{{ media.alt }}"
            data-full="{{ media | image_url: width: 2000 }}"
          >
        {% endif %}
      </div>
    {% endif %}
  {% endfor %}
</div>

      <!-- Mobile: pagination dots -->
      <div class="ps-pagination-dots" id="psPaginationDots"></div>
    </div>

    <!-- Sticky right sidebar that scrolls with content -->
    <div class="ps-info-right">
      <div class="ps-top-row">
        <span class="ps-vendor">{{ product.vendor }}</span>
      </div>
     <div class="ps-top-row">
  <h1 class="ps-title">{{ product.title }}</h1>
  
  <div class="ps-price-container">
    {% assign variant = product.selected_or_first_available_variant %}
    <span class="ps-price" id="psPriceDisplay" data-price>
      ${{ variant.price | divided_by: 100.0 | round: 2 }}
    </span>

    {% if variant.compare_at_price and variant.compare_at_price > variant.price %}
      <span class="ps-original-price" data-compare-price>
        ${{ variant.compare_at_price | divided_by: 100.0 | round: 2 }}
      </span>
      <span class="ps-price-badge" data-sale-badge>Sale</span>
    {% endif %}
  </div>

</div>

      
      <!-- Variant Options -->
      {% if product.variants.size > 1 %}
        <div class="ps-variant ps-variant-options" data-variant-options>
          {% for variant in product.variants %}
          <button
  class="ps-variant ps-variant-btn{% if forloop.first %} active{% endif %}"
  data-variant-id="{{ variant.id }}"
  data-variant-price="{{ variant.price }}"
  data-variant-compare="{% if variant.compare_at_price %}{{ variant.compare_at_price }}{% else %}0{% endif %}"
  data-available="{{ variant.available | json }}"
  data-inventory="{{ variant.inventory_quantity }}"
  data-inventory-policy="{{ variant.inventory_policy }}"
  data-inventory-management="{{ variant.inventory_management }}"
>
  {{ variant.title }}
</button>


          {% endfor %}
        </div>
      {% endif %}

      <!-- Quantity Control -->
      <form method="post" action="/cart/add" class="ps-form" data-product-id="{{ product.id }}">

  <!-- Quantity (NOW INSIDE FORM) -->
  <div class="ps-quantity-wrapper">
    <span class="ps-qty-label">QTY</span>
<button type="button" class="ps-qty-circle ps-qty-minus">−</button>
<span id="psQuantityDisplay">1</span>
<button type="button" class="ps-qty-circle ps-qty-plus">+</button>
  </div>

  <!-- REQUIRED hidden inputs -->
  <input type="hidden" name="id" class="ps-variant-id-input" value="{{ product.variants.first.id }}">
  <input type="hidden" name="quantity" id="psQuantityInput" value="1">

  <button type="submit" class="ps-cart ps-cart-btn">ADD TO CART</button>

</form>


      <!-- Product Description -->
      <div class="ps-description">{{ product.description }}</div> 

      <!-- Product Icons -->
      <div class="product-icons">
        <div class="icon-item">
          <div class="icon-wrapper">
            <img src="{{ 'Screenshot 2025-06-30 161707.png' | asset_url }}" alt="">
          </div>
          <p>30 Days Return</p>
        </div>
        <div class="icon-item">
          <div class="icon-wrapper">
            <img src="{{ 'icon-2.png' | asset_url }}" alt="">
          </div>
          <p>Fast Shipping</p>
        </div>
        <div class="icon-item">
          <div class="icon-wrapper">
            <img src="{{ 'icon-3.png' | asset_url }}" alt="">
          </div>
          <p>Vegan & Cruelty Free</p>
        </div>
        <div class="icon-item">
          <div class="icon-wrapper">
            <img src="https://cdn.shopify.com/s/files/1/0698/9398/0343/files/Frame_1.png?v=1767264841" alt="">
          </div>
          <p>Long-Lasting Extrait Formula</p>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Image popup modal -->
<div id="psImageModal" class="ps-image-modal">
  <div class="ps-modal-content">
    <button class="ps-modal-close">&times;</button>

    <img id="psModalImage" style="display:none;" />

    <video
      id="psModalVideo"
      controls
      autoplay
      muted
      playsinline
      loop
      style="display:none;"
    ></video>

  </div>
</div>


