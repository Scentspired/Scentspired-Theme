{% schema %}
{
  "name": "Product Info Tabs",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "about_image",
      "label": "About Section Image"
    },
    {
      "type": "image_picker",
      "id": "ingredients_image",
      "label": "Ingredients Section Image"
    },
    {
      "type": "image_picker",
      "id": "usage_image",
      "label": "Usage Section Image"
    },
    {
      "type": "image_picker",
      "id": "faq_image",
      "label": "FAQ Section Image"
    },
    {
      "type": "image_picker",
      "id": "icon_1",
      "label": "Icon 1"
    },
    {
      "type": "text",
      "id": "icon_1_text",
      "label": "Icon 1 Text",
      "default": "Skin Brightening"
    },
    {
      "type": "image_picker",
      "id": "icon_2",
      "label": "Icon 2"
    },
    {
      "type": "text",
      "id": "icon_2_text",
      "label": "Icon 2 Text",
      "default": "Deep Cleanse"
    },
    {
      "type": "image_picker",
      "id": "icon_3",
      "label": "Icon 3"
    },
    {
      "type": "text",
      "id": "icon_3_text",
      "label": "Icon 3 Text",
      "default": "Anti-Oxidant"
    },
    {
      "type": "image_picker",
      "id": "icon_4",
      "label": "Icon 4"
    },
    {
      "type": "text",
      "id": "icon_4_text",
      "label": "Icon 4 Text",
      "default": "Exfoliating"
    },
    {
      "type": "image_picker",
      "id": "icon_5",
      "label": "Icon 5"
    },
    {
      "type": "text",
      "id": "icon_5_text",
      "label": "Icon 5 Text",
      "default": "Vegan"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer"
        }
      ]
    },
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "text",
          "id": "ingredient_name",
          "label": "Ingredient Name"
        },
        {
          "type": "text",
          "id": "safety_rating",
          "label": "EWG Safety Rating"
        },
        {
          "type": "text",
          "id": "concentration",
          "label": "Concentration"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Info Tabs",
      "blocks": []
    }
  ]
}
{% endschema %}

<style>
  @media screen and (min-width: 1441px) {
    .tab-nav {
      max-width: 94% !important;
      width: 94% !important;
    }
    .tab-nav button {
      min-width: 350px !important;
      text-align: center !important;
      padding: 12px 150px !important;
    }
  }

  .product-tabs-wrapper {
    width: 100%;
    padding: 0;
    font-family: 'PP Mori', sans-serif;
    padding-left: 5rem;
    padding-right: 5rem;
  }

  .tab-nav {
    display: flex;
    justify-content: center;
    background-color: #f7ff66;
    border-radius: 40px;
    margin: 20px auto;
    padding: 8px;
    gap: 10px;
    max-width: 95%;
    width: 95%;
  }

  .tab-nav button {
    background: none;
    border: none;
    padding: 12px 115px;
    font-weight: 600;
    font-size: 16px;
    cursor: pointer;
    color: black;
    border-radius: 40px;
    transition: 0.3s;
    font-family: 'PP Mori', sans-serif;
    min-width: 200px;
    text-align: center;
  }

  .tab-nav button.active {
    background: black;
    color: white;
  }

  .tab-panel {
    display: none;
    width: 100%;
    padding: 60px 20px;
    margin: 0 auto;
    max-width: 1600px;
    align-items: flex-start;
    gap: 50px;
  }

  .tab-panel.active {
    display: flex;
    flex-wrap: wrap;
  }

  .tab-panel .image-side {
    flex: 1 1 45%;
    min-width: 400px;
  }

  .tab-panel .image-side img {
    width: 100%;
    border-radius: 20px;
  }

  .tab-panel .content-side {
    flex: 1 1 50%;
    padding-right: 20px;
    padding-left: 90px;
    padding-top: 40px;
    min-width: 400px;
  }

  .content-side h4 {
    text-transform: uppercase;
    font-size: 12px;
    color: #888;
    margin-bottom: 10px;
    text-align: left;
    font-family: 'PP Mori', sans-serif;
  }

  .content-side p {
    font-size: 20px;
    line-height: 1.6;
    margin-bottom: 30px;
    text-align: left;
    font-family: 'PP Mori', sans-serif;
    font-weight: 600 !important;
  }

  .content-side ul {
    padding-left: 20px;
    margin-bottom: 20px;
    text-align: left;
    font-family: 'PP Mori', sans-serif;
    font-weight: 600 !important;
  }

  .two-column-section {
    display: flex;
    gap: 50px;
    margin-bottom: 30px;
  }

  .column {
    flex: 1;
  }

  .column h4 {
    text-transform: uppercase;
    font-size: 12px;
    color: #888;
    margin-bottom: 10px;
    text-align: left;
    font-family: 'PP Mori', sans-serif;
  }

  .column ul {
    padding-left: 20px;
    font-family: 'PP Mori', sans-serif;
  }

  .icon-row {
    display: flex;
    flex-wrap: nowrap;
    gap: 20px;
    margin-top: 30px;
    justify-content: space-between;
  }

  .icon-item {
    text-align: center;
    font-size: 14px;
    font-family: 'PP Mori', sans-serif;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .icon-item img {
    width: 40px;
    height: 40px;
    margin-bottom: 5px;
    display: block;
  }

  .icon-item span {
    display: block;
    font-size: 12px;
    font-family: 'PP Mori', sans-serif;
    line-height: 1.2;
    text-align: center;
    font-weight: 600 !important;
  }

  /* Ingredients Table Styles */
  .ingredients-table-wrapper {
    width: 100%;
    position: relative;
  }

  .ingredients-header {
    text-transform: uppercase;
    font-size: 12px;
    color: #888;
    margin-bottom: 30px;
    text-align: left;
    font-family: 'PP Mori', sans-serif;
  }

  .ingredients-table {
    width: 100%;
    border-collapse: collapse;
    font-family: 'PP Mori', sans-serif;
    table-layout: fixed;
  }

  .ingredients-table thead th {
    text-transform: uppercase;
    font-size: 12px;
    color: #888;
    font-weight: 600;
    padding: 15px 10px;
    text-align: left;
    border-bottom: 2px solid #ddd;
    background-color: #fff;
  }

  .ingredients-table thead th:first-child {
    width: 50%;
  }

  .ingredients-table thead th:nth-child(2) {
    width: 25%;
    text-align: center;
  }

  .ingredients-table thead th:last-child {
    width: 25%;
    text-align: center;
  }

  .ingredients-table tbody td {
    padding: 18px 10px;
    font-size: 14px;
    font-weight: 600;
    color: #333;
    border-bottom: 1px solid #ddd;
    vertical-align: top;
    line-height: 1.4;
  }

  .ingredients-table tbody td:nth-child(2) {
    text-align: center;
  }

  .ingredients-table tbody td:last-child {
    text-align: center;
  }

  .ingredients-table tbody tr:last-child td {
    border-bottom: 1px solid #ddd;
  }

  .ingredients-table tbody tr {
    display: none;
  }

  .ingredients-table tbody tr.visible {
    display: table-row;
  }

  /* Pagination Arrows - Simple Style */
  .ingredients-pagination {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 40px;
    position: relative;
    width: 100%;
  }

  .pagination-arrow {
    background: none;
    border: none;
    cursor: pointer;
    padding: 10px;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    color: #333;
    font-weight: 300;
  }

  .pagination-arrow:hover {
    color: #666;
  }

  .pagination-arrow:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .pagination-arrow:disabled:hover {
    color: #333;
  }

  .pagination-arrow#prevArrow {
    position: absolute;
    left: 0;
  }

  .pagination-arrow#nextArrow {
    position: absolute;
    right: 0;
  }

  .ingredients-pagination.hidden {
    display: none;
  }

  /* Usage Section Styles */
  .usage-content {
    width: 100%;
  }

  .usage-section {
    margin-bottom: 40px;
  }

  .usage-section h4 {
    text-transform: uppercase;
    font-size: 12px;
    color: #888;
    margin-bottom: 15px;
    text-align: left;
    font-family: 'PP Mori', sans-serif;
  }

  .usage-section p {
    font-size: 18px;
    line-height: 1.6;
    color: #333;
    font-family: 'PP Mori', sans-serif;
    font-weight: 600;
    margin: 0;
  }

  /* FAQ Styles */
  .faq-content {
    width: 100%;
  }

  .faq-header {
    text-transform: uppercase;
    font-size: 12px;
    color: #888;
    margin-bottom: 30px;
    text-align: left;
    font-family: 'PP Mori', sans-serif;
  }

  .faq-list {
    width: 100%;
  }

  .faq-item {
    width: 100%;
    border-bottom: 1px solid #ddd;
    padding: 20px 0;
  }

  .faq-item:last-child {
    border-bottom: none;
  }

  .faq-question {
    font-weight: 600;
    cursor: pointer;
    position: relative;
    padding-right: 30px;
    font-size: 18px;
    font-family: 'PP Mori', sans-serif;
    color: #333;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .faq-question::after {
    content: '+';
    font-size: 24px;
    font-weight: 300;
    color: #333;
  }

  .faq-item.open .faq-question::after {
    content: '–';
  }

  .faq-answer {
    display: none;
    padding-top: 15px;
    font-size: 16px;
    color: #666;
    font-family: 'PP Mori', sans-serif;
    line-height: 1.6;
  }

  .faq-item.open .faq-answer {
    display: block;
  }

  /* Special layout for FAQ tab - reverse order */
  #faq.tab-panel.active {
    display: flex;
    flex-wrap: wrap;
    flex-direction: row-reverse;
  }

  #faq .content-side {
    padding-left: 20px;
    padding-right: 90px;
  }

  /* Mobile Accordion Styles */
  .mobile-accordion {
    display: none;
    flex-direction: column;
    gap: 12px;
    margin: 20px 16px;
    padding: 0;
  }

  .mobile-accordion-item {
    border: none;
    margin-bottom: 0;
  }

  .mobile-accordion-header {
    background: #f7ff66;
    border: none;
    width: 100%;
    padding: 16px 20px;
    text-align: left;
    font-family: 'PP Mori', sans-serif;
    font-weight: 600;
    font-size: 16px;
    color: #000;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-radius: 30px;
    margin-bottom: 0;
    transition: all 0.3s ease;
    box-shadow: none;
    outline: none;
  }

  .mobile-accordion-header.active {
    background: #000;
    color: #fff;
  }

  .mobile-accordion-header::after {
    content: '▾'; /* chevron down */
    font-size: 18px;
    font-weight: 400;
    margin-left: auto;
    transition: transform 0.3s ease;
    color: #666;
    display: inline-block;
  }

  .mobile-accordion-header.active::after {
    transform: rotate(180deg);
    color: #fff;
  }

  .mobile-accordion-content {
    display: none;
    padding: 0;
    background: transparent;
    margin-bottom: 0;
    border: none;
  }

  .mobile-accordion-content.active {
    display: block;
  }

  .mobile-tab-content {
    padding: 20px 40px;
  }

  .mobile-tab-content .image-side {
    margin-bottom: 20px;
  }

  .mobile-tab-content .image-side img {
    width: 100%;
    max-width: 100%;
    height: auto;
    border-radius: 15px;
    object-fit: cover;
  }

  .mobile-tab-content .content-side {
    padding: 0;
  }

  @media (min-width: 1200px) {
    .tab-panel .content-side {
      flex: 1 1 52%;
      padding-right: 40px;
    }

    .tab-panel .image-side {
      flex: 1 1 43%;
    }

    #faq .content-side {
      padding-left: 40px;
      padding-right: 20px;
    }

    .icon-row {
      gap: 40px;
    }

    .icon-item span {
      font-size: 14px;
    }
  }

  @media (min-width: 1023px) and (max-width: 1199px) {
    .tab-panel .image-side {
      flex: 1 1 45%;
      min-width: 350px;
    }

    .tab-panel .content-side {
      flex: 1 1 50%;
      min-width: 350px;
      padding-left: 40px;
    }

    #faq .content-side {
      padding-left: 40px;
      padding-right: 20px;
    }

    .icon-row {
      gap: 30px;
    }

    .icon-item span {
      font-size: 14px;
    }
  }

  @media (max-width: 1023px) {
    .tab-nav {
      display: none;
    }

    .tab-panel {
      display: none;
    }

    .mobile-accordion {
      display: flex;
    }

    .tab-panel.active {
      flex-direction: column;
    }

    .tab-panel .image-side,
    .tab-panel .content-side {
      min-width: auto;
    }

    .two-column-section {
      flex-direction: column;
      gap: 20px;
    }

    .tab-panel .content-side {
      padding-right: 0;
      padding-left: 0;
      padding-top: 0;
    }

    #faq .content-side {
      padding-left: 0;
      padding-right: 0;
    }

    .icon-row {
      gap: 10px;
    }

    .icon-item {
      min-width: 0;
    }

    .icon-item img {
      width: 30px;
      height: 30px;
    }

    .icon-item span {
      font-size: 10px;
    }

    .ingredients-table {
      font-size: 12px;
    }

    .ingredients-table thead th,
    .ingredients-table tbody td {
      padding: 8px 5px;
    }

    .ingredients-table thead th:first-child {
      width: 45%;
    }

    .ingredients-table thead th:nth-child(2) {
      width: 25%;
    }

    .ingredients-table thead th:last-child {
      width: 30%;
    }

    .mobile-tab-content h4 {
      font-size: 12px;
      color: #888;
      text-transform: uppercase;
      margin-bottom: 10px;
      font-family: 'PP Mori', sans-serif;
    }

    .mobile-tab-content p {
      font-size: 16px;
      line-height: 1.5;
      margin-bottom: 20px;
      font-family: 'PP Mori', sans-serif;
      font-weight: 600;
    }

    .mobile-tab-content ul {
      padding-left: 20px;
      margin-bottom: 20px;
      font-family: 'PP Mori', sans-serif;
      font-weight: 600;
    }
    .tab-panel.active {
      display: none !important;
    }
    .icon-row {
      display: grid !important;
      grid-template-columns: 1fr 1fr !important;
      gap: 0 !important;
      border-top: 1px solid #ddd !important;
      border-bottom: 1px solid #ddd !important;
      margin-top: 25px !important;
    }

    .icon-item {
      text-align: center;
      padding: 25px 15px;
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      border-right: 1px solid #ddd;
      border-bottom: 1px solid #ddd;
      width: 100%;
      flex: none;
      font-family: 'PPMori Regular', sans-serif;
    }
    .icon-item:nth-child(n + 3) {
      border-bottom: 1px solid #ddd;
    }
    .icon-item:nth-child(2n) {
      border-bottom: 1px solid #ddd;
    }

    .icon-item img {
      width: 45px;
      height: 45px;
      object-fit: contain;
      margin-bottom: 12px;
      background: none;
      border-radius: 0;
      padding: 0;
    }

    .icon-item span {
      font-size: 12px;
      color: #333;
      margin: 0;
      font-family: 'PPMori Regular', sans-serif;
      line-height: 1.3;
      font-weight: 400;
    }
  }
</style>

<div class="product-tabs-wrapper">
  <div class="tab-nav">
    <button class="active" data-tab="about">About</button>
    <button data-tab="ingredients">Ingredients</button>
    <button data-tab="usage">Notes</button>
    <button data-tab="faq">FAQ's</button>
  </div>

  <div class="tab-panel active" id="about">
    <div class="image-side">
      {%- comment -%}
        Use metafield for about image with fallback to section settings
      {%- endcomment -%}
      {% if product.metafields.custom.about_image %}
        <img src="{{ product.metafields.custom.about_image | image_url }}" alt="About Image">
      {% elsif section.settings.about_image %}
        <img src="{{ section.settings.about_image | image_url }}" alt="About Image">
      {% else %}
        <img
          src="https://cdn.shopify.com/s/files/1/0680/4150/7113/files/perfume.jpg?v=1666767765"
          alt="Default About Image">
      {% endif %}
    </div>
    <div class="content-side">
      <h4>About the product</h4>

      {% assign about_mf = product.metafields.custom.about %}
      {% if about_mf != blank %}
        {% capture about_html %}{{ about_mf | metafield_tag }}{% endcapture %}
        {% assign paragraphs = about_html | split: "</p>" %}

        {% assign about_p1 = "" %}
        {% assign about_p2 = "" %}
        {% assign about_p3 = "" %}

        {% if paragraphs.size > 0 and paragraphs[0] != blank %}
          {% assign about_p1 = paragraphs[0] | append: "</p>" %}
        {% endif %}
        {% if paragraphs.size > 1 and paragraphs[1] != blank %}
          {% assign about_p2 = paragraphs[1] | append: "</p>" %}
        {% endif %}
        {% if paragraphs.size > 2 and paragraphs[2] != blank %}
          {% assign about_p3 = paragraphs[2] | append: "</p>" %}
        {% endif %}

        {% if about_p1 != "" %}
          {{ about_p1 }}
        {% endif %}

        {% if about_p2 != "" or about_p3 != "" %}
          <div class="two-column-section">
            {% if about_p2 != "" %}
              <div class="column">
                {{ about_p2 }}
              </div>
            {% endif %}
            {% if about_p3 != "" %}
              <div class="column">
                {{ about_p3 }}
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% else %}
        <p>
          A boost of antioxidant-rich nourishing renewal for dull, dry and tired skin. This super-absorbable oil helps
          clear dark spots & blemishes and creates a brighter complexion.
        </p>

        <div class="two-column-section">
          <div class="column">
            <h4>Recommended for</h4>
            <ul>
              <li>Dull Skin</li>
              <li>Hyper Pigmentation</li>
              <li>Uneven Skin Tone</li>
              <li>Excess Oil</li>
              <li>Enlarged Pores</li>
            </ul>
          </div>
          <div class="column">
            <h4>Suitable for</h4>
            <ul>
              <li>Unisex skin care for all Skin Types</li>
              <li>Pregnancy Safe</li>
            </ul>
          </div>
        </div>
      {% endif %}

      {%- comment -%}
        Use metafield for icon images with fallback to section settings
      {%- endcomment -%}
      <div class="icon-row">
        <div class="icon-item">
          {% if product.metafields.custom.icon_1_image %}
            <img src="{{ product.metafields.custom.icon_1_image | image_url }}" alt="Icon 1">
          {% elsif section.settings.icon_1 %}
            <img src="{{ section.settings.icon_1 | image_url }}" alt="Icon 1">
          {% endif %}
          <span>
            {% if product.metafields.custom.icon_1_text %}
              {{ product.metafields.custom.icon_1_text }}
            {% else %}
              {{ section.settings.icon_1_text }}
            {% endif %}
          </span>
        </div>
        <div class="icon-item">
          {% if product.metafields.custom.icon_2_image %}
            <img src="{{ product.metafields.custom.icon_2_image | image_url }}" alt="Icon 2">
          {% elsif section.settings.icon_2 %}
            <img src="{{ section.settings.icon_2 | image_url }}" alt="Icon 2">
          {% endif %}
          <span>
            {% if product.metafields.custom.icon_2_text %}
              {{ product.metafields.custom.icon_2_text }}
            {% else %}
              {{ section.settings.icon_2_text }}
            {% endif %}
          </span>
        </div>
        <div class="icon-item">
          {% if product.metafields.custom.icon_3_image %}
            <img src="{{ product.metafields.custom.icon_3_image | image_url }}" alt="Icon 3">
          {% elsif section.settings.icon_3 %}
            <img src="{{ section.settings.icon_3 | image_url }}" alt="Icon 3">
          {% endif %}
          <span>
            {% if product.metafields.custom.icon_3_text %}
              {{ product.metafields.custom.icon_3_text }}
            {% else %}
              {{ section.settings.icon_3_text }}
            {% endif %}
          </span>
        </div>
        <div class="icon-item">
          {% if product.metafields.custom.icon_4_image %}
            <img src="{{ product.metafields.custom.icon_4_image | image_url }}" alt="Icon 4">
          {% elsif section.settings.icon_4 %}
            <img src="{{ section.settings.icon_4 | image_url }}" alt="Icon 4">
          {% endif %}
          <span>
            {% if product.metafields.custom.icon_4_text %}
              {{ product.metafields.custom.icon_4_text }}
            {% else %}
              {{ section.settings.icon_4_text }}
            {% endif %}
          </span>
        </div>
        <div class="icon-item">
          {% if product.metafields.custom.icon_5_image %}
            <img src="{{ product.metafields.custom.icon_5_image | image_url }}" alt="Icon 4">
          {% elsif section.settings.icon_5 %}
            <img src="{{ section.settings.icon_5 | image_url }}" alt="Icon 5">
          {% endif %}
          <span>
            {% if product.metafields.custom.icon_5_text %}
              {{ product.metafields.custom.icon_5_text }}
            {% else %}
              {{ section.settings.icon_5_text }}
            {% endif %}
          </span>
        </div>
      </div>
    </div>
  </div>

