



{% render 'card--product-carousel' %}

<section class="bs-section">
    <div class="bs-container">
        <div class="bs-grid">
            <div class="bs-products-side">
                <div class="bs-heading">
                    <div class="bs-heading-content">
                        <h2 class="bs-title">{{ section.settings.section_title }}</h2>
                    </div>
                    <div class="bs-navigation">
                        <button class="bs-nav-arrow" id="prevBtn" onclick="navigateProducts(-1)">‹</button>
                        <span class="bs-nav-counter">
                            <span id="currentPage">1</span> / <span id="totalPages">1</span>
                        </span>
                        <button class="bs-nav-arrow" id="nextBtn" onclick="navigateProducts(1)">›</button>
                    </div>
                </div>
                        
                <div class="bs-products-grid" id="productsGrid">
                    <!-- Cards are rendered here via JavaScript -->
                </div>

                {% if section.settings.subheading %}
                    <div class="bs-subheading">
                        <p>{{ section.settings.subheading }}</p>
                    </div>
                {% endif %}
                        
                {% if section.settings.view_all_link != blank %}
                    <div style="text-align: center; margin-top: 0px;">
                        <a href="{{ section.settings.view_all_link }}" class="view-all-button" style="display: inline-block; padding: 16px 80px; background: #f4ff41; border-radius: 999px; text-decoration: none; color: #000; font-family: var(--font-body); font-weight: 500; text-transform: uppercase;">
                            {{ 'sections.product_list.view_all' | t }}
                        </a>
                    </div>
                {% endif %}
            </div>
                  
            <div class="bs-image-side">
                {% if section.settings.featured_image %}
                    <div class="bs-featured-image">
                        <img src="{{ section.settings.featured_image | image_url: width: 1200 }}" alt="{{ section.settings.featured_image.alt }}" loading="lazy">
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</section>

{%- comment -%} The collection's products, for the script below (each value as the script used to receive it) {%- endcomment -%}
{%- assign collection = collections[section.settings.collection] -%}
<script type="application/json" id="bestSellersProducts-{{ section.id }}">
  [
  {%- for product in collection.products %}
    {
      "id": {{ product.id }},
      "title": {{ product.title | escape | json }},
      "vendor": {{ product.vendor | escape | json }},
      "url": {{ product.url | json }},
      "featured_image": {{ product.featured_image | image_url: width: 600 | json }},
      "hover_image": {% if product.images.size > 1 %}{{ product.images[1] | image_url: width: 600 | json }}{% else %}null{% endif %},
      "tags": {{ product.tags | join: ',' | json }},
      "variants": [
      {%- for variant in product.variants %}
        {
          "id": {{ variant.id }},
          "title": {{ variant.title | escape | json }},
          "price": {{ variant.price | money | json }},
          "priceRaw": {{ variant.price }},
          "compareAtPrice": {{ variant.compare_at_price | default: 0 }},
          "available": {{ variant.available | json }},
          "availableInventory": {{ variant.inventory_quantity | default: 0 }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor %}
      ]
    }{% unless forloop.last %},{% endunless %}
  {%- endfor %}
  ]
</script>
{% # theme-check-disable ParserBlockingScript %}
<script src="{{ 'catalog--best-sellers.js' | asset_url }}" data-section-id="{{ section.id }}"></script>
{% # theme-check-enable ParserBlockingScript %}
{% schema %}
{
  "name": "Best Sellers Section",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Best Sellers"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "STAY GLOWING AND HEALTHY WITHOUT HAVING TO THINK ABOUT IT."
    },
    {
      "type": "image_picker",
      "id": "featured_image",
      "label": "Featured Image"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link"
    }
  ],
  "presets": [
    {
      "name": "Best Sellers Section"
    }
  ]
}
{% endschema %}
