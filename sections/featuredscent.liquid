<style>
/* Container */
.fragrance-container {
  max-width: 2100px;
  margin: 0 auto;
  padding: 0px 5rem;
  padding-bottom: 25px;
}

.fragrance-heading {
  font-family: 'PPMori Extralight', sans-serif;
  font-size: 46px;
  font-weight: 200;
  color: #808080;
  margin-bottom: 0px;
}

.fragrance-subtitle {
  font-family: 'PPEditorialNew Italic', serif;
  font-weight: 500;
  font-size: 45px;
  font-style: italic;
  position: relative;
  display: inline-block;
  padding-bottom: 15px;
  text-decoration: underline !important;
  text-decoration-color: #fadb95 !important;
  text-decoration-thickness: 2px !important;
  text-underline-offset: 2px !important;
}

/* Grid layout with 4 products per row, flexible sizing */
.fragrance-layout {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  margin-top: 40px;
  width: 100%;
}

/* Product card using flexbox column - NO absolute positioning */
.fragrance-item {
  display: flex;
  flex-direction: column;
  height: auto;
  width: 100%;
  border-radius: 8px;
  overflow: hidden;
  background-color: #F5F5F5;
}

/* Image wrapper - only this has hover effect */
.fragrance-image-wrap {
  position: relative;
  height: 390px !important;
  width: 100%;
  overflow: hidden;
  flex-shrink: 0;
}

.fragrance-image-wrap img {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  width: 100%;
  object-fit: cover;
  transition: opacity 0.4s ease;
}

.fragrance-image-wrap .secondary-image {
  opacity: 0;
  transition: opacity 0.4s ease;
}

/* Only image changes on hover - content stays static */
.fragrance-image-wrap:hover .secondary-image {
  opacity: 1;
}

/* Badges - positioned on image only */
.product-badges {
  position: relative !important;
  top: 12px;
  left: 12px;
  z-index: 0 !important;
  display: flex;
  flex-direction: column;
  gap: 6px;
  pointer-events: none;
}

/* Single badge */
.product-badge {
  color: #fff !important;
  font-family: 'PPMori Regular', sans-serif;
  font-weight: 400;
  font-size: 12px;
  padding: 4px 18px;
  border-radius: 20px;
  width: fit-content;
  white-space: nowrap;
  background: transparent; /* reset */
}

/* Men */
.product-badge.badge-men {
  background-color: #363745 !important;
}

/* Women */
.product-badge.badge-women {
  background-color: #79242f !important;
}

/* Unisex */
.product-badge.badge-unisex {
  background-color: #4e4a33 !important;
}

/* Coming Soon - Red with white text */
.product-badge.badge-coming-soon {
  background-color: #ff0000 !important;
  color: #fff !important;
}


/* Content section - grey background, flows naturally below image */
.fragrance-info {
  background-color: #F5F5F5;
  padding: 16px 12px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  width: 100%;
  flex: 1;
}

/* Stars - left aligned, NO hover effects */
.fragrance-rating {
  font-size: 24px;
  color: #cbdd00;
  letter-spacing: -2px;
  margin: 0;
  text-align: left;
  margin-top: -20px;
}

.rating-star.filled {
  color: #cbdd00;
}

.rating-star:not(.filled) {
  color: #E0E0E0;
}

/* Product title - left aligned, NO hover effects */
.fragrance-name {
  font-size: 16px;
  font-weight: 600;
  margin: 0;
  font-family: 'PPMori Regular', sans-serif;
  text-transform: uppercase;
  text-align: left;
  line-height: 1.3;
  color: #000;
  margin-top: -10px;
}

/* Vendor text - left aligned, NO hover effects */
.fragrance-brand {
  margin: 0;
  font-size: 12px;
  font-family: 'PPMori Regular', sans-serif;
  font-weight: 400;
  text-align: left;
  color: #666;
}

/* Price section */
.price-section {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 2px;
}

.product-price-display {
  font-size: 18px;
  font-weight: 600!important;
  color: #000;
  font-family: 'PPMori Regular', sans-serif;
}

.price-badge {
  background-color: #fa0000ff;
  color: white;
  font-size: 12px;
  font-weight: 600;
  padding: 2px 8px;
  border-radius: 3px;
  font-family: 'PPMori Regular', sans-serif;
}

.original-price {
  font-size: 12px;
  color: #000 !important;
  text-decoration: line-through;
  font-family: 'PPMori Regular', sans-serif;
  font-weight: 400;
}

/* Variant options */
.variant-options {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin: 4px 0 0 0;
}

.variant-option-btn {
  padding: 6px 16px !important;
  background-color: #fff;
  border: 1px solid #ddd;
  border-radius: 20px;
  font-size: 11px !important;
  cursor: pointer;
  font-family: 'PPMori Regular', sans-serif;
  transition: all 0.2s ease;
  color: #000;
  font-weight: 400;
}

.variant-option-btn.active {
  background-color: #f4ff41 !important;
  color: #000 !important;
  border-color: #000 !important;
}
.variant-option-btn.disabled {
  opacity: 0.4;
  cursor: not-allowed;
  text-decoration: line-through;
  pointer-events: none;
  background-color: #f5f5f5;
  border-color: #ccc;
}


/* Add to cart button */
.cart-button {
  margin-top: 8px;
  background: #f4ff41;
  color: #000;
  font-weight: 600;
  font-size: 12px !important;
  padding: 16px 16px !important;
  border-radius: 20px !important;
  cursor: pointer;
  border: none;
  width: 100%;
  font-family: 'PPMori Regular', sans-serif;
  transition: background 0.2s ease;
}

.cart-button:hover {
  background: #e0ea36;
}

.cart-button:disabled,
.cart-button.disabled {
  opacity: 0.5;
  cursor: not-allowed;
  background: #f4ff41 !important;
  color: #000 !important;
  text-transform: uppercase;
}

/* View All Button */
.show-all-btn {
  display: inline-block;
  padding: 16px 94px;
  background: #f4ff41;
  color: #000;
  font-weight: 500;
  font-size: 15px;
  border-radius: 999px;
  text-transform: uppercase;
  margin-top: 60px;
  text-decoration: none;
  text-align: center;
  font-family: 'PPMORI REGULAR';
}

.show-all-btn:hover {
  background: #e0ea36;
}

/* Mobile Styles - 2 products per row */
@media screen and (max-width: 990px) {
  .fragrance-container {
    margin: 0;
    padding: 0px 20px;
    padding-bottom: 25px;
  }

  .fragrance-heading {
    font-size: 32px;
    text-align: left;
    margin-bottom: 0px;
  }

  .fragrance-subtitle {
    font-size: 32px;
    text-align: left;
    display: block;
  }
  .product-badges {
    top: 5px;
    left: 5px;
  }
  /* 2 columns for mobile */
  .fragrance-layout {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 10px;
    gap: 10px !important;
  }

  /* Hide scrollbar */
  .fragrance-layout::-webkit-scrollbar {
    display: none;
  }
  .fragrance-layout {
    scrollbar-width: none;
  }

  /* Each product card width */
  .fragrance-item {
    min-width: 85%;
    scroll-snap-align: start;
    flex-shrink: 0;
  }
  .mobile-only {
    display: flex !important;
    justify-content: center;
    gap: 8px;
    margin-top: 16px;
  }

  .fragrance-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #dcdcdc;
    transition: background 0.3s ease;
  }

  .fragrance-dot.active {
    background: #f4ff41;
  }

  .fragrance-image-wrap {
    height: 280px;
  }

  .fragrance-info {
    padding: 12px 10px;
    gap: 6px;
  }

  .fragrance-name {
    font-size: 13px;
  }

  .fragrance-brand {
    font-size: 12px;
  }

  .product-price-display {
    font-size: 14px;
  }

  .variant-options {
    gap: 5px;
  }

  .variant-option-btn {
    padding: 5px 10px;
    font-size: 10px;
  }

  .cart-button {
    font-size: 12px;
    padding: 10px 12px;
  }

  .show-all-btn {
    padding: 16px 40px;
    font-size: 13px;
    margin-top: 40px;
  }
}
@media only screen and (min-width: 768px) and (max-width: 1024px) {
  .fragrance-brand {
    margin: 0;
    font-size: 14px;
    font-family: 'PPMori Regular', sans-serif;
    font-weight: 400;
    text-align: left;
    color: #666;
  }
  .fragrance-layout {
    padding: 0px 180px !important;
  }
}
</style>

<div class="fragrance-container">
  <h1 class="fragrance-heading">{{ section.settings.heading }}</h1>
  <div class="fragrance-subtitle">{{ section.settings.subheading }}</div>

  <div class="fragrance-carousel-wrapper">
    <div class="fragrance-layout" id="fragrance-carousel">
      {% assign products = collections[section.settings.collection].products %}
      {% for product in products limit: 4 %}
        <div class="fragrance-item product-card" data-product-id="{{ product.id }}">
          <!-- Badges -->
          
          <!-- Image with secondary image on hover -->
          <a href="{{ product.url }}" style="text-decoration: none; color: inherit;">
            <div class="fragrance-image-wrap">
              <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title }}">
              {% if product.images.size > 1 %}
                <img class="secondary-image" src="{{ product.images[1] | image_url: width: 600 }}" alt="{{ product.title }}">
              {% endif %}
              <div class="product-badges">
  {% for tag in product.tags %}
    {% if tag == 'men' or tag == 'Men' %}
      <span class="product-badge badge-men">Men</span>
      {% break %}
    {% elsif tag == 'women' or tag == 'Women' %}
      <span class="product-badge badge-women">Women</span>
      {% break %}
    {% elsif tag == 'unisex' or tag == 'Unisex' %}
      <span class="product-badge badge-unisex">Unisex</span>
      {% break %}
    {% endif %}
  {% endfor %}
</div>
            </div>
          </a>

          <!-- Content section - grey background, NO hover effects -->
          <div class="fragrance-info">
            <!-- Coming Soon badge - shows when all variants are out of stock -->
            {% assign all_variants_out_of_stock = true %}
            {% for variant in product.variants %}
              {% if variant.available and variant.inventory_quantity > 0 %}
                {% assign all_variants_out_of_stock = false %}
                {% break %}
              {% endif %}
            {% endfor %}
            

            <!-- Product Title -->
            <a href="{{ product.url }}" style="text-decoration: none; color: inherit;">
            <div class="fragrance-name">{{ product.title }}</div>
             </a>
            <!-- Inspired by (Vendor) -->
            <div class="fragrance-brand">
              {{ product.vendor }}
            </div>

            <!-- Price section with discount -->
            <!-- Price section with discount -->
<div class="price-section">
  {% assign variant = product.variants.first %}
  
  <span class="product-price-display" data-price-display data-product-id="{{ product.id }}">
    {{ variant.price | money }}
  </span>
  
  {% if variant.compare_at_price and variant.compare_at_price > variant.price %}
  <span class="original-price" data-compare-price>
    {{ variant.compare_at_price | money }}
  </span>
  <span class="price-badge" data-sale-badge>Sale</span>
{% endif %}
</div>

  <!-- Variant options -->
  <form method="post" action="/cart/add" class="item-form" data-product-id="{{ product.id }}">
  {% if product.variants.size > 1 %}
  <div class="variant-options" data-variant-options>
  {% for variant in product.variants %}
  <!-- Added data-inventory attribute to track stock levels -->
  <button
  type="button"
  class="variant-option-btn"
  data-variant-id="{{ variant.id }}"
  data-variant-price="{{ variant.price }}"
  data-variant-compare="{{ variant.compare_at_price }}"
  data-available="{{ variant.available }}"
  data-inventory="{{ variant.inventory_quantity }}"
  >
  {{ variant.title }}
  </button>
  {% endfor %}
  </div>
                <!-- Store first available variant in hidden input for form submission -->
                {% assign first_available_variant = product.selected_or_first_available_variant %}
<input
  type="hidden"
  name="id"
  class="variant-id-input"
  value="{{ first_available_variant.id }}"
>
              {% else %}
                <input type="hidden" name="id" value="{{ product.variants.first.id }}">
              {% endif %}

              <!-- Add to cart button -->
              <button type="submit" class="cart-button">ADD TO CART</button>
            </form>
          </div>
        </div>
      {% endfor %}
    </div>
      <div class="fragrance-dots mobile-only">
    {% for product in products limit: 4 %}
      <span class="fragrance-dot {% if forloop.first %}active{% endif %}"></span>
    {% endfor %}
  </div>
  </div>

  {% if section.settings.view_all_link != blank %}
    <div style="text-align: center;">
      <a href="{{ section.settings.view_all_link }}" class="show-all-btn">
        View All Products
      </a>
    </div>
  {% endif %}
</div>

<script>
document.addEventListener("DOMContentLoaded", () => {
  function updateVariantAvailability() {
    // Update all product cards
    document.querySelectorAll(".fragrance-container .fragrance-item").forEach((card) => {
      const variantBtns = card.querySelectorAll(".variant-option-btn")
      const cartBtn = card.querySelector(".cart-button")
      let hasAvailableVariant = false

      variantBtns.forEach((btn) => {
        const isAvailable = btn.dataset.available === "true"
        const inventory = parseInt(btn.dataset.inventory || "0", 10)
        
        // Disable only based on Shopify backend inventory, not cart
        const shouldDisable = !isAvailable || inventory <= 0

        if (shouldDisable) {
          btn.classList.add("disabled")
        } else {
          btn.classList.remove("disabled")
          hasAvailableVariant = true
        }
      })

      // Disable cart button if no variants available
      if (cartBtn) {
        if (hasAvailableVariant) {
          cartBtn.disabled = false
          cartBtn.classList.remove("disabled")
        } else {
          cartBtn.disabled = true
          cartBtn.classList.add("disabled")
          cartBtn.innerHTML = "SOLD OUT"
        }
      }
    })
  }

  updateVariantAvailability()

  setInterval(updateVariantAvailability, 1000)

  // Handle variant selection - using Shopify backend inventory only
  document.querySelectorAll(".fragrance-container .fragrance-item").forEach((card) => {
    const form = card.querySelector(".item-form");
    if (!form) return;
    const variantBtns = card.querySelectorAll(".variant-option-btn");
    const priceDisplay = card.querySelector("[data-price-display]");
    const variantIdInput = form.querySelector(".variant-id-input");

    let firstAvailableBtn = null;

    variantBtns.forEach((btn) => {
      const isAvailable = btn.dataset.available === "true";
      const inventory = parseInt(btn.dataset.inventory || "0", 10);
      
      // Disable based on Shopify backend inventory only
      const shouldDisable = !isAvailable || inventory <= 0;

      if (shouldDisable) {
        btn.classList.add("disabled");
        return;
      }

      if (!firstAvailableBtn) {
        firstAvailableBtn = btn;
      }

      btn.addEventListener("click", (e) => {
        e.preventDefault();

        variantBtns.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");

        if (variantIdInput) {
          variantIdInput.value = btn.dataset.variantId;
        }

        const variantPrice = parseInt(btn.dataset.variantPrice, 10);
        const comparePrice = parseInt(btn.dataset.variantCompare, 10);

        if (priceDisplay && variantPrice) {
          priceDisplay.textContent = "$" + (variantPrice / 100).toFixed(2);
        }

        let compareEl = card.querySelector("[data-compare-price]");
        let badgeEl = card.querySelector("[data-sale-badge]");

        if (comparePrice && comparePrice > variantPrice) {
          if (!compareEl) {
            compareEl = document.createElement("span");
            compareEl.className = "original-price";
            compareEl.setAttribute("data-compare-price", "");
            priceDisplay.after(compareEl);
          }

          compareEl.textContent = "$" + (comparePrice / 100).toFixed(2);

          if (!badgeEl) {
            badgeEl = document.createElement("span");
            badgeEl.className = "price-badge";
            badgeEl.setAttribute("data-sale-badge", "");
            badgeEl.textContent = "Sale";
            compareEl.after(badgeEl);
          }
        } else {
          if (compareEl) compareEl.remove();
          if (badgeEl) badgeEl.remove();
        }
      });
    });

    if (firstAvailableBtn) {
      firstAvailableBtn.classList.add("active");
      if (variantIdInput) {
        variantIdInput.value = firstAvailableBtn.dataset.variantId;
      }

      if (priceDisplay) {
        const price = parseInt(firstAvailableBtn.dataset.variantPrice, 10);
        const compare = parseInt(firstAvailableBtn.dataset.variantCompare, 10);

        priceDisplay.textContent = "$" + (price / 100).toFixed(2);

        // Trigger compare-at logic
        firstAvailableBtn.click();
      }
    }
  });

  // Handle add to cart
  document.querySelectorAll(".fragrance-container .item-form").forEach((form) => {
    let isSubmitting = false;

    form.addEventListener("submit", (e) => {
      e.preventDefault();

      if (isSubmitting) return;

      const submitBtn = form.querySelector(".cart-button");
      if (!submitBtn) return;
      const variantIdInput = form.querySelector('input[name="id"]');
      const variantId = variantIdInput ? variantIdInput.value : null;

      if (!variantId) {
        alert("Please select a variant");
        return;
      }

      isSubmitting = true;
      submitBtn.disabled = true;
      submitBtn.innerHTML = "Adding...";

      fetch("/cart/add.js", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
        },
        body: JSON.stringify({ id: variantId, quantity: 1 }),
      })
        .then((res) => {
          if (!res.ok) throw new Error("Failed to add to cart");
          return res.json();
        })
        .then(() => {
          submitBtn.innerHTML = "ADDED!";
          updateVariantAvailability();
          return fetch('/cart.js');
        })
        .then((cartRes) => {
          if (!cartRes.ok) throw new Error("Failed to fetch cart");
          return cartRes.json();
        })
        .then((cartData) => {
          if (typeof window.updateDossierCartUI === 'function') {
            window.updateDossierCartUI(cartData);
          }
          if (typeof window.openDossierCart === 'function') {
            window.openDossierCart();
          }

          setTimeout(() => {
            submitBtn.disabled = false;
            submitBtn.innerHTML = "ADD TO CART";
            isSubmitting = false;
          }, 2000);
        })
        .catch((err) => {
          console.error("Add to cart error:", err);
          submitBtn.disabled = false;
          submitBtn.innerHTML = "ADD TO CART";
          isSubmitting = false;
        });
    });
  });

  // Mobile swipe pagination dots
  const layout = document.querySelector(".fragrance-layout");
  const dots = document.querySelectorAll(".fragrance-dot");

  if (layout && dots.length) {
    layout.addEventListener("scroll", () => {
      const firstCard = layout.querySelector(".fragrance-item");
      const cardWidth = (firstCard ? firstCard.offsetWidth : 300) + 12;
      const index = Math.round(layout.scrollLeft / cardWidth);

      dots.forEach((dot) => dot.classList.remove("active"));
      if (dots[index]) dots[index].classList.add("active");
    });
  }
})

</script>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Collection"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Premium Scents"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Button Link"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
