{% schema %}
{
  "name": "Newsletter Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Hear More"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "From Us"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Get the latest news about skincare tips and new products."
    }
  ],
  "presets": [
    {
      "name": "Newsletter Banner",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}

