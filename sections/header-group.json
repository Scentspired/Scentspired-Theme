/*
 * Section group layout, shared by every region: structure and design only.
 * Its words, images, links and lists are each region's regions/<id>/content/header-group.json:
 *   "@content:<page>.<path>"   a value from that file
 *   "@shown": "<path>"         the section appears where that file says "shown": true
 *   "@list:<page>.<path>"      one block per item of that list, styled by "block_designs"
 * The build fills these in (scripts/compile-region.cjs). Edit design here, content there.
 */
{
  "name": "t:sections.header.name",
  "type": "header",
  "sections": {
    "announcement-bar": {
      "type": "core--announcement-bar",
      "settings": {
        "auto_rotate": false,
        "change_slides_speed": 5,
        "color_scheme": "",
        "show_line_separator": true,
        "show_social": false,
        "enable_country_selector": false,
        "enable_language_selector": false
      },
      "custom_css": [
        ".announcement-bar {padding-top: 1px; padding-bottom: 0px; margin-bottom: 0px;}",
        ".announcement-bar__message {line-height: 0.2; font-size: 12px; /* optional: adjust text size */ font-weight: 400;}",
        "@media only screen and (max-width: 767px) {.announcement-bar__message {line-height: 01.6; font-size: 8px; }}"
      ],
      "blocks": {
        "announcement_EiQRND": {
          "type": "announcement",
          "settings": {
            "text": "@content:header-group.announcement_bar.announcement.text",
            "link": "@content:header-group.announcement_bar.announcement.link"
          }
        }
      },
      "block_order": [
        "announcement_EiQRND"
      ]
    },
    "header": {
      "type": "header--main",
      "settings": {
        "logo_position": "middle-left",
        "mobile_logo_position": "center",
        "menu": "@content:header-group.header.menu",
        "menu_type_desktop": "dropdown",
        "sticky_header_type": "on-scroll-up",
        "show_line_separator": false,
        "color_scheme": "scheme-2",
        "menu_color_scheme": "",
        "enable_country_selector": false,
        "enable_language_selector": false,
        "enable_customer_avatar": false,
        "margin_bottom": 0,
        "padding_top": 36,
        "padding_bottom": 0
      },
      "custom_css": [
        ".header {position: absolute; max-width: 2100px; width: 100%; z-index: 1000;}",
        "@media only screen and (min-width: 1440px) {.header__inline-menu {padding-left: 300px !important; }}",
        "@media only screen and (min-width: 1251px) and (max-width: 1329px) {.header__inline-menu {padding-left: 70px !important; }}",
        "@media only screen and (min-width: 1440px) and (max-width: 1510px) {.header__inline-menu {padding-left: 163px !important; }}",
        "@media only screen and (min-width: 1330px) and (max-width: 1439px) {.header__inline-menu {padding-left: 110px !important; }}"
      ]
    }
  },
  "order": [
    "announcement-bar",
    "header"
  ]
}
