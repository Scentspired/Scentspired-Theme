{% schema %}
{
  "name": "Scent Video Banner",
  "settings": [
    {
      "type": "text",
      "id": "video_url",
      "label": "Video file URL (.mp4)"
    },
    {
      "type": "text",
      "id": "brands_label",
      "label": "Brands heading",
      "default": "Brands"
    },
    {
      "type": "text",
      "id": "notes_label",
      "label": "Notes heading",
      "default": "Notes"
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Shop button link"
        }
      ]
    },
    {
      "type": "note",
      "name": "Note",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Shop button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scent Families Video Banner",
      "category": "Custom"
    }
  ]
}
{% endschema %}


{% render 'card--product-carousel' %}

<div class="scent-video-banner" id="scent-video-banner">
  <div class="video-container">
    <video id="main-video" autoplay muted loop playsinline style="filter: brightness(40%);">
      <source src="{{ section.settings.video_url }}" type="video/mp4">
    </video>

    <div class="scent-content">
      <div class="scent-left">
        {%- liquid
          assign brand_blocks = section.blocks | where: 'type', 'brand'
          assign note_blocks = section.blocks | where: 'type', 'note'
        -%}
        <p class="scent-label">{{ 'sections.scent_banner.inspired_by' | t }}</p>

        <!-- Added main category headings (Brands and Notes) -->
        <div class="main-headings-container">
          <h2 class="main-heading active-main" data-category="brands">{{ section.settings.brands_label }}</h2>
          <h2 class="main-heading" data-category="notes">{{ section.settings.notes_label }}</h2>
        </div>

        <!-- Brands inner headings -->
        <div class="inner-headings-group" data-category="brands" style="display: block;">
          {%- for block in brand_blocks %}
          <p class="scent-heading heading-{{ forloop.index }} clickable-heading{% if forloop.index == 3 %} active-heading{% endif %}" data-index="{{ forloop.index }}" data-collection="brand_collection_{{ forloop.index }}" {{ block.shopify_attributes }}>
            {{ block.settings.heading }}
          </p>
          {%- endfor %}
        </div>

        <!-- Notes inner headings -->
        <div class="inner-headings-group" data-category="notes" style="display: none;">
          {%- for block in note_blocks %}
          <p class="scent-heading heading-{{ forloop.index }} clickable-heading{% if forloop.index == 3 %} active-heading{% endif %}" data-index="{{ forloop.index0 }}" data-collection="notes_collection_{{ forloop.index }}" {{ block.shopify_attributes }}>
            {{ block.settings.heading }}
          </p>
          {%- endfor %}
        </div>
      </div>
      <div class="scent-right">
        <div class="products-container">
          <div class="product-nav">
            <button class="nav-btn prev-btn" id="prevBtn">‹</button>
            <button class="nav-btn next-btn" id="nextBtn">›</button>
          </div>

          <div class="products-display" id="productsDisplay"></div>

          <div class="pagination-dots" id="paginationDots"></div>

          <div class="shop-button-container">
            <a href="#" class="shop-button" id="shopButton">
              <span id="shopButtonText" data-label="{{ 'sections.scent_banner.shop_now' | t }}">{{ 'sections.scent_banner.shop_now' | t }}</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<script type="application/json" id="themeButtonUrls">
  {
    {%- for block in brand_blocks %}
    "brand_{{ forloop.index }}": "{{ block.settings.button_url }}",
    {%- endfor %}
    {%- for block in note_blocks %}
    "notes_{{ forloop.index }}": "{{ block.settings.button_url }}"{% unless forloop.last %},{% endunless %}
    {%- endfor %}
  }
</script>
<!-- Updated product data to include both brands and notes collections -->
<script type="application/json" id="productData">
  {
    {% for block in brand_blocks %}
      {% assign brand_collection = collections[block.settings.collection] %}
      "brand_collection_{{ forloop.index }}": [
        {% for product in brand_collection.products limit: 6 %}
          {
            "id": {{ product.id }},
            "title": {{ product.title | json }},
            "price": "{{ product.price | money }}",
            "vendor": {{ product.vendor | json }},
            "url": "{{ product.url }}",
            "image": "{{ product.featured_image | image_url: width: 600 }}",
            "hover_image": "{% if product.images.size > 1 %}{{ product.images[1] | image_url: width: 600 }}{% endif %}",
            "tags": {{ product.tags | json }},
            "variants": [
              {% for variant in product.variants %}
                {
                  "id": {{ variant.id }},
                  "title": {{ variant.title | json }},
                  "price": "{{ variant.price | money }}",
                  "priceRaw": {{ variant.price }},
                  "compareAtPrice": {{ variant.compare_at_price | default: 0 }},
                  "available": {{ variant.available | json }},
                  "availableInventory": {{ variant.inventory_quantity | default: 0 }}
                }{% unless forloop.last %},{% endunless %}
              {% endfor %}
            ],
            "handle": "{{ brand_collection.handle }}"
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]{% unless forloop.last %},{% endunless %}
    {% endfor %}
    ,
    {% for block in note_blocks %}
      {% assign notes_collection = collections[block.settings.collection] %}
      "notes_collection_{{ forloop.index }}": [
        {% for product in notes_collection.products limit: 6 %}
          {
            "id": {{ product.id }},
            "title": {{ product.title | json }},
            "price": "{{ product.price | money }}",
            "vendor": {{ product.vendor | json }},
            "url": "{{ product.url }}",
            "image": "{{ product.featured_image | image_url: width: 600 }}",
            "hover_image": "{% if product.images.size > 1 %}{{ product.images[1] | image_url: width: 600 }}{% endif %}",
            "tags": {{ product.tags | json }},
            "variants": [
              {% for variant in product.variants %}
                {
                  "id": {{ variant.id }},
                  "title": {{ variant.title | json }},
                  "price": "{{ variant.price | money }}",
                  "priceRaw": {{ variant.price }},
                  "compareAtPrice": {{ variant.compare_at_price | default: 0 }},
                  "available": {{ variant.available | json }},
                  "availableInventory": {{ variant.inventory_quantity | default: 0 }}
                }{% unless forloop.last %},{% endunless %}
              {% endfor %}
            ],
            "handle": "{{ notes_collection.handle }}"
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]{% unless forloop.last %},{% endunless %}
    {% endfor %}
  }
</script>

<script src="{{ 'media--scent-filter-banner.js' | asset_url }}"></script>

{{ 'media--scent-filter-banner.css' | asset_url | stylesheet_tag }}
