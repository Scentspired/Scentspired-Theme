{{ 'social--instagram-grid.css' | asset_url | stylesheet_tag }}


<div
  class="ai-instagram-grid"
  style="--instagram-gap-desktop: {{ section.settings.gap_desktop }}px; --instagram-gap-tablet: {{ section.settings.gap_tablet }}px; --instagram-gap-mobile: {{ section.settings.gap_mobile }}px; --instagram-padding-vertical: {{ section.settings.padding_vertical }}px; --instagram-padding-horizontal: {{ section.settings.padding_horizontal }}px; --instagram-padding-vertical-mobile: {{ section.settings.padding_vertical_mobile }}px; --instagram-padding-horizontal-mobile: {{ section.settings.padding_horizontal_mobile }}px; --instagram-border-radius: {{ section.settings.border_radius }}px;">
  {% for block in section.blocks %}
    {% assign image = block.settings.image %}
    <div
      class="ai-instagram-item"
      style="--instagram-item-delay: {{ forloop.index0 | times: 0.5 }}s;"
      {{ block.shopify_attributes }}>
      {% if section.settings.instagram_url != blank %}
        <a
          href="{{ section.settings.instagram_url }}"
          class="ai-instagram-link"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="{{ 'sections.instagram_grid.profile_link' | t }}">
      {% endif %}

      {% if image %}
        <img
          src="{{ image | image_url: width: 400 }}"
          alt="{{ image.alt | escape }}"
          class="ai-instagram-image"
          loading="lazy"
          width="400"
          height="400">
      {% else %}
        <div class="ai-instagram-placeholder">
          {{ "image" | placeholder_svg_tag }}
          <div class="ai-instagram-empty-state">{{ 'sections.instagram_grid.add_image' | t: number: forloop.index }}</div>
        </div>
      {% endif -%}
      {%- if section.settings.instagram_url != blank %}
        </a>
      {% endif %}
    </div>
  {% endfor %}
</div>

{% schema %}
{
  "name": "Instagram grid",
  "settings": [
    {
      "type": "header",
      "content": "Instagram link"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram profile URL"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "min": 5,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Gap on desktop",
      "default": 15
    },
    {
      "type": "range",
      "id": "gap_tablet",
      "min": 5,
      "max": 40,
      "step": 5,
      "unit": "px",
      "label": "Gap on tablet",
      "default": 10
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "min": 5,
      "max": 30,
      "step": 5,
      "unit": "px",
      "label": "Gap on mobile",
      "default": 10
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Image border radius",
      "default": 8
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Vertical padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_vertical_mobile",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Vertical padding on mobile",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_horizontal_mobile",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Horizontal padding on mobile",
      "default": 15
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram grid"
    }
  ]
}
{% endschema %}
