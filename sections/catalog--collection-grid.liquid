            <input type="checkbox" class="filter-range" data-min="0" data-max="50" data-variant-index="0">
            0 – 25{{ cart.currency.symbol | default: '$' }} </label
          ><br>
          <label>
            <input type="checkbox" class="filter-size" value="100ml" data-variant-index="1">
            25 – 50{{ cart.currency.symbol | default: '$' }}
          </label>
        </div>
      </details>

      <details>
        <summary>Size</summary>
