{{ 'catalog--collection-grid.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Words, links and lists come from the region's content/collection-grid.json
  (shared by every collection page); interface wording from the locale
  (sections.collection_grid).
{%- endcomment -%}
{%- liquid
  capture grid_intro
    render 'region--content', key: 'collection-grid.intro'
  endcapture
  capture season_collections_heading
    render 'region--content', key: 'collection-grid.season_collections_heading'
  endcapture
  capture scent_notes_heading
    render 'region--content', key: 'collection-grid.scent_notes_heading'
  endcapture
-%}

{% comment %} ========== HTML STRUCTURE ========== {% endcomment %}
<div class="scent-wrapper">
  {% comment %} ========== HEADER SECTION ========== {% endcomment %}
  <div class="scent-header-content-wrapper" id="headerContentWrapper">
    {% comment %} Title Row {% endcomment %}
    <div class="scent-title-row">
      <h1 class="scent-main-title">
        {% assign words = collection.title | split: " " %}

        {% if words.size > 2 %}
          <span class="small-text">
            {{ words[0] }}
            {{ words[1] }}
          </span>

          <span class="large-text">
            {% for word in words offset: 2 %}
              {{ word -}}
              {%- unless forloop.last %} {% endunless %}
            {% endfor %}
          </span>
        {% else %}
          <span class="large-text">{{ collection.title }}</span>
        {% endif %}
      </h1>

      <p class="scent-sub-description">
        {{ grid_intro }}
      </p>
    </div>

    {% comment %} Collection Navigation {% endcomment %}
    <div class="scent-collection-nav">
      {%- capture link_keys -%}{%- render 'region--content', key: 'collection-grid.collection_links.__keys' -%}{%- endcapture -%}
      {%- assign link_keys = link_keys | strip | split: ',' -%}
      {%- for i in link_keys -%}
        {%- liquid
          assign k = 'collection-grid.collection_links.' | append: i | append: '.label'
          capture link_label
            render 'region--content', key: k
          endcapture
          assign k = 'collection-grid.collection_links.' | append: i | append: '.url'
          capture link_url
            render 'region--content', key: k
          endcapture
        -%}
        <a href="{{ link_url }}">{{ link_label }}</a>
      {% endfor %}

      {% comment %} Desktop Filter Button {% endcomment %}
      <button class="filter-toggle-desktop" id="filterToggleDesktop">
        <span id="filterToggleTextDesktop">{{ 'sections.collection_grid.show_filters_html' | t }}</span>
        <span id="filterCountDesktop">(0)</span>
        <svg
          id="filterToggleIconDesktop"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round">
          <path d="m18 15-6-6-6 6"/>
        </svg>
      </button>

      {% comment %} Original Filter Button {% endcomment %}
      <button class="filter-toggle-button" id="filterToggleButton">
        <span id="filterToggleText">{{ 'sections.collection_grid.hide_filters_html' | t }}</span>
        <span id="filterCount">(0)</span>
        <svg
          id="filterToggleIcon"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round">
          <path d="m18 15-6-6-6 6"/>
        </svg>
      </button>
    </div>

    {% comment %} ========== SEARCH AREA ========== {% endcomment %}
    <div class="scent-search-area">
      {% comment %} Initial Search Bar {% endcomment %}
      <div class="scent-search-background" id="initialSearchBar">
        <div class="scent-search-input-wrapper">
          <input
            type="text"
            placeholder="{{ 'sections.collection_grid.search_placeholder' | t }}"
            class="scent-search-input"
            id="mainSearchInput">
        </div>

        <div class="scent-search-tags">
          {%- render 'catalog--search-tags', list: 'collection-grid.search_bar_tags' %}
        </div>

        <span class="scent-search-tag-add" id="openSearchFromPlus">
          <svg class="chevron-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </div>

      {% comment %} Expanded Search Overlay {% endcomment %}
      <div class="scent-search-expanded-overlay" id="searchExpandedOverlay">
        {% comment %} Overlay Header {% endcomment %}
        <div class="scent-overlay-header">
          <div class="scent-overlay-search-input-wrapper">
            <input
              type="text"
              placeholder="{{ 'sections.collection_grid.search_placeholder' | t }}"
              class="scent-overlay-search-input"
              id="overlaySearchInput">
            <button class="scent-overlay-search-button" id="overlaySearchButton">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-search">
                <circle cx="11" cy="11" r="8"/>
                <path d="m21 21-4.3-4.3"/>
              </svg>
            </button>
          </div>
          <button class="scent-overlay-close-button" id="closeSearchOverlay">✕</button>
        </div>

        {% comment %} Search Results Container {% endcomment %}
        <div class="scent-overlay-search-results-container">
          <!-- Dynamic search results will be inserted here by JavaScript -->
        </div>

        {% comment %} Recent Searches Section {% endcomment %}
        <div class="scent-overlay-section scent-overlay-recent-searches">
          <div class="scent-overlay-section-title">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="lucide lucide-history">
              <path d="M12 8v4l2 2"/>
              <circle cx="12" cy="12" r="10"/>
            </svg>
            {{ 'sections.collection_grid.recent_searches' | t }}
          </div>
          <div class="scent-overlay-tags-grid" id="recentSearchesGrid">
            <!-- Dynamic recent search tags will be inserted here by JavaScript -->
          </div>
        </div>

        {% comment %} Trending Search Section {% endcomment %}
        <div class="scent-overlay-section">
          <div class="scent-overlay-section-title">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="lucide lucide-trending-up">
              <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/>
              <polyline points="16 7 22 7 22 13"/>
            </svg>
            {{ 'sections.collection_grid.trending_searches' | t }}
          </div>
          <div class="scent-overlay-tags-grid">
            {%- render 'catalog--search-tags', list: 'collection-grid.trending_searches' %}
          </div>
        </div>

        {% comment %} Inspired by Brands Section {% endcomment %}
        <div class="scent-overlay-section">
          <div class="scent-overlay-section-title">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="lucide lucide-shopping-bag">
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
              <path d="M3 6h18"/>
              <path d="M16 10a4 4 0 0 1-8 0"/>
            </svg>
            {{ season_collections_heading }}
          </div>
          <div class="scent-overlay-brands-grid">
            {% assign brand_collection_handles = section.settings.brand_collection_handles | split: "," %}
            {% for handle in brand_collection_handles limit: 4 %}
              {% assign brand_collection = collections[handle] %}
              {% if brand_collection %}
                <a href="{{ brand_collection.url }}" class="scent-overlay-collection-link">
                  <div class="scent-overlay-collection-content">
                    {% if brand_collection.featured_image %}
                      <img
                        src="{{ brand_collection.featured_image | image_url: width: 400 }}"
                        alt="{{ brand_collection.title }}">
                    {% else %}
                      <div class="scent-overlay-no-image">
                        <span>{{ 'sections.collection_grid.no_image' | t }}</span>
                      </div>
                    {% endif %}
                    <span class="col-button">{{ brand_collection.title }}</span>
                  </div>
                </a>
              {% endif %}
            {% endfor %}
          </div>
        </div>

        {% comment %} Scent Notes Section {% endcomment %}
        <div class="scent-overlay-section" style="display: none;">
          <div class="scent-overlay-section-title">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="lucide lucide-flask-conical">
              <path d="M10 16.5V22h4v-5.5"/>
              <path d="M14 9.5V2h-4v7.5"/>
              <path d="M8.5 2h7L12 7.5 8.5 2Z"/>
              <path d="M12 7.5v9"/>
              <path d="M3 15h18"/>
            </svg>
            {{ scent_notes_heading }}
          </div>
          <div class="scent-overlay-scent-notes-grid">
            {% assign scent_collection_handles = section.settings.scent_collection_handles | split: "," %}
            {% for handle in scent_collection_handles limit: 4 %}
              {% assign scent_collection = collections[handle] %}
              {% if scent_collection %}
                <a href="{{ scent_collection.url }}" class="scent-overlay-collection-link">
                  <div class="scent-overlay-collection-content">
                    {% if scent_collection.featured_image %}
                      <img
                        src="{{ scent_collection.featured_image | image_url: width: 400 }}"
                        alt="{{ scent_collection.title }}">
                    {% else %}
                      <div class="scent-overlay-no-image">
                        <span>{{ 'sections.collection_grid.no_image' | t }}</span>
                      </div>
                    {% endif %}
                    <span class="scent-overlay-collection-title-on-image">{{ scent_collection.title }}</span>
                  </div>
                </a>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
    </div>

    {% comment %} ========== NEW MOBILE PRODUCT PER ROW SELECTOR ========== {% endcomment %}
    <div class="mobile-product-per-row-selector" id="mobileProductPerRowSelector">
      <div class="selector-label">{{ 'sections.collection_grid.products_per_row' | t }}</div>
      <div class="selector-buttons">
        <button class="selector-button active" data-columns="1">1</button>
        <button class="selector-button" data-columns="2">2</button>
      </div>
    </div>
  </div>

  {% comment %} ========== MAIN LAYOUT SECTION ========== {% endcomment %}
  <div class="scent-layout sidebar-hidden" id="scentLayout">
    {% comment %} ========== SIDEBAR ========== {% endcomment %}
    <div class="scent-sidebar" id="scentSidebar">
      <h3 style="font-family: var(--font-mori-alt); font-size: 14px; margin-bottom: 20px;">{{ 'sections.collection_grid.filters' | t }}</h3>

      {% comment %} Price Range Filter {% endcomment %}
      <details>
        <summary>{{ 'sections.collection_grid.filter_price' | t }}</summary>
        <div style="padding-left: 10px; margin-top: 6px;">
          <label>
            <input type="checkbox" class="filter-range" data-min="0" data-max="50" data-variant-index="0">
            0 – 25{{ cart.currency.symbol | default: '$' }} </label
          ><br>
          <label>
            <input type="checkbox" class="filter-size" value="100ml" data-variant-index="1">
            25 – 50{{ cart.currency.symbol | default: '$' }}
          </label>
        </div>
      </details>

      <details>
        <summary>{{ 'sections.collection_grid.filter_size' | t }}</summary>
        <div style="padding-left: 10px; margin-top: 6px;">
          {%- render 'catalog--filter-options', list: 'collection-grid.filters.sizes', input_class: 'filter-size', variant_index: true %}
        </div>
      </details>
      {% comment %} Gender Filter {% endcomment %}
      <details>
        <summary>{{ 'sections.collection_grid.filter_gender' | t }}</summary>
        <div style="padding-left: 10px; margin-top: 6px;">
          {%- render 'catalog--filter-options', list: 'collection-grid.filters.genders', input_class: 'filter-gender' %}
        </div>
      </details>

      <details>
        <summary>{{ 'sections.collection_grid.filter_scent_families' | t }}</summary>
        <div style="padding-left: 10px; margin-top: 6px;">
          {%- render 'catalog--filter-options', list: 'collection-grid.filters.scent_families', input_class: 'filter-type' %}
        </div>
      </details>

      {% comment %} Inspired By Filter {% endcomment %}
      <details style="padding-left: 10px; margin-top: 6px; display: none;">
        <summary>{{ 'sections.collection_grid.filter_inspired_by' | t }}</summary>
        <div style="padding-left: 10px; margin-top: 6px; display: none;">
          {%- render 'catalog--filter-options', list: 'collection-grid.filters.inspired_by', input_class: 'filter-type' %}
        </div>
      </details>

      {% comment %} Ingredients Filter {% endcomment %}
      <details>
        <summary>{{ 'sections.collection_grid.filter_ingredients' | t }}</summary>
        <div style="padding-left: 10px; margin-top: 6px;">
          {%- render 'catalog--filter-options', list: 'collection-grid.filters.ingredients', input_class: 'filter-ingredient' %}
        </div>
      </details>
    </div>

    {% comment %} ========== PRODUCT GRID ========== {% endcomment %}
    {% paginate collection.products by 250 %}
      <div class="scent-grid" id="scentGrid">
        {% for product in collection.products %}
          {% unless product.tags contains "5ml" %}
            {% unless product.tags contains "50ml" %}
              {% unless product.tags contains "100ml" %}
                {% unless product.tags contains "bundle" %}
                  {% assign price = product.price | money_without_currency | remove: "," | times: 1 %}
                  {% assign tags = product.tags | join: " " | downcase %}

                  {% comment %} Replaced old card structure with new fragrance-item design while keeping data attributes for filtering {% endcomment %}
                    {% render 'card--product-carousel', product: product, filter_price: price, filter_tags: tags %}
                {% endunless %}
              {% endunless %}
            {% endunless %}
          {% endunless %}
        {% endfor %}
      </div>
    {% endpaginate %}
  </div>
</div>

<script type="application/json" id="collectionGridStrings">
  {
    "showFilters": {{ 'sections.collection_grid.show_filters_html' | t | json }},
    "hideFilters": {{ 'sections.collection_grid.hide_filters_html' | t | json }},
    "noRecentSearches": {{ 'sections.collection_grid.no_recent_searches' | t | json }},
    "noProducts": {{ 'sections.collection_grid.no_products' | t | json }},
    "addToCart": {{ 'sections.collection_grid.add_to_cart' | t | json }},
    "soldOut": {{ 'sections.collection_grid.sold_out' | t | json }}
  }
</script>
{% # theme-check-disable ParserBlockingScript %}
<script src="{{ 'catalog--collection-grid-cards.js' | asset_url }}"></script>
{% # theme-check-enable ParserBlockingScript %}

{% # theme-check-disable ParserBlockingScript %}
<script src="{{ 'catalog--collection-grid-variants.js' | asset_url }}"></script>
{% # theme-check-enable ParserBlockingScript %}

{% # theme-check-disable ParserBlockingScript %}
<script src="{{ 'catalog--collection-grid.js' | asset_url }}"></script>
{% # theme-check-enable ParserBlockingScript %}

{% schema %}
{
  "name": "Collection Grid",
  "settings": [
    {
      "type": "text",
      "id": "brand_collection_handles",
      "label": "Brand Collection Handles",
      "info": "Enter 4 collection handles separated by commas (e.g., tom-ford,chanel,dior,versace)",
      "default": "ysl,chanel,dior,versace"
    },
    {
      "type": "text",
      "id": "scent_collection_handles",
      "label": "Scent Note Collection Handles",
      "info": "Enter 4 collection handles separated by commas (e.g., citrus,floral,woody,oriental)",
      "default": "citrus,floral,woody,oriental"
    }
  ],
  "presets": [
    {
      "name": "Collection Grid with Filters"
    }
  ]
}
{% endschema %}
