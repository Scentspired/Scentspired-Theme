{% comment %}
  Scentspired Blog Rich Text Section
  ──────────────────────────────────────────────────────────
  Canonical rich text section for blog article pages.
  Replaces: blogtextliquid.liquid, text-blog.liquid
  CSS is loaded from the shared blog typography system.
{% endcomment %}

{{ "section-blog-typography.css" | asset_url | stylesheet_tag }}

{%- liquid
  assign text_size = section.settings.text_size | default: 'body'
  assign text_align = section.settings.text_alignment | default: 'left'
  assign max_width_class = 'blog-richtext--standard'
  if text_size == 'statement'
    assign max_width_class = 'blog-richtext--statement'
  endif
-%}

<style>
  .blog-richtext-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: {{ section.settings.padding_top | default: 40 }}px 20px {{ section.settings.padding_bottom | default: 60 }}px;
    background-color: {{ section.settings.background_color | default: '#ffffff' }};
  }

  .blog-richtext-content {
    font-family: var(--blog-body-font, 'PPMori Regular', sans-serif);
    font-weight: 200;
    font-style: normal;
    line-height: 1.6;
    letter-spacing: 0.02em;
    color: {{ section.settings.text_color | default: '#000000' }};
    max-width: var(--blog-column-max-width, 680px);
    text-align: {{ text_align }};
    margin: 0 auto;
  }

  .blog-richtext--standard .blog-richtext-content {
    font-size: var(--blog-body-size, 19px);
  }

  .blog-richtext--statement .blog-richtext-content {
    font-size: 28px;
    line-height: 1.3;
  }

  .blog-richtext-content p {
    margin: 0 0 28px;
  }

  .blog-richtext-content p:last-child {
    margin-bottom: 0;
  }

  .blog-richtext-content a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .blog-richtext-content strong,
  .blog-richtext-content b {
    font-weight: 700;
    color: #000;
  }

  @media (min-width: 768px) {
    .blog-richtext--statement .blog-richtext-content {
      font-size: 52px;
      line-height: 1.15;
    }
  }

  @media screen and (max-width: 749px) {
    .blog-richtext-content {
      max-width: 100%;
    }
  }
</style>

<div class="blog-richtext-wrapper">
  <div class="{{ max_width_class }}">
    <div class="blog-richtext-content">
      {{ section.settings.text_content }}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Blog Rich Text",
  "settings": [
    {
      "type": "richtext",
      "id": "text_content",
      "label": "Text Content",
      "default": "<p>There is a glass cabinet in quite a lot of British homes.</p><p><strong>So we built one.</strong></p>"
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "Text size",
      "options": [
        {
          "value": "body",
          "label": "Body (standard reading)"
        },
        {
          "value": "statement",
          "label": "Statement (large display)"
        }
      ],
      "default": "body"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Blog Rich Text"
    }
  ]
}
{% endschema %}