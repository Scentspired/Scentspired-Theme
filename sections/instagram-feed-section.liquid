{% schema %}
{
  "name": "Instagram Feed (Custom)",
  "settings": [
    {
      "type": "url",
      "id": "instagram_link",
      "label": "Instagram Profile Link"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image 3"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "Image 4"
    },
    {
      "type": "image_picker",
      "id": "image_5",
      "label": "Image 5"
    },
    {
      "type": "image_picker",
      "id": "image_6",
      "label": "Image 6"
    }
  ],
  "presets": [
    {
      "name": "Instagram Feed (Custom)"
    }
  ]
}
{% endschema %}

<div class="custom-instagram-feed">
  <div class="instagram-grid">
    {% for i in (1..6) %}
      {% assign image_id = "image_" | append: i %}
      {% if section.settings[image_id] != blank %}
        <a href="{{ section.settings.instagram_link }}" target="_blank" class="instagram-item">
          <img src="{{ section.settings[image_id] | img_url: '600x600' }}" alt="Instagram post {{ i }}">
        </a>
      {% endif %}
    {% endfor %}
  </div>
</div>

<style>
  /* --- Instagram Feed Grid --- */
  .custom-instagram-feed {
    width: 100%;
    margin: 40px auto;
    padding: 0 15px;
  }

  .instagram-grid {
    display: grid;
    gap: 15px;
    grid-template-columns: repeat(6, 1fr);
  }

  /* Tablet */
  @media (max-width: 1024px) {
    .instagram-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Mobile */
  @media (max-width: 600px) {
    .instagram-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .instagram-item img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 8px;
    object-fit: cover;
  }

  /* --- Shake Animation --- */
  @keyframes shake {
    0% {
      transform: rotate(0deg);
    }
    15% {
      transform: rotate(3deg);
    }
    30% {
      transform: rotate(-3deg);
    }
    45% {
      transform: rotate(3deg);
    }
    60% {
      transform: rotate(-3deg);
    }
    75% {
      transform: rotate(2deg);
    }
    100% {
      transform: rotate(0deg);
    }
  }

  .instagram-item img {
    animation: shake 1s ease-in-out infinite;
  }

  /* Sequential delays for 6 images */
  .instagram-item:nth-child(1) img {
    animation-delay: 0s;
  }
  .instagram-item:nth-child(2) img {
    animation-delay: 0.2s;
  }
  .instagram-item:nth-child(3) img {
    animation-delay: 0.4s;
  }
  .instagram-item:nth-child(4) img {
    animation-delay: 0.6s;
  }
  .instagram-item:nth-child(5) img {
    animation-delay: 0.8s;
  }
  .instagram-item:nth-child(6) img {
    animation-delay: 1s;
  }
</style>
