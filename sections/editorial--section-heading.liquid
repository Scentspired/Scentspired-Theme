{%- comment -%}
  A section's heading: a light title with a bold italic line under it (the
  homepage's "The Collection / Better Value When Chosen Together"). Its words
  are the region's content (templates/index.json fills them from home.json).

  It was the scent carousel. Every place that used it hid the carousel
  (show_carousel off, or custom_css .carousel-container {display: none;}),
  so its images, "#Scent Inspired" text and script were removed; the
  heading's markup and classes are unchanged.
{%- endcomment -%}
{%- assign subheading_class = section.settings.subheading_style | default: 'scent-sub' -%}
<section class="scent-carousel">
  <!-- Header -->
  <div class="scent-header">
    <h2 class="scent-title">{{ section.settings.heading }}</h2>
    <p class="{{ subheading_class }}">{{ section.settings.subheading }}</p>
  </div>
  <!-- Bottom Spacing -->
  <div class="carousel-spacing"></div>
</section>

{{ 'editorial--section-heading.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "Section heading",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    {
      "type": "select",
      "id": "subheading_style",
      "label": "Subheading style",
      "options": [
        { "value": "scent-sub", "label": "Bold italic, 28px" },
        { "value": "scent-subtitle", "label": "Bold italic, 48px" }
      ],
      "default": "scent-sub"
    }
  ],
  "presets": [{ "name": "Section heading" }]
}
{% endschema %}
