{% stylesheet %}
  /* Updated section base styles for consistency */
  .bs-section {
      max-width: 2100px;
      margin: 0 auto !important;
      padding: 0px 0;
      background-color: #ffffff;
      padding-left: 2rem;
  }

  @media only screen and (min-width: 1024px) {
      .bs-section {
          padding-left: 5rem;
      }
  }
  @media only screen and (max-width: 1024px) {
       .fragrance-item {
          width: 100% !important;
          }
        }

  .bs-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 30px;
      align-items: start;
  }
  .bs-grid.bs-grid--full {
      grid-template-columns: 1fr !important;
  }
  .bs-grid.bs-grid--full .bs-products-side {
      width: 100%;
      max-width: 100%;
  }

  .bs-products-side {
      display: flex;
      flex-direction: column;
      gap: 40px;
      margin-bottom: 60px;
      padding-top: 20px;
  }

  /* Updated Card Design Styles from form-aRxqB.tsx */
  .fragrance-item {
      display: flex;
      flex-direction: column;
      height: auto;
      width: 100%;
      border-radius: 8px;
      overflow: hidden;
      background-color: #F5F5F5;
      position: relative;
      min-width: 0; /* Fix for flexbox grid issues */
  }

  .fragrance-image-wrap {
      position: relative;
      height: 350px;
      width: 100%;
      overflow: hidden;
      flex-shrink: 0;
  }

  .fragrance-image-wrap img {
      position: absolute;
      top: 0;
      left: 0;
      height: 100%;
      width: 100%;
      object-fit: cover;
      transition: opacity 0.4s ease;
  }

  .fragrance-image-wrap .secondary-image {
      opacity: 0;
      transition: opacity 0.4s ease;
  }

  .fragrance-image-wrap:hover .secondary-image {
      opacity: 1;
  }

  .product-badges {
      position: absolute;
      top: 12px;
      left: 12px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      pointer-events: none;
  }

  .product-badge {
      color: #fff !important;
      font-family: var(--font-family-primary);
      font-weight: 400;
      font-size: 12px;
      padding: 4px 18px;
      border-radius: 20px;
      width: fit-content;
      white-space: nowrap;
  }

  .badge-men { background-color: var(--badge-men-bg, #242521) !important; }
  .badge-women { background-color: var(--badge-women-bg, #8b5b5d) !important; }
  .badge-unisex { background-color: var(--badge-unisex-bg, #7a795c) !important; }

  .fragrance-info {
      background-color: var(--fragrance-card-bg, #F5F5F5);
      padding: var(--fragrance-card-padding, 16px 12px);
      display: flex;
      flex-direction: column;
      gap: 6px;
      width: 100%;
      flex: 1;
  }

  .fragrance-rating {
      font-size: var(--rating-font-size, 24px);
      color: var(--rating-star-color, #cbdd00);
      letter-spacing: var(--rating-letter-spacing, -2px);
      margin: 0;
      text-align: left;
      margin-top: -10px;
  }

  .fragrance-name {
      font-size: var(--fragrance-title-font-size, 16px);
      font-weight: var(--fragrance-title-font-weight, 600);
      margin: 0;
      font-family: var(--font-family-primary);
      text-transform: uppercase;
      text-align: left;
      line-height: 1.3;
      color: var(--color-text-primary, #000);
  }

  .fragrance-brand {
      margin: 0;
      font-size: var(--fragrance-brand-font-size, 12px);
      font-family: var(--font-family-primary);
      font-weight: var(--fragrance-brand-font-weight, 400);
      text-align: left;
      color: var(--color-text-muted, #666);
  }

  .product-price-display {
      font-size: var(--price-font-size, 18px);
      font-weight: var(--price-font-weight, 600);
      color: var(--price-color, #000);
      font-family: var(--font-family-primary);
      margin-top: 2px;
      display: flex;
      align-items: center;
      gap: 8px;
  }

  .price-wrapper {
      display: flex;
      align-items: center;
      gap: 8px;
  }

  .compare-price {
      font-size: var(--price-compare-font-size, 14px);
      color: var(--price-compare-color, #666);
      text-decoration: line-through;
      font-weight: 400;
  }

  .sale-badge {
      background-color: var(--price-badge-bg, #d90429);
      color: var(--price-badge-color, #ffffff);
      font-size: var(--price-badge-font-size, 12px);
      font-weight: 600;
      padding: var(--price-badge-padding-y, 2px) var(--price-badge-padding-x, 8px);
      border-radius: var(--price-badge-radius, 4px);
      font-family: var(--font-family-primary);
      white-space: nowrap;
  }

  .variant-options {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin: 4px 0 0 0;
  }

  .variant-option-btn {
      padding: var(--btn-pill-padding-y, 6px) var(--variant-pill-round-padding-x, 16px);
      background-color: #fff;
      border: 1px solid var(--btn-pill-border, #ddd);
      border-radius: var(--variant-pill-round-radius, 20px);
      font-size: var(--btn-pill-font-size, 11px);
      cursor: pointer;
      font-family: var(--font-family-primary);
      transition: all 0.2s ease;
      color: var(--color-text-primary, #000);
  }

  .variant-option-btn.active {
      background-color: var(--btn-pill-active-bg, #f4ff41);
      color: var(--color-text-primary, #000);
      border-color: var(--btn-pill-active-border, #000);
  }

  .variant-option-btn.disabled {
      color: #4a4a4a !important;
      background-color: var(--btn-pill-disabled-bg, #f0f0f0);
      border-color: var(--btn-pill-disabled-border, #c4c4c4);
      cursor: not-allowed;
      pointer-events: none;
      text-decoration: line-through;
  }

  .cart-button {
      margin-top: 8px;
      background: var(--btn-brand-bg, #f4ff41);
      color: var(--btn-brand-color, #000);
      font-weight: var(--btn-brand-font-weight, 600);
      font-size: var(--btn-brand-font-size, 12px);
      padding: var(--btn-brand-padding-y, 16px) var(--btn-brand-padding-x, 16px);
      border-radius: var(--btn-brand-radius, 20px);
      cursor: pointer;
      border: none;
      width: 100%;
      font-family: var(--font-family-primary);
      transition: all 0.3s ease;
  }

  .cart-button:hover { background: var(--btn-brand-hover-bg, #e0ea36); }

  .cart-button.sold-out {
      background: var(--btn-brand-disabled-bg, #e0e0e0) !important;
      color: var(--btn-brand-disabled-color, #333333) !important;
      cursor: not-allowed;
      pointer-events: none;
  }

  /* Updated heading layout to match requested design (Title left, Nav right) */
  .bs-heading {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: 20px;
  }

  .bs-heading-content {
      flex: 1;
  }

  /* Existing Navigation Styles */
  .bs-navigation { display: flex; gap: 10px; align-items: center; }
  .bs-nav-arrow {
      width: var(--carousel-nav-arrow-size, 45px);
      height: var(--carousel-nav-arrow-size, 45px);
      background: var(--carousel-nav-arrow-bg, #f4ff41);
      border-radius: var(--radius-circle, 50%);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.3s ease;
      border: 2px solid var(--carousel-nav-arrow-border, #f4ff41) !important;
      font-size: var(--carousel-nav-arrow-font-size, 24px);
  }
  .bs-nav-counter { font-family: var(--font-family-primary); font-size: var(--carousel-nav-counter-font-size, 14px); color: var(--carousel-nav-counter-color, #666); }

  .bs-title {
      font-family: var(--section-heading-font-family, var(--font-family-heading));
      font-size: var(--section-heading-font-size, 48px);
      font-weight: var(--section-heading-font-weight, 400);
      font-style: var(--section-heading-font-style, italic);
      color: var(--color-text-primary, #000);
      margin: 0;
      text-decoration: underline;
      text-decoration-color: var(--section-heading-accent-color, #FADB95);
      text-decoration-thickness: var(--section-heading-accent-thickness, 2px);
      text-underline-offset: 2px;
  }


  .bs-products-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 30px;
      overflow: hidden;
  }

  .bs-image-side {
      height: auto;
      padding-top: 80px;
  }
  .bs-featured-image { width: 100%; height: auto; border-radius: 16px; overflow: hidden; }
  .bs-featured-image img { width: 100%; height: 100%; object-fit: cover; }

  @media screen and (max-width: 800px) {
      .bs-section { padding-left: 1rem; padding-right: 1rem; }
      .bs-grid { grid-template-columns: 1fr; gap: 0px; }
      .bs-products-grid { grid-template-columns: 1fr; gap: 15px; }
      .fragrance-image-wrap { height: 200px; }
      .bs-image-side { padding-top: 0; margin-top: 20px; }
      .bs-title { font-size: 32px; }
      .fragrance-name { font-size: 13px; }
      .fragrance-brand { font-size: 11px; }
      .variant-option-btn { padding: 4px 10px; font-size: 10px; }
      .cart-button { padding: 12px; font-size: 10px; }
      .bs-products-side {
      padding-top: 30px;
  }
      @media screen and (max-width: 800px) {
      .cart-button {
          font-size: 11px;
          padding: 16px 12px;
      }
  }
  .bs-subheading {
      margin-top: 30px;
      max-width: 450px;
  }

  .bs-subheading p {
      font-family: var(--font-family-primary);
      font-size: 14px;
      font-weight: 400;
      line-height: 1.5;
      color: #000;
      text-transform: uppercase;
      margin: 0;
  }
  @media screen and (max-width: 800px) {
      .bs-image-side {
         display: none;
          margin-top: 20px;
         }
        }
{% endstylesheet %}

<section class="bs-section" id="bestSellers-{{ section.id }}">
  <div class="bs-container">
    <div class="bs-grid{% unless section.settings.show_featured_image and section.settings.featured_image %} bs-grid--full{% endunless %}">
      <div class="bs-products-side">
        <div class="bs-heading">
          <div class="bs-heading-content">
            <h2 class="bs-title">{{ section.settings.section_title }}</h2>
          </div>
          <div class="bs-navigation">
            <button class="bs-nav-arrow bs-prev-btn" id="prevBtn" aria-label="Previous products">‹</button>
            <span class="bs-nav-counter"> <span id="currentPage">1</span> / <span id="totalPages">1</span> </span>
            <button class="bs-nav-arrow bs-next-btn" id="nextBtn" aria-label="Next products">›</button>
          </div>
        </div>

        {% if section.settings.show_products %}
          <div class="bs-products-grid" id="productsGrid">
            <!-- Cards are rendered here via JavaScript -->
          </div>
        {% else %}
          <div class="bs-editorial-spacer" style="min-height: 100px;"></div>
        {% endif %}

        {% if section.settings.subheading != blank and section.settings.subheading != "" %}
          <div class="bs-subheading">
            <p>{{ section.settings.subheading }}</p>
          </div>
        {% endif %}

        {% if section.settings.view_all_link != blank %}
          <div style="text-align: center; margin-top: 20px; margin-bottom: 40px;">
            <a
              href="{{ section.settings.view_all_link }}"
              class="view-all-button"
              aria-label="View all bestsellers"
              style="display: inline-block; padding: 16px 80px; background: var(--color-brand-primary, #f4ff41); border-radius: var(--radius-pill, 999px); text-decoration: none; color: var(--color-text-primary, #000); font-family: var(--font-family-primary); font-weight: 500; text-transform: uppercase;">
              View All Bestsellers
            </a>
          </div>
        {% endif %}
      </div>

      {% if section.settings.show_featured_image and section.settings.featured_image %}
        <div class="bs-image-side">
          <div class="bs-featured-image">
            <img
              src="{{ section.settings.featured_image | image_url: width: 1200 }}"
              alt="{{ section.settings.featured_image.alt | default: 'Best Sellers' | escape }}"
              loading="lazy"
              decoding="async"
              width="1200"
              height="{{ 1200 | divided_by: section.settings.featured_image.aspect_ratio | default: 900 | round }}">
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</section>

<script>
// Unified carousel engine (.selected-variant-id, bindEvents, window.rebindProductEvents)
let allProducts = [];

document.addEventListener('DOMContentLoaded', function () {
  {% assign collection = collections[section.settings.collection] | default: collections['best-sellers'] | default: collections['all'] %}
  {% paginate collection.products by 250 %}
  allProducts = [
  {% for product in collection.products %}
  {
    id: {{ product.id }},
    title: "{{ product.title | escape }}",
    vendor: "{{ product.vendor | escape }}",
    url: "{{ product.url }}",
    featured_image: "{{ product.featured_image | image_url: width: 600 }}",
    hover_image: {% if product.images.size > 1 %}"{{ product.images[1] | image_url: width: 600 }}"{% else %}null{% endif %},
    tags: "{{ product.tags | join: ',' }}",
    variants: [
      {% for variant in product.variants %}
      {
        id: {{ variant.id }},
        title: "{{ variant.title | escape }}",
        price: "{{ variant.price | money }}",
        priceRaw: {{ variant.price }},
        compareAtPrice: {{ variant.compare_at_price | default: 0 }},
        available: {{ variant.available | json }},
        availableInventory: {{ variant.inventory_quantity }}
      }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
];
  {% endpaginate %}
  function initBestSellersCarousel() {
    var container = document.getElementById('bestSellers-{{ section.id }}');
    var grid = document.getElementById('productsGrid');
    if (!grid) return;
    if (container && window.ScentspiredProductCarousel) {
      new window.ScentspiredProductCarousel(container, allProducts, {
        showRating: false,
        showComparePrice: true,
        buttonText: 'Add to Cart',
        breakpoint: 800
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBestSellersCarousel);
  } else {
    initBestSellersCarousel();
  }
  window.addEventListener('load', initBestSellersCarousel);
  document.addEventListener('scentspired:carousel-ready', initBestSellersCarousel);
});
</script>
{% schema %}
{
  "name": "Best Sellers Section",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Best Sellers"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "STAY GLOWING AND HEALTHY WITHOUT HAVING TO THINK ABOUT IT."
    },
    {
      "type": "image_picker",
      "id": "featured_image",
      "label": "Featured Image"
    },
    {
      "type": "checkbox",
      "id": "show_products",
      "label": "Show Product Cards Grid",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_featured_image",
      "label": "Show Featured Side Image",
      "default": false
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link"
    }
  ],
  "presets": [
    {
      "name": "Best Sellers Section"
    }
  ]
}
{% endschema %}
