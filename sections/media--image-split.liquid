{%- liquid
  assign image_position = section.settings.image_position | default: "left"
  assign section_height = section.settings.section_height | default: "600px"
-%}

{{ 'media--image-split.css' | asset_url | stylesheet_tag }}
<section
  class="image-content-split"
  data-section-id="{{ section.id }}"
  style="--split-min-height: {{ section_height }}; --split-background-color: {{ section.settings.background_color | default: '#f8f8f8' }}; --split-eyebrow-color: {{ section.settings.eyebrow_color | default: '#666' }}; --split-heading-color: {{ section.settings.heading_color | default: '#333' }}; --split-text-color: {{ section.settings.text_color | default: '#666' }};">
  <div class="split-container {% if image_position == 'right' %}reverse-layout{% endif %}">
    <!-- Image Section -->
    <div class="image-section">
      {% if section.settings.image %}
        <img
          src="{{ section.settings.image | img_url: '1200x800' }}"
          alt="{{ section.settings.image.alt | escape }}"
          loading="lazy"
          class="split-image">
      {% else %}
        <div class="placeholder-image">
          <span>{{ 'sections.image_split.add_image' | t }}</span>
        </div>
      {% endif %}
    </div>

    <!-- Content Section -->
    <div class="content-section {% if image_position == 'right' %}content-left{% else %}content-right{% endif %}">
      <div class="content-wrapper">
        {% if section.settings.eyebrow_text != blank %}
          <p class="eyebrow-text">{{ section.settings.eyebrow_text }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="main-heading">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="description">
            {{ section.settings.description }}
          </div>
        {% endif %}

        {% if section.settings.button_text != blank and section.settings.button_url != blank %}
          <a href="{{ section.settings.button_url }}" class="cta-button">
            {{ section.settings.button_text }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</section>


{% schema %}
{
  "name": "Image Content Split",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "section_height",
      "label": "Section Height (Desktop)",
      "default": "600px",
      "info": "Use CSS units like px, vh, etc."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow Text",
      "default": "IN COLLABORATION WITH NATURE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A RADICAL APPROACH"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Behind every Abel fragrance is a radical approach to how we operate. In a fragrance world shrouded by secrecy, we're always transparent.</p><p>In a culture fuelled by hype and excess, we favour the long view and curbing our environmental footprint. And in our use of biotechnology, guided by the artistry of our master perfumer, we create long-lasting 100% natural fragrances that eliminate the need for petrochemical-derived synthetic ingredients.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "READ MORE ABOUT OUR PRACTICE"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f8f8f8"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Text Color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#666666"
    }
  ],
  "presets": [
    {
      "name": "Image Content Split"
    }
  ]
}
{% endschema %}
