{
  "name": "FAQ Section",
  "max_blocks": 50,
  "settings": [
    {
      "type": "text",
      "id": "page_title",
      "label": "Page Title",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "text",
      "id": "link_1_text",
      "label": "Link 1 Text",
      "default": "Contact Us"
    },
    {
      "type": "url",
      "id": "link_1_url",
      "label": "Link 1 URL"
    },
    {
      "type": "text",
      "id": "link_2_text",
      "label": "Link 2 Text",
      "default": "[ FAQs ]"
    },
    {
      "type": "url",
      "id": "link_2_url",
      "label": "Link 2 URL"
    },
    {
      "type": "text",
      "id": "link_3_text",
      "label": "Link 3 Text",
      "default": "Stockists"
    },
    {
      "type": "url",
      "id": "link_3_url",
      "label": "Link 3 URL"
    },
    {
      "type": "text",
      "id": "link_4_text",
      "label": "Link 4 Text",
      "default": "Privacy Policy"
    },
    {
      "type": "url",
      "id": "link_4_url",
      "label": "Link 4 URL"
    },
    {
      "type": "text",
      "id": "link_5_text",
      "label": "Link 5 Text",
      "default": "Terms and Conditions"
    },
    {
      "type": "url",
      "id": "link_5_url",
      "label": "Link 5 URL"
    },
    {
      "type": "text",
      "id": "link_6_text",
      "label": "Link 6 Text"
    },
    {
      "type": "url",
      "id": "link_6_url",
      "label": "Link 6 URL"
    },
    {
      "type": "text",
      "id": "link_7_text",
      "label": "Link 7 Text"
    },
    {
      "type": "url",
      "id": "link_7_url",
      "label": "Link 7 URL"
    },
    {
      "type": "text",
      "id": "link_8_text",
      "label": "Link 8 Text"
    },
    {
      "type": "url",
      "id": "link_8_url",
      "label": "Link 8 URL"
    }
  ],
  "presets": [
    {
      "name": "FAQ Section"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category heading",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category title",
          "default": "ABOUT FRAGRANCES"
        }
      ]
    },
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Your question here"
        },
        {
          "type": "html",
          "id": "answer",
          "label": "Answer",
          "info": "Accepts [support_email] and [returns_email], filled in from this storefront’s region data.",
          "default": "Your answer here"
        }
      ]
    }
  ]
}
{% endschema %}
