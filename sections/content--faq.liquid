{% comment %}  The `faq-section` is a customizable section for displaying privacy policies or FAQ content.  It includes a sidebar for navigation and dynamic content blocks.{% endcomment %}

{%- liquid
  # Contact addresses are regional data, never literals. See regions/_defaults.json.
  capture support_email
    render 'region--active', key: 'support_email'
  endcapture
  capture returns_email
    render 'region--active', key: 'returns_email'
  endcapture
  assign support_email = support_email | strip
  assign returns_email = returns_email | strip
-%}
<style>
  /* Custom Fonts */
  @font-face {
    font-family: 'PPMori Regular';
    src: url('https://cdn.shopify.com/s/files/1/0698/9398/0343/files/PPMori-Regular.otf?v=1751621372')
      format('opentype');
    font-weight: 400;
    font-style: normal;
  }
  @font-face {
    font-family: 'PPEditorialNew Italic';
    src: url('https://cdn.shopify.com/s/files/1/0698/9398/0343/files/PPEditorialNew-Italic-BF644b214fb0c0a.otf?v=1751620955')
      format('opentype');
    font-weight: 900;
    font-style: italic;
  }
  /* Base Styles */
  .faq-section {
    font-family: var(--font-body);
    background-color: white;
    padding: 40px 0;
    margin-top: 100px; /* Added from your global CSS */
  }
  .faq-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 10px;
  }
  .faq-header {
    margin-bottom: 40px;
    border-top: 1px solid #bfbec0; /* Border moved here to span full width */
    padding-top: 3px; /* Space between border and title */
    display: flex; /* Added for centering title with lines */
    align-items: center; /* Added for centering title with lines */
    justify-content: center; /* Added for centering title with lines */
    gap: 20px; /* Space between lines and title */
  }
  .faq-title {
    font-size: 24px;
    font-weight: 600;
    margin-bottom: -30px; /* Reset negative margin */
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #333;
    /* Removed border-top and margin-left */
    font-family: var(--font-display-italic);
    flex-shrink: 0; /* Prevent title from shrinking */
  }
  .faq-title-line {
    /* New CSS for the lines on either side of the title */
    flex-grow: 1;
    height: 1px;
    background-color: #bfbec0;
    display: none;
  }
  .faq-content {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 0;
    position: relative;
    border-top: 1px solid #bfbec0 !important;
  }
  .faq-content::after {
    content: '';
    position: absolute;
    left: 600px; /* Keeping user's original value */
    top: 0;
    bottom: 0;
    width: 1px;
    background-color: #e5e5e5;
  }
  .faq-sidebar {
    padding-right: 0;
    position: sticky;
    margin-top: 20px;
    height: fit-content;
  }
  .faq-sidebar ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .faq-sidebar li {
    margin-bottom: 15px;
  }
  .faq-sidebar a {
    color: #666;
    text-decoration: none;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition:
      color 0.3s ease,
      background-color 0.3s ease;
    display: block; /* Ensures the background covers the full width */
    padding: 4px 8px; /* Adds padding around the text within the block */
    border-radius: 4px;
    font-family: var(--font-body);
  }
  .faq-sidebar a:hover {
    color: #000;
    background-color: #efff31; /* Yellow background on hover */
  }
  .faq-sidebar a.active {
    color: #000;
    background-color: #efff31; /* Yellow background for active state */
  }
  .faq-main {
    padding-left: 40px;
    border-right: 1px solid #e5e5e5;
    padding-right: 20px;
  }
  .faq-category {
    margin-bottom: 40px;
  }
  .faq-category-title {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 20px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #333;
    font-family: var(--font-body);
  }
  .faq-item {
    border-bottom: 1px solid #e5e5e5;
    margin-bottom: 0;
  }
  .faq-question {
    width: 100%;
    background: none;
    border: none;
    padding: 15px 30px 15px 0;
    text-align: left;
    font-family: var(--font-body);
    font-size: 13px;
    color: #333;
    cursor: pointer;
    position: relative;
    transition: color 0.3s ease;
    line-height: 1.4;
  }
  .faq-question:hover {
    color: #000;
  }
  .faq-question::after {
    content: '+';
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    font-size: 18px;
    transition: transform 0.3s ease;
  }
  .faq-question.active::after {
    transform: translateY(-50%) rotate(45deg);
  }
  .faq-answer {
    padding: 0 0 15px 0;
    font-size: 13px;
    line-height: 1.5;
    color: #666;
    display: none;
    font-family: var(--font-body);
  }
  .faq-answer.active {
    display: block;
  }
  @media (max-width: 768px) {
    .faq-content {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .faq-content::after {
      display: none;
    }
    .faq-sidebar {
      position: static;
      order: 1;
      overflow-x: auto;
      padding-bottom: 10px;
    }
    .faq-sidebar ul {
      display: flex;
      gap: 20px;
      white-space: nowrap;
      padding-bottom: 10px;
    }
    .faq-sidebar li {
      margin-bottom: 0;
      flex-shrink: 0;
    }
    .faq-main {
      padding-left: 0;
      order: 2;
      border-right: none;
      padding-right: 0;
    }
    .faq-title {
      font-size: 20px;
    }
    .faq-category-title {
      font-size: 14px;
    }
    .faq-question {
      font-size: 12px;
      padding: 12px 25px 12px 0;
    }
    .faq-answer {
      font-size: 12px;
      padding: 0 0 12px 0;
    }
  }
  /* Custom scrollbar for mobile sidebar */
  .faq-sidebar::-webkit-scrollbar {
    height: 3px;
  }
  .faq-sidebar::-webkit-scrollbar-track {
    background: #f1f1f1;
  }
  .faq-sidebar::-webkit-scrollbar-thumb {
    background: #ccc;
    border-radius: 3px;
  }
  .faq-sidebar::-webkit-scrollbar-thumb:hover {
    background: #999;
  }

  /* Consolidated and updated media queries */
  @media screen and (min-width: 1441px) {
    .faq-container {
      max-width: 1900px;
      margin: 0 auto;
      padding: 0 5px;
    }
    .faq-main {
      padding-left: 240px !important;
    }
    .faq-content::after {
      left: 433px !important;
    }
  }
  @media screen and (min-width: 1024px) and (max-width: 1440px) {
    .faq-main {
      padding-left: 100px !important;
    }
    .faq-container {
      max-width: 1300px;
      margin: 0 auto;
      padding: 0 10px;
    }
    .faq-content::after {
      left: 298px !important;
    }
  }
  @media screen and (min-width: 700px) and (max-width: 1024px) {
    .faq-content::after {
      content: '';
      position: absolute;
      left: 200px;
      top: 0;
      bottom: 0;
      width: 1px;
      background-color: #e5e5e5;
    }
  }
</style>
<div class="faq-section">
  <div class="faq-container">
    <div class="faq-header">
      <div class="faq-title-line"></div>
      <h1 class="faq-title">{{ section.settings.page_title | default: "Frequently Asked Questions" }}</h1>
      <div class="faq-title-line"></div>
    </div>
    <div class="faq-content">
      <aside class="faq-sidebar">
        <ul>
          {% comment %}
            The active class is now added by JavaScript based on the current URL.
            Removed Liquid 'active' class logic to avoid conflicts.
          {% endcomment %}
          {% if section.settings.link_1_text != blank %}
            <li>
              <a href="{{ section.settings.link_1_url }}">{{ section.settings.link_1_text }}</a>
            </li>
          {% endif %}
          {% if section.settings.link_2_text != blank %}
            <li>
              <a href="{{ section.settings.link_2_url }}">{{ section.settings.link_2_text }}</a>
            </li>
          {% endif %}
          {% if section.settings.link_3_text != blank %}
            <li>
              <a href="{{ section.settings.link_3_url }}">{{ section.settings.link_3_text }}</a>
            </li>
          {% endif %}
          {% if section.settings.link_4_text != blank %}
            <li>
              <a href="{{ section.settings.link_4_url }}">{{ section.settings.link_4_text }}</a>
            </li>
          {% endif %}
          {% if section.settings.link_5_text != blank %}
            <li>
              <a href="{{ section.settings.link_5_url }}">{{ section.settings.link_5_text }}</a>
            </li>
          {% endif %}
          {% if section.settings.link_6_text != blank %}
            <li>
              <a href="{{ section.settings.link_6_url }}">{{ section.settings.link_6_text }}</a>
            </li>
          {% endif %}
          {% if section.settings.link_7_text != blank %}
            <li>
              <a href="{{ section.settings.link_7_url }}">{{ section.settings.link_7_text }}</a>
            </li>
          {% endif %}
          {% if section.settings.link_8_text != blank %}
            <li>
              <a href="{{ section.settings.link_8_url }}">{{ section.settings.link_8_text }}</a>
            </li>
          {% endif %}
        </ul>
      </aside>
      <main class="faq-main">
        {%- comment -%}
          The questions are template data, not markup. Each region overlays
          templates/page.faqs.json, so a storefront can rewrite any answer
          without touching this file. Categories and questions are one flat,
          ordered block list: a "category" block opens a group and the
          "question" blocks after it fall inside, until the next category.

          Answers may carry [support_email] and [returns_email], which resolve
          from region data below — so the address stays defined in exactly one
          place even though the copy around it lives in the template.
        {%- endcomment -%}
        {%- liquid
          assign category_open = false
        -%}
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'category' -%}
              {%- if category_open %}</div>{% endif -%}
              <div class="faq-category"{{ block.shopify_attributes }}>
                <h2 class="faq-category-title">{{ block.settings.title }}</h2>
              {%- assign category_open = true -%}
            {%- when 'question' -%}
              {%- liquid
                assign answer = block.settings.answer
                assign answer = answer | replace: '[support_email]', support_email
                assign answer = answer | replace: '[returns_email]', returns_email
                assign question = block.settings.question
                assign question = question | replace: '[support_email]', support_email
                assign question = question | replace: '[returns_email]', returns_email
              -%}
              <div class="faq-item"{{ block.shopify_attributes }}>
                <button class="faq-question" onclick="toggleFaq(this)">{{ question }}</button>
                <div class="faq-answer">{{ answer }}</div>
              </div>
          {%- endcase -%}
        {%- endfor -%}
        {%- if category_open %}</div>{% endif -%}
      </main>
    </div>
  </div>
</div>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const sidebarLinks = document.querySelectorAll('.faq-sidebar a');
    const currentPath = window.location.pathname;
    sidebarLinks.forEach(link => {
      // Normalize href to match pathname (remove domain, query params, hash)
      const linkPath = new URL(link.href).pathname;
      // Check if the link's path matches the current page's path
      if (linkPath === currentPath) {
        link.classList.add('active');
      }
    });
  });

  function toggleFaq(button) {
    const answer = button.nextElementSibling;
    const isActive = button.classList.contains('active');
    // Close all other FAQs
    document.querySelectorAll('.faq-question.active').forEach(q => {
      q.classList.remove('active');
      q.nextElementSibling.classList.remove('active');
    });
    // Toggle current FAQ
    if (!isActive) {
      button.classList.add('active');
      answer.classList.add('active');
    }
  }
</script>
{% schema %}
{
  "name": "FAQ Section",
  "max_blocks": 50,
  "settings": [
    {
      "type": "text",
      "id": "page_title",
      "label": "Page Title",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "text",
      "id": "link_1_text",
      "label": "Link 1 Text",
      "default": "Contact Us"
    },
    {
      "type": "url",
      "id": "link_1_url",
      "label": "Link 1 URL"
    },
    {
      "type": "text",
      "id": "link_2_text",
      "label": "Link 2 Text",
      "default": "[ FAQs ]"
    },
    {
      "type": "url",
      "id": "link_2_url",
      "label": "Link 2 URL"
    },
    {
      "type": "text",
      "id": "link_3_text",
      "label": "Link 3 Text",
      "default": "Stockists"
    },
    {
      "type": "url",
      "id": "link_3_url",
      "label": "Link 3 URL"
    },
    {
      "type": "text",
      "id": "link_4_text",
      "label": "Link 4 Text",
      "default": "Privacy Policy"
    },
    {
      "type": "url",
      "id": "link_4_url",
      "label": "Link 4 URL"
    },
    {
      "type": "text",
      "id": "link_5_text",
      "label": "Link 5 Text",
      "default": "Terms and Conditions"
    },
    {
      "type": "url",
      "id": "link_5_url",
      "label": "Link 5 URL"
    },
    {
      "type": "text",
      "id": "link_6_text",
      "label": "Link 6 Text"
    },
    {
      "type": "url",
      "id": "link_6_url",
      "label": "Link 6 URL"
    },
    {
      "type": "text",
      "id": "link_7_text",
      "label": "Link 7 Text"
    },
    {
      "type": "url",
      "id": "link_7_url",
      "label": "Link 7 URL"
    },
    {
      "type": "text",
      "id": "link_8_text",
      "label": "Link 8 Text"
    },
    {
      "type": "url",
      "id": "link_8_url",
      "label": "Link 8 URL"
    }
  ],
  "presets": [
    {
      "name": "FAQ Section"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category heading",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category title",
          "default": "ABOUT FRAGRANCES"
        }
      ]
    },
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Your question here"
        },
        {
          "type": "html",
          "id": "answer",
          "label": "Answer",
          "info": "Accepts [support_email] and [returns_email], filled in from this storefront’s region data.",
          "default": "Your answer here"
        }
      ]
    }
  ]
}
{% endschema %}
