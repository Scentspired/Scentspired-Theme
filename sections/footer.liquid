{% if section.settings.youtube_url != blank %}
  <a href="{{ section.settings.youtube_url }}" target="_blank" rel="noopener" aria-label="YouTube">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
      <path d="M8.051 1.999h-.002C3.617 1.999 1.5 2.216 1.5 8c0 5.784 2.117 6.001 6.549 6.001h.002C12.383 14.001 14.5 13.784 14.5 8c0-5.784-2.117-6.001-6.449-6.001zM6.5 10.5v-5l4 2.5-4 2.5z"/>
