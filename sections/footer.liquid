{% if section.settings.pinterest_url != blank %}
  <a href="{{ section.settings.pinterest_url }}" target="_blank" rel="noopener" aria-label="Pinterest">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pinterest" viewBox="0 0 16 16">
  <path d="M8 0a8 8 0 0 0-2.915 15.452c-.07-.633-.134-1.606.027-2.297.146-.625.938-3.977.938-3.977s-.239-.479-.239-1.187c0-1.113.645-1.943 1.448-1.943.682 0 1.012.512 1.012 1.127 0 .686-.437 1.712-.663 2.663-.188.796.4 1.446 1.185 1.446 1.422 0 2.515-1.5 2.515-3.664 0-1.915-1.377-3.254-3.342-3.254-2.276 0-3.612 1.707-3.612 3.471 0 .688.265 1.425.595 1.826a.24.24 0 0 1 .056.23c-.061.252-.196.796-.222.907-.035.146-.116.177-.268.107-1-.465-1.624-1.926-1.624-3.1 0-2.523 1.834-4.84 5.286-4.84 2.775 0 4.932 1.977 4.932 4.62 0 2.757-1.739 4.976-4.151 4.976-.811 0-1.573-.421-1.834-.919l-.498 1.902c-.181.695-.669 1.566-.995 2.097A8 8 0 1 0 8 0"/>
</svg>
  </a>
{% endif %}

        </div>
        <div class="footer-auth-links">
          <a href="/account/login">{{ section.settings.sign_in_text }}</a>
          <a href="/account/register">{{ section.settings.create_account_text }}</a>
        </div>
      </div>

      <!-- Meet Section -->
      <div class="footer-column footer-meet">
        <h4>{{ section.settings.meet_heading }}</h4>
        <ul class="footer-links">
          {% for block in section.blocks %}
            {% if block.type == 'meet_link' %}
              <li><a href="{{ block.settings.link_url }}">{{ block.settings.link_text }}</a></li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>

      <!-- Questions Section -->
      <div class="footer-column footer-questions">
        <h4>{{ section.settings.questions_heading }}</h4>
        <ul class="footer-links">
          {% for block in section.blocks %}
            {% if block.type == 'question_link' %}
              <li><a href="{{ block.settings.link_url }}">{{ block.settings.link_text }}</a></li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>

      <!-- Additional Links -->
      <div class="footer-column footer-additional">
        <ul class="footer-links">
          {% for block in section.blocks %}
            {% if block.type == 'additional_link' %}
              <li><a href="{{ block.settings.link_url }}">{{ block.settings.link_text }}</a></li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>
    </div>

    <!-- Background Text -->
    <!-- Background Text / Image -->
<div class="footer-background-text">
  {% if section.settings.footer_bg_image != blank %}
    <a href="https://scentspired.com" class="footer-background-link" aria-label="Scentspired home">
  <img
    src="{{ section.settings.footer_bg_image | image_url: width: 1200 }}"
    alt=""
    loading="lazy"
    class="footer-background-image"
  >
</a>
  {% else %}
    <span class="footer-fallback-text">
      {{ section.settings.background_text }}
    </span>
  {% endif %}
</div>
  </div>
</footer>

<style>
.custom-footer {
  background-color: {{ section.settings.footer_bg_color | default: '#ebfb33' }};
  color: {{ section.settings.footer_text_color | default: '#000000' }};
  padding: 60px 0 80px;
  position: relative;
  overflow: hidden;
}
.footer-background-link {
  text-decoration: none;
  color: inherit;
}

.footer-background-link:link,
.footer-background-link:visited {
  color: inherit;
}
.footer-background-image {
    width: calc(100vw - 40px);
    margin-left: calc(-50vw + 50% + 20px);
    padding: 70px 0;
    text-align: center;
}

.footer-container {
  max-width: 1650px;
  margin: 0 auto;
  padding: 0px 50px;
  position: relative;
  z-index: 2;
    margin-left: 260px !important;
  height: 323px;
  
}

.footer-content {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr 1fr;
  gap: 40px;
  align-items: start;
  color: #fff;
}

@media (max-width: 1024px) {
  .footer-content {
    grid-template-columns: 1fr;
    gap: 30px;
    margin-left: -290px;
  }
  .footer-column h4 {
  margin-bottom: 8px !important;
}
.footer-brand {
 padding-top: 25px;
}
}
.footer-column h4 {
  font-size: 14px;
  font-weight: 700;
  margin-bottom: 20px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: #fff;
}

.brand-description {
  font-size: 14px;
  line-height: 1.6;
  margin-bottom: 20px;
  max-width: 300px;
  color: #fff;
}

.brand-tagline {
  font-size: 16px;
  font-weight: 700;
  margin: 0;
  color: #fff;
}

.social-icons {
  display: flex;
  gap: 15px;
  margin-bottom: 20px;
  color: #fff;
}

.social-icons a {
  transition: opacity 0.3s ease;
  color: #fff;
}

.social-icons a:hover {
  opacity: 0.7;
}

.footer-auth-links {
  display: flex;
  flex-direction: column;
  gap: 8px;
  color: #fff;
}

.footer-auth-links a {
  font-size: 14px;
  text-decoration: none;
  font-weight: 500;
  color: #fff;
}

.footer-auth-links a:hover {
  text-decoration: underline;
}

.footer-links {
  list-style: none;
  padding: 0;
  margin: 0;
  color: #fff;
}

.footer-links li {
  margin-bottom: 12px;
  color: #fff;
}

.footer-links a {
  color: currentColor;
  text-decoration: none;
  font-size: 14px;
  font-weight: 500;
  transition: opacity 0.3s ease;
  color: #fff;
}

.footer-links a:hover {
  opacity: 0.7;
}

.footer-background-text {
  position: absolute;
  bottom: 50px;
  left: 0;
  right: 0;
  text-align: center;
  font-size: clamp(420px, 14vw, 550px);
  font-weight: 900;
  color: rgba(255, 255, 255, 0.08) !important;
  white-space: nowrap;
  pointer-events: none;
  z-index: 1;
  line-height: 0.8;
  margin-left: -120px;
  font-family: 'PPEditorial New Ultrabold', serif;
  margin-top: -140px;
  font-weight: 600;
}

@media (max-width: 1000px) {
  .footer-background-text {
    font-size: clamp(80px, 25vw, 150px);
    bottom: -15px;
  }
  
}
  @media only screen and (min-width: 1024px) and (max-width: 1439px) {
    .footer-container {
  max-width: 1650px;
  margin: 0 auto;
  padding: 0px 50px;
  position: relative;
  z-index: 2;
    margin-left: 90px !important;
  
}
.footer-background-text {
  position: absolute;
  bottom: 150px;
  left: 0;
  right: 0;
  text-align: center;
  font-size: clamp(300px, 14vw, 650px);
  font-weight: 900;
  color: rgba(255, 255, 255, 0.08) !important;
  white-space: nowrap;
  pointer-events: none;
  z-index: 1;
  line-height: 0.8;
  margin-left: -120px;
  font-family: 'PPEditorial New Ultrabold', serif;
  margin-top: -140px !important;
  font-weight: 600;
  margin-bottom: 90px;
}
}
 @media only screen and (min-width: 1081px) and (max-width: 1099px) {
    .footer-background-text {
        position: absolute;
         bottom: -315px !important;
         left: 35% !important;
        right: 0;
        text-align: center;
        font-size: clamp(108px, 21vw, 615px);
        font-weight: 900;
        color: rgba(255, 255, 255, 0.08) !important;
        white-space: nowrap;
        pointer-events: none;
        z-index: 1;
        line-height: 0.8;
        margin-left: -120px;
        font-family: 'PPEditorial New Ultrabold', serif;
        margin-top: -140px !important;
        font-weight: 600;
        margin-bottom: 90px;
    }
 }
 @media only screen and (min-width: 1400px) {
    .footer-background-text {
        position: absolute;
         bottom: -450px !important;
         left: 50% !important;
        right: 0;
        text-align: center;
        font-size: clamp(289px, 21vw, 615px);
        font-weight: 900;
        color: rgba(255, 255, 255, 0.08) !important;
        white-space: nowrap;
        pointer-events: none;
        z-index: 1;
        line-height: 0.8;
        margin-left: -120px;
        font-family: 'PPEditorial New Ultrabold', serif;
        margin-top: -140px !important;
        font-weight: 600;
        margin-bottom: 90px;
    }
 }
 .footer-background-image {
    width: calc(100vw - 40px);
    margin-left: calc(-36vw + 68% + 20px);
    padding: 10px 0;
    text-align: center;
}
@media only screen and (min-width: 768px) and (max-width: 1024px) {
 .custom-footer {
    padding: 30px 0 750px !important;
    position: relative;
    overflow: hidden;
}
.footer-background-text {
    position: absolute;
    bottom: -765px !important;
    left: 45%;
    z-index: 1;
  }
}
.footer-background-link {
  display: inline-block;
  position: relative;
  z-index: 10;
  pointer-events: auto;
}

.footer-background-image {
  pointer-events: auto;
}
</style>

