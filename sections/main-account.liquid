{{ 'customer.css' | asset_url | stylesheet_tag }}

{%- style -%}
.customer.account {
  max-width: 1000px;
  margin: 0 auto;
  padding: 155px 20px;
  font-family: "Unbounded", sans-serif;
  color: #012169;
}
.customer.account h1,
.customer.account h2,
.customer.account h3 {
  margin-bottom: 20px;
}
.customer.account .welcome {
  font-size: 28px;
  font-weight: 600;
  margin-bottom: 30px;
}
.customer.account .section {
  margin-bottom: 50px;
  border-bottom: 1px solid #eee;
  padding-bottom: 30px;
}
.customer.account table {
  width: 100%;
  border-collapse: collapse;
  margin-top: 15px;
}
.customer.account table th,
.customer.account table td {
  border: 1px solid #eee;
  padding: 10px;
  text-align: left;
}
.customer.account a {
  color: #1a73e8;
  text-decoration: none;
}
.customer.account a:hover {
  text-decoration: underline;
}
{%- endstyle -%}

<div class="customer account">
  <div class="welcome">
    Welcome, {{ customer.first_name }}!
  </div>

  <!-- Orders Section -->
  <div class="section orders">
    <h2>Your Orders</h2>
    {% if customer.orders_count > 0 %}
      <table>
        <thead>
          <tr>
            <th>Order #</th>
            <th>Date</th>
            <th>Payment</th>
            <th>Fulfillment</th>
            <th>Total</th>
          </tr>
        </thead>
        <tbody>
          {% for order in customer.orders %}
            <tr>
              <td>
                <a href="{{ order.customer_url }}">#{{ order.name }}</a>
              </td>
              <td>{{ order.created_at | date: "%b %d, %Y" }}</td>
              <td>{{ order.financial_status_label }}</td>
              <td>{{ order.fulfillment_status_label }}</td>
              <td>{{ order.total_price | money_with_currency }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    {% else %}
      <p>You have no orders yet.</p>
    {% endif %}
  </div>

  <!-- Account Details Section -->
  <div class="section account-details">
    <h2>Account Details</h2>
    <p><strong>Email:</strong> {{ customer.email }}</p>
    <p><strong>First Name:</strong> {{ customer.first_name }}</p>
    <p><strong>Last Name:</strong> {{ customer.last_name }}</p>

    <a href="{{ routes.account_edit_url }}">Edit Account Details</a>
  </div>

  <!-- Addresses Section -->
  <div class="section addresses">
    <h2>Addresses</h2>
    {% if customer.addresses_count > 0 %}
      <ul>
        {% for address in customer.addresses %}
          <li>
            {{ address.name }} — {{ address.address1 }}, {{ address.city }}, {{ address.country }}
            {% if address.default %}(Default){% endif %}
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <p>You have no saved addresses.</p>
    {% endif %}

    <a href="{{ routes.account_addresses_url }}">Manage Addresses</a>
  </div>

  <!-- Logout -->
  <div class="section logout">
    <a href="{{ routes.account_logout_url }}">Log Out</a>
  </div>
</div>
