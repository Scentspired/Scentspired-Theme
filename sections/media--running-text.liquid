{{ 'media--running-text.css' | asset_url | stylesheet_tag }}

<div class="running-text-wrapper">
  <div class="running-text-track">
    {% for i in (1..2) %}
      <div class="running-text-content">
        <span class="marquee-spacer"></span>
        <span>{{ section.settings.text_left }}</span>
        {% if section.settings.icon_image != blank %}
          <img src="{{ section.settings.icon_image | image_url: width: 60 }}" alt="{{ 'sections.running_text.icon_alt' | t }}" />
        {% endif %}
        <span>{{ section.settings.text_center }}</span>
        {% if section.settings.icon_image != blank %}
          <img src="{{ section.settings.icon_image | image_url: width: 60 }}" alt="{{ 'sections.running_text.icon_alt' | t }}" />
        {% endif %}
        <span>{{ section.settings.text_right }}</span>
        {% if section.settings.icon_image != blank %}
          <img src="{{ section.settings.icon_image | image_url: width: 60 }}" alt="{{ 'sections.running_text.icon_alt' | t }}" />
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Running Text Marquee",
  "settings": [
    {
      "type": "text",
      "id": "text_left",
      "label": "Left Text",
      "default": "Daily Dew"
    },
    {
      "type": "text",
      "id": "text_center",
      "label": "Center Text",
      "default": "Pure Brilliance"
    },
    {
      "type": "image_picker",
      "id": "icon_image",
      "label": "Icon Image"
    },
    {
      "type": "text",
      "id": "text_right",
      "label": "Right Text",
      "default": "Varnava Blends"
    }
  ],
  "presets": [
    {
      "name": "Running Text Marquee"
    }
  ]
}
{% endschema %}
