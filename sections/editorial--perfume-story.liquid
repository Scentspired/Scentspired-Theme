{{ 'editorial--perfume-story.css' | asset_url | stylesheet_tag }}

<section class="perfume-story-section">
  <div class="perfume-story-container">
    <div class="perfume-story-content">
      <h1 class="main-headline">
        {{ section.settings.main_headline }}
      </h1>

      <p class="story-text">
        {{ section.settings.story_text }}
      </p>

      <p class="get-scentspired">
        {{ section.settings.tagline }}
      </p>

      <a href="{{ section.settings.button_link }}" class="shop-button">
        {{ section.settings.button_text }}
      </a>
    </div>

    <div class="perfume-story-image">
      {%- comment -%} A stand-in pointed at /images/image.png, which does not exist; every region sets the image. {%- endcomment -%}
      {% if section.settings.hero_image %}
        {%- liquid
          assign image_alt = section.settings.hero_image.alt
          if image_alt == blank
            assign image_alt = 'sections.perfume_story.image_alt' | t
          endif
        -%}
        <img
          src="{{ section.settings.hero_image | img_url: '1200x' }}"
          alt="{{ image_alt | escape }}"
          loading="lazy">
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Perfume Story Section",
  "settings": [
    {
      "type": "text",
      "id": "main_headline",
      "label": "Main Headline",
      "default": "We are not just a perfume house."
    },
    {
      "type": "textarea",
      "id": "story_text",
      "label": "Story Text",
      "default": "We are storytellers of scent. And we invite you to find the fragrance that tells your story. Whether it's bold and daring, soft and nostalgic, or vibrant and unexpected—your signature scent is out there, waiting to be discovered. Let your senses lead the way, and begin your journey through our curated collection designed to speak to your soul."
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Get Scentspired."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "SHOP PRODUCTS"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "default": "/collections/all"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    }
  ],
  "presets": [
    {
      "name": "Perfume Story Section"
    }
  ]
}
{% endschema %}
