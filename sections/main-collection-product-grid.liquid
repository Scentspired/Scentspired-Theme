<style>
    {% comment %} Font Imports {% endcomment %}
    @import url('https://fonts.googleapis.com/css2?family=Unbounded:wght@300;400;700&display=swap');
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;1,500&family=Libre+Bodoni:ital,wght@0,400;0,500;1,400;1,500&display=swap');

    {% comment %} Custom Font Faces {% endcomment %}
    {% comment %} ========== SIDEBAR STYLES ========== {% endcomment %}

    .fragrance-rating {
      margin-top: 0px !important;
  }

    .product-badges {
    position: absolute;
    top: 10px;
    left: 15px;
    z-index: 5;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .product-badge {
    background-color: #FFFFFF;
    color: #000000 !important;
    font-family: 'PPMori Regular', sans-serif;
    font-weight: 400 !important;
    font-size: 12px !important;
    padding: 2px 20px !important;
    border-radius: 20px;
    white-space: nowrap;
    text-transform: capitalize;
    display: inline-block;
  }

    .scent-sidebar details summary {
      font-family: 'PPMori Regular';
      font-size: 13px;
      cursor: pointer;
      list-style: none;
      position: relative;
      padding-right: 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      color: black;
    }

    .scent-sidebar details summary::after {
      content: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1L6 6L11 1' stroke='%23000000' stroke-width='1.5'/%3E%3C/svg%3E");
      transition: transform 0.3s ease;
    }

    .scent-sidebar details[open] summary::after {
      transform: rotate(180deg);
    }

    .scent-overlay-search-input {
      font-family: 'PP Mori', sans-serif;
      border-right: 1px solid #e0e0e0;
    }

    .scent-sidebar details {
      border-bottom: 1px solid #ddd;
      padding-bottom: 8px;
      margin-bottom: 16px;
    }

    {% comment %} Add scrollable container for filter items {% endcomment %}
    .scent-sidebar details > div {
      padding-left: 10px;
      margin-top: 6px;
      max-height: 160px;
      overflow-y: auto;
      padding-right: 8px;
    }

    {% comment %} Style scrollbar for better appearance {% endcomment %}
    .scent-sidebar details > div::-webkit-scrollbar {
      width: 6px;
    }

    .scent-sidebar details > div::-webkit-scrollbar-track {
      background: #f1f1f1;
      border-radius: 3px;
    }

    .scent-sidebar details > div::-webkit-scrollbar-thumb {
      background: #d0d0d0;
      border-radius: 3px;
    }

    .scent-sidebar details > div::-webkit-scrollbar-thumb:hover {
      background: #a0a0a0;
    }

    {% comment %} Firefox scrollbar styling {% endcomment %}
    .scent-sidebar details > div {
      scrollbar-color: #d0d0d0 #f1f1f1;
      scrollbar-width: thin;
    }

    @font-face {
      font-family: 'PPMori Extralight';
      src: url('https://cdn.shopify.com/s/files/1/0698/9398/0343/files/PPMori-Extralight.otf?v=1751619970') format('opentype');
      font-weight: 200;
      font-style: normal;
    }

    @font-face {
      font-family: 'PPEditorialNew Italic';
      src: url('https://cdn.shopify.com/s/files/1/0698/9398/0343/files/PPEditorialNew-Italic-BF644b214fb0c0a.otf?v=1751620955') format('opentype');
      font-weight: 900;
      font-style: italic;
    }

    @font-face {
      font-family: 'PPMori Regular';
      src: url('https://cdn.shopify.com/s/files/1/0698/9398/0343/files/PPMori-Regular.otf?v=1751621372') format('opentype');
      font-weight: 400;
      font-style: normal;
    }

    /* ========== GLOBAL STYLES ========== */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', sans-serif;
      background-color: #ffffff;
      color: #333;
      line-height: 1.6;
    }

    {% comment %} ========== BASE WRAPPER STYLES ========== {% endcomment %}
    .scent-wrapper {
      padding: 40px 20px;
    }
    .scent-layout{
      max-width: 2100px !important;
      margin: 0 auto !important;
     padding-left: 4rem !important;
    padding-right: 4rem !important;
    }

    /* ========== RESPONSIVE LAYOUT CONTAINERS ========== */
    @media screen and (max-width: 1199px) {
      .scent-header-content-wrapper {
        /* Made container responsive instead of fixed 1200px */
        max-width: min(1400px, 95vw);
        margin: 0 auto;
        padding: 0 2rem;
      }
      .scent-layout {
        /* Made layout container responsive instead of fixed 1200px */
        max-width: min(1400px, 95vw);
        margin: 0 auto;
        padding: 0 2rem;
      }
      /* Match header alignment when sidebar is hidden on responsive screens */
      .scent-layout.sidebar-hidden {
        max-width: min(1400px, 95vw) !important;
        margin: 0 auto !important;
        padding: 0 2rem !important;
      }
    }

    {% comment %} ========== DESKTOP SPECIFIC STYLES ========== {% endcomment %}
    @media screen and (min-width: 1200px) {
      .scent-header-content-wrapper {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 2rem;
      }
      .scent-layout {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 2rem;
        /* Ensure sidebar + products align with header right edge */
        box-sizing: border-box;
      }
      /* Align products with header when sidebar is hidden */
      .scent-layout.sidebar-hidden {
        max-width: 1200px !important;
        margin: 0 auto !important;
        padding: 0 2rem !important;
      }
    }

    {% comment %} ========== HEADER STYLES ========== {% endcomment %}
    .scent-header-container {
      margin-bottom: 30px;
    }

    .scent-title-row {
      display: flex;
      align-items: flex-end;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 20px;
    }

    .scent-main-title {
      font-family: 'PPMori Regular';
      font-weight: 500;
      color: #000;
      line-height: 1;
      margin: 0;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }

    .scent-main-title .small-text {
      font-size: 24px;
      font-weight: 300;
      color: #333;
    }

    .scent-main-title .large-text {
      font-size: 48px;
      font-weight: 500;
      color: #000;
    }

    .scent-sub-description {
      font-family: 'Inter', sans-serif;
      font-size: 16px;
      color: #333;
      margin: 0;
      max-width: 600px;
    }

    .scent-sub-description strong {
      font-weight: 600;
      color: #E57373;
    }

    {% comment %} ========== NAVIGATION STYLES ========== {% endcomment %}
    .scent-collection-nav {
      display: flex;
      flex-wrap: nowrap;
      gap: 9px;
      margin-bottom: 30px;
      align-items: center;
    }

    .scent-collection-nav a,
    .scent-collection-nav button {
      font-family: 'PPMori Regular';
      font-size: 13px;
      font-weight: 500;
      padding: 8px 16px;
      border-radius: 999px;
      border: 1px solid #e0e0e0;
      background-color: #fff;
      color: #333;
      text-decoration: none;
      white-space: nowrap;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .scent-collection-nav a:hover,
    .scent-collection-nav button:hover {
      border-color: #a0a0a0;
    }

    .scent-collection-nav a.active {
      background: linear-gradient(90deg, #FFF8F0 0%, #FFF0E0 100%);
      color: #000;
      border-color: #FFF8F0;
    }

    .scent-collection-nav .filter-toggle-button {
      margin-left: auto;
      display: flex;
      align-items: center;
      gap: 5px;
    }

    .scent-collection-nav .filter-toggle-button svg {
      width: 16px;
      height: 16px;
    }

    {% comment %} ========== DESKTOP FILTER BUTTON ========== {% endcomment %}
    .filter-toggle-desktop {
      font-family: 'PPMori Regular';
      font-size: 14px;
      font-weight: 500;
      padding: 8px 16px;
      border-radius: 999px;
      border: 1px solid #e0e0e0;
      background-color: #fff;
      color: #333;
      cursor: pointer;
      transition: all 0.2s ease;
      display: flex;
      align-items: center;
      gap: 5px;
      margin-left: auto;
      white-space: nowrap;
      flex-shrink: 0;
    }

    {% comment %} ========== DESKTOP VIEW POSITIONING ========== {% endcomment %}
    @media (min-width: 1200px) {
      .filter-toggle-desktop {
        display: flex !important;
      }
      .scent-collection-nav .filter-toggle-button {
        display: none !important;
      }
      .scent-layout {
        /* Fixed layout to be proper sidebar layout, not stacked */
        display: grid !important;
        grid-template-columns: 300px 1fr !important;
        gap: 2rem !important;
        position: relative;
        align-items: start;
        /* Ensure total width including sidebar aligns with header */
        box-sizing: border-box;
      }
      .scent-sidebar {
        /* Proper sidebar positioning - sticky to stay in view */
        position: sticky !important;
        top: 20px !important;
        left: auto !important;
        width: 100% !important;
        height: fit-content;
        z-index: 1;
      }
      .scent-grid {
        /* Exactly 3 products per row for desktop */
        display: grid !important;
        grid-template-columns: repeat(3, 1fr) !important;
        gap: 2rem !important;
        margin-left: 0 !important;
        grid-column: auto !important;
      }
      .scent-card {
        /* Auto width to fit exactly in 3-column grid */
        width: 100% !important;
        max-width: none !important;
      }
      .scent-layout.sidebar-hidden .scent-sidebar {
        display: none !important;
      }
      .scent-layout.sidebar-hidden {
        /* Full width when sidebar hidden, still 3 columns */
        grid-template-columns: 1fr !important;
      }
      .scent-layout.sidebar-hidden .scent-grid {
        /* Still 3 products per row when sidebar hidden on desktop */
        grid-template-columns: repeat(3, 1fr) !important;
      }
    }

    {% comment %} ========== LAPTOP VIEW STYLES ========== {% endcomment %}
   /* ========== Make collection nav scrollable ========== */
  @media screen and (min-width: 800px) and (max-width: 1199px) {
    .scent-collection-nav {
      display: flex;
      overflow-x: auto; /* horizontal scroll */
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch; /* smooth scrolling on iOS */
      gap: 0.75rem; /* space between buttons */
      padding-bottom: 0.5rem; /* optional: space below buttons */
    }

    /* Hide native scrollbar */
    .scent-collection-nav::-webkit-scrollbar {
      display: none;
    }
    .scent-collection-nav {
      -ms-overflow-style: none; /* IE and Edge */
      scrollbar-width: none; /* Firefox */
    }

    .scent-collection-nav a,
    .scent-collection-nav button {
      flex: 0 0 auto; /* prevent shrinking */
    }
  }



    @media (min-width: 1440px) {
      .scent-layout {
        max-width: min(1400px, 90vw) !important;
        margin: 0 auto !important;
        /* Slightly wider sidebar for large screens */
        grid-template-columns: 320px 1fr !important;
        gap: 2.5rem !important;
        /* Ensure total width including sidebar aligns with header */
        box-sizing: border-box;
      }
      .scent-grid {
        /* Still 3 products per row on large screens */
        grid-template-columns: repeat(3, 1fr) !important;
        gap: 2rem !important;
      }
      .scent-card {
        width: 100% !important;
        max-width: none !important;
      }
    }

    {% comment %} ========== MOBILE VIEW STYLES (UNCHANGED) ========== {% endcomment %}
    @media (max-width: 1019px) {
      .scent-collection-nav .filter-toggle-button,
      .filter-toggle-desktop {
        display: none !important;
      }
      .scent-sidebar {
        display: none !important;
      }
      .scent-layout {
        grid-template-columns: 1fr !important;
      }
      .scent-grid {
        margin-left: 0 !important;
        grid-column: auto !important;
      }
    }

    {% comment %} ========== SEARCH AREA STYLES ========== {% endcomment %}
    .scent-search-area {
      margin-bottom: 10px;
    }

    {% comment %} ========== SEARCH BACKGROUND RESPONSIVE ========== {% endcomment %}
    @media screen and (min-width: 800px) {
      .scent-search-background {
        background: #f3f3f3;
        border-radius: 999px;
        padding: 8px;
        display: flex;
        align-items: center;
        gap: 10px;
        /* Made search width responsive instead of fixed 1310px */
        width: min(1310px, 90vw) !important;
        max-width: 1400px !important;
      }
    }

    .scent-search-background {
      background: #f3f3f3;
      border-radius: 999px;
      padding: 8px;
      display: flex;
      align-items: center;
      gap: 10px;
      overflow: hidden;
    }

    .scent-search-tags {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
      flex-shrink: 0;
      max-width: 100%;
    }

    .scent-search-tags::-webkit-scrollbar {
      display: none;
    }

    .scent-search-tag {
      font-family: 'PPMori Regular', sans-serif;
      font-size: 13px;
      padding: 8px 16px;
      border-radius: 999px;
      background-color: #fff;
      border: 1px solid #e0e0e0;
      color: #333;
      white-space: nowrap;
      cursor: pointer;
      transition: background-color 0.2s ease;
    }

    .scent-search-input-wrapper {
      flex-grow: 1;
      position: relative;
    }

    .scent-search-input {
      width: 100%;
      padding: 12px 20px;
      border-radius: 999px;
      border: 1px solid #e0e0e0;
      font-family: 'Inter', sans-serif;
      font-size: 14px;
      color: #333;
      outline: none;
      box-shadow: none;
      transition: border-color 0.2s ease;
      background-color: #fff;
    }

    .scent-search-input::placeholder {
      color: #888;
    }

    .scent-search-input:focus {
      border-color: #000;
    }

    .scent-search-tag-add {
      background-color: #000;
      color: #fff;
      font-weight: 600;
      padding: 6px 12px;
      border-radius: 999px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      line-height: 1;
    }

    {% comment %} ========== SEARCH EXPANDED OVERLAY ========== {% endcomment %}
    .scent-search-expanded-overlay.open {
      max-height: 1000px;
      opacity: 1;
      /* Made overlay width responsive instead of fixed 1310px */
      width: min(1310px, 90vw) !important;
      max-width: 1400px !important;
    }

    .scent-search-expanded-overlay {
      background: #f3f3f3;
      border-radius: 12px;
      padding: 20px;
      display: flex;
      flex-direction: column;
      overflow-y: auto;
      max-height: 0;
      opacity: 0;
      transition: max-height 0.3s ease-out, opacity 0.3s ease-out;
    }

    @media screen and (min-width: 1441px) {
      .scent-search-expanded-overlay.open {
        max-height: 1000px;
        opacity: 1;
      }
    }

    .scent-overlay-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 30px;
    }

    .scent-overlay-search-input-wrapper {
      flex-grow: 1;
      position: relative;
      display: flex;
      align-items: center;
      border-radius: 999px;
      border: 1px solid #e0e0e0;
      background-color: #fff;
      overflow: hidden;
    }

    .scent-overlay-search-input {
      flex-grow: 1;
      padding: 12px 20px;
      border: none;
      font-family: 'PP Mori', sans-serif;
      font-size: 14px;
      color: #333;
      outline: none;
      box-shadow: none;
      background-color: #fff;
      border-right: 1px solid #e0e0e0;
    }

    .scent-overlay-search-button {
      background: none;
      border: none;
      padding: 0 5px;
      cursor: pointer;
      color: #333;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .scent-overlay-search-button svg {
      width: 20px;
      height: 20px;
    }

    .scent-overlay-close-button {
      background: none;
      border: none;
      font-size: 18px;
      cursor: pointer;
      color: #333;
      margin-left: 2px;
    }

    .scent-overlay-section {
      margin-bottom: 30px;
    }

    .scent-overlay-section-title {
      font-family: 'PPMori Regular', sans-serif;
      font-size: 16px;
      font-weight: 600;
      color: #000;
      margin-bottom: 15px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .scent-overlay-section-title svg {
      width: 20px;
      height: 20px;
      color: #333;
    }

    .scent-overlay-tags-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .scent-overlay-tag {
      font-family: 'PPMori Regular', sans-serif;
      font-size: 14px;
      padding: 8px 16px;
      border-radius: 999px;
      background-color: #fff;
      border: 1px solid #e0e0e0;
      color: #333;
      cursor: pointer;
      transition: background-color 0.2s ease;
    }

    .scent-overlay-tag:hover {
      background-color: #f0f0f0;
    }

    .scent-overlay-brands-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }

    {% comment %} ========== COLLECTION LINKS STYLES ========== {% endcomment %}
    .scent-overlay-collection-link {
      position: relative;
      display: block;
      width: 100%;
      padding-bottom: 70%;
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid #e0e0e0;
      background-color: #f0f0f0;
      transition: border-color 0.2s ease;
      text-decoration: none;
    }

    .scent-overlay-collection-link:hover {
      border-color: #000;
    }

    .scent-overlay-collection-content {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    .scent-overlay-collection-content img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .scent-overlay-no-image {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      background-color: #f0f0f0;
      color: #999;
      font-size: 14px;
      font-family: 'Inter', sans-serif;
    }

    .scent-overlay-collection-title-on-image {
      position: absolute;
      top: 15px;
      left: 15px;
      font-family: 'Inter', sans-serif;
      font-size: 16px;
      font-weight: 600;
      color: #fff;
      text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.7);
      text-align: left;
      max-width: calc(100% - 30px);
      word-wrap: break-word;
    }

    .scent-overlay-collection-link > span:not(.scent-overlay-collection-title-on-image) {
      display: none;
    }

    .scent-overlay-scent-notes-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 15px;
    }

    {% comment %} ========== NEW MOBILE PRODUCT PER ROW SELECTOR ========== {% endcomment %}
    .mobile-product-per-row-selector {
      display: none;
      background: #f8f9fa;
      border-radius: 12px;
      padding: 15px;
      margin-bottom: 20px;
      align-items: center;
      justify-content: space-between;
    }

    .mobile-product-per-row-selector .selector-label {
      font-family: 'PPMori Regular', sans-serif;
      font-size: 14px;
      font-weight: 600;
      color: #000;
    }

    .mobile-product-per-row-selector .selector-buttons {
      display: flex;
      gap: 8px;
    }

    .mobile-product-per-row-selector .selector-button {
      background: #fff;
      border: 1px solid #e0e0e0;
      border-radius: 8px;
      padding: 8px 16px;
      font-family: 'PPMori Regular', sans-serif;
      font-size: 12px;
      font-weight: 500;
      color: #333;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .mobile-product-per-row-selector .selector-button.active {
      background: #000;
      color: #fff;
      border-color: #000;
    }

    .mobile-product-per-row-selector .selector-button:hover {
      border-color: #a0a0a0;
    }

    {% comment %} ========== PRODUCT GRID STYLES ========== {% endcomment %}
    .scent-grid {
      display: grid;
      /* Default 4 columns for very large screens, will be overridden by media queries */
      grid-template-columns: repeat(4, 1fr);
      gap: 30px;
      margin-top: 40px;
    }

    .scent-card {
      position: relative;
      overflow: hidden;
      border-radius: 18px;
      font-family: 'Unbounded', sans-serif;
      height: 610px;
      background-color: #fff;
      border: 1px solid #e0e0e0;
      /* Default to 100% width, let grid control sizing */
      width: 100%;
      max-width: none;
    }

    .scent-card img,
    .scent-card video {
      position: absolute;
      top: 0;
      left: 0;
      height: 100%;
      width: 100%;
      object-fit: cover;
      transition: opacity 0.4s ease;
      display: block;
    }

    .scent-card .hover-image {
      position: absolute;
      top: 0;
      left: 0;
      height: 100%;
      width: 100%;
      object-fit: cover;
      opacity: 0;
      transition: opacity 0.4s ease;
    }

    .scent-card:hover .hover-image {
      opacity: 1;
    }

    .scent-price {
      position: absolute;
      top: 20px;
      right: 20px;
      font-size: 16px;
      color: #000;
      z-index: 2;
      font-family: 'PPMori Regular', sans-serif;
      transition: color 0.3s ease;
    }

    .scent-card:hover .scent-price {
      color: #ffffff;
    }

    .scent-bottom-text {
      position: absolute;
      bottom: 5px;
      left: 20px;
      right: 20px;
      color: black;
      text-align: center;
      transition: all 0.3s ease;
    }

    .scent-card:hover .scent-bottom-text {
      transform: translateY(-60px);
      color: white;
    }

    .scent-card:hover .scent-bottom-text .scent-title,
    .scent-card:hover .scent-bottom-text .scent-subtext {
      color: white;
    }

    .scent-overlay {
      position: absolute;
      bottom: 0;
      width: 100%;
      padding: 20px;
      background: linear-gradient(to top, rgba(0, 0, 0, 0.6), transparent);
      color: #fff;
      transform: translateY(100%);
      transition: transform 0.3s ease;
      text-align: center;
    }

