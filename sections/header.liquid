    /* Dossier-style Dropdown Menu - FIXED VISIBILITY */
  .dossier-dropdown {
  position: absolute;
  top: 100%;
  left: 0;
  background: #ffffff;
  border-radius: 16px;
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1),
              0 10px 10px -5px rgba(0, 0, 0, 0.04);
  width: 280px;
  z-index: 1000;

  /* Animation */
  opacity: 0;
  visibility: hidden;
  transform: translateY(-10px);
  transition: opacity 0.3s ease, transform 0.3s ease;

  font-family: 'PPMori Regular', sans-serif;
  padding: 0;
  display: block !important;

  /* 🔥 CRITICAL FIX */
  overflow: visible; /* allow inner scrolling */
}

/* SHOW ON HOVER */
.header__menu-item:hover .dossier-dropdown {
  opacity: 1 !important;
  visibility: visible !important;
  transform: translateY(0) !important;
}

/* SCROLLABLE CONTENT */
.dossier-dropdown-content {
  padding: 20px;

  /* 🔥 SCROLL CONTROL */
  max-height: 550px; /* adjust as needed */
  overflow-y: auto;
  overflow-x: hidden;

  /* Smooth scrolling on iOS */
  -webkit-overflow-scrolling: touch;

  /* Scrollbar styling (Firefox) */
  scrollbar-width: thin;
  scrollbar-color: #d1d5db #f8f9fa;
}

/* Scrollbar styling (Chrome / Edge / Safari) */
.dossier-dropdown-content::-webkit-scrollbar {
  width: 6px;
}

.dossier-dropdown-content::-webkit-scrollbar-track {
  background: #f8f9fa;
  border-radius: 10px;
}

.dossier-dropdown-content::-webkit-scrollbar-thumb {
  background-color: #d1d5db;
  border-radius: 10px;
}


