{% comment %}
  Dual Image Slider Section – Final Mobile Padding Fix
{% endcomment %}

{{ 'media--dual-slider.css' | asset_url | stylesheet_tag }}

<div class="dual-slider-wrapper">
  <!-- Desktop View -->
  <div class="desktop-slider">
    <div class="image-box">
      {% if section.settings.image_1 != blank %}
        <img src="{{ section.settings.image_1 | image_url: width: 1200 }}" alt="Image 1">
      {% endif %}
    </div>
    <div class="image-box">
      {% if section.settings.image_2 != blank %}
        <img src="{{ section.settings.image_2 | image_url: width: 1200 }}" alt="Image 2">
      {% endif %}
    </div>
  </div>

  <!-- Mobile View -->
  <div class="mobile-slider">
    <button class="slider-arrow left">‹</button>
    <button class="slider-arrow right">›</button>

    <div class="mobile-slide-wrapper">
      {% if section.settings.image_1 != blank %}
        <div class="mobile-slide active">
          <img src="{{ section.settings.image_1 | image_url: width: 800 }}" alt="Image 1">
        </div>
      {% endif %}
    </div>
  </div>

  <h2 class="main-heading">Inspired by Icons, Crafted Independently</h2>
  <div class="slider-caption">
    The world of fragrance is rich with legendary houses and iconic creations that continue to inspire perfumers
    globally. At Scentspired, these serve as creative reference points, guiding our understanding of balance, structure,
    and emotion.
    <br>
    <br>
    Each Scentspired fragrance is an independent formulation, carefully developed to capture the essence of admired
    scent styles while expressing its own character. We are not affiliated with or endorsed by any designer or luxury
    brand. Our approach is rooted in respect for the icons that came before us, and for the individuality of the person
    wearing our fragrance.
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const slides = document.querySelectorAll('.mobile-slide');
    const leftArrow = document.querySelector('.slider-arrow.left');
    const rightArrow = document.querySelector('.slider-arrow.right');
    let current = 0;

    function showSlide(index) {
      slides.forEach((s, i) => s.classList.toggle('active', i === index));
    }

    if (leftArrow && rightArrow) {
      leftArrow.addEventListener('click', function () {
        current = (current - 1 + slides.length) % slides.length;
        showSlide(current);
      });

      rightArrow.addEventListener('click', function () {
        current = (current + 1) % slides.length;
        showSlide(current);
      });
    }

    showSlide(current);
  });
</script>

{% schema %}
{
  "name": "Dual Image Slider",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "First Image"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Second Image"
    }
  ],
  "presets": [
    {
      "name": "Dual Image Slider"
    }
  ]
}
{% endschema %}
