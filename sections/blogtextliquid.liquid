
<style>
  .shopify-hardcoded-text-section-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: #ffffff;
    padding: clamp(2rem, 3.5vw, 3.5rem) 1.5rem;
    margin: 0 auto;
  }

  .shopify-hardcoded-text-section-content {
    font-family: 'PPMori Regular', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-weight: 300;
    font-style: normal;
    font-size: clamp(1.35rem, 2.6vw, 2.25rem);
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: #121212;
    max-width: 900px;
    width: 100%;
    text-align: left;
    margin: 0 auto;
  }

  .shopify-hardcoded-text-section-content p {
    margin: 0 0 1.5rem;
  }
  .shopify-hardcoded-text-section-content p:last-child {
    margin-bottom: 0;
  }
  .shopify-hardcoded-text-section-content a {
    color: #121212;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .shopify-hardcoded-text-section-content strong,
  .shopify-hardcoded-text-section-content b {
    font-weight: 600;
    color: #000;
  }
</style>

<div class="shopify-hardcoded-text-section-wrapper">
  <div class="shopify-hardcoded-text-section-content">
    {{ section.settings.text_content }}
  </div>
</div>

{% schema %}
{
  "name": "Blog Text Liquid",
  "settings": [
    {
      "type": "richtext",
      "id": "text_content",
      "label": "Text Content",
      "default": "<p>There is a glass cabinet in quite a lot of British homes.</p><p><strong>So we built one.</strong></p>"
    }
  ],
  "presets": [
    {
      "name": "Blog Text Liquid"
    }
  ]
}
{% endschema %}