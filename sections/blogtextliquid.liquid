
<style>
  .shopify-hardcoded-text-section-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: #FAF8F5;
    padding: clamp(3.5rem, 5vw, 4.5rem) 1.5rem;
    margin: 0 auto;
  }

  .shopify-hardcoded-text-section-content {
    font-family: var(--font-body);
    font-weight: 350;
    font-style: normal;
    font-size: clamp(1.0625rem, 1.25vw, 1.1875rem);
    line-height: 1.85;
    letter-spacing: -0.01em;
    color: #2D2A26;
    max-width: 720px;
    width: 100%;
    text-align: left;
    margin: 0 auto;
  }

  .shopify-hardcoded-text-section-content p {
    margin: 0 0 1.65rem;
  }
  .shopify-hardcoded-text-section-content p:last-child {
    margin-bottom: 0;
  }
  .shopify-hardcoded-text-section-content a {
    color: #8C6D46;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }
  .shopify-hardcoded-text-section-content a:hover {
    color: #121212;
  }

  .shopify-hardcoded-text-section-content strong,
  .shopify-hardcoded-text-section-content b {
    font-weight: 600;
    color: #121212;
  }
</style>

<div class="shopify-hardcoded-text-section-wrapper">
  <div class="shopify-hardcoded-text-section-content">
    {{ section.settings.text_content }}
  </div>
</div>

{% schema %}
{
  "name": "Blog Text Liquid",
  "settings": [
    {
      "type": "richtext",
      "id": "text_content",
      "label": "Text Content",
      "default": "<p>There is a glass cabinet in quite a lot of British homes.</p><p><strong>So we built one.</strong></p>"
    }
  ],
  "presets": [
    {
      "name": "Blog Text Liquid"
    }
  ]
}
{% endschema %}