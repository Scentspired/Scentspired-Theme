{%- liquid
  # Prices below used to be prefixed with a hardcoded currency symbol, which
  # shipped one region's currency to every storefront.
  capture region_currency_symbol
    render 'region--active', key: 'currency_symbol'
  endcapture
  assign region_currency_symbol = region_currency_symbol | strip
-%}
{% comment %}
  Discovery Box Builder
  - 5 slots with dynamic progress timeline
  - Desktop: Auto-open first slot, sequential product filling, auto-advance to next slot
  - Mobile: Original flexible behavior (no auto-select, manual slot selection)
  - Direct to checkout redirect
  - Selection flow: Brand -> Product
  - Requires exactly 5 items to checkout
{% endcomment %}

<style>
  :root {
    --perfume-gold: #b39152;
    --perfume-dark: #000;
    --perfume-gray: #f2f2f2;
    --sidebar-bg: #f5f0e6;
    --border-dashed: #a8a095;
    --font-primary: 'Montserrat', sans-serif;
  }

  .perfume-bundle-section {
    max-width: 1400px;
    margin: 0 auto;
    padding: 40px 20px;
    background: #fff;
    font-family: var(--font-primary);
  }

  .builder-layout {
    display: flex;
    gap: 40px;
    position: relative;
    align-items: flex-start;
  }

  /* SIDEBAR: YOUR PRODUCT BUNDLE */
  .bundle-sidebar {
    flex: 0 0 420px;
    background: #f3f3f3;
    border: 1px solid #000;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .sidebar-header {
    padding: 25px 20px;
    border-bottom: 1px solid #000;
    background: #f3f3f3;
  }

  .sidebar-header h2 {
    font-size: 22px;
    margin: 0 0 10px;
    color: #000;
    font-weight: 600;
  }

  .sidebar-header p {
    font-size: 14px;
    color: #000;
    line-height: 1.4;
    margin: 0;
  }

  .slots-wrapper {
    padding: 30px 20px;
    position: relative;
    display: flex;
    gap: 20px;
  }

  /* Progress Line Sidebar */
  .progress-timeline {
    position: relative;
    width: 20px;
    display: flex;
    justify-content: center;
  }

  .progress-line {
    position: absolute;
    top: 5px;
    bottom: 5px;
    width: 2px;
    background: #000;
  }

  .progress-marker {
    position: absolute;
    width: 10px;
    height: 10px;
    background: #fff;
    border: 2px solid #000;
    border-radius: 50%;
    left: 50%;
    transform: translateX(-50%);
  }

  .progress-marker.active {
    background: #f4ff41;
    border-color: #f4ff41;
    width: 14px;
    height: 14px;
  }

  .progress-label {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    background: #fff;
    border: 1px solid #000;
    border-radius: 50%;
    width: 12px;
    height: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s;
  }

  .progress-label.active {
    border-color: #f4ff41;
    background: #f4ff41;
  }

  .slot-list {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .slot-item {
    background: #fff;
    border: 1px solid #000;
    border-radius: 4px;
    padding: 12px;
    min-height: 100px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 15px;
    position: relative;
    transition: 0.2s;
  }

  .slot-item.empty {
    border: 1px dashed var(--border-dashed);
    background: transparent;
  }

  .slot-item.active {
    border-color: #000;
    box-shadow: 0 0 0 1px #000;
  }

  .slot-placeholder-icon {
    width: 50px;
    height: 60px;
    border: 1px dashed var(--border-dashed);
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ccc;
    font-size: 20px;
  }

  .slot-placeholder-text {
    flex: 1;
  }

  .slot-placeholder-text .primary {
    display: block;
    font-size: 14px;
    color: #888;
  }

  .slot-placeholder-text .unlock {
    display: block;
    font-size: 16px;
    color: #000;
    font-weight: 600;
    margin-top: 4px;
  }

  .slot-filled-content {
    display: flex;
    align-items: center;
    gap: 15px;
    width: 100%;
  }

  .slot-img {
    width: 65px;
    height: 65px;
    background: #f9f9f9;
    padding: 5px;
    border-radius: 4px;
  }

  .slot-img img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .slot-info {
    flex: 1;
  }

  .slot-info h4 {
    margin: 0;
    font-size: 16px;
    color: #333;
    font-weight: 600;
  }

  .slot-info p {
    margin: 3px 0 0;
    font-size: 13px;
    color: #888;
    font-style: italic;
  }

  .slot-price {
    font-size: 15px;
    font-weight: 600;
    margin-top: 5px;
  }

  .remove-item {
    position: absolute;
    top: 5px;
    right: 5px;
    background: #f0f0f0;
    border: none;
    border-radius: 50%;
    width: 25px;
    height: 25px;
    font-size: 18px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* SIDEBAR FOOTER */
  .sidebar-footer {
    padding: 0;
    background: #fff;
    border-top: 1px solid #000;
  }

  .add-to-cart-btn {
    width: 100%;
    background: #f4ff41;
    color: #000;
    padding: 20px;
    font-size: 15px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    border: none;
    cursor: pointer;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 15px;
    border-radius: 40px;
  }

  .add-to-cart-btn:disabled {
     background-color: #f4ff41;
    opacity: 0.7;
    cursor: not-allowed;
  }

  /* RIGHT SIDE: DRAWER */
  .selection-drawer {
    flex: 1;
    background: #f9f9f9;
    border-radius: 12px;
    padding: 40px;
    max-height: 800px;
    overflow-y: auto;
    display: none;
    position: sticky;
    top: 40px;
  }

  .selection-drawer.visible {
    display: block;
  }

  .drawer-title {
    font-size: 20px;
    text-transform: uppercase;
    margin-bottom: 30px;
    letter-spacing: 1px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .drawer-title-content {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1;
  }

  .drawer-title-text {
    flex: 1;
  }
.back-arrow-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 24px;
    color: #000;
    padding: 0;
    display: none;
    transition: 0.2s;
    line-height: 1;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .back-arrow-btn:hover {
    opacity: 0.6;
  }

  .back-arrow-btn.visible {
    display: flex;
  }

  /* List Styles */
  .option-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .option-item {
    background: #fff;
    padding: 15px 20px;
    border-radius: 8px;
    border: 1px solid #eee;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 15px;
    transition: 0.2s;
  }

  .option-item:hover {
    border-color: #f4ff41;
    background: #fff;
  }

  .item-thumb {
    width: 50px;
    height: 50px;
    background: #f2f2f2;
    border-radius: 6px;
    overflow: hidden;
  }

  .item-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* SEARCH BAR STYLES */
  .search-bar-wrapper {
    width: 100%;
    margin-bottom: 25px;
    display: flex;
    gap: 0;
  }

  .search-input-container {
    flex: 1;
    position: relative;
    display: flex;
    align-items: center;
    background: #fff;
    border: 1px solid #e0e0e0;
    border-radius: 25px;
    padding: 0 20px;
    transition: all 0.3s ease;
  }

  .search-input-container input {
    flex: 1;
    border: none;
    outline: none;
    padding: 12px 0;
    font-size: 15px;
    font-family: var(--font-primary);
    background: transparent;
    color: #333;
    box-shadow: none;
  }

  .search-input-container input::placeholder {
    color: #999;
  }

  .search-icon {
    width: 20px;
    height: 20px;
    background: transparent;
    border-radius: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #000;
    font-size: 16px;
    flex-shrink: 0;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .search-icon:hover {
    color: #e0e635;
    transform: scale(1.1);
  }

  .search-icon svg {
    width: 20px;
    height: 20px;
  }

  .no-results-message {
    text-align: center;
    padding: 40px 20px;
    color: #666;
    font-size: 15px;
  }

  /* MOBILE POPUP */
  @media (max-width: 1024px) {
    .builder-layout {
      flex-direction: column;
    }
    .bundle-sidebar {
      flex: 1 0 auto;
      width: 100%;
    }
    .selection-drawer {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 1000;
      border-radius: 0;
      padding: 20px;
      overflow-y: auto;
    }
    .selection-drawer:not(.visible) {
      display: none;
    }
    .add-to-cart-btn {
    font-size: 11px;
  }
  .sidebar-header h2 {
    font-size: 19px;
    margin: 0 0 10px;
    color: #000;
    font-weight: 600;
}
}
  .cart{
      padding: 15px 20px;
      background: #f3f3f3;
      border-bottom: 1px solid black;
    }
     .savings-row {
    padding: 15px;
    text-align: center;
    font-size: 14px;
    color: #666;
    background: #f3f3f3;
  }
  .save-row {
    padding: 0px;
    text-align: center;
    font-size: 14px;
    color: #000;
    background: #f3f3f3;
        margin-top: -20px;
  }
 .saving {
  font-weight: 600;
  text-decoration: line-through;
  color: #000;
}

</style>

<div class="perfume-bundle-section">
  <div class="builder-layout">
    
    <!-- LEFT SIDEBAR: BUNDLE STATUS -->
    <div class="bundle-sidebar">
      <div class="sidebar-header">
        <h2>Build Your Own Five Favourites</h2>
        <p id="BundleStatusText">Add 5 items to complete your five favourites</p>
      </div>

      <div class="slots-wrapper">
        <div class="progress-timeline">
          <div class="progress-line"></div>
          <div class="progress-marker" style="top: 0%" id="Marker-0"></div>
          <div class="progress-label" style="top: 0%" id="Label-1"></div>
          <div class="progress-marker" style="top: 25%" id="Marker-1"></div>
          <div class="progress-label" style="top: 25%" id="Label-2"></div>
          <div class="progress-marker" style="top: 50%" id="Marker-2"></div>
          <div class="progress-label" style="top: 50%;" id="Label-15"></div>
          <div class="progress-marker" style="top: 75%" id="Marker-3"></div>
          <div class="progress-label" style="top: 75%" id="Label-4"></div>
          <div class="progress-marker" style="top: 98%" id="Marker-4"></div>
          <div class="progress-label" style="top: 98%;" id="Label-25"></div>
        </div>

        <div class="slot-list" id="BundleSlots">
          {% for i in (1..5) %}
            <div class="slot-item empty" data-index="{{ forloop.index0 }}" onclick="openSelector({{ forloop.index0 }})">
              <div class="slot-placeholder-icon">+</div>
              <div class="slot-placeholder-text">
                <span class="primary">Select a product</span>
                <span class="unlock"> {{ 5 | minus: forloop.index | plus: 1 }} Selections Remaining</span>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>

      <div class="sidebar-footer">
      <div class="cart">
<button class="add-to-cart-btn" id="MainActionBtn" disabled onclick="handleCheckout()">
          <span>Add to cart</span>
          <span id="TotalDisplay">{{ region_currency_symbol }} 0</span>
        </button>
      </div>
      <div class="savings-row">
         Standard Price: <span class="saving">{{ region_currency_symbol }}0</span>
        </div>
        <div class="save-row">
         Total Saving <span>{{ region_currency_symbol }}0</span>
        </div>
      </div>
    </div>

    <!-- RIGHT CONTENT: SELECTION DRAWER -->
    <div class="selection-drawer" id="SelectionDrawer">
      <div class="drawer-title">
        <div class="drawer-title-content">
        <button onclick="goBackToStep()" class="back-arrow-btn" id="BackArrowBtn" title="Go back">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
        <span class="drawer-title-text" id="DrawerHeadline">Select Brand</span>
        </div>
        <button onclick="closeSelector()" style="background: none; border: none; cursor: pointer; font-size: 25px;">×</button>
      </div>

      <div id="Step-Size" class="step-container">
        <div class="option-list">
          <div class="option-item" onclick="selectSize('50ml')">
            <span>50ml</span>
          </div>
          <div class="option-item" onclick="selectSize('100ml')">
            <span>100ml</span>
          </div>
        </div>
      </div>

      <div id="Step-Brand" class="step-container">
        <div class="option-list" id="BrandGrid">
          <!-- Brands injected here -->
        </div>
      </div>

      <div id="Step-Product" class="step-container" style="display: none;">
        <div class="search-bar-wrapper">
          <div class="search-input-container">
            <input type="text" id="ProductSearch" placeholder="Search" />
            <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.35-4.35"></path>
            </svg>
          </div>
        </div>
        <div class="option-list" id="ProductGrid">
          <!-- Products injected here -->
        </div>
      </div>
    </div>

  </div>
</div>

<script>
  const currSym = (window.__STORE_CONFIG && window.__STORE_CONFIG.currencySymbol) || '{{ cart.currency.symbol }}' || '$';
  let activeSize = null;
  let currentStep = 'Step-Size';        // Tracks which step is open
let hasAddedFirstProduct = false;     // Becomes true after first product is added
let allFilteredProducts = [];

const PRICING = {
  "50ml": {
    total: 72.99,
    standard: 129.95,
    saving: 56.96
  },
  "100ml": {
    total: 103.99,
    standard: 199.95,
    saving: 95.96
  }
};
// 🔑 Discovery Box main product variants
const DISCOVERY_SET_VARIANT = {
  "50ml": 57083185922393,   // <-- your 50ml variant ID
  "100ml": 57083185955161  // <-- your 100ml variant ID
};

  // Load all products from the 'shop' collection
  const PRODUCTS_BY_SIZE = {
  "50ml": [
    {% paginate collections['bundle-50ml'].products by 100 %}
      {% for product in collections['bundle-50ml'].products %}
        {
          id: {{ product.id }},
          title: {{ product.title | json }},
          vendor: {{ product.vendor | json }},
          image: {{ product.featured_image | img_url: '300x300' | json }},
          tags: {{ product.tags | json }},
variants: [
  {% for variant in product.variants %}
    {
      id: {{ variant.id }},
      title: {{ variant.title | json }},
      price: {{ variant.price }},
      sku: {{ variant.sku | json }},
      available: {{ variant.available | json }}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    {% endpaginate %}
  ],

  "100ml": [
    {% paginate collections['bundle-100ml'].products by 100 %}
      {% for product in collections['bundle-100ml'].products %}
        {
          id: {{ product.id }},
          title: {{ product.title | json }},
          vendor: {{ product.vendor | json }},
          image: {{ product.featured_image | img_url: '300x300' | json }},
          tags: {{ product.tags | json }},
          variants: [
  {% for variant in product.variants %}
    {
      id: {{ variant.id }},
      title: {{ variant.title | json }},
      price: {{ variant.price }},
      sku: {{ variant.sku | json }},
      available: {{ variant.available | json }}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]

        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    {% endpaginate %}
  ]
};


 
  const brands = [
    { tag: "tomford", name: "Tom Ford" },
    { tag: "chanel", name: "Chanel" },
    { tag: "lv", name: "Louis Vuitton" },
    { tag: "bykillian", name: "By Killian" },
    { tag: "byredo", name: "Byredo" },
    { tag: "dior", name: "Dior" },
    { tag: "maisoncrivelli", name: "Maison Crivelli" },
    { tag: "creed", name: "Creed" },
    { tag: "lelabo", name: "Le Labo" },
    { tag: "ysl", name: "YSL" },
    { tag: "burberry", name: "Burberry" },
    { tag: "exnihilos", name: "Ex Nihilo's" },
    { tag: "parfums", name: "Parfums" },
    { tag: "bvlgari", name: "Bvlgari" },
    { tag: "carolinaherrera", name: "Carolina Herrera" },
    { tag: "diptyque", name: "Diptyque" },
    { tag: "giorgioarmani", name: "Giorgio Armani" },
    { tag: "gucci", name: "Gucci" },
    { tag: "herm", name: "Hermès" },
    { tag: "initio", name: "Initio" },
    { tag: "lancôme", name: "Lancôme" },
    { tag: "mfk", name: "MFK" },
    { tag: "narciso", name: "Narciso" },
    { tag: "nasomattos", name: "Nasomatto's" },
    { tag: "nishane", name: "Nishane" },
    { tag: "pacorabanne", name: "Paco Rabanne" }
  ];

  let bundle = [null, null, null, null, null];
  let currentSlot = null;

  function isDesktop() {
    return window.innerWidth > 1024;
  }

  window.addEventListener('DOMContentLoaded', function() {
    if (isDesktop()) {
      openSelector(0);
    }
  });

 function openSelector(index) {
  currentSlot = index;
  document.getElementById('SelectionDrawer').classList.add('visible');

  document.querySelectorAll('.slot-item').forEach(s => s.classList.remove('active'));
  document.querySelector(`.slot-item[data-index="${index}"]`).classList.add('active');

  if (activeSize) {
    showStep('Step-Product');
  } else {
    showStep('Step-Size');
  }
}



  function closeSelector() {
    document.getElementById('SelectionDrawer').classList.remove('visible');
    document.querySelectorAll('.slot-item').forEach(s => s.classList.remove('active'));
  }

  function showStep(id) {
  document.querySelectorAll('.step-container').forEach(c => c.style.display = 'none');
  document.getElementById(id).style.display = 'block';

  currentStep = id;

  const backArrowBtn = document.getElementById('BackArrowBtn');
  if (!backArrowBtn) return;

  // ---- BACK BUTTON LOGIC ----
 // ---- BACK BUTTON LOGIC ----
if (id === 'Step-Size') {
  backArrowBtn.style.display = 'none';
}
else if (id === 'Step-Product') {
  // Show arrow ONLY before first product is added
  backArrowBtn.style.display = hasAddedFirstProduct ? 'none' : 'flex';
}


  // ---- HEADINGS + RENDER ----
  if (id === 'Step-Size') {
  document.getElementById('DrawerHeadline').innerText = 'Select Size';
}

if (id === 'Step-Product') {
  document.getElementById('DrawerHeadline').innerText = 'Select Product';
  renderProducts();
  initSearchListener();
}

}


  function goBackToStep() {
  if (currentStep === 'Step-Product') {
    showStep('Step-Size');
  }
}


  function selectSize(size) {
  activeSize = size;
  showStep('Step-Product');
}

  // Store filtered products for search
  // Handle search input
  function handleSearch(event) {
    const searchQuery = event.target.value;
    renderProducts(searchQuery);
  }

  // Initialize search listener when Step-Product is shown
  function initSearchListener() {
    const searchInput = document.getElementById('ProductSearch');
    if (searchInput) {
      searchInput.value = '';
      searchInput.addEventListener('input', handleSearch);
    }
  }

function renderProducts(searchQuery = '') {
  const grid = document.getElementById('ProductGrid');
  if (!activeSize) return;

  const products = PRODUCTS_BY_SIZE[activeSize] || [];

  const filtered = products.filter(p =>
    Array.isArray(p.variants) &&
    p.variants.some(v => v.available === true)
  );

  allFilteredProducts = filtered;

  let displayProducts = filtered;

  // Apply search filter if query exists
  if (searchQuery.trim()) {
    const query = searchQuery.toLowerCase();
    displayProducts = filtered.filter(p => {
      const matchesTitle = p.title.toLowerCase().includes(query);
      const matchesVendor = p.vendor.toLowerCase().includes(query);
      const matchesTags = p.tags.some(tag => tag.toLowerCase().includes(query));
      
      return matchesTitle || matchesVendor || matchesTags;
    });
  }

  if (displayProducts.length === 0) {
    grid.innerHTML = '<div class="no-results-message">No products found matching your search.</div>';
    return;
  }

  grid.innerHTML = displayProducts.map(p => `
    <div class="option-item" onclick="addProductToBundle(${p.id}, '${activeSize}')">
      <div class="item-thumb"><img src="${p.image}" alt=""></div>
      <span>${p.title} (${p.vendor})</span>
    </div>
  `).join('');
}



// Add product to bundle
function addProductToBundle(id, size) {
  const product = PRODUCTS_BY_SIZE[size].find(p => p.id === id);
  if (!product) return alert('Product not found');

  // Find variant matching the selected size (if variant title contains size)
  const variant = product.variants.find(v => v.title.toLowerCase().includes(size.toLowerCase())) || product.variants[0];

  const isDesktopView = isDesktop();

  if (isDesktopView) {
    // Desktop: fill first empty slot
    const firstEmptyIndex = bundle.findIndex(item => item === null);
    if (firstEmptyIndex !== -1) {
      bundle[firstEmptyIndex] = {
        variantId: variant.id,
        title: product.title,
        sku: variant.sku,
        image: product.image,
        price: variant.price
      };
      if (!hasAddedFirstProduct) {
  hasAddedFirstProduct = true;
}

      updateUI();

      // Open next empty slot
      const nextEmptyIndex = bundle.findIndex(item => item === null);
      if (nextEmptyIndex !== -1) {
        setTimeout(() => openSelector(nextEmptyIndex), 300);
      } else closeSelector();
    }
  } else {
    // Mobile: add to current slot
    bundle[currentSlot] = {
      variantId: variant.id,
      title: product.title,
      sku: variant.sku,
      image: product.image,
      price: variant.price
    };
    if (!hasAddedFirstProduct) {
  hasAddedFirstProduct = true;
}
    updateUI();
    closeSelector();
  }
}


  function removeItem(index) {
    bundle[index] = null;
    updateUI();
  }

  function updateUI() {
    const count = bundle.filter(x => x).length;

    // Update slots
    bundle.forEach((item, i) => {
      const el = document.querySelector(`.slot-item[data-index="${i}"]`);
      if (item) {
        el.classList.remove('empty');
        el.innerHTML = `
          <div class="slot-filled-content">
            <div class="slot-img"><img src="${item.image}" alt=""></div>
            <div class="slot-info">
              <h4>${item.title}</h4>
            </div>
            <button class="remove-item" onclick="event.stopPropagation(); removeItem(${i})">×</button>
          </div>
        `;
      } else {
        el.classList.add('empty');
        el.innerHTML = `
          <div class="slot-placeholder-icon">+</div>
          <div class="slot-placeholder-text">
            <span class="primary">Select a product</span>
            <span class="unlock"> ${5 - i} Selections Remaining</span>
          </div>
        `;
      }
    });

    const totalDisplay = document.getElementById('TotalDisplay');
const mainBtn = document.getElementById('MainActionBtn');

/* Enable button only when exactly 3 items are selected */
mainBtn.disabled = count !== 5;

/* Show price ONLY when bundle is complete */
if (count === 5 && activeSize) {
  const pricing = PRICING[activeSize];

  totalDisplay.innerText = `${currSym} ${pricing.total}`;
  totalDisplay.style.visibility = 'visible';

  document.querySelector('.savings-row .saving').innerText = `${currSym} ${pricing.standard}`;
  document.querySelector('.save-row span').innerText = `${currSym} ${pricing.saving}`;
} else {
  totalDisplay.innerText = '';
  totalDisplay.style.visibility = 'hidden';
}



const statusText = count < 5 ? `Add ${5 - count} more items to complete your Five favourites` : `Your Fifer Favourites are complete!`;
    document.getElementById('BundleStatusText').innerText = statusText;
    // Update progress markers
    document.querySelectorAll('.progress-marker, .progress-label').forEach(el => el.classList.remove('active'));
    for (let i = 0; i < count; i++) {
      if (document.getElementById(`Marker-${i}`)) document.getElementById(`Marker-${i}`).classList.add('active');
    }
    if (count >= 1) document.getElementById('Label-1').classList.add('active');
    if (count >= 2) document.getElementById('Label-2').classList.add('active');
    if (count >= 3) document.getElementById('Label-15').classList.add('active');
    if (count >= 4) document.getElementById('Label-4').classList.add('active');
    if (count >= 5) document.getElementById('Label-25').classList.add('active');
  }

  async function handleCheckout() {
  const btn = document.getElementById('MainActionBtn');
  const priceSpan = btn.querySelector('span:nth-child(2)');

  // Prevent double submission
  if (window.isProcessingCartAction) {
    console.warn('Cart action already in progress');
    return;
  }

  // Safety check
  if (!activeSize || bundle.filter(x => x).length !== 5) {
    alert('Please complete your Five Box.');
    return;
  }

  // Get correct Discovery Box variant
  const variantId = DISCOVERY_SET_VARIANT[activeSize];
  if (!variantId) {
    alert('Discovery Box variant not found.');
    return;
  }

  window.isProcessingCartAction = true;
  btn.disabled = true;
  priceSpan.innerText = "Adding...";

  // Build line item properties
const properties = {};
bundle.forEach((item, index) => {
  if (!item) return;

  properties[`Product ${index + 1}`] = item.title;
  properties[`SKU ${index + 1}`] = item.sku;
  properties[`Variant ID ${index + 1}`] = item.variantId; // ADD THIS
});


  try {
    // Add the Discovery Box to cart
    const response = await fetch('/cart/add.js', {
      method: 'POST',
      headers: { 
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      },
      body: JSON.stringify({
        id: variantId,
        quantity: 1,
        properties: properties
      })
    });

    if (!response.ok) throw new Error('Failed to add to cart');

    console.log('Discovery Box added successfully');

    // ✅ Clear the bundle slots
    bundle = [null, null, null, null, null];
    if (typeof updateUI === 'function') updateUI(); // clears the slot-items in the UI

    // Update button text
    btn.disabled = false;
    priceSpan.innerText = "ADDED!";

    // Fetch updated cart and update UI
    const cartResponse = await fetch('/cart.js');
    const cart = await cartResponse.json();

    if (typeof updateDossierCartUI === 'function') updateDossierCartUI(cart);
    if (typeof openDossierCart === 'function') openDossierCart();

    // Reset button after 2 seconds
    setTimeout(() => {
      priceSpan.innerText = activeSize === '50ml' ? '$29.99' : '$49.99';
      window.isProcessingCartAction = false;
    }, 2000);

  } catch (err) {
    console.error('Add to cart error:', err);
    alert('Failed to add Discovery Box.');
    btn.disabled = false;
    priceSpan.innerText = activeSize === '50ml' ? '$29.99' : '$49.99';
    window.isProcessingCartAction = false;
  }
}


</script>

