{%- comment -%}
  The video is the region's (templates/index.json fills video_url from
  home.json). The desktop_video / mobile_video settings this read were not in
  the schema, so never set: that code, and its stray "c", are gone.
{%- endcomment -%}
<section id="mvps-{{ section.id }}" class="mvps-section" aria-label="{{ 'sections.scent_banner.selector_label' | t }}">

  <div class="mvps-video-wrap" aria-hidden="true">
    <video
      class="mvps-video mvps-desktop mvps-mobile"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      style="filter: brightness(70%);">
      <source src="{{ section.settings.video_url | escape }}" type="video/mp4">
      {{ 'sections.scent_banner.video_unsupported' | t }}
    </video>
  </div>

  {%- liquid
    assign brand_blocks = section.blocks | where: 'type', 'brand'
    assign note_blocks = section.blocks | where: 'type', 'note'
  -%}
  <div class="mvps-overlay">
    <div class="mvps-top">
      <div class="mvps-subtitle">{{ 'sections.scent_banner.inspired_by' | t }}</div>

      <!-- Two dropdown system with Brands and Notes -->
      <div class="mvps-dropdowns-wrapper">
        <!-- Brands Dropdown -->
        <div class="mvps-dropdown-group">
          <div class="mvps-heading-wrap">
            <button class="mvps-dropdown-btn" id="mvps-brands-btn-{{ section.id }}" data-category="brands">
              <span class="mvps-dropdown-text">{{ brand_blocks.first.settings.heading }}</span>
              <svg
                class="mvps-chevron"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                fill="none"
                viewBox="0 0 24 24"
                stroke="#fff"
                stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6" />
              </svg>
            </button>
          </div>

          <!-- Brands Popup -->
          <div class="mvps-popup" id="mvps-brands-popup-{{ section.id }}" style="display:none;">
            <div class="mvps-popup-content">
              <button class="mvps-popup-close" aria-label="{{ 'sections.scent_banner.close' | t }}">×</button>
              <div class="mvps-popup-items">
                {% for block in brand_blocks %}
                  {% assign collection_key = "collection_" | append: forloop.index %}
                  <button
                    class="mvps-popup-item {% if forloop.first %}active{% endif %}"
                    data-index="{{ forloop.index }}"
                    data-collection="{{ collection_key }}"
                    {{ block.shopify_attributes }}>
                    {{ block.settings.heading }}
                  </button>
                {% endfor %}
              </div>
            </div>
          </div>
        </div>

        <!-- Notes Dropdown -->
        <div class="mvps-dropdown-group">
          <div class="mvps-heading-wrap">
            <button class="mvps-dropdown-btn" id="mvps-notes-btn-{{ section.id }}" data-category="notes">
              <span class="mvps-dropdown-text">{{ note_blocks.first.settings.heading }}</span>
              <svg
                class="mvps-chevron"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                fill="none"
                viewBox="0 0 24 24"
                stroke="#fff"
                stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6" />
              </svg>
            </button>
          </div>

          <!-- Notes Popup -->
          <div class="mvps-popup" id="mvps-notes-popup-{{ section.id }}" style="display:none;">
            <div class="mvps-popup-content">
              <button class="mvps-popup-close" aria-label="{{ 'sections.scent_banner.close' | t }}">×</button>
              <div class="mvps-popup-items">
                {% for block in note_blocks %}
                  {% assign collection_key = "collection_notes_" | append: forloop.index %}
                  <button class="mvps-popup-item" data-index="{{ forloop.index }}" data-collection="{{ collection_key }}" {{ block.shopify_attributes }}>
                    {{ block.settings.heading }}
                  </button>
                {% endfor %}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="mvps-content">
      <div class="mvps-fragrance-container">
        <!-- Brands Collections -->
        {% for block in brand_blocks %}
          {% assign collection_key = "collection_" | append: forloop.index %}
          {% assign coll = collections[block.settings.collection] %}
          <div
            class="mvps-fragrance-layout"
            data-collection="{{ collection_key }}"
            {% if forloop.first %}
              data-active="true"
            {% else %}
              style="display:none"
            {% endif %}>
            {% if coll and coll.products_count > 0 %}
              {% for product in coll.products limit: 12 %}
                {% render 'card--product-carousel', product: product %}
              {% endfor %}
            {% else %}
              <div class="mvps-fragrance-item empty">{{ 'sections.scent_banner.no_products' | t }}</div>
            {% endif %}
          </div>
        {% endfor %}

        <!-- Notes Collections -->
        {% for block in note_blocks %}
          {% assign collection_key = "collection_notes_" | append: forloop.index %}
          {% assign coll = collections[block.settings.collection] %}
          <div class="mvps-fragrance-layout" data-collection="{{ collection_key }}" style="display:none;">
            {% if coll and coll.products_count > 0 %}
              {% for product in coll.products limit: 12 %}
                {% render 'card--product-carousel', product: product %}
              {% endfor %}
            {% else %}
              <div class="mvps-fragrance-item empty">{{ 'sections.scent_banner.no_products' | t }}</div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
      <!-- Add pagination dots container below product grid -->
      <div class="mvps-dots-wrapper">
        <div id="mvps-dots-{{ section.id }}" class="mvps-dots-container"></div>
      </div>
    </div>
  </div>

  {{ 'media--mobile-video-banner.css' | asset_url | stylesheet_tag }}

  <script src="{{ 'media--mobile-video-banner.js' | asset_url }}" data-section-id="{{ section.id }}"></script>
</section>

{% schema %}
{
  "name": "Scent Families Video",
  "settings": [
    { "type": "text", "id": "video_url", "label": "Video (MP4 URL)" }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    },
    {
      "type": "note",
      "name": "Note",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scent Families Video Mobile"
    }
  ]
}
{% endschema %}
