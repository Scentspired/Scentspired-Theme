    "blocks_LdziD8": {
      "type": "_blocks",
      "blocks": {
        "ai_gen_block_e9ac98b_PRWMMm": {
          "type": "editorial--split-text",
          "settings": {
            "container_width": 1200,
            "horizontal_padding": 20,
            "padding_top": 80,
            "padding_bottom": 80,
            "column_gap": 20,
            "mobile_gap": 30,
            "mobile_scale": 0.6,
            "background_color": "#ffffff",
            "prefix_text": "",
            "prefix_font_size": 50,
            "brand_scent_text": "",
            "brand_spired_text": "",
            "brand_font_size": 50,
            "start_text": "",
            "start_font_size": 18,
            "bestsellers_text": "",
            "bestsellers_font_size": 52,
            "heading_line_spacing": 4,
            "heading_line_height": 1,
            "heading_color": "#000000",
            "body_text": "Once you start reading fragrance this way, you can't go back. You'll know what you're buying before you hit checkout, you'll understand why the same fragrance smells completely different on your best friend, and you'll have so much more fun exploring. Fragrance is so much more interesting when you know what's going on underneath, and now you do",
            "body_font_size": 25,
            "body_line_height": 1.3,
