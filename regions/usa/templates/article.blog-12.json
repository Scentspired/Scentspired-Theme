          "type": "editorial--luxury-perfume-banner",
          "settings": {
            "heading": "<p>The fragrance gift guide for people who refuse to give boring presents:</p>",
            "heading_size": 40,
            "mobile_heading_size": 16,
            "heading_line_height": 1.1,
            "heading_color": "#000000",
            "paragraph": "<p>luxury inspired perfumes sorted by personality, not price</p>",
            "paragraph_size": 40,
            "mobile_paragraph_size": 16,
            "paragraph_line_height": 1,
            "paragraph_color": "#000000",
            "desktop_image": "shopify://shop_images/The_fragrance_gift_guide_for_people_jpg.jpg",
