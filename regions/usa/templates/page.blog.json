        "blog_item_yhLdnU": {
          "type": "blog_item",
          "settings": {
            "image": "shopify://shop_images/the_most_searched_scent_category_Thumbnail_jpg.jpg",
            "tag": "",
            "title": "How luxury unisex perfumes became the most searched scent category in the UK and why everyone is obsessed",
            "excerpt": "There was a time, not especially long ago, when walking into Boots or Selfridges\nmeant choosing a side. Pink bottles on the left, blue bottles on the right, and an\nentire industry built on the assumption that your gender should decide what you\nsmell like. Nobody seems especially bothered about that any longer. The unisex\nshelf, once a slightly apologetic corner of the fragrance aisle, has quietly started to\ncommand the most shelf space. Ask 10 people why they made the change and you\nwill get 10 different answers, and they all land in roughly the same place.",
            "link": "shopify://blogs/news/how-luxury-unisex-perfumes-became-the-most-searched-scent-category-in-the-uk-and-why-everyone-is-obsessed",
            "link_label": "Read Article"
          }
