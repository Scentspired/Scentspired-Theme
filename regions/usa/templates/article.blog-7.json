            "heading": "<p>EDT, EDP, OR PARFUM:</p>",
            "heading_size": 48,
            "mobile_heading_size": 16,
            "heading_line_height": 1.1,
            "heading_color": "#1a1a1a",
            "paragraph": "<p>the label that determines whether your fragrance lasts all day or ghosts you by noon</p>",
