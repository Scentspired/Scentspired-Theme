  <script>
    /* ---------- 1. helpers ---------- */
    function makeMapper(pxRange) {
      // Factory that returns {mapX, mapY} for a given ±pixel range
      const mapX = gsap.utils.mapRange(0, innerWidth, pxRange, -pxRange);
      const mapY = gsap.utils.mapRange(0, innerHeight, pxRange, -pxRange);
      return () => ({ mapX, mapY }); // closure so we can refresh on resize
    }

    let mkArt = makeMapper(innerWidth * 0.04); // 5 vw in px
    let mkBlank = makeMapper(innerWidth * 0.02); // 2.5 vw in px

    /* ---------- 2. floaty setters ---------- */
    const float = { duration: 0.6, ease: "sine.out" };
    const setArtX = gsap.quickTo(".ai-img_artwork-wrapper", "x", float);
    const setArtY = gsap.quickTo(".ai-img_artwork-wrapper", "y", float);
    const setBlankX = gsap.quickTo(".ai-img_blank-wrapper", "x", float);
    const setBlankY = gsap.quickTo(".ai-img_blank-wrapper", "y", float);

    /* ---------- 3. cursor driver ---------- */
    addEventListener("pointermove", ({ clientX, clientY }) => {
      const { mapX: ax, mapY: ay } = mkArt();
      const { mapX: bx, mapY: by } = mkBlank();
      setArtX(ax(clientX));
      setArtY(ay(clientY));
      setBlankX(bx(clientX));
      setBlankY(by(clientY));
    });

    /* ---------- 4. stay responsive ---------- */
    addEventListener("resize", () => {
      mkArt = makeMapper(innerWidth * 0.05); // 5 vw
      mkBlank = makeMapper(innerWidth * 0.025); // 2.5 vw
    });
  </script>

