<script>
document.getElementById('waitlist-form').addEventListener('submit', function(e) {
  e.preventDefault(); // prevent default form submission

  const form = e.target;
  const formData = new FormData(form);

  fetch(form.action, {
    method: 'POST',
    body: formData,
    headers: {
      'Accept': 'application/json' // ask Shopify for JSON response if possible
    }
  })
  .then(response => response.text())
  .then(html => {
    if (html.includes('g-recaptcha')) {
      // Shopify triggered CAPTCHA
      // Show it in a popup/modal
      const captchaPopup = document.createElement('div');
      captchaPopup.style.position = 'fixed';
      captchaPopup.style.top = '0';
      captchaPopup.style.left = '0';
      captchaPopup.style.width = '100%';
      captchaPopup.style.height = '100%';
      captchaPopup.style.background = 'rgba(0,0,0,0.6)';
      captchaPopup.style.display = 'flex';
      captchaPopup.style.alignItems = 'center';
      captchaPopup.style.justifyContent = 'center';
      captchaPopup.style.zIndex = '9999';
      captchaPopup.innerHTML = html;
      document.body.appendChild(captchaPopup);
    } else {
      // Success
      document.getElementById('waitlist-message').textContent = 'Thank you! You are on the waitlist.';
      form.reset();
    }
  })
  .catch(err => {
    console.error(err);
    document.getElementById('waitlist-message').textContent = 'Something went wrong. Please try again.';
  });
});
</script>

    
