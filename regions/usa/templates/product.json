        "faq_wCTUC3": {
          "type": "faq",
          "settings": {
            "question": "How long does this fragrance last?",
            "answer": "Our perfumes are crafted using high-quality fragrance oils with a higher oil concentration, designed for long-lasting wear. Longevity can vary based on skin type and environment, but most customers experience at least 10 hours of noticeable scent with proper application."
          }
        },
        "faq_FC4YEU": {
          "type": "faq",
          "settings": {
            "question": "Are Scentspired perfumes original, and are they similar to designer fragrances?",
            "answer": "All Scentspired perfumes are original formulations, independently crafted by our perfumers. They are inspired by iconic luxury fragrance profiles, capturing the essence and character of well-known scents while remaining distinct creations. We are not affiliated with any designer brands."
          }
        },
        "faq_REjGjU": {
          "type": "faq",
          "settings": {
            "question": "What concentration are your perfumes?",
            "answer": "Our perfumes are formulated at a high concentration of up to 35% fragrance oils, placing them in the Eau de Parfum to Extrait-level range. This higher concentration delivers a richer scent profile, stronger projection, and longer wear compared to standard formulations."
          }
        },
        "faq_qVb9eT": {
          "type": "faq",
          "settings": {
            "question": "How should I apply the perfume for best results?",
            "answer": "We recommend applying your perfume to pulse points such as the neck, wrists, and behind the ears, where body heat helps the scent develop naturally. Avoid rubbing after application, as this can alter the fragrance structure.\nFor a lighter, all-over effect, you can also spritz the fragrance into the air and walk through it, allowing the scent to gently envelop you. Applying on moisturized skin can further enhance longevity.\nFor more application tips and techniques, you can explore our Blog section."
          }
        },
        "faq_zNXtpk": {
          "type": "faq",
          "settings": {
            "question": "Are Scentspired perfumes suitable for everyday wear?",
            "answer": "Yes. Our collection features a wide range of scent profiles from fresh and clean to warm, bold, and sensual—making them suitable for daily wear, evenings, and special occasions."
          }
        },
