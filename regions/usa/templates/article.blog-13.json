        "ai_gen_block_0232e4c_37U8Va": {
          "type": "ai_gen_block_0232e4c",
          "settings": {
            "heading": "<p>The scent of an American summer: </p>",
            "heading_size": 40,
            "mobile_heading_size": 16,
            "heading_line_height": 1.1,
            "heading_color": "#000000",
            "paragraph": "<p>sunscreen you swear you applied, a screen door slamming, and the fragrance that ties the whole season together</p>",
            "paragraph_size": 40,
            "mobile_paragraph_size": 16,
            "paragraph_line_height": 1,
            "paragraph_color": "#000000",
            "desktop_image": "shopify://shop_images/The_scent_of_an_American_summer_jpg.jpg",
            "image_aspect_ratio": "16/9",
            "horizontal_alignment": "flex-start",
