        "blog_luxury_perfume_banner_37U8Va": {
          "type": "blog--luxury-perfume-banner",
          "settings": {
            "heading": "<p>WE PUT OUR LUXURY INSPIRED PERFUMES UP AGAINST THE ORIGINALS:</p>",
            "heading_size": 48,
            "mobile_heading_size": 24,
            "heading_line_height": 1.1,
            "heading_color": "#1a1a1a",
            "paragraph": "<p>blind wear tests, longevity benchmarks, and what happens when the designer labels come off</p>",
            "paragraph_size": 18,
            "mobile_paragraph_size": 16,
            "paragraph_line_height": 1.4,
            "paragraph_color": "#332F2B",
            "desktop_image": "shopify://shop_images/Best_cologne_for_men_and_luxury_perfumes_for_women.png",
            "image_aspect_ratio": "16/9",
