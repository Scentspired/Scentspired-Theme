        "blog_luxury_perfume_banner_37U8Va": {
          "type": "blog--luxury-perfume-banner",
          "settings": {
            "heading": "<p>MEET SCENTSPIRED:</p>",
            "heading_size": 48,
            "mobile_heading_size": 24,
            "heading_line_height": 1.1,
            "heading_color": "#1a1a1a",
            "paragraph": "<p>because incredible fragrance should be something everyone can enjoy, not just a luxury few</p>",
            "paragraph_size": 18,
            "mobile_paragraph_size": 16,
            "paragraph_line_height": 1.4,
            "paragraph_color": "#332F2B",
            "desktop_image": "shopify://shop_images/TOP_Image_jpg.jpg",
