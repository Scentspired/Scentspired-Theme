        "blog_luxury_perfume_banner_37U8Va": {
          "type": "blog--luxury-perfume-banner",
          "settings": {
            "heading": "<p>THE BEST COLOGNE FOR MEN, CHOSEN FOR YOU:</p>",
            "heading_size": 48,
            "mobile_heading_size": 24,
            "heading_line_height": 1.1,
            "heading_color": "#1a1a1a",
            "paragraph": "<p>a gift guide for the guy who likes to be a little different and refuses to smell like everyone else</p>",
            "paragraph_size": 18,
            "mobile_paragraph_size": 16,
            "paragraph_line_height": 1.4,
            "paragraph_color": "#332F2B",
            "desktop_image": "shopify://shop_images/Last_Blog_Cover_jpg.jpg",
            "image_aspect_ratio": "16/9",
            "horizontal_alignment": "flex-start",
