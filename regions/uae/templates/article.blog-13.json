        "blog_luxury_perfume_banner_37U8Va": {
          "type": "blog--luxury-perfume-banner",
          "settings": {
            "heading": "<p>THE SCENT OF AN AMERICAN SUMMER:</p>",
            "heading_size": 48,
            "mobile_heading_size": 24,
            "heading_line_height": 1.1,
            "heading_color": "#1a1a1a",
            "paragraph": "<p>sunscreen you swear you applied, a screen door slamming, and the fragrance that captures the season</p>",
            "paragraph_size": 18,
            "mobile_paragraph_size": 16,
            "paragraph_line_height": 1.4,
            "paragraph_color": "#332F2B",
            "desktop_image": "shopify://shop_images/The_scent_of_an_American_summer_jpg.jpg",
            "image_aspect_ratio": "16/9",
