        "blog_luxury_perfume_banner_37U8Va": {
          "type": "blog--luxury-perfume-banner",
          "settings": {
            "heading": "<p>WHAT YOU ARE ACTUALLY PAYING FOR IN A $300 LUXURY PERFUME:</p>",
            "heading_size": 48,
            "mobile_heading_size": 24,
            "heading_line_height": 1.1,
            "heading_color": "#1a1a1a",
            "paragraph": "<p>breaking down the real economics behind high-end department store fragrance pricing</p>",
            "paragraph_size": 18,
            "mobile_paragraph_size": 16,
            "paragraph_line_height": 1.4,
            "paragraph_color": "#332F2B",
            "desktop_image": "shopify://shop_images/What_you_are_actually_paying_for_jpg.jpg",
            "image_aspect_ratio": "16/9",
