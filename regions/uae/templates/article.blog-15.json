          "type": "blog--luxury-perfume-banner",
          "settings": {
            "heading": "<p>TRANSITION FROM SUMMER TO AUTUMN FRAGRANCES:</p>",
            "heading_size": 48,
            "mobile_heading_size": 24,
            "heading_line_height": 1.1,
            "heading_color": "#1a1a1a",
            "paragraph": "<p>how to shift your fragrance wardrobe as temperatures drop and crisp air arrives</p>",
            "paragraph_size": 18,
            "mobile_paragraph_size": 16,
            "paragraph_line_height": 1.4,
            "paragraph_color": "#332F2B",
            "desktop_image": "shopify://shop_images/ChatGPT_Image_Jul_14_2026_02_16_37_PM.png",
            "image_aspect_ratio": "16/9",
