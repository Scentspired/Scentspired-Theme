          "type": "ai_gen_block_5c54be2",
          "settings": {
            "heading": "<p>Life Is Too Short</p>",
            "heading_size": 48,
            "mobile_heading_size": 22,
            "heading_line_height": 1.1,
            "heading_color": "#ffffff",
            "paragraph": "<p>To Save Your Good Perfume </p><p>For Best</p>",
            "paragraph_size": 20,
            "mobile_paragraph_size": 16,
            "paragraph_line_height": 1,
            "paragraph_color": "#ffffff",
            "desktop_image": "shopify://shop_images/Why_we_started_Scentspired.png",
            "image_aspect_ratio": "16/9",
            "horizontal_alignment": "flex-start",
            "vertical_alignment": "center",
