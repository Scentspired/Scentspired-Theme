          "settings": {
            "heading": "<p>TOP NOTES, HEART NOTES, BASE NOTES:</p>",
            "heading_size": 48,
            "mobile_heading_size": 24,
            "heading_line_height": 1.1,
            "heading_color": "#1a1a1a",
            "paragraph": "<p>how to decode the fragrance pyramid and understand what you are actually buying</p>",
