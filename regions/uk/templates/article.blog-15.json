          "type": "ai_gen_block_0232e4c",
          "settings": {
            "heading": "<p>THE MAN WHO IS IMPOSSIBLE TO BUY FOR:</p>",
            "heading_size": 48,
            "mobile_heading_size": 24,
            "heading_line_height": 1.1,
            "heading_color": "#1a1a1a",
            "paragraph": "<p>a curated fragrance guide for the guy who claims he already has everything</p>",
            "paragraph_size": 18,
            "mobile_paragraph_size": 16,
            "paragraph_line_height": 1.4,
            "paragraph_color": "#332F2B",
            "desktop_image": "shopify://shop_images/ChatGPT_Image_Jul_14_2026_02_16_37_PM.png",
