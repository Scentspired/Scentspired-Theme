        "ai_gen_block_c88e324_m8PFU4": {
          "type": "ai_gen_block_c88e324",
          "settings": {
            "container_width": 1100,
            "left_column_width": 45,
            "right_column_width": 55,
            "column_gap": 50,
            "desktop_width_percent": 100,
            "heading": "What this means when you are shopping",
            "heading_font": "serif",
            "heading_size": 42,
            "mobile_heading_size": 28,
            "heading_color": "#1A1816",
            "heading_indent": 0,
            "mobile_heading_indent": 0,
            "image": "shopify://shop_images/magnific_luxury-perfume-comparison_74h5S6MJAL_jpg.jpg",
            "image_max_width": 500,
            "heading_image_gap": 16,
            "mobile_heading_image_gap": 20,
            "body_text": "<p>Never test a brand-new fragrance for the very first time on a first date. Skin chemistry can react unexpectedly with certain floral or spicy base notes, leaving you feeling self-conscious throughout the evening.</p><p>Wear your chosen scent once or twice during a regular day beforehand so you know exactly how it develops, how long it projects, and how confident it makes you feel.</p>",
            "body_font": "system_ui_n4",
            "body_size": 17,
            "mobile_body_size": 15,
            "body_color": "#2D2A26",
