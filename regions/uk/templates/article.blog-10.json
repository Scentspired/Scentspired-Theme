        "blog_luxury_perfume_banner_37U8Va": {
          "type": "blog--luxury-perfume-banner",
          "settings": {
            "heading": "<p>WHY SWEET SUDDENLY GOT SOPHISTICATED:</p>",
            "heading_size": 48,
            "mobile_heading_size": 24,
            "heading_line_height": 1.1,
            "heading_color": "#1a1a1a",
            "paragraph": "<p>how modern gourmand perfumes evolved from teen body sprays into high-luxury signatures</p>",
            "paragraph_size": 18,
            "mobile_paragraph_size": 16,
            "paragraph_line_height": 1.4,
            "paragraph_color": "#332F2B",
            "desktop_image": "shopify://shop_images/WhatsApp_Image_2026-07-03_at_9.01.11_AM.jpg",
            "image_aspect_ratio": "16/9",
            "horizontal_alignment": "flex-start",
