{
  "sections": {
    "main": {
      "type": "main-article",
      "blocks": {
        "breadcrumb": {
          "type": "breadcrumb",
          "settings": {
            "show_home": true,
            "show_blog": true,
            "show_category": true
          }
        },
        "title": {
          "type": "title",
          "settings": {
            "blog_show_date": true,
            "blog_show_author": true,
            "blog_show_reading_time": true
          }
        },
        "featured_image": {
          "type": "featured_image",
          "settings": {
            "image_height": "adapt"
          }
        },
        "content": {
          "type": "content",
          "settings": {}
        },
        "tags": {
          "type": "tags",
          "settings": {
            "label": "Tags"
          }
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        },
        "author_bio": {
          "type": "author_bio",
          "settings": {
            "show_avatar": true,
            "bio_text": "Fragrance writer and scent enthusiast at Scentspired."
          }
        },
        "related_posts": {
          "type": "related_posts",
          "settings": {
            "heading": "You might also enjoy",
            "posts_to_show": 3
          }
        },
        "related_products": {
          "type": "related_products",
          "settings": {
            "heading": "Shop the scents",
            "auto_related": true,
            "products_to_show": 4
          }
        },
        "newsletter": {
          "type": "newsletter",
          "settings": {
            "heading": "Stay in the know",
            "subtext": "Join the Scentspired community for fragrance insights, new arrivals, and exclusive offers.",
            "placeholder": "Enter your email",
            "button_text": "Subscribe",
            "success_message": "Thanks for subscribing!"
          }
        }
      },
      "block_order": [
        "breadcrumb",
        "title",
        "featured_image",
        "content",
        "tags",
        "share",
        "author_bio",
        "related_posts",
        "related_products",
        "newsletter"
      ],
      "settings": {}
    }
  },
  "order": [
    "main"
  ]
}
