          "settings": {
            "heading": "<p>WE TESTED OUR LUXURY INSPIRED PERFUME AGAINST THE £250 ORIGINAL:</p>",
            "heading_size": 48,
            "mobile_heading_size": 24,
            "heading_line_height": 1.1,
            "heading_color": "#1a1a1a",
            "paragraph": "<p>an honest verdict for anyone who has ever winced at a department store price tag</p>",
            "paragraph_size": 18,
            "mobile_paragraph_size": 16,
            "paragraph_line_height": 1.4,
            "paragraph_color": "#332F2B",
            "desktop_image": "shopify://shop_images/Fragrance_guide_you_needed_before_your_last_very_expensive_mistake.png",
