{%- comment -%}
  The "image_banner" part of an article: its design, the same for every article.
  Edit it here. (Built from blocks/editorial--banner-2.liquid, removed once every article used
  this part.) An article's words, images and links are in
  regions/<id>/content/articles.json.

  Fields: image_desktop, image_mobile, line_1, line_1_italic, line_2
  Params: content_key ('articles.<entry>.parts.<n>.'), part_id (unique on the page)
{%- endcomment -%}
{%- liquid
  assign k = content_key | append: 'image_desktop'
  capture part_desktop_image
    render 'region--content', key: k
  endcapture
  assign part_desktop_image = part_desktop_image | strip
  # an image is named as in Shopify ("shopify://shop_images/<file>") and read from the store's files
  assign image_file = part_desktop_image | remove_first: 'shopify://shop_images/'
  assign part_desktop_image = nil
  if image_file != blank
    # a file the store does not have comes back as an empty image: treat it
    # as no image, as Shopify does for a missing image setting
    assign image_found = images[image_file]
    if image_found.width > 0
      assign part_desktop_image = image_found
    endif
  endif
  assign k = content_key | append: 'image_mobile'
  capture part_mobile_image
    render 'region--content', key: k
  endcapture
  assign part_mobile_image = part_mobile_image | strip
  # an image is named as in Shopify ("shopify://shop_images/<file>") and read from the store's files
  assign image_file = part_mobile_image | remove_first: 'shopify://shop_images/'
  assign part_mobile_image = nil
  if image_file != blank
    # a file the store does not have comes back as an empty image: treat it
    # as no image, as Shopify does for a missing image setting
    assign image_found = images[image_file]
    if image_found.width > 0
      assign part_mobile_image = image_found
    endif
  endif
  assign k = content_key | append: 'line_1'
  capture part_heading_line_1_part_1
    render 'region--content', key: k
  endcapture
  assign part_heading_line_1_part_1 = part_heading_line_1_part_1 | strip
  assign k = content_key | append: 'line_1_italic'
  capture part_heading_line_1_part_2
    render 'region--content', key: k
  endcapture
  assign part_heading_line_1_part_2 = part_heading_line_1_part_2 | strip
  assign k = content_key | append: 'line_2'
  capture part_heading_line_2
    render 'region--content', key: k
  endcapture
  assign part_heading_line_2 = part_heading_line_2 | strip
-%}

{{ 'article--part-image-banner.css' | asset_url | stylesheet_tag }}

<editorial-banner-image-banner
  class="ai-editorial-banner-image-banner">
  <div class="ai-editorial-banner__image-wrapper-image-banner">
    {% if part_desktop_image %}
      <img
        src="{{ part_desktop_image | image_url: width: 2000 }}"
        alt="{{ part_desktop_image.alt | escape }}"
        loading="lazy"
        width="{{ part_desktop_image.width }}"
        height="{{ part_desktop_image.height }}"
        class="ai-editorial-banner__image-image-banner ai-editorial-banner__desktop-image-image-banner">
    {% else %}
      <div class="ai-editorial-banner__image-placeholder-image-banner ai-editorial-banner__desktop-image-image-banner">
        {{ "hero-apparel-1" | placeholder_svg_tag }}
        <div class="ai-editorial-banner__empty-state-image-banner">{{ 'sections.article_parts.add_desktop_image' | t }}</div>
      </div>
    {% endif %}

    {% if part_mobile_image %}
      <img
        src="{{ part_mobile_image | image_url: width: 1000 }}"
        alt="{{ part_mobile_image.alt | escape }}"
        loading="lazy"
        width="{{ part_mobile_image.width }}"
        height="{{ part_mobile_image.height }}"
        class="ai-editorial-banner__image-image-banner ai-editorial-banner__mobile-image-image-banner">
    {% else %}
      <div class="ai-editorial-banner__image-placeholder-image-banner ai-editorial-banner__mobile-image-image-banner">
        {{ "hero-apparel-1" | placeholder_svg_tag }}
        <div class="ai-editorial-banner__empty-state-image-banner">{{ 'sections.article_parts.add_mobile_image' | t }}</div>
      </div>
    {% endif %}

    <div class="ai-editorial-banner__content-image-banner">
      <p class="ai-editorial-banner__text-image-banner">
        {% if part_heading_line_1_part_1 != blank or part_heading_line_1_part_2 != blank %}
          <span class="ai-editorial-banner__line-1-image-banner">
            {% if part_heading_line_1_part_1 != blank %}
              <span class="ai-editorial-banner__line-1-part-1-image-banner">
                {{- part_heading_line_1_part_1 -}}
              </span>
            {% endif %}
            {% if part_heading_line_1_part_2 != blank %}
              <span class="ai-editorial-banner__line-1-part-2-image-banner">
                {{ part_heading_line_1_part_2 -}}
              </span>
            {% endif %}
          </span>
        {% endif %}
        {% if part_heading_line_2 != blank %}
          <span class="ai-editorial-banner__line-2-image-banner">{{ part_heading_line_2 }}</span>
        {% endif %}
      </p>
    </div>
  </div>
</editorial-banner-image-banner>

