{%- comment -%}
  The "image_banner" part of an article: its design, the same for every article.
  Edit it here. (Built from blocks/editorial--banner-2.liquid, removed once every article used
  this part.) An article's words, images and links are in
  regions/<id>/content/articles.json.

  Fields: image_desktop, image_mobile, line_1, line_1_italic, line_2
  Params: content_key ('articles.<entry>.parts.<n>.'), part_id (unique on the page)
{%- endcomment -%}
{%- liquid
  assign k = content_key | append: 'image_desktop'
  capture part_desktop_image
    render 'region--content', key: k
  endcapture
  assign part_desktop_image = part_desktop_image | strip
  # an image is named as in Shopify ("shopify://shop_images/<file>") and read from the store's files
  assign image_file = part_desktop_image | remove_first: 'shopify://shop_images/'
  assign part_desktop_image = nil
  if image_file != blank
    # a file the store does not have comes back as an empty image: treat it
    # as no image, as Shopify does for a missing image setting
    assign image_found = images[image_file]
    if image_found.width > 0
      assign part_desktop_image = image_found
    endif
  endif
  assign k = content_key | append: 'image_mobile'
  capture part_mobile_image
    render 'region--content', key: k
  endcapture
  assign part_mobile_image = part_mobile_image | strip
  # an image is named as in Shopify ("shopify://shop_images/<file>") and read from the store's files
  assign image_file = part_mobile_image | remove_first: 'shopify://shop_images/'
  assign part_mobile_image = nil
  if image_file != blank
    # a file the store does not have comes back as an empty image: treat it
    # as no image, as Shopify does for a missing image setting
    assign image_found = images[image_file]
    if image_found.width > 0
      assign part_mobile_image = image_found
    endif
  endif
  assign k = content_key | append: 'line_1'
  capture part_heading_line_1_part_1
    render 'region--content', key: k
  endcapture
  assign part_heading_line_1_part_1 = part_heading_line_1_part_1 | strip
  assign k = content_key | append: 'line_1_italic'
  capture part_heading_line_1_part_2
    render 'region--content', key: k
  endcapture
  assign part_heading_line_1_part_2 = part_heading_line_1_part_2 | strip
  assign k = content_key | append: 'line_2'
  capture part_heading_line_2
    render 'region--content', key: k
  endcapture
  assign part_heading_line_2 = part_heading_line_2 | strip
-%}
{% assign ai_gen_id = part_id %}

{% style %}
  .ai-editorial-banner-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    display: block;
  }

  .ai-editorial-banner__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: auto;
  }

  .ai-editorial-banner__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-editorial-banner__image-placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    width: 100%;
    min-height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-editorial-banner__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-editorial-banner__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-editorial-banner__content-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 10%;
    transform: translateY(-50%);
    max-width: 700px;
    padding: 0 20px;
    z-index: 2;
  }

  .ai-editorial-banner__text-{{ ai_gen_id }} {
    font-family: var(--font-display);
    font-size: 36px;
    line-height: 1;
    text-align: left;
    margin: 0;
  }

  .ai-editorial-banner__line-1-{{ ai_gen_id }} {
    display: block;
  }

  .ai-editorial-banner__line-1-part-1-{{ ai_gen_id }} {
    font-family: var(--font-display);
    font-style: normal;
    color: #2b2b2b;
  }

  .ai-editorial-banner__line-1-part-2-{{ ai_gen_id }} {
    font-family: var(--font-display-italic);
    font-style: italic;
    color: #8B1D22;
    font-size: 60px;
  }

  .ai-editorial-banner__line-2-{{ ai_gen_id }} {
    display: block;
    font-family: var(--font-display);
    font-style: normal;
    color: #2b2b2b;
  }

  .ai-editorial-banner__mobile-image-{{ ai_gen_id }} {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .ai-editorial-banner__desktop-image-{{ ai_gen_id }} {
      display: none;
    }

    .ai-editorial-banner__mobile-image-{{ ai_gen_id }} {
      display: block;
    }

    .ai-editorial-banner__content-{{ ai_gen_id }} {
      max-width: calc(100% - 40px);
    }

    .ai-editorial-banner__text-{{ ai_gen_id }} {
      font-family: var(--font-display);
      font-size: 13px;
      line-height: 1;
      text-align: left;
      margin: 0;
    }

    .ai-editorial-banner__line-1-part-2-{{ ai_gen_id }} {
      font-family: var(--font-display-italic);
      font-style: italic;
      color: #8B1D22;
      font-size: 25px;
    }

    .ai-editorial-banner__content-{{ ai_gen_id }} {
      left: 0%;
    }
  }
{% endstyle %}

<editorial-banner-{{ ai_gen_id }}
  class="ai-editorial-banner-{{ ai_gen_id }}">
  <div class="ai-editorial-banner__image-wrapper-{{ ai_gen_id }}">
    {% if part_desktop_image %}
      <img
        src="{{ part_desktop_image | image_url: width: 2000 }}"
        alt="{{ part_desktop_image.alt | escape }}"
        loading="lazy"
        width="{{ part_desktop_image.width }}"
        height="{{ part_desktop_image.height }}"
        class="ai-editorial-banner__image-{{ ai_gen_id }} ai-editorial-banner__desktop-image-{{ ai_gen_id }}">
    {% else %}
      <div class="ai-editorial-banner__image-placeholder-{{ ai_gen_id }} ai-editorial-banner__desktop-image-{{ ai_gen_id }}">
        {{ "hero-apparel-1" | placeholder_svg_tag }}
        <div class="ai-editorial-banner__empty-state-{{ ai_gen_id }}">Next, add a desktop image</div>
      </div>
    {% endif %}

    {% if part_mobile_image %}
      <img
        src="{{ part_mobile_image | image_url: width: 1000 }}"
        alt="{{ part_mobile_image.alt | escape }}"
        loading="lazy"
        width="{{ part_mobile_image.width }}"
        height="{{ part_mobile_image.height }}"
        class="ai-editorial-banner__image-{{ ai_gen_id }} ai-editorial-banner__mobile-image-{{ ai_gen_id }}">
    {% else %}
      <div class="ai-editorial-banner__image-placeholder-{{ ai_gen_id }} ai-editorial-banner__mobile-image-{{ ai_gen_id }}">
        {{ "hero-apparel-1" | placeholder_svg_tag }}
        <div class="ai-editorial-banner__empty-state-{{ ai_gen_id }}">Next, add a mobile image</div>
      </div>
    {% endif %}

    <div class="ai-editorial-banner__content-{{ ai_gen_id }}">
      <p class="ai-editorial-banner__text-{{ ai_gen_id }}">
        {% if part_heading_line_1_part_1 != blank or part_heading_line_1_part_2 != blank %}
          <span class="ai-editorial-banner__line-1-{{ ai_gen_id }}">
            {% if part_heading_line_1_part_1 != blank %}
              <span class="ai-editorial-banner__line-1-part-1-{{ ai_gen_id }}">
                {{- part_heading_line_1_part_1 -}}
              </span>
            {% endif %}
            {% if part_heading_line_1_part_2 != blank %}
              <span class="ai-editorial-banner__line-1-part-2-{{ ai_gen_id }}">
                {{ part_heading_line_1_part_2 -}}
              </span>
            {% endif %}
          </span>
        {% endif %}
        {% if part_heading_line_2 != blank %}
          <span class="ai-editorial-banner__line-2-{{ ai_gen_id }}">{{ part_heading_line_2 }}</span>
        {% endif %}
      </p>
    </div>
  </div>
</editorial-banner-{{ ai_gen_id }}>

