      });
    });

    // Lazy load Sentry on user interaction or idle timeout (zero impact on initial load)
    var sentryTriggered = false;
    function triggerSentryLoad() {
      if (sentryTriggered) return;
      sentryTriggered = true;
      ['click', 'touchstart', 'keydown', 'scroll', 'mousemove'].forEach(function(evt) {
        window.removeEventListener(evt, triggerSentryLoad);
      });
      if (window.Sentry && typeof window.Sentry.forceLoad === 'function') {
        window.Sentry.forceLoad();
      }
    }
    ['click', 'touchstart', 'keydown', 'scroll', 'mousemove'].forEach(function(evt) {
      window.addEventListener(evt, triggerSentryLoad, { once: true, passive: true });
    });
    // Fallback idle timeout: 10s
    setTimeout(triggerSentryLoad, 10000);
  }

