{% comment %}
  -----------------------------------------------------------------------------
  MODULAR COMPONENT: Bundle Sidebar & Progress Timeline
  -----------------------------------------------------------------------------
  Parameters:
    - title: String
    - subtitle: String
    - capacity: Number (e.g. 3 or 5)
  -----------------------------------------------------------------------------
{% endcomment %}

<div class="bundle-sidebar">
  <div class="sidebar-header">
    <h2>{{ title }}</h2>
    <p id="BundleStatusText">{{ subtitle }}</p>
  </div>

  <div class="slots-wrapper">
    <div class="progress-timeline">
      <div class="progress-line"></div>
      {%- if capacity == 3 -%}
        <div class="progress-marker" style="top: 0%" id="Marker-0"></div>
        <div class="progress-label" style="top: 0%" id="Label-1"></div>
        <div class="progress-marker" style="top: 50%" id="Marker-1"></div>
        <div class="progress-label" style="top: 50%" id="Label-2"></div>
        <div class="progress-marker" style="top: 98%" id="Marker-2"></div>
        <div class="progress-label" style="top: 98%" id="Label-3"></div>
      {%- else -%}
        <div class="progress-marker" style="top: 0%" id="Marker-0"></div>
        <div class="progress-label" style="top: 0%" id="Label-1"></div>
        <div class="progress-marker" style="top: 25%" id="Marker-1"></div>
        <div class="progress-label" style="top: 25%" id="Label-2"></div>
        <div class="progress-marker" style="top: 50%" id="Marker-2"></div>
        <div class="progress-label" style="top: 50%" id="Label-15"></div>
        <div class="progress-marker" style="top: 75%" id="Marker-3"></div>
        <div class="progress-label" style="top: 75%" id="Label-4"></div>
        <div class="progress-marker" style="top: 98%" id="Marker-4"></div>
        <div class="progress-label" style="top: 98%" id="Label-25"></div>
      {%- endif -%}
    </div>

    <div class="slot-list" id="BundleSlots">
      {%- for i in (1..capacity) -%}
        <div class="slot-item empty" data-index="{{ forloop.index0 }}" onclick="openSelector({{ forloop.index0 }})">
          <div class="slot-placeholder-icon">+</div>
          <div class="slot-placeholder-text">
            <span class="primary">Select a product</span>
            <span class="unlock"> {{ capacity | minus: forloop.index | plus: 1 }} Selections Remaining</span>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>

  <div class="sidebar-footer">
    <div class="cart">
      <button class="add-to-cart-btn" id="MainActionBtn" disabled onclick="handleCheckout()">
        <span>Add to cart</span>
        <span id="TotalDisplay">$ 0</span>
      </button>
    </div>
    {%- if show_savings -%}
      <div class="savings-row">Standard Price: <span class="saving">$0</span></div>
      <div class="save-row">Total Saving <span>$0</span></div>
    {%- endif -%}
  </div>
</div>
