{%- comment -%}
  The "staggered_heading" part of an article: its design, the same for every article.
  Edit it here. (Built from blocks/editorial--staggered-typography-2.liquid, removed once every article used
  this part.) An article's words, images and links are in
  regions/<id>/content/articles.json.

  Fields: line_1, line_2, line_3, text
  Params: content_key ('articles.<entry>.parts.<n>.'), part_id (unique on the page)
{%- endcomment -%}
{%- liquid
  assign k = content_key | append: 'line_1'
  capture part_line_1_text
    render 'region--content', key: k
  endcapture
  assign part_line_1_text = part_line_1_text | strip
  assign k = content_key | append: 'line_2'
  capture part_line_2_text
    render 'region--content', key: k
  endcapture
  assign part_line_2_text = part_line_2_text | strip
  assign k = content_key | append: 'line_3'
  capture part_line_3_text
    render 'region--content', key: k
  endcapture
  assign part_line_3_text = part_line_3_text | strip
  assign k = content_key | append: 'text'
  capture part_body_text
    render 'region--content', key: k
  endcapture
  assign part_body_text = part_body_text | strip
-%}

{{ 'article--part-staggered-heading.css' | asset_url | stylesheet_tag }}

<div class="ai-staggered-typography-staggered-heading">
  <div class="ai-staggered-typography-container-staggered-heading">
    <div class="ai-staggered-typography-header-staggered-heading">
      {% if part_line_1_text != blank %}
        <h2 class="ai-staggered-typography-line-1-staggered-heading">{{ part_line_1_text }}</h2>
      {% endif %}
      {% if part_line_2_text != blank %}
        <h2 class="ai-staggered-typography-line-2-staggered-heading">{{ part_line_2_text }}</h2>
      {% endif %}
      {% if part_line_3_text != blank %}
        <h2 class="ai-staggered-typography-line-3-staggered-heading">{{ part_line_3_text }}</h2>
      {% endif %}
    </div>
    {% if part_body_text != blank %}
      <div class="ai-staggered-typography-body-staggered-heading">
        {{ part_body_text }}
      </div>
    {% endif %}
  </div>
</div>

