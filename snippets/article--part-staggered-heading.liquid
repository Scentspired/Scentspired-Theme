{%- comment -%}
  The "staggered_heading" part of an article: its design, the same for every article.
  Edit it here. (Built from blocks/editorial--staggered-typography-2.liquid, removed once every article used
  this part.) An article's words, images and links are in
  regions/<id>/content/articles.json.

  Fields: line_1, line_2, line_3, text
  Params: content_key ('articles.<entry>.parts.<n>.'), part_id (unique on the page)
{%- endcomment -%}
{%- liquid
  assign k = content_key | append: 'line_1'
  capture part_line_1_text
    render 'region--content', key: k
  endcapture
  assign part_line_1_text = part_line_1_text | strip
  assign k = content_key | append: 'line_2'
  capture part_line_2_text
    render 'region--content', key: k
  endcapture
  assign part_line_2_text = part_line_2_text | strip
  assign k = content_key | append: 'line_3'
  capture part_line_3_text
    render 'region--content', key: k
  endcapture
  assign part_line_3_text = part_line_3_text | strip
  assign k = content_key | append: 'text'
  capture part_body_text
    render 'region--content', key: k
  endcapture
  assign part_body_text = part_body_text | strip
-%}
{% assign ai_gen_id = part_id %}

{% style %}
  .ai-staggered-typography-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: #ffffff;
    padding: 60px 20px 60px;
    overflow-x: hidden;
  }

  .ai-staggered-typography-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-staggered-typography-header-{{ ai_gen_id }} {
    margin-bottom: 40px;
    line-height: 0.85;
  }

  .ai-staggered-typography-line-1-{{ ai_gen_id }} {
    font-family: var(--font-display-italic);
    font-style: italic;
    font-size: 40px;
    text-align: left;
    margin: 0;
    padding: 0;
    color: #121212;
    transform: translateX(-20px);
    margin: 0 0 -20px 0;
  }

  .ai-staggered-typography-line-2-{{ ai_gen_id }} {
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 400;
    font-size: 80px;
    text-align: center;
    margin: -20px 0 0 0;
    padding: 0;
    color: #121212;
    transform: translateX(-60px);
  }

  .ai-staggered-typography-line-3-{{ ai_gen_id }} {
    font-family: var(--font-display-italic);
    font-style: italic;
    font-size: 40px;
    text-align: right;
    margin: -4px 0 0 0;
    padding: 0;
    color: #121212;
    transform: translateX(40px);
  }

  .ai-staggered-typography-body-{{ ai_gen_id }} {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 24px;
    line-height: 1.6;
    text-align: center;
    max-width: 1000px;
    margin: 0 auto;
    color: #121212;
  }

  @media screen and (max-width: 749px) {
    .ai-staggered-typography-{{ ai_gen_id }} {
      padding: {{ 60 | times: 0.6 }}px 16px {{ 60 | times: 0.6 }}px;
    }

    .ai-staggered-typography-line-1-{{ ai_gen_id }} {
      font-size: {{ 40 | times: 0.5 }}px;
      transform: translateX(15px);
      margin: 0 0 0px 0;
    }

    .ai-staggered-typography-line-2-{{ ai_gen_id }} {
      font-size: {{ 80 | times: 0.5 }}px;
      margin-top: {{ -20 | times: 0.5 }}px;
      transform: translateX({{ -60 | times: 0.5 }}px);
    }

    .ai-staggered-typography-line-3-{{ ai_gen_id }} {
      font-size: {{ 40 | times: 0.5 }}px;
      margin-top: {{ -4 | times: 0.5 }}px;
      transform: translateX(-20px);
    }

    .ai-staggered-typography-body-{{ ai_gen_id }} {
      font-size: {{ 24 | times: 0.9 }}px;
      max-width: 100%;
    }

    .ai-staggered-typography-header-{{ ai_gen_id }} {
      margin-bottom: {{ 40 | times: 0.6 }}px;
    }
  }
{% endstyle %}

<div class="ai-staggered-typography-{{ ai_gen_id }}">
  <div class="ai-staggered-typography-container-{{ ai_gen_id }}">
    <div class="ai-staggered-typography-header-{{ ai_gen_id }}">
      {% if part_line_1_text != blank %}
        <h2 class="ai-staggered-typography-line-1-{{ ai_gen_id }}">{{ part_line_1_text }}</h2>
      {% endif %}
      {% if part_line_2_text != blank %}
        <h2 class="ai-staggered-typography-line-2-{{ ai_gen_id }}">{{ part_line_2_text }}</h2>
      {% endif %}
      {% if part_line_3_text != blank %}
        <h2 class="ai-staggered-typography-line-3-{{ ai_gen_id }}">{{ part_line_3_text }}</h2>
      {% endif %}
    </div>
    {% if part_body_text != blank %}
      <div class="ai-staggered-typography-body-{{ ai_gen_id }}">
        {{ part_body_text }}
      </div>
    {% endif %}
  </div>
</div>

