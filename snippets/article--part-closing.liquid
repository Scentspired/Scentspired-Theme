{%- comment -%}
  GENERATED by scripts/build-article-parts.cjs from blocks/editorial--split-text-2.liquid — the
  "closing" part of an article. Edit the design here (or regenerate); an
  article's words, images and links are in regions/<id>/content/articles.json.

  Fields: line_1, line_1_brand_scent, line_1_brand_spired, line_2_start, line_2_end, text
  Params: content_key ('articles.<entry>.parts.<n>.'), part_id (unique on the page)
{%- endcomment -%}
{%- liquid
  assign k = content_key | append: 'line_1'
  capture part_prefix_text
    render 'region--content', key: k
  endcapture
  assign part_prefix_text = part_prefix_text | strip
  assign k = content_key | append: 'line_1_brand_scent'
  capture part_brand_scent_text
    render 'region--content', key: k
  endcapture
  assign part_brand_scent_text = part_brand_scent_text | strip
  assign k = content_key | append: 'line_1_brand_spired'
  capture part_brand_spired_text
    render 'region--content', key: k
  endcapture
  assign part_brand_spired_text = part_brand_spired_text | strip
  assign k = content_key | append: 'line_2_start'
  capture part_start_text
    render 'region--content', key: k
  endcapture
  assign part_start_text = part_start_text | strip
  assign k = content_key | append: 'line_2_end'
  capture part_bestsellers_text
    render 'region--content', key: k
  endcapture
  assign part_bestsellers_text = part_bestsellers_text | strip
  assign k = content_key | append: 'text'
  capture part_body_text
    render 'region--content', key: k
  endcapture
  assign part_body_text = part_body_text | strip
-%}
{% assign ai_gen_id = part_id %}

{% style %}
  .ai-split-editorial-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: #ffffff;
    padding: 40px 0 35px;
  }

  .ai-split-editorial-container-{{ ai_gen_id }} {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-split-editorial-wrapper-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 40px;
  }

  .ai-split-editorial-left-{{ ai_gen_id }} {
    max-width: 45%;
  }

  .ai-split-editorial-right-{{ ai_gen_id }} {
    max-width: 72%;
  }

  .ai-split-editorial-heading-line1-{{ ai_gen_id }} {
    margin: 0 0 4px;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .ai-split-editorial-prefix-{{ ai_gen_id }} {
    font-family: var(--font-display);
    font-weight: 400;
    font-style: normal;
    font-size: 50px;
    color: #000000;
  }

  .ai-split-editorial-brand-scent-{{ ai_gen_id }} {
    font-family: var(--font-display);
    font-weight: 400;
    font-style: normal;
    font-size: 50px;
    color: #000000;
  }

  .ai-split-editorial-brand-spired-{{ ai_gen_id }} {
    font-family: var(--font-display-ultralight-italic);
    font-weight: 400;
    font-style: italic;
    font-size: 50px;
    color: #000000;
  }

  .ai-split-editorial-heading-line2-{{ ai_gen_id }} {
    margin: 0;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .ai-split-editorial-start-{{ ai_gen_id }} {
    font-family: var(--font-display);
    font-weight: 400;
    font-style: normal;
    font-size: 36px;
    color: #000000;
    margin-right: 5px;
  }

  .ai-split-editorial-bestsellers-{{ ai_gen_id }} {
    font-family: var(--font-display-italic);
    font-weight: 400;
    font-style: italic;
    font-size: 40px;
    color: #000000;
  }

  .ai-split-editorial-body-{{ ai_gen_id }} {
    font-family: var(--font-body);
    font-weight: 400;
    font-style: normal;
    font-size: 25px;
    line-height: 1.3;
    color: #000000;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-split-editorial-wrapper-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 20px;
    }

    .ai-split-editorial-left-{{ ai_gen_id }},
    .ai-split-editorial-right-{{ ai_gen_id }} {
      max-width: 100%;
    }

    .ai-split-editorial-prefix-{{ ai_gen_id }} {
      font-size: calc(50px * 0.6);
    }

    .ai-split-editorial-brand-scent-{{ ai_gen_id }},
    .ai-split-editorial-brand-spired-{{ ai_gen_id }} {
      font-size: calc(50px * 0.6);
    }

    .ai-split-editorial-start-{{ ai_gen_id }} {
      font-size: calc(36px * 0.6);
    }

    .ai-split-editorial-bestsellers-{{ ai_gen_id }} {
      font-size: calc(40px * 0.6);
    }

    .ai-split-editorial-body-{{ ai_gen_id }} {
      font-size: calc(25px * 0.6);
    }
  }
{% endstyle %}

<div class="ai-split-editorial-{{ ai_gen_id }}">
  <div class="ai-split-editorial-container-{{ ai_gen_id }}">
    <div class="ai-split-editorial-wrapper-{{ ai_gen_id }}">
      <div class="ai-split-editorial-left-{{ ai_gen_id }}">
        <h2 class="ai-split-editorial-heading-line1-{{ ai_gen_id }}">
          <span class="ai-split-editorial-prefix-{{ ai_gen_id }}">{{ part_prefix_text }}</span>
          <span class="ai-split-editorial-brand-scent-{{ ai_gen_id }}">{{ part_brand_scent_text }}</span><span class="ai-split-editorial-brand-spired-{{ ai_gen_id }}">{{ part_brand_spired_text }}</span>
        </h2>
        <p class="ai-split-editorial-heading-line2-{{ ai_gen_id }}">
          <span class="ai-split-editorial-start-{{ ai_gen_id }}">{{ part_start_text }}</span>
          <span class="ai-split-editorial-bestsellers-{{ ai_gen_id }}">{{ part_bestsellers_text }}</span>
        </p>
      </div>
      <div class="ai-split-editorial-right-{{ ai_gen_id }}">
        <p class="ai-split-editorial-body-{{ ai_gen_id }}">{{ part_body_text }}</p>
      </div>
    </div>
  </div>
</div>

