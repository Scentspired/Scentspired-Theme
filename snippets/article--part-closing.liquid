{%- comment -%}
  The "closing" part of an article: its design, the same for every article.
  Edit it here. (Built from blocks/editorial--split-text-2.liquid, removed once every article used
  this part.) An article's words, images and links are in
  regions/<id>/content/articles.json.

  Fields: line_1, line_1_brand_scent, line_1_brand_spired, line_2_start, line_2_end, text
  Params: content_key ('articles.<entry>.parts.<n>.'), part_id (unique on the page)
{%- endcomment -%}
{%- liquid
  assign k = content_key | append: 'line_1'
  capture part_prefix_text
    render 'region--content', key: k
  endcapture
  assign part_prefix_text = part_prefix_text | strip
  assign k = content_key | append: 'line_1_brand_scent'
  capture part_brand_scent_text
    render 'region--content', key: k
  endcapture
  assign part_brand_scent_text = part_brand_scent_text | strip
  assign k = content_key | append: 'line_1_brand_spired'
  capture part_brand_spired_text
    render 'region--content', key: k
  endcapture
  assign part_brand_spired_text = part_brand_spired_text | strip
  assign k = content_key | append: 'line_2_start'
  capture part_start_text
    render 'region--content', key: k
  endcapture
  assign part_start_text = part_start_text | strip
  assign k = content_key | append: 'line_2_end'
  capture part_bestsellers_text
    render 'region--content', key: k
  endcapture
  assign part_bestsellers_text = part_bestsellers_text | strip
  assign k = content_key | append: 'text'
  capture part_body_text
    render 'region--content', key: k
  endcapture
  assign part_body_text = part_body_text | strip
-%}

{{ 'article--part-closing.css' | asset_url | stylesheet_tag }}

<div class="ai-split-editorial-closing">
  <div class="ai-split-editorial-container-closing">
    <div class="ai-split-editorial-wrapper-closing">
      <div class="ai-split-editorial-left-closing">
        <h2 class="ai-split-editorial-heading-line1-closing">
          <span class="ai-split-editorial-prefix-closing">{{ part_prefix_text }}</span>
          <span class="ai-split-editorial-brand-scent-closing">{{ part_brand_scent_text }}</span><span class="ai-split-editorial-brand-spired-closing">{{ part_brand_spired_text }}</span>
        </h2>
        <p class="ai-split-editorial-heading-line2-closing">
          <span class="ai-split-editorial-start-closing">{{ part_start_text }}</span>
          <span class="ai-split-editorial-bestsellers-closing">{{ part_bestsellers_text }}</span>
        </p>
      </div>
      <div class="ai-split-editorial-right-closing">
        <p class="ai-split-editorial-body-closing">{{ part_body_text }}</p>
      </div>
    </div>
  </div>
</div>

