{% comment %}
  Renders responsive featured hero image for a blog article.
  Blast Radius: Strictly this file for article hero image optimization and responsive srcset.

  Accepts:
  - image: {Object} Image object (required)
  - title: {String} Fallback alt text (required)
  - image_height: {String} adapt | small | medium | large (optional)

  Usage:
  {% render 'blog--article--featured-image', image: article.image, title: article.title %}
{% endcomment %}

{%- if image -%}
  <div class="blog-featured-image{% if image_height and image_height != 'adapt' %} blog-featured-image--{{ image_height }}{% endif %}">
    <img
      srcset="
        {% if image.width >= 350 %}{{ image | image_url: width: 350 }} 350w,{% endif %}
        {% if image.width >= 750 %}{{ image | image_url: width: 750 }} 750w,{% endif %}
        {% if image.width >= 1100 %}{{ image | image_url: width: 1100 }} 1100w,{% endif %}
        {% if image.width >= 1500 %}{{ image | image_url: width: 1500 }} 1500w,{% endif %}
        {% if image.width >= 2200 %}{{ image | image_url: width: 2200 }} 2200w,{% endif %}
        {{ image | image_url }} {{ image.width }}w
      "
      sizes="(min-width: 1200px) 1100px, (min-width: 750px) 90vw, 100vw"
      src="{{ image | image_url: width: 1100 }}"
      loading="eager"
      fetchpriority="high"
      width="{{ image.width }}"
      height="{{ image.height }}"
      alt="{{ image.alt | default: title | escape }}"
      itemprop="image">
  </div>
{%- endif -%}
