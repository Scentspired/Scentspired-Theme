{% comment %}
  -----------------------------------------------------------------------------
  ATOMIC COMPONENT: Price Formatter
  -----------------------------------------------------------------------------
  Parameters:
    - price: Money / Integer cents
    - compare_at_price: Money / Integer cents (optional)
    - show_badges: Boolean (optional)
    - price_class: String (optional)
  -----------------------------------------------------------------------------
{% endcomment %}

{%- liquid
  assign target_price = price | default: 0
  assign target_compare = compare_at_price | default: 0
  assign on_sale = false
  if target_compare > target_price
    assign on_sale = true
  endif
-%}

<div class="price {{ price_class }} {% if on_sale %}price--on-sale{% endif %}">
  <div class="price__container">
    <span class="price-item price-item--regular" data-price="{{ target_price }}">
      {{ target_price | money }}
    </span>
    {%- if on_sale -%}
      <s class="price-item price-item--sale price-item--compare" data-compare-price="{{ target_compare }}">
        {{ target_compare | money }}
      </s>
    {%- endif -%}
  </div>
</div>
