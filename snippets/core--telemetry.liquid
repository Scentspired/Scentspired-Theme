<!-- iOS WebKit Native Bridge Shield (Prevents window.webkit.messageHandlers runtime exceptions) -->
<script src="{{ 'core--webkit-shield.js' | asset_url }}"></script>

<!-- Sentry.io Enterprise Observability Loader -->
<script src="{{ 'core--telemetry-sentry.min.js' | asset_url }}" defer="defer"></script>

<script type="application/json" id="telemetryConfig">
  {
    "template": {{ template.name | default: 'unknown' | json }},
    "customerId": {% if customer %}{{ customer.id | json }}{% else %}null{% endif %},
    "customerEmail": {% if customer %}{{ customer.email | json }}{% else %}null{% endif %},
    "cartItemCount": {{ cart.item_count | default: 0 }},
    "cartTotalPrice": {{ cart.total_price | default: 0 }},
    "currency": {{ cart.currency.iso_code | default: shop.currency | json }},
    "themeId": {{ theme.id | json }},
    "storeUrl": {{ shop.permanent_domain | json }}
  }
</script>
<script src="{{ 'core--telemetry-config.js' | asset_url }}"></script>

<script src="{{ 'core--telemetry.js' | asset_url }}" defer></script>
