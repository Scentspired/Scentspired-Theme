{%- comment -%}
  The "products" part of an article: its design, the same for every article.
  Edit it here. (Built from blocks/catalog--product-collection-grid-2.liquid, removed once every article used
  this part.) An article's words, images and links are in
  regions/<id>/content/articles.json.

  Fields: collection
  Params: content_key ('articles.<entry>.parts.<n>.'), part_id (unique on the page)
{%- endcomment -%}
{%- liquid
  assign k = content_key | append: 'collection'
  capture part_collection
    render 'region--content', key: k
  endcapture
  assign part_collection = part_collection | strip
  assign part_collection = collections[part_collection]
-%}

{{ 'article--part-products.css' | asset_url | stylesheet_tag }}

<product-collection-grid-products class="ai-product-grid-container-products">
  {% if part_collection != blank %}
    {% assign collection = part_collection %}
    {% if collection.products.size > 0 %}
      <div class="ai-product-grid-products">
        {% for product in collection.products limit: 3 %}
          <a href="{{ product.url }}" class="ai-product-card-products" role="link">
            <div class="ai-product-image-wrapper-products">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  class="ai-product-image-products"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {% else %}
                <div class="ai-product-image-placeholder-products">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            <div class="ai-product-details-products">
              <h3 class="ai-product-title-products">{{ product.title }}</h3>
              {% if product.vendor %}
                <div class="ai-product-vendor-products">
                  {% assign vendor_lower = product.vendor | downcase %}
                  {% if vendor_lower contains 'inspired by' %}
                    {% assign parts = product.vendor | split: 'Inspired By' %}
                    {% if parts.size == 1 %}
                      {% assign parts = product.vendor | split: 'inspired by' %}
                    {% endif %}
                    {% if parts.size == 1 %}
                      {% assign parts = product.vendor | split: 'Inspired by' %}
                    {% endif %}
                    {% if parts.size == 1 %}
                      {% assign parts = product.vendor | split: 'INSPIRED BY' %}
                    {% endif %}
                    
                    {% if parts.size > 1 %}
                      <span class="ai-vendor-inspired-products">{{ 'products.product.inspired_by' | t }}<br></span>
                      <span class="ai-vendor-brand-products">{{ parts[1] | strip }}</span>
                    {% else %}
                      <span class="ai-vendor-brand-products">{{ product.vendor }}</span>
                    {% endif %}
                  {% else %}
                    <span class="ai-vendor-brand-products">{{ product.vendor }}</span>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          </a>
        {% endfor %}
      </div>
    {% else %}
      <div class="ai-empty-state-products">
        {{ 'sections.article_parts.empty_collection' | t }}
      </div>
    {% endif %}
  {% else %}
    <div class="ai-empty-state-products">
      {{ 'sections.article_parts.choose_collection' | t }}
    </div>
  {% endif %}
</product-collection-grid-products>


