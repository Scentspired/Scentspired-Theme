{%- comment -%}
  The "products" part of an article: its design, the same for every article.
  Edit it here. (Built from blocks/catalog--product-collection-grid-2.liquid, removed once every article used
  this part.) An article's words, images and links are in
  regions/<id>/content/articles.json.

  Fields: collection
  Params: content_key ('articles.<entry>.parts.<n>.'), part_id (unique on the page)
{%- endcomment -%}
{%- liquid
  assign k = content_key | append: 'collection'
  capture part_collection
    render 'region--content', key: k
  endcapture
  assign part_collection = part_collection | strip
  assign part_collection = collections[part_collection]
-%}
{% assign ai_gen_id = part_id %}

{% style %}
 

  .ai-product-grid-container-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 0 40px 70px 40px;
        margin: 0 auto;
    max-width: 1200px;
  }

  .ai-product-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    width: 100%;
    max-width: 100%;
  }

  .ai-product-card-{{ ai_gen_id }} {
    background-color: #F2F2F2;
    display: flex;
    flex-direction: row;
    align-items: center;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease;
    overflow: hidden;
  }

  .ai-product-card-{{ ai_gen_id }}:hover {
    transform: translateY(-2px);
  }

  .ai-product-image-wrapper-{{ ai_gen_id }} {
    flex: 0 0 50%;
    width: 50%;
    aspect-ratio: 1 / 1;
    position: relative;
    padding: 8px;
    box-sizing: border-box;
  }

  .ai-product-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background-color: #ffffff;
    border: 2px solid #ffffff;
    box-sizing: border-box;
  }

  .ai-product-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #ffffff;
    border: 2px solid #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-product-details-{{ ai_gen_id }} {
    flex: 0 0 50%;
    width: 50%;
    padding: 20px 15px 20px 15px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-sizing: border-box;
  }

  .ai-product-title-{{ ai_gen_id }} {
    font-family: var(--font-body);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 8px 0;
    color: #000000;
  }

  .ai-product-vendor-{{ ai_gen_id }} {
    margin: 0;
    line-height: 1.4;
  }

  .ai-vendor-inspired-{{ ai_gen_id }} {
    font-family: var(--font-display-italic);
    font-size: 15px;
    font-style: italic;
    color: #000000;
  }

  .ai-vendor-brand-{{ ai_gen_id }} {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 400;
    color: #000000;
  }

  .ai-empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666666;
    font-size: 16px;
  }

  @media screen and (max-width: 749px) {
    .ai-product-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 12px;
    }

      .ai-product-grid-container-{{ ai_gen_id }} {
    padding: 0 20px;
  }

    .ai-product-card-{{ ai_gen_id }} {
      flex-direction: row;
    }

    .ai-product-image-wrapper-{{ ai_gen_id }} {
      flex: 0 0 45%;
      width: 45%;
      padding: 6px;
    }

    .ai-product-details-{{ ai_gen_id }} {
      flex: 0 0 55%;
      width: 55%;
      padding: 12px 16px 12px 20px;
    }

    .ai-product-title-{{ ai_gen_id }} {
      font-size: 18px;
      margin: 0 0 6px 0;
    }

    .ai-vendor-inspired-{{ ai_gen_id }},
    .ai-vendor-brand-{{ ai_gen_id }} {
      font-size: 14px;
    }
  }
{% endstyle %}

<product-collection-grid-{{ ai_gen_id }} class="ai-product-grid-container-{{ ai_gen_id }}">
  {% if part_collection != blank %}
    {% assign collection = part_collection %}
    {% if collection.products.size > 0 %}
      <div class="ai-product-grid-{{ ai_gen_id }}">
        {% for product in collection.products limit: 3 %}
          <a href="{{ product.url }}" class="ai-product-card-{{ ai_gen_id }}" role="link">
            <div class="ai-product-image-wrapper-{{ ai_gen_id }}">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  class="ai-product-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {% else %}
                <div class="ai-product-image-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            <div class="ai-product-details-{{ ai_gen_id }}">
              <h3 class="ai-product-title-{{ ai_gen_id }}">{{ product.title }}</h3>
              {% if product.vendor %}
                <div class="ai-product-vendor-{{ ai_gen_id }}">
                  {% assign vendor_lower = product.vendor | downcase %}
                  {% if vendor_lower contains 'inspired by' %}
                    {% assign parts = product.vendor | split: 'Inspired By' %}
                    {% if parts.size == 1 %}
                      {% assign parts = product.vendor | split: 'inspired by' %}
                    {% endif %}
                    {% if parts.size == 1 %}
                      {% assign parts = product.vendor | split: 'Inspired by' %}
                    {% endif %}
                    {% if parts.size == 1 %}
                      {% assign parts = product.vendor | split: 'INSPIRED BY' %}
                    {% endif %}
                    
                    {% if parts.size > 1 %}
                      <span class="ai-vendor-inspired-{{ ai_gen_id }}">{{ 'sections.article_parts.inspired_by' | t }}<br></span>
                      <span class="ai-vendor-brand-{{ ai_gen_id }}">{{ parts[1] | strip }}</span>
                    {% else %}
                      <span class="ai-vendor-brand-{{ ai_gen_id }}">{{ product.vendor }}</span>
                    {% endif %}
                  {% else %}
                    <span class="ai-vendor-brand-{{ ai_gen_id }}">{{ product.vendor }}</span>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          </a>
        {% endfor %}
      </div>
    {% else %}
      <div class="ai-empty-state-{{ ai_gen_id }}">
        {{ 'sections.article_parts.empty_collection' | t }}
      </div>
    {% endif %}
  {% else %}
    <div class="ai-empty-state-{{ ai_gen_id }}">
      {{ 'sections.article_parts.choose_collection' | t }}
    </div>
  {% endif %}
</product-collection-grid-{{ ai_gen_id }}>


