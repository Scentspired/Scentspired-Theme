{%- comment -%}
  The "callout" part of an article: its design, the same for every article.
  Edit it here. (Built from blocks/editorial--section-2.liquid, removed once every article used
  this part.) An article's words, images and links are in
  regions/<id>/content/articles.json.

  Fields: heading, image, text
  Params: content_key ('articles.<entry>.parts.<n>.'), part_id (unique on the page)
{%- endcomment -%}
{%- liquid
  assign k = content_key | append: 'heading'
  capture part_heading
    render 'region--content', key: k
  endcapture
  assign part_heading = part_heading | strip
  assign k = content_key | append: 'image'
  capture part_image
    render 'region--content', key: k
  endcapture
  assign part_image = part_image | strip
  # an image is named as in Shopify ("shopify://shop_images/<file>") and read from the store's files
  assign image_file = part_image | remove_first: 'shopify://shop_images/'
  assign part_image = nil
  if image_file != blank
    # a file the store does not have comes back as an empty image: treat it
    # as no image, as Shopify does for a missing image setting
    assign image_found = images[image_file]
    if image_found.width > 0
      assign part_image = image_found
    endif
  endif
  assign k = content_key | append: 'text'
  capture part_body_text
    render 'region--content', key: k
  endcapture
  assign part_body_text = part_body_text | strip
-%}
{% assign ai_gen_id = part_id %}

{% style %}
  .ai-editorial-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: #f5f3ee;
    padding: 60px 10px 58px;
  }

  .ai-editorial-container-{{ ai_gen_id }} {
    padding: 0px 70px;
  }

  .ai-editorial-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 40% 60%;
    gap: 80px;
    align-items: start;
  }

  .ai-editorial-left-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .ai-editorial-heading-{{ ai_gen_id }} {
    font-family: var(--font-display-ultralight-italic);
    font-weight: 400;
    font-style: {{ normal }};
    font-size: 54px;
    color: #000000;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0;
    padding-left: 15px;
  }

  .ai-editorial-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    max-width: 600px;
  }

  .ai-editorial-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .ai-editorial-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-editorial-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-editorial-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-editorial-right-{{ ai_gen_id }} {
    padding-top: 100px;
  }

  .ai-editorial-text-{{ ai_gen_id }} {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 24px;
    color: #111111;
    line-height: 1.6;
    max-width: 920px;
  }

  .ai-editorial-text-{{ ai_gen_id }} p {
    margin: 0 0 30px 0;
  }

  .ai-editorial-text-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-editorial-section-{{ ai_gen_id }} {
      padding: 60px 0 60px;
    }

    .ai-editorial-container-{{ ai_gen_id }} {
      padding: 0 20px;
    }

    .ai-editorial-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ai-editorial-heading-{{ ai_gen_id }} {
      font-size: 38px;
      padding-left: 15px;
    }

    .ai-editorial-left-{{ ai_gen_id }} {
      gap: 25px;
    }

    .ai-editorial-right-{{ ai_gen_id }} {
      padding-top: 0;
    }

    .ai-editorial-text-{{ ai_gen_id }} {
      font-size: 16px;
    }

    .ai-editorial-text-{{ ai_gen_id }} p {
      margin-bottom: 15px;
    }
  }
{% endstyle %}

<editorial-section-{{ ai_gen_id }} class="ai-editorial-section-{{ ai_gen_id }}">
  <div class="ai-editorial-container-{{ ai_gen_id }}">
    <div class="ai-editorial-grid-{{ ai_gen_id }}">
      <div class="ai-editorial-left-{{ ai_gen_id }}">
        {% if part_heading != blank %}
          {%- assign editorial_heading_level = 'h2' | default: 'h2' -%}
          <{{ editorial_heading_level }} class="ai-editorial-heading-{{ ai_gen_id }}">{{ part_heading }}</{{ editorial_heading_level }}>
        {% endif %}

        <div class="ai-editorial-image-wrapper-{{ ai_gen_id }}">
          {% if part_image %}
            <img
              src="{{ part_image | image_url: width: 1000 }}"
              alt="{{ part_image.alt | escape }}"
              loading="lazy"
              width="{{ part_image.width }}"
              height="{{ part_image.height }}"
              class="ai-editorial-image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-editorial-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
              <div class="ai-editorial-empty-state-{{ ai_gen_id }}">
                {{ 'sections.article_parts.add_image' | t }}
              </div>
            </div>
          {% endif %}
        </div>
      </div>

      <div class="ai-editorial-right-{{ ai_gen_id }}">
        {% if part_body_text != blank %}
          <div class="ai-editorial-text-{{ ai_gen_id }}">
            {{ part_body_text }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</editorial-section-{{ ai_gen_id }}>


