{%- comment -%}
  The "callout" part of an article: its design, the same for every article.
  Edit it here. (Built from blocks/editorial--section-2.liquid, removed once every article used
  this part.) An article's words, images and links are in
  regions/<id>/content/articles.json.

  Fields: heading, image, text
  Params: content_key ('articles.<entry>.parts.<n>.'), part_id (unique on the page)
{%- endcomment -%}
{%- liquid
  assign k = content_key | append: 'heading'
  capture part_heading
    render 'region--content', key: k
  endcapture
  assign part_heading = part_heading | strip
  assign k = content_key | append: 'image'
  capture part_image
    render 'region--content', key: k
  endcapture
  assign part_image = part_image | strip
  # an image is named as in Shopify ("shopify://shop_images/<file>") and read from the store's files
  assign image_file = part_image | remove_first: 'shopify://shop_images/'
  assign part_image = nil
  if image_file != blank
    # a file the store does not have comes back as an empty image: treat it
    # as no image, as Shopify does for a missing image setting
    assign image_found = images[image_file]
    if image_found.width > 0
      assign part_image = image_found
    endif
  endif
  assign k = content_key | append: 'text'
  capture part_body_text
    render 'region--content', key: k
  endcapture
  assign part_body_text = part_body_text | strip
-%}

{{ 'article--part-callout.css' | asset_url | stylesheet_tag }}

<editorial-section-callout class="ai-editorial-section-callout">
  <div class="ai-editorial-container-callout">
    <div class="ai-editorial-grid-callout">
      <div class="ai-editorial-left-callout">
        {% if part_heading != blank %}
          {%- assign editorial_heading_level = 'h2' | default: 'h2' -%}
          <{{ editorial_heading_level }} class="ai-editorial-heading-callout">{{ part_heading }}</{{ editorial_heading_level }}>
        {% endif %}

        <div class="ai-editorial-image-wrapper-callout">
          {% if part_image %}
            <img
              src="{{ part_image | image_url: width: 1000 }}"
              alt="{{ part_image.alt | escape }}"
              loading="lazy"
              width="{{ part_image.width }}"
              height="{{ part_image.height }}"
              class="ai-editorial-image-callout"
            >
          {% else %}
            <div class="ai-editorial-image-placeholder-callout">
              {{ 'image' | placeholder_svg_tag }}
              <div class="ai-editorial-empty-state-callout">
                {{ 'sections.article_parts.add_image' | t }}
              </div>
            </div>
          {% endif %}
        </div>
      </div>

      <div class="ai-editorial-right-callout">
        {% if part_body_text != blank %}
          <div class="ai-editorial-text-callout">
            {{ part_body_text }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</editorial-section-callout>


