{%- comment -%}
  The sidebar of the info pages (content--faq, content--privacy-policy,
  content--contact): one link per entry of sidebar_links in the region's
  content/info-pages.json, in the file's order. Which link is the current page
  is marked by each section's own script.

  Usage: {% render 'content--info-sidebar' %}
{%- endcomment -%}
{%- liquid
  capture positions
    render 'region--content', key: 'info-pages.sidebar_links.__keys'
  endcapture
  assign positions = positions | strip | split: ','
-%}
<aside class="faq-sidebar">
        <ul>
          {%- for position in positions -%}
            {%- liquid
              assign link_key = 'info-pages.sidebar_links.' | append: position | append: '.'
              assign k = link_key | append: 'label'
              capture link_label
                render 'region--content', key: k
              endcapture
              assign k = link_key | append: 'url'
              capture link_url
                render 'region--content', key: k
              endcapture
              assign link_label = link_label | strip
              assign link_url = link_url | strip
            -%}
            {%- if link_label != blank %}
            <li>
              <a href="{{ link_url | escape }}">{{ link_label | escape }}</a>
            </li>
            {%- endif -%}
          {%- endfor %}
        </ul>
      </aside>