{%- comment -%}
  The "content_box" part of an article: its design, the same for every article.
  Edit it here. (Built from blocks/editorial--content-2.liquid, removed once every article used
  this part.) An article's words, images and links are in
  regions/<id>/content/articles.json.

  Fields: heading, box_paragraph_1, box_paragraph_2, box_paragraph_3, subheading, subheading_text
  Params: content_key ('articles.<entry>.parts.<n>.'), part_id (unique on the page)
{%- endcomment -%}
{%- liquid
  assign k = content_key | append: 'heading'
  capture part_heading
    render 'region--content', key: k
  endcapture
  assign part_heading = part_heading | strip
  assign k = content_key | append: 'box_paragraph_1'
  capture part_box_paragraph_1
    render 'region--content', key: k
  endcapture
  assign part_box_paragraph_1 = part_box_paragraph_1 | strip
  assign k = content_key | append: 'box_paragraph_2'
  capture part_box_paragraph_2
    render 'region--content', key: k
  endcapture
  assign part_box_paragraph_2 = part_box_paragraph_2 | strip
  assign k = content_key | append: 'box_paragraph_3'
  capture part_box_paragraph_3
    render 'region--content', key: k
  endcapture
  assign part_box_paragraph_3 = part_box_paragraph_3 | strip
  assign k = content_key | append: 'subheading'
  capture part_subheading
    render 'region--content', key: k
  endcapture
  assign part_subheading = part_subheading | strip
  assign k = content_key | append: 'subheading_text'
  capture part_bottom_text
    render 'region--content', key: k
  endcapture
  assign part_bottom_text = part_bottom_text | strip
-%}

{{ 'article--part-content-box.css' | asset_url | stylesheet_tag }}

<div class="ai-editorial-section-content-box">
  <div class="ai-editorial-section__container-content-box">
    {% if part_heading != blank %}
      <h2 class="ai-editorial-section__heading-content-box">
        {{ part_heading }}
      </h2>
    {% endif %}

    <div class="ai-editorial-section__red-box-content-box">
      {% if part_box_paragraph_1 != blank %}
        <div class="ai-editorial-section__box-text-content-box">
          {{ part_box_paragraph_1 }}
        </div>
      {% endif %}

      {% if part_box_paragraph_2 != blank %}
        <div class="ai-editorial-section__box-text-content-box">
          {{ part_box_paragraph_2 }}
        </div>
      {% endif %}

      {% if part_box_paragraph_3 != blank %}
        <div class="ai-editorial-section__box-text-content-box">
          {{ part_box_paragraph_3 }}
        </div>
      {% endif %}
    </div>

    {% if part_subheading != blank %}
      <h3 class="ai-editorial-section__subheading-content-box">
        {{ part_subheading }}
      </h3>
    {% endif %}

    {% if part_bottom_text != blank %}
      <div class="ai-editorial-section__bottom-text-content-box">
        {{ part_bottom_text }}
      </div>
    {% endif %}
  </div>
</div>

