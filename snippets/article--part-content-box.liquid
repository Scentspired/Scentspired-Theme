{%- comment -%}
  The "content_box" part of an article: its design, the same for every article.
  Edit it here. (Built from blocks/editorial--content-2.liquid, removed once every article used
  this part.) An article's words, images and links are in
  regions/<id>/content/articles.json.

  Fields: heading, box_paragraph_1, box_paragraph_2, box_paragraph_3, subheading, subheading_text
  Params: content_key ('articles.<entry>.parts.<n>.'), part_id (unique on the page)
{%- endcomment -%}
{%- liquid
  assign k = content_key | append: 'heading'
  capture part_heading
    render 'region--content', key: k
  endcapture
  assign part_heading = part_heading | strip
  assign k = content_key | append: 'box_paragraph_1'
  capture part_box_paragraph_1
    render 'region--content', key: k
  endcapture
  assign part_box_paragraph_1 = part_box_paragraph_1 | strip
  assign k = content_key | append: 'box_paragraph_2'
  capture part_box_paragraph_2
    render 'region--content', key: k
  endcapture
  assign part_box_paragraph_2 = part_box_paragraph_2 | strip
  assign k = content_key | append: 'box_paragraph_3'
  capture part_box_paragraph_3
    render 'region--content', key: k
  endcapture
  assign part_box_paragraph_3 = part_box_paragraph_3 | strip
  assign k = content_key | append: 'subheading'
  capture part_subheading
    render 'region--content', key: k
  endcapture
  assign part_subheading = part_subheading | strip
  assign k = content_key | append: 'subheading_text'
  capture part_bottom_text
    render 'region--content', key: k
  endcapture
  assign part_bottom_text = part_bottom_text | strip
-%}
{% assign ai_gen_id = part_id %}

{% style %}
  .ai-editorial-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
    background-color: #f9f6f1;
    padding: 20px 20px;
    text-align: center;
  }

  .ai-editorial-section__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-editorial-section__heading-{{ ai_gen_id }} {
    font-family: var(--font-display-ultralight-italic);
    font-size: 50px;
    color: #121212;
    margin: 0 0 -34px 0;
    line-height: 1.2;
  }

  .ai-editorial-section__red-box-{{ ai_gen_id }} {
    background-color: #8b1d22;
    border-radius: 25px;
    padding: 30px 98px;
    margin: 0 0 -10px 0;
  }

  .ai-editorial-section__box-text-{{ ai_gen_id }} {
    font-family: var(--font-body);
    font-size: 24px;
    color: #ffffff;
    line-height: 1.6;
    margin: 0 0 25px 0;
  }

  .ai-editorial-section__box-text-{{ ai_gen_id }}:last-child {
    margin-bottom: 0;
  }

  .ai-editorial-section__subheading-{{ ai_gen_id }} {
    font-family: var(--font-display-ultralight-italic);
    font-style: italic;
    font-size: 60px;
    color: #000000;
    margin: 0 0 -37px 0;
    line-height: 1.3;
  }

  .ai-editorial-section__bottom-text-{{ ai_gen_id }} {
    font-family: var(--font-body);
    font-size: 24px;
    color: #000000;
    line-height: 1.6;
    margin: 0 auto;
    max-width: 1000px;
  }

  @media screen and (max-width: 749px) {
    .ai-editorial-section-{{ ai_gen_id }} {
      padding: {{ 20 | times: 0.6 }}px 16px;
    }

    .ai-editorial-section__heading-{{ ai_gen_id }} {
      font-size: 32px;
    }

    .ai-editorial-section__red-box-{{ ai_gen_id }} {
      padding: {{ 40 | times: 0.6 }}px;
      border-radius: {{ 25 | times: 0.6 }}px;
    }

    .ai-editorial-section__box-text-{{ ai_gen_id }} {
      font-size: 12.6px;
    }

    .ai-editorial-section__subheading-{{ ai_gen_id }} {
      font-size: 34px;
    }

    .ai-editorial-section__bottom-text-{{ ai_gen_id }} {
      font-size: 12.6px;
    }
  }
 strong {
    font-weight: 700;
  }

  /* Was per-article custom CSS in every template using this part. */
  .ai-editorial-section-{{ ai_gen_id }} a { color: #fff; }
{% endstyle %}

<div class="ai-editorial-section-{{ ai_gen_id }}">
  <div class="ai-editorial-section__container-{{ ai_gen_id }}">
    {% if part_heading != blank %}
      <h2 class="ai-editorial-section__heading-{{ ai_gen_id }}">
        {{ part_heading }}
      </h2>
    {% endif %}

    <div class="ai-editorial-section__red-box-{{ ai_gen_id }}">
      {% if part_box_paragraph_1 != blank %}
        <div class="ai-editorial-section__box-text-{{ ai_gen_id }}">
          {{ part_box_paragraph_1 }}
        </div>
      {% endif %}

      {% if part_box_paragraph_2 != blank %}
        <div class="ai-editorial-section__box-text-{{ ai_gen_id }}">
          {{ part_box_paragraph_2 }}
        </div>
      {% endif %}

      {% if part_box_paragraph_3 != blank %}
        <div class="ai-editorial-section__box-text-{{ ai_gen_id }}">
          {{ part_box_paragraph_3 }}
        </div>
      {% endif %}
    </div>

    {% if part_subheading != blank %}
      <h3 class="ai-editorial-section__subheading-{{ ai_gen_id }}">
        {{ part_subheading }}
      </h3>
    {% endif %}

    {% if part_bottom_text != blank %}
      <div class="ai-editorial-section__bottom-text-{{ ai_gen_id }}">
        {{ part_bottom_text }}
      </div>
    {% endif %}
  </div>
</div>

