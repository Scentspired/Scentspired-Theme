{%- comment -%}
  Structured Data: BreadcrumbList
  Standardized hierarchical breadcrumbs for Rich Results across Products, Collections, Articles, and Pages.
  Blast radius: SEO metadata only. Non-blocking.
{%- endcomment -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "{{ shop.url }}"
    }
    {%- if type == 'product' -%}
      {%- assign crumb_collection = collection | default: product.collections.first -%}
      {%- if crumb_collection -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ crumb_collection.title | json }},
        "item": "{{ shop.url }}{{ crumb_collection.url }}"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": {{ product.title | json }},
        "item": {{ canonical_url | json }}
      }
      {%- else -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ product.title | json }},
        "item": {{ canonical_url | json }}
      }
      {%- endif -%}
    {%- elsif type == 'collection' -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ collection.title | json }},
        "item": {{ canonical_url | json }}
      }
    {%- elsif type == 'article' -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ blog.title | default: 'Blog' | json }},
        "item": "{{ shop.url }}{{ blog.url }}"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": {{ article.title | json }},
        "item": {{ canonical_url | json }}
      }
    {%- elsif type == 'page' -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ page.title | json }},
        "item": {{ canonical_url | json }}
      }
    {%- endif -%}
  ]
}
</script>
