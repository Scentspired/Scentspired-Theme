{%- comment -%}
  ============================================================================
  SCENTSPIRED — Centralized Region Detection Snippet
  ============================================================================
  Returns the active region identifier ('uk', 'uae', or 'usa').

  Usage:
    {% capture current_region %}{% render 'region-detect' %}{% endcapture %}
    {% assign current_region = current_region | strip %}
    {% if current_region == 'uk' %} ... {% endif %}
    {% if current_region == 'uae' %} ... {% endif %}
    {% if current_region == 'usa' %} ... {% endif %}

  Adding a new region:
    1. Add an elsif block below with the appropriate domain/currency checks
    2. That's it — all consuming files pick it up automatically
  ============================================================================
{%- endcomment -%}

{%- liquid
  if cart.currency.iso_code == 'GBP' or shop.currency == 'GBP' or shop.domain contains 'scentspired.co.uk' or shop.permanent_domain contains 'scentspireduk' or shop.domain contains 'scentspireduk'
    echo 'uk'
  elsif cart.currency.iso_code == 'AED' or shop.currency == 'AED' or shop.domain contains 'scentspired.ae' or shop.permanent_domain contains 'scentspiredae' or shop.domain contains 'scentspiredae' or shop.permanent_domain contains 'scentspireduae' or shop.domain contains 'scentspireduae' or shop.permanent_domain contains 'nfveen-nd' or shop.domain contains 'nfveen-nd'
    echo 'uae'
  else
    echo 'usa'
  endif
-%}
