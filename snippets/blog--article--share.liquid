{% comment %}
  Renders social sharing suite (X/Twitter, Facebook, Pinterest, Copy Link) for an article.
  Blast Radius: Strictly this file for social sharing platforms, icons, and clipboard logic.

  Accepts:
  - article: {Object} Article object (required)
  - share_label: {String} Label before icons (the region's: content/article.json, article.share)

  Usage:
  {% render 'blog--article--share', article: article, share_label: "Share this post" %}
{% endcomment %}

{%- assign label_text = share_label -%}
{%- assign share_url = request.origin | append: article.url -%}
{%- assign share_title = article.title | url_encode -%}
{%- assign share_url_encoded = share_url | url_encode -%}

<div class="page-width page-width--narrow blog-share">
  <span class="blog-share__label">{{ label_text | escape }}</span>
  <div class="blog-share__buttons">
    <!-- Twitter/X -->
    <a
      href="https://twitter.com/intent/tweet?url={{ share_url_encoded }}&text={{ share_title }}"
      target="_blank"
      rel="noopener noreferrer"
      class="blog-share__btn"
      aria-label="{{ 'blogs.article.share_x' | t }}">
      <svg viewBox="0 0 24 24" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
      </svg>
    </a>

    <!-- Facebook -->
    <a
      href="https://www.facebook.com/sharer/sharer.php?u={{ share_url_encoded }}"
      target="_blank"
      rel="noopener noreferrer"
      class="blog-share__btn"
      aria-label="{{ 'blogs.article.share_facebook' | t }}">
      <svg viewBox="0 0 24 24" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
        <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
      </svg>
    </a>

    <!-- Pinterest -->
    <a
      href="https://pinterest.com/pin/create/button/?url={{ share_url_encoded }}&description={{ share_title }}{% if article.image %}&media={{ article.image | image_url: width: 1200 | url_encode }}{% endif %}"
      target="_blank"
      rel="noopener noreferrer"
      class="blog-share__btn"
      aria-label="{{ 'blogs.article.share_pinterest' | t }}">
      <svg viewBox="0 0 24 24" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
        <path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12.017 24c6.624 0 11.99-5.367 11.99-11.988C24.007 5.367 18.641 0 12.017 0z"/>
      </svg>
    </a>

    <!-- Copy Link Button with Toast State -->
    <button
      type="button"
      class="blog-share__btn blog-share__copy"
      aria-label="{{ 'blogs.article.copy_link' | t }}"
      data-url="{{ share_url }}"
      onclick="navigator.clipboard.writeText(this.dataset.url).then(()=>{this.classList.add('is-copied');setTimeout(()=>this.classList.remove('is-copied'),2000)})">
      <svg viewBox="0 0 24 24" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
        <path d="M13.723 4.277a3.75 3.75 0 010 5.303l-1.06 1.06a.75.75 0 01-1.061-1.06l1.06-1.061a2.25 2.25 0 00-3.182-3.182l-2.829 2.83a2.25 2.25 0 000 3.182.75.75 0 01-1.06 1.06 3.75 3.75 0 010-5.303l2.828-2.829a3.75 3.75 0 015.304 0zm-3.446 7.446a.75.75 0 011.06 0 3.75 3.75 0 010 5.304l-2.828 2.828a3.75 3.75 0 01-5.304-5.303l1.06-1.06a.75.75 0 111.061 1.06l-1.06 1.06a2.25 2.25 0 003.182 3.183l2.828-2.83a2.25 2.25 0 000-3.181.75.75 0 010-1.061z"/>
      </svg>
    </button>
  </div>
</div>
