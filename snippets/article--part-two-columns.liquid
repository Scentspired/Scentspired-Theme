{%- comment -%}
  The "two_columns" part of an article: its design, the same for every article.
  Edit it here. (Built from blocks/editorial--text-section-2.liquid, removed once every article used
  this part.) An article's words, images and links are in
  regions/<id>/content/articles.json.

  Fields: heading, column_1, column_2
  Params: content_key ('articles.<entry>.parts.<n>.'), part_id (unique on the page)
{%- endcomment -%}
{%- liquid
  assign k = content_key | append: 'heading'
  capture part_heading
    render 'region--content', key: k
  endcapture
  assign part_heading = part_heading | strip
  assign k = content_key | append: 'column_1'
  capture part_column_1_text
    render 'region--content', key: k
  endcapture
  assign part_column_1_text = part_column_1_text | strip
  assign k = content_key | append: 'column_2'
  capture part_column_2_text
    render 'region--content', key: k
  endcapture
  assign part_column_2_text = part_column_2_text | strip
-%}

{{ 'article--part-two-columns.css' | asset_url | stylesheet_tag }}

<editorial-section-two-columns class="ai-editorial-section-two-columns">
  <div class="ai-editorial-container-two-columns">
    {% if part_heading != blank %}
      <h2 class="ai-editorial-heading-two-columns">{{ part_heading }}</h2>
    {% endif %}

    <div class="ai-editorial-columns-two-columns">
      <div class="ai-editorial-column-two-columns">
        {{ part_column_1_text }}
      </div>
      <div class="ai-editorial-column-two-columns">
        {{ part_column_2_text }}
      </div>
    </div>
  </div>
</editorial-section-two-columns>


