{%- comment -%}
  GENERATED by scripts/build-article-parts.cjs from blocks/editorial--text-section-2.liquid — the
  "two_columns" part of an article. Edit the design here (or regenerate); an
  article's words, images and links are in regions/<id>/content/articles.json.

  Fields: heading, column_1, column_2
  Params: content_key ('articles.<entry>.parts.<n>.'), part_id (unique on the page)
{%- endcomment -%}
{%- liquid
  assign k = content_key | append: 'heading'
  capture part_heading
    render 'region--content', key: k
  endcapture
  assign part_heading = part_heading | strip
  assign k = content_key | append: 'column_1'
  capture part_column_1_text
    render 'region--content', key: k
  endcapture
  assign part_column_1_text = part_column_1_text | strip
  assign k = content_key | append: 'column_2'
  capture part_column_2_text
    render 'region--content', key: k
  endcapture
  assign part_column_2_text = part_column_2_text | strip
-%}
{% assign ai_gen_id = part_id %}

{% style %}
  .ai-editorial-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: #f9f6f1;
    padding: 60px 40px 60px;
  }

  .ai-editorial-container-{{ ai_gen_id }} {
    max-width: 80%;
    margin: 0 auto;
  }

  .ai-editorial-heading-{{ ai_gen_id }} {
    font-family: var(--font-display-italic);
    font-style: italic;
    font-size: 56px;
    line-height: 1;
    color: #000000;
    margin: 0 0 50px 0;
    text-align: left;
    width: 100%;
  }

  .ai-editorial-columns-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
  }

  .ai-editorial-column-{{ ai_gen_id }} {
    font-family: var(--font-body);
    font-size: 24px;
    line-height: 1.6;
    color: #000000;
    text-align: left;
  }

  .ai-editorial-column-{{ ai_gen_id }} p {
    margin: 0 0 10px 0;
  }

  .ai-editorial-column-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-editorial-section-{{ ai_gen_id }} {
      padding: 40px 20px 40px;
    }

    .ai-editorial-heading-{{ ai_gen_id }} {
      font-size: 32px;
      margin-bottom: 30px;
    }

    .ai-editorial-columns-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .ai-editorial-column-{{ ai_gen_id }} {
      font-size: 14px;
    }
    
  }

  /* Was per-article custom CSS in every template using this part. */
  .ai-editorial-heading-{{ ai_gen_id }} { max-width: 625px; }
{% endstyle %}

<editorial-section-{{ ai_gen_id }} class="ai-editorial-section-{{ ai_gen_id }}">
  <div class="ai-editorial-container-{{ ai_gen_id }}">
    {% if part_heading != blank %}
      <h2 class="ai-editorial-heading-{{ ai_gen_id }}">{{ part_heading }}</h2>
    {% endif %}

    <div class="ai-editorial-columns-{{ ai_gen_id }}">
      <div class="ai-editorial-column-{{ ai_gen_id }}">
        {{ part_column_1_text }}
      </div>
      <div class="ai-editorial-column-{{ ai_gen_id }}">
        {{ part_column_2_text }}
      </div>
    </div>
  </div>
</editorial-section-{{ ai_gen_id }}>

<script>
  (function() {
    class EditorialSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('editorial-section-{{ ai_gen_id }}', EditorialSection{{ ai_gen_id }});
  })();
</script>

