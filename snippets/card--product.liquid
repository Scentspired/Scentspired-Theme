{%- comment -%}
  ============================================================================
  SCENTSPIRED — Product Card
  ============================================================================
  The single definition of product card markup.

  Six sections previously each carried their own copy of this markup inside a
  JavaScript template literal — best-sellers, Video-banner1, featuredscent,
  main-collection-product-grid, bundlediscovery and mobile-video-banner. A
  change to the card meant editing six files and hoping none were missed.

  The markup lives here once, as an inert <template>. assets/card--product.js
  clones it and fills the slots, so no JavaScript contains card markup.

  Usage — render once per page, then build cards in JS:

      {% render 'card--product' %}
      <script src="{{ 'card--product.js' | asset_url }}" defer></script>
      ...
      grid.appendChild(ScentspiredCard.render(product));

  Slots are marked with data-card-* attributes. Adding a field means adding a
  slot here and one line in the renderer — never touching a section.

  Contract for `product`:
    id, url, title, vendor, featured_image, hover_image (optional),
    rating (optional), badges: [{label, modifier}],
    variants: [{ id, title, price, compareAtPrice, available }]
  ============================================================================
{%- endcomment -%}

<template id="card--product">
  <div class="fragrance-item" data-card-root>
    <a data-card-image-link style="text-decoration: none; color: inherit;">
      <div class="fragrance-image-wrap">
        <img data-card-image alt="">
        <img class="secondary-image" data-card-hover-image alt="" hidden>
        <div class="product-badges" data-card-badges></div>
      </div>
    </a>

    <div class="fragrance-info">
      <p class="fragrance-rating" data-card-rating hidden></p>

      <a data-card-title-link style="text-decoration: none; color: inherit;">
        <div class="fragrance-name" data-card-title></div>
      </a>

      <div class="fragrance-brand" data-card-vendor></div>

      <div class="product-price-display" data-price-display>
        <div class="price-wrapper">
          <span data-current-price></span>
          <span class="compare-price" data-card-compare-price hidden></span>
          <span class="sale-badge" data-card-sale-badge hidden>SALE</span>
        </div>
      </div>

      <form method="post" action="/cart/add" class="product-form" data-card-form>
        <input type="hidden" name="id" class="selected-variant-id" value="">
        <div class="variant-options" data-card-variants hidden></div>
        <button type="submit" class="cart-button" data-card-submit>Add to Cart</button>
      </form>
    </div>
  </div>
</template>
