{%- comment -%}
  The "text" part of an article: its design, the same for every article.
  Edit it here. (Built from sections/editorial--blog-text.liquid, removed once every article used
  this part.) An article's words, images and links are in
  regions/<id>/content/articles.json.

  Fields: text
  Params: content_key ('articles.<entry>.parts.<n>.'), part_id (unique on the page)
{%- endcomment -%}
{%- liquid
  assign k = content_key | append: 'text'
  capture part_text_content
    render 'region--content', key: k
  endcapture
  assign part_text_content = part_text_content | strip
-%}
{% comment %}
  Scentspired Blog Rich Text Section
  ──────────────────────────────────────────────────────────
  Canonical rich text section for blog article pages.
  Replaces: blogtextliquid.liquid, text-blog.liquid
  Styled by blog--typography.css, which layout/theme.liquid loads on every
  article page.
{% endcomment %}

{%- liquid
  assign text_size = 'body' | default: 'body'
  assign text_align = 'left' | default: 'left'
  assign max_width_class = 'blog-richtext--standard'
  if text_size == 'statement'
    assign max_width_class = 'blog-richtext--statement'
  endif
-%}

<style>
  .blog-richtext-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: {{ 40 | default: 40 }}px 20px {{ 60 | default: 60 }}px;
    background-color: {{ '#ffffff' | default: '#ffffff' }};
  }

  .blog-richtext-content {
    font-family: var(--blog-body-font, 'PPMori Regular', sans-serif);
    font-weight: 200;
    font-style: normal;
    line-height: 1.6;
    letter-spacing: 0.02em;
    color: {{ '#000000' | default: '#000000' }};
    max-width: var(--blog-column-max-width, 680px);
    text-align: {{ text_align }};
    margin: 0 auto;
  }

  .blog-richtext--standard .blog-richtext-content {
    font-size: var(--blog-body-size, 19px);
  }

  .blog-richtext--statement .blog-richtext-content {
    font-size: 28px;
    line-height: 1.3;
  }

  .blog-richtext-content p {
    margin: 0 0 28px;
  }

  .blog-richtext-content p:last-child {
    margin-bottom: 0;
  }

  .blog-richtext-content a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .blog-richtext-content strong,
  .blog-richtext-content b {
    font-weight: 700;
    color: #000;
  }

  @media (min-width: 768px) {
    .blog-richtext--statement .blog-richtext-content {
      font-size: 52px;
      line-height: 1.15;
    }
  }

  @media screen and (max-width: 749px) {
    .blog-richtext-content {
      max-width: 100%;
    }
  }

  /* Was per-article custom CSS in every template using this part. */
  .blog-richtext-wrapper a { color: #000; }
</style>

<div class="blog-richtext-wrapper">
  <div class="{{ max_width_class }}">
    <div class="blog-richtext-content">
      {{ part_text_content }}
    </div>
  </div>
</div>

