    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
    font-size: 14px;
  }

  .sp-summary-label {
    color: #333;
    font-weight: 600;
  }

  .sp-summary-price {
    color: #333;
    font-weight: 400;
  }

  .sp-summary-line.sp-member-discount-line {
    color: #e67e5b;
    font-weight: 600;
  }

  .sp-tax-note {
    font-size: 12px;
    color: #999;
    text-align: right;
    margin-top: 12px;
  }

  .sp-discount-notice {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #f1e9dd;
    padding: 8px;
    border-radius: 4px;
    margin-top: 12px;
  }

  /* Recommendations - Updated to match reference image */
  .sp-recommendations-section {
    padding: 0 20px 20px;
  }

  .sp-recommendations-section h3 {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 16px;
    color: #333;
  }

  .sp-recommended-products {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    padding-bottom: 8px;
    scroll-behavior: smooth;
  }

  .sp-recommended-products::-webkit-scrollbar {
    height: 4px;
  }

  .sp-recommended-products::-webkit-scrollbar-track {
    background: #f1f1f1;
    border-radius: 2px;
  }

  .sp-recommended-products::-webkit-scrollbar-thumb {
    background: #ccc;
    border-radius: 2px;
  }

  .sp-recommended-products::-webkit-scrollbar-thumb:hover {
    background: #999;
  }

  .sp-recommended-item {
    flex-shrink: 0;
    width: 140px;
    background: #fffcf7;
    border-radius: 8px;
    padding: 12px;
    text-align: center;
    border: 1px solid #f0f0f0;
    display: flex;
    flex-direction: column;
  }

  .sp-rec-image {
    width: 100%;
    height: 120px;
    margin-bottom: 12px;
    background: #f8f8f8;
    border-radius: 6px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sp-rec-product-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 6px;
  }

  .sp-rec-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #f5f1e8 0%, #e8e4d9 100%);
  }

  .sp-bottles-group {
    display: flex;
    gap: 2px;
    align-items: flex-end;
  }

  .sp-bottle {
    width: 12px;
    height: 20px;
    background: #d4756b;
    border-radius: 1px 1px 3px 3px;
    position: relative;
  }

  .sp-bottle:nth-child(2) {
    height: 24px;
    background: #e67e5b;
  }

  .sp-bottle:nth-child(3) {
    height: 18px;
    background: #c66a5a;
  }

  .sp-bottle::before {
    content: '';
    position: absolute;
    top: -2px;
    left: 50%;
    transform: translateX(-50%);
    width: 4px;
    height: 3px;
    background: #999;
    border-radius: 1px;
  }

  .sp-single-bottle {
    width: 20px;
    height: 32px;
    background: #e67e5b;
    border-radius: 2px 2px 6px 6px;
    position: relative;
  }

  .sp-single-bottle.citrus {
    background: #f4d03f;
  }

  .sp-single-bottle::before {
    content: '';
    position: absolute;
    top: -4px;
    left: 50%;
    transform: translateX(-50%);
    width: 8px;
    height: 6px;
    background: #999;
    border-radius: 2px;
  }

  .sp-rec-details {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    flex: 1; /* key */
  }

  .sp-rec-details h4 {
    font-size: 12px;
    font-weight: 700;
    margin: 0;
    color: #333;
    letter-spacing: 0.5px;
    line-height: 1.2;
    text-align: center;
    min-height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sp-rec-vendor {
    font-size: 10px;
    color: #666;
    margin: 0;
    line-height: 1.2;
    text-align: center;
    min-height: 12px;
  }

  .sp-rec-inspired {
    font-size: 9px;
    color: #666;
    margin: 0;
    line-height: 1.2;
    text-align: center;
    min-height: 12px;
  }

  .sp-rec-price {
    font-size: 14px;
    font-weight: 700;
    color: #333;
    margin: 8px 0;
    text-align: center;
  }

  .sp-add-to-cart-btn {
    background: #f4ff41;
    padding: 8px 12px;
    font-size: 10px;
    font-weight: 600;
    border-radius: 20px;
    cursor: pointer;
    width: 100%;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: all 0.2s ease;
    color: #000;
    border: none;
    margin-top: auto; /* key */
  }

  .sp-add-to-cart-btn:hover {
    background: #f4ff41;
    color: #000;
  }

  /* Checkout Section */
  .sp-checkout-section {
    padding: 20px;
    background: white;
    border-top: 1px solid #e0ddd4;
  }

  .sp-checkout-btn {
    width: 100%;
    background: #f4ff41 !important;
    color: #000;
    border: none;
    padding: 16px;
    border-radius: 25px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .sp-checkout-btn:hover {
    background: #f4ff41 !important;
  }

  .sp-checkout-total {
    font-size: 16px;
    font-weight: 700;
  }

  .sp-checkout-notice {
    text-align: center;
  }

  .sp-checkout-notice p {
    font-size: 10px;
    color: #666;
    line-height: 1.3;
    margin: 0;
  }

  .sp-checkout-notice a {
    color: #e67e5b;
    text-decoration: underline;
  }

  /* Responsive */
  @media (max-width: 480px) {
    .sp-cart-drawer {
      max-width: 80%;
    }

    .sp-product-actions {
      width: 105px;
    }
    .sp-remove-product {
      padding: 0px;
    }
    .sp-bundle-tiers {
      flex-wrap: wrap;
    }

    .sp-tier {
      min-width: calc(50% - 3px);
    }

    .sp-product-item {
      flex-direction: row;
      gap: 3px;
    }

    .sp-product-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }

    .sp-product-pricing {
      align-items: flex-start;
    }

    .sp-product-title {
      max-width: 100%;
    }

    .sp-empty-cart-full-container {
      padding: 30px 15px;
    }

    .sp-empty-title {
      font-size: 28px;
    }

    .sp-collections-grid {
      gap: 12px;
    }

    .sp-collection-card {
      padding: 12px;
      gap: 10px;
    }

    .sp-collection-image {
      width: 40px;
      height: 40px;
    }

    .sp-collection-name {
      font-size: 13px;
    }

    .sp-shop-all-btn {
      padding: 14px 28px;
      font-size: 13px;
    }
  }
  .sp-original-price-bundle {
    font-size: 14px;
    color: #cbdd00 !important;
    line-height: 1;
    font-weight: 700;
  }
  .bundle-restrict {
    color: #000 !important;
    font-size: 13px;
    text-align: left;
    font-style: italic;
  }
  .sp-logo-image {
    height: 30px !important; /* adjust as needed */
    width: auto;
    display: block;
  }
  .sp-rec-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
</style>

{% comment %}
  Renders cart drawer with empty state collections and all other sections.
  Usage: {% render 'cart-drawer-complete' %}
{% endcomment %}

<!-- Cart Drawer Overlay -->
<div id="sp-cart-overlay" class="sp-cart-overlay" onclick="closeDossierCart()"></div>

<!-- Cart Drawer -->
<div id="sp-cart-drawer" class="sp-cart-drawer">
  <div class="sp-cart-content">
    <!-- Header -->
    <div class="sp-cart-header">
      <button class="sp-back-btn" onclick="closeDossierCart()">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M10 12L6 8L10 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Back
      </button>
    </div>

    <!-- Empty Cart State - Full Drawer -->
    <div
      class="sp-empty-cart-full-container"
      id="sp-empty-cart-full-container"
      {% if cart.items.size > 0 %}
        style="display: none;"
      {% endif %}>
      <div class="sp-empty-cart-content">
        <h2 class="sp-empty-title">Oops...</h2>
        <p class="sp-empty-subtitle">You have no items in your bag.</p>
        <p class="sp-empty-help">Let us help!</p>

        <!-- Collections Grid -->
        <div class="sp-collections-grid">
          {% comment %} You can change these collection handles as needed {% endcomment %}
          {% assign collection_handles = "men,women,bestsellers,unisex" | split: "," %}
          {% assign collection_names = "Men Inspired Impressions,Women Inspired Impressions,Best-sellers,Unisex Inspired Impression"
            | split: ","
          %}

          {% for handle in collection_handles %}
            {% assign collection = collections[handle] %}
            {% assign collection_name = collection_names[forloop.index0] %}

            <a
              href="{{ collection.url | default: '/collections/all' }}"
              class="sp-collection-card"
              onclick="closeDossierCart()">
              <div class="sp-collection-image">
                {% if collection.image %}
                  <img src="{{ collection.image | img_url: '120x120' }}" alt="{{ collection_name }}" loading="lazy">
                {% else %}
                  <!-- Fallback placeholder based on collection type -->
                  <div class="sp-collection-placeholder" data-collection="{{ forloop.index }}">
                    {% case forloop.index %}
                      {% when 1 %}
                        <!-- Impressions placeholder -->
                        <div class="sp-bottles-group">
                          <div class="sp-bottle impressions"></div>
                          <div class="sp-bottle impressions-2"></div>
                          <div class="sp-bottle impressions-3"></div>
                        </div>
                      {% when 2 %}
                        <!-- Originals placeholder -->
                        <div class="sp-single-bottle originals"></div>
                      {% when 3 %}
                        <!-- Best-sellers placeholder -->
                        <div class="sp-bottles-group bestsellers">
                          <div class="sp-bottle best-1"></div>
                          <div class="sp-bottle best-2"></div>
                        </div>
                      {% when 4 %}
                        <!-- Home Scents placeholder -->
                        <div class="sp-single-bottle home-scents"></div>
                    {% endcase %}
                  </div>
                {% endif %}
              </div>
              <h3 class="sp-collection-name">{{ collection_name }}</h3>
            </a>
          {% endfor %}
        </div>

        <!-- Shop All Button -->
        <a
          href="https://scentspired.myshopify.com/collections/shop"
          class="sp-shop-all-btn"
          onclick="closeDossierCart()">
          SHOP ALL PERFUMES
        </a>

        <!-- Free Shipping Text -->
        <p class="sp-free-shipping-text">Free Shipping over 70$</p>
      </div>
    </div>

    <!-- Full Cart Sections -->
    <div
      id="sp-full-cart-sections"
      {% if cart.items.size == 0 %}
        style="display: none;"
      {% endif %}>
      <!-- Bundle Offers Section -->
      <div class="sp-bundle-section">
        <div class="sp-bundle-container">
          <div class="sp-bundle-header">
            <img
              src="https://scentspired.com/cdn/shop/files/Scentspired_logo.png?v=1758619291&width=200"
              alt="Scentspired"
              class="sp-logo-image" />

            <div class="sp-info-icon">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                <circle cx="7" cy="7" r="6" stroke="#999" stroke-width="1"/>
                <path d="M7 5v4M7 9h.01" stroke="#999" stroke-width="1"/>
              </svg>
            </div>
          </div>

          <!-- Updated bundle tiers from 3 to 5 tiers with new discount and shipping structure -->
          <div class="sp-bundle-tiers">
            <div class="sp-tier" data-items="1">
              <div class="sp-tier-items">Below $70</div>
              <div class="sp-tier-discount">$7.99 Shipping</div>
            </div>
            <div class="sp-tier" data-items="2">
              <div class="sp-tier-items">$70+</div>
              <div class="sp-tier-discount">Free Shipping</div>
            </div>
          </div>
          <!-- Free Shipping Threshold -->
          <div class="sp-free-shipping">
            <div class="sp-shipping-circle">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <circle cx="8" cy="8" r="7" stroke="#666" stroke-width="2"/>
                <circle cx="8" cy="8" r="3" fill="#666"/>
              </svg>
            </div>
            <span><strong>FREE</strong> shipping on orders over $70 | $7.99 shipping under $70</span>
          </div>
        </div>
      </div>

      <!-- Login Section - Updated Design -->
      <div class="sp-login-section">
        <div class="sp-login-header">
          <button class="sp-go-to-summary" onclick="scrollToOrderSummary()">
            <span>Go to Order Summary</span>
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
              <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

          {% if customer %}
            <a href="/account" class="sp-login-link">View Account</a>
          {% else %}
            <a href="/account/login" class="sp-login-link">Login</a>
          {% endif %}
        </div>
      </div>

      <!-- Your Cart Section - ALL PRODUCTS VERTICAL -->
      <div class="sp-cart-section">
        <div class="sp-cart-container">
          <div class="sp-cart-header-section">
            <div class="sp-section-number">1</div>
            <h2 class="sp-cart-title">YOUR CART</h2>
          </div>

          <div class="sp-cart-items-list" id="sp-cart-items-list">
            {% comment %} This content will be dynamically updated by JavaScript {% endcomment %}
            {% comment %} Initial render based on Liquid for first load {% endcomment %}
            {% assign total_cart_quantity = 0 %}
            {% for item in cart.items %}
              {% assign total_cart_quantity = total_cart_quantity | plus: item.quantity %}
            {% endfor %}

            <!-- SHIPPING LOGIC ONLY: No Discounts -->
            {% assign bundle_discount_percentage = 0 %}
            {% assign shipping_cost_cents = 799 %}

            {% for item in cart.items %}
              <div
                class="sp-product-item"
                data-key="{{ item.key }}"
                data-variant-id="{{ item.variant.id }}"
                data-inventory="{{ item.variant.inventory_quantity | default: 999 }}">
                <div class="sp-product-image-container">
                  <img src="{{ item.image | img_url: '120x120' }}" alt="{{ item.title }}" class="sp-product-image">
                </div>

                <div class="sp-product-details">
                  <div class="sp-product-header">
                    <h3 class="sp-product-title">{{ item.product.title | upcase }}</h3>
                    <div class="sp-product-pricing">
                      {% assign original_price_per_item = item.original_price %}
                      {% assign total_discounted_line_price = original_price_per_item | times: item.quantity %}

                      <span class="sp-discounted-price">
                        $<span
                          class="price-value"
                          data-single-price="{{ original_price_per_item | money_without_currency }}"
                          data-original-single="{{ original_price_per_item | money_without_currency }}"
                          data-discount="0">
                          {{- total_discounted_line_price | money_without_currency -}}
                        </span>
                      </span>
                    </div>
                  </div>

                  <div class="sp-product-description">
                    {% if item.product.description != blank %}
                      {{ item.product.description | strip_html | truncate: 60 }}
                    {% else %}
                      Eau de Parfum, Size: {{ item.variant.option1 | default: "50ml" }} / 1.7oz
                    {% endif %}
                  </div>

                  <div class="sp-product-vendor">
                    {% if item.product.metafields.custom.inspired_by != blank %}
                      Inspired by {{ item.product.metafields.custom.inspired_by }}
                    {% elsif item.vendor != blank and item.vendor != "Your Store" %}
                      {{ item.vendor }}
                    {% else %}
                      Dossier Perfumes
                    {% endif %}
                  </div>

                  <div class="sp-product-actions">
                    <div class="sp-quantity-section">
                      <button class="sp-qty-decrease">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                          <path d="M3 7h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                      </button>
                      <span class="sp-quantity-display" data-quantity="{{ item.quantity }}">{{ item.quantity }}</span>
                      <button class="sp-qty-increase">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                          <path d="M7 3v8M3 7h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                      </button>
                    </div>

                    <button class="sp-remove-product" onclick="removeDossierCartItem('{{ item.key }}')">
                      <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                        <path d="M2.25 4.5h13.5M6 4.5V3a1.5 1.5 0 011.5-1.5h3A1.5 1.5 0 0112 3v1.5m3 0v10.5a1.5 1.5 0 01-1.5 1.5h-9A1.5 1.5 0 013 15V4.5h12z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      </div>

      <!-- Order Summary Section - Move this right after Pick the Way You Shop -->
      <div class="sp-order-summary-section" id="sp-order-summary">
        <div class="sp-summary-box">
          <div class="sp-section-header">
            <span class="sp-section-number">2</span>
            <h2>ORDER SUMMARY</h2>
          </div>

          <div class="sp-summary-details">
            <div class="sp-summary-line">
              <span class="sp-summary-label"> Cart Subtotal </span>
              <span class="sp-summary-price" id="summary-initial-price">$0.00</span>
            </div>

            <div class="sp-summary-line">
              <span class="sp-summary-label">Shipping</span>
              <span class="sp-summary-price" id="sp-shipping-cost">$3.95</span>
            </div>

            <div class="sp-summary-line sp-member-discount-line" id="member-discount-line" style="display: none;">
              <span>d<sup>+</sup> Discount: 10% OFF</span>
              <span id="summary-member-discount">-$0.00</span>
            </div>

            <div class="sp-tax-note" style="display: none;">
              <span>Tax is calculated at next step</span>
            </div>
          </div>
        </div>

        <!-- Move discount notice outside the box -->
        <div class="sp-discount-notice" id="discount-notice" style="display: none;">
          <div class="sp-check-icon">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <rect width="16" height="16" rx="8" fill="#e67e5b"/>
              <path d="M4.5 8l2.5 2.5 5-5" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <span>Your Sp+ discount has been automatically added to your total.</span>
        </div>
      </div>

      <!-- You Might Like to Add Section -->
      <div class="sp-recommendations-section">
        <h3>You might like to add</h3>

        <div class="sp-recommended-products">
          {% comment %} Get products from most-popular collection {% endcomment %}
          {% assign recommended_collection = collections.bestsellers %}
          {% if recommended_collection.products.size > 0 %}
            {% for product in recommended_collection.products limit: 10 %}
              <div class="sp-recommended-item" data-product-id="{{ product.id }}">
                <a href="{{ product.url }}" class="sp-rec-link">
                  <div class="sp-rec-image">
                    {% if product.featured_image %}
                      <img
                        src="{{ product.featured_image | img_url: '200x200' }}"
                        alt="{{ product.title }}"
                        class="sp-rec-product-image">
                    {% else %}
                      <div class="sp-rec-placeholder">
                        <div class="sp-single-bottle"></div>
                      </div>
                    {% endif %}
                  </div>
                  <div class="sp-rec-details">
                    <h4>{{ product.title | upcase }}</h4>
                    <p class="sp-rec-vendor">
                      {% if product.vendor and product.vendor != "Your Store" %}
                        {{ product.vendor }}
                      {% else %}
                        Dossier Perfumes
                      {% endif %}
                    </p>
                    {% if product.metafields.custom.inspired_by %}
                      <p class="sp-rec-inspired">Inspired by {{ product.metafields.custom.inspired_by }}</p>
                    {% endif %}
                    <div class="sp-rec-price">${{ product.price | money_without_currency }}</div>
                  </div>
                </a>
                <button
                  class="sp-add-to-cart-btn"
                  onclick="addDossierRecommended('{{ product.variants.first.id }}', '{{ product.title | escape }}', '{{ product.featured_image | img_url: '120x120' }}', {{ product.price }}, {{ product.compare_at_price | default: product.price }})">
                  ADD TO CART
                </button>
              </div>
            {% endfor %}
          {% else %}
            {% comment %} Fallback products if collection doesn't exist {% endcomment %}
            <div class="sp-recommended-item">
              <div class="sp-rec-image">
                <div class="sp-rec-placeholder">
                  <div class="sp-bottles-group">
                    <div class="sp-bottle"></div>
                    <div class="sp-bottle"></div>
                    <div class="sp-bottle"></div>
                  </div>
                </div>
              </div>
              <div class="sp-rec-details">
                <h4>DISCOVERY SET</h4>
                <p class="sp-rec-vendor">Dossier Perfumes</p>
                <div class="sp-rec-price">$99</div>
                <button class="sp-add-to-cart-btn" onclick="addDossierRecommended('discovery-set')">ADD TO CART</button>
              </div>
            </div>

            <div class="sp-recommended-item">
              <div class="sp-rec-image">
                <div class="sp-rec-placeholder">
                  <div class="sp-single-bottle"></div>
                </div>
              </div>
              <div class="sp-rec-details">
                <h4>WOODY SAGE</h4>
                <p class="sp-rec-vendor">Inspired by</p>
                <p class="sp-rec-inspired">Jo Malone's Wood Sage & Sea Salt</p>
                <div class="sp-rec-price">$29</div>
                <button class="sp-add-to-cart-btn" onclick="addDossierRecommended('woody-sage')">ADD TO CART</button>
              </div>
            </div>

            <div class="sp-recommended-item">
              <div class="sp-rec-image">
                <div class="sp-rec-placeholder">
                  <div class="sp-single-bottle citrus"></div>
                </div>
              </div>
              <div class="sp-rec-details">
                <h4>FLORA LAVENDER</h4>
                <p class="sp-rec-vendor">Inspired by</p>
                <p class="sp-rec-inspired">YSL's Libre</p>
                <div class="sp-rec-price">$29</div>
                <button class="sp-add-to-cart-btn" onclick="addDossierRecommended('flora-lavender')">
                  ADD TO CART
                </button>
              </div>
