{%- comment -%}
  GENERATED by scripts/build-article-parts.cjs from blocks/editorial--luxury-perfume-banner-3.liquid — the
  "feature_banner" part of an article. Edit the design here (or regenerate); an
  article's words, images and links are in regions/<id>/content/articles.json.

  Fields: image, line_1, line_2_regular, line_2_italic, line_3, image_tone ("light" | "dark")
  Params: content_key ('articles.<entry>.parts.<n>.'), part_id (unique on the page)
{%- endcomment -%}
{%- liquid
  assign k = content_key | append: 'image'
  capture part_background_image
    render 'region--content', key: k
  endcapture
  assign part_background_image = part_background_image | strip
  # an image is named as in Shopify ("shopify://shop_images/<file>") and read from the store's files
  assign image_file = part_background_image | remove_first: 'shopify://shop_images/'
  assign part_background_image = nil
  if image_file != blank
    # a file the store does not have comes back as an empty image: treat it
    # as no image, as Shopify does for a missing image setting
    assign image_found = images[image_file]
    if image_found.width > 0
      assign part_background_image = image_found
    endif
  endif
  assign k = content_key | append: 'line_1'
  capture part_text_line_1
    render 'region--content', key: k
  endcapture
  assign part_text_line_1 = part_text_line_1 | strip
  assign k = content_key | append: 'line_2_regular'
  capture part_brand_name_regular
    render 'region--content', key: k
  endcapture
  assign part_brand_name_regular = part_brand_name_regular | strip
  assign k = content_key | append: 'line_2_italic'
  capture part_brand_name_italic
    render 'region--content', key: k
  endcapture
  assign part_brand_name_italic = part_brand_name_italic | strip
  assign k = content_key | append: 'line_3'
  capture part_text_line_2
    render 'region--content', key: k
  endcapture
  assign part_text_line_2 = part_text_line_2 | strip
  # text over a photo: dark photo, light text; light photo, dark text
  assign k = content_key | append: 'image_tone'
  capture part_image_tone
    render 'region--content', key: k
  endcapture
  assign part_image_tone = part_image_tone | strip | default: 'dark'
  assign part_text_color = '#000000'
  if part_image_tone == 'dark'
    assign part_text_color = '#ffffff'
  endif
  # the banner takes its image's own shape (height as a % of width)
  assign part_image_shape = 56
  if part_background_image != blank
    assign part_image_shape = 100.0 | divided_by: part_background_image.aspect_ratio | round: 1
  endif
-%}
{% assign ai_gen_id = part_id %}

{% style %}

  /* ─── Outer white border wrapper ─── */
  .lux-wrap-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background: #ffffff;
    padding: 16px;
    box-sizing: border-box;
  }

  /* ─── Inner banner: key trick — padding-top % creates height relative to WIDTH ─── */
  /*   The image is 16:9 (1328×747 px approx). ratio = 747/1328 = 56.25%               */
  .lux-banner-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    /* Adapt to actual image aspect ratio */
    padding-top: {{ part_image_shape }}%;
    overflow: hidden;
    background: #2d0a0f;
  }

  /* ─── Background image fills the ratio box exactly ─── */
  .lux-bg-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
    z-index: 1;
  }

  /* ─── Placeholder when no image uploaded ─── */
  .lux-bg-placeholder-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, #3d0a10 0%, #7a1520 45%, #2a0508 100%);
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.3);
    font-size: 14px;
    font-family: sans-serif;
  }

  /* ─── Spotlight overlays ─── */
  .lux-spot-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }
  .lux-spot-{{ ai_gen_id }}::before,
  .lux-spot-{{ ai_gen_id }}::after {
    content: '';
    position: absolute;
    top: -30%;
    width: 55%;
    height: 80%;
    border-radius: 50%;
    filter: blur(120px);
    opacity: {{ nil }};
  }
  .lux-spot-{{ ai_gen_id }}::before {
    left: -8%;
    background: radial-gradient(circle, rgba(255,255,255,0.18) 0%, transparent 70%);
  }
  .lux-spot-{{ ai_gen_id }}::after {
    right: -8%;
    background: radial-gradient(circle, rgba(255,255,255,0.13) 0%, transparent 70%);
  }

  /* ─── Text layer — absolute, fills the ratio box ─── */
  .lux-text-layer-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    z-index: 3;
    /* 
      CORE FIX:
      We use a coordinate system where the banner is treated as if it were always
      the "design width" (1440px in this case). By expressing left/top as percentages
      they move proportionally with the banner's width AND height (since height is
      locked by padding-top % to the same aspect ratio). This means the text always
      sits at the same relative position in the image, regardless of screen width.
    */
  }

  /* ─── Line 1: "That is where" ─── */
  /*
    In the 1440px reference:
      - Visually starts around x=270px  → 270/1440 = 18.75%
      - Visually at y≈475px in a ~750px tall banner → 475/750 = 63.3%
    Using left + no transform so it anchors from its own left edge.
  */
  .lux-line1-{{ ai_gen_id }} {
    position: absolute;
    top: 61%;
    left: 21%;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    /* 
      Font size scales with banner WIDTH via vw — but clamped so it doesn't get
      too large or too small. At 1440px wide we want ~52px → 52/1440 = 3.6vw
    */
    font-size: clamp(22px, 3.9vw, 68px);
    color: {{ part_text_color }};
    letter-spacing: 0.03em;
    line-height: 1;
    text-shadow: 0 2px 20px rgba(0,0,0,0.5);
    white-space: nowrap;
    pointer-events: none;
  }

  /* ─── Line 2: "Scentspired" hero text ─── */
  /*
    In the 1440px reference:
      - Center of text around x=700px → left ~42%
      - y ≈ 520px → 520/750 = 69.3%
    Font: ~110px at 1440px → 110/1440 = 7.64vw
  */
  .lux-line2-{{ ai_gen_id }} {
    position: absolute;
    top: 2%;
    left: 29%;
    font-size: clamp(42px, 3.6vw, 145px);
    letter-spacing: -0.02em;
    line-height: 0.9;
    color: {{ part_text_color }};
    text-shadow: 0 4px 30px rgba(0,0,0,0.6);
    white-space: nowrap;
    pointer-events: none;
  }
  .lux-line2-regular-{{ ai_gen_id }} {
    font-family: 'PP Editorial New', 'Cormorant Garamond', Georgia, serif;
    font-style: normal;
    font-weight: 300;
  }
  .lux-line2-italic-{{ ai_gen_id }} {
    font-family: var(--font-display-ultralight-italic);
    font-style: italic;
    font-weight: 300;
  }

  /* ─── Line 3: "comes in." ─── */
  /*
    In the 1440px reference:
      - Starts around x=880px → 880/1440 = 61%
      - y ≈ 620px → 620/750 = 82.7%
    Font: ~48px at 1440px → 48/1440 = 3.33vw
  */
  .lux-line3-{{ ai_gen_id }} {
    position: absolute;
    top: 85%;
    left: 61%;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(18px, 7.3vw, 73px);
    color: {{ part_text_color }};
    letter-spacing: 0.04em;
    line-height: 1;
    text-shadow: 0 2px 20px rgba(0,0,0,0.5);
    white-space: nowrap;
    pointer-events: none;
  }

  /* ─── Mobile: below 480px keep things readable ─── */
  @media (max-width: 480px) {
    .lux-spot-{{ ai_gen_id }}::before,
    .lux-spot-{{ ai_gen_id }}::after {
      filter: blur(60px);
    }
    @media (max-width: 768px) {
    .lux-line1-{{ ai_gen_id }} {
    font-size: clamp(13px, 0.6vw, 68px);
}
.lux-line2-{{ ai_gen_id }} {
    position: absolute;
    top: 2%;
    left: 4%;
}
.lux-line2-{{ ai_gen_id }} {
    font-size: clamp(25px, 7.6vw, 145px);
}
.lux-line3-{{ ai_gen_id }} {
    font-size: clamp(18px, 4.3vw, 73px);
}
  }

  /* Was per-article custom CSS in every template using this part. */
  @media screen and (max-width: 768px) {
    .lux-line2-{{ ai_gen_id }} { position: absolute; top: 2%; left: 15%; }
  }
{% endstyle %}

<div class="lux-wrap-{{ ai_gen_id }}">
  <div class="lux-banner-{{ ai_gen_id }}">

    {% comment %} Background image {% endcomment %}
    {% if part_background_image %}
      <img
        class="lux-bg-{{ ai_gen_id }}"
        src="{{ part_background_image | image_url: width: 2400 }}"
        alt="{{ part_background_image.alt | escape }}"
        loading="lazy"
        width="{{ part_background_image.width }}"
        height="{{ part_background_image.height }}"
      >
    {% else %}
      <div class="lux-bg-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
        <span style="position:absolute;bottom:20px;font-size:13px;opacity:0.6;">Upload a background image in theme editor</span>
      </div>
    {% endif %}

    {% comment %} Spotlight overlay {% endcomment %}
    <div class="lux-spot-{{ ai_gen_id }}"></div>

    {% comment %} Text layer {% endcomment %}
    <div class="lux-text-layer-{{ ai_gen_id }}">

      <div class="lux-line1-{{ ai_gen_id }}">
        {{ part_text_line_1 }}
      </div>

      <div class="lux-line2-{{ ai_gen_id }}">
        <span class="lux-line2-regular-{{ ai_gen_id }}">{{ part_brand_name_regular }}</span><span class="lux-line2-italic-{{ ai_gen_id }}">{{ part_brand_name_italic }}</span>
      </div>

      <div class="lux-line3-{{ ai_gen_id }}">
        {{ part_text_line_2 }}
      </div>

    </div>
  </div>
</div>


