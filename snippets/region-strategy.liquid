{%- comment -%}
  ============================================================================
  SCENTSPIRED — Regional Strategy Resolver & Dispatcher
  ============================================================================
  Single entry point for regional strategy execution.
  - In SSOT Theme Engine (multi-region): Detects environment and dispatches
    to the active regional strategy module.
  - In Downstream Stores (e.g. Scentspired-UAE): Localized directly via
    regions/<id>/snippets/region-strategy.liquid.
  ============================================================================
{%- endcomment -%}
{%- capture current_region -%}{%- render 'region-detect' -%}{%- endcapture -%}
{%- assign current_region = current_region | strip -%}
{%- case current_region -%}
  {%- when 'uk' -%}
    {%- render 'region-strategy-uk', key: key -%}
  {%- when 'uae' -%}
    {%- render 'region-strategy-uae', key: key -%}
  {%- else -%}
    {%- render 'region-strategy-usa', key: key -%}
{%- endcase -%}
