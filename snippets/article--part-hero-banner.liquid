{%- comment -%}
  GENERATED by scripts/build-article-parts.cjs from blocks/editorial--luxury-perfume-banner-4.liquid — the
  "hero_banner" part of an article. Edit the design here (or regenerate); an
  article's words, images and links are in regions/<id>/content/articles.json.

  Fields: heading, subheading, image_desktop, image_mobile, image_tone ("light" | "dark")
  Params: content_key ('articles.<entry>.parts.<n>.'), part_id (unique on the page)
{%- endcomment -%}
{%- liquid
  assign k = content_key | append: 'heading'
  capture part_heading
    render 'region--content', key: k
  endcapture
  assign part_heading = part_heading | strip
  assign k = content_key | append: 'subheading'
  capture part_paragraph
    render 'region--content', key: k
  endcapture
  assign part_paragraph = part_paragraph | strip
  assign k = content_key | append: 'image_desktop'
  capture part_desktop_image
    render 'region--content', key: k
  endcapture
  assign part_desktop_image = part_desktop_image | strip
  # an image is named as in Shopify ("shopify://shop_images/<file>") and read from the store's files
  assign image_file = part_desktop_image | remove_first: 'shopify://shop_images/'
  assign part_desktop_image = nil
  if image_file != blank
    # a file the store does not have comes back as an empty image: treat it
    # as no image, as Shopify does for a missing image setting
    assign image_found = images[image_file]
    if image_found.width > 0
      assign part_desktop_image = image_found
    endif
  endif
  assign k = content_key | append: 'image_mobile'
  capture part_mobile_image
    render 'region--content', key: k
  endcapture
  assign part_mobile_image = part_mobile_image | strip
  # an image is named as in Shopify ("shopify://shop_images/<file>") and read from the store's files
  assign image_file = part_mobile_image | remove_first: 'shopify://shop_images/'
  assign part_mobile_image = nil
  if image_file != blank
    # a file the store does not have comes back as an empty image: treat it
    # as no image, as Shopify does for a missing image setting
    assign image_found = images[image_file]
    if image_found.width > 0
      assign part_mobile_image = image_found
    endif
  endif
  # text over a photo: dark photo, light text; light photo, dark text
  assign k = content_key | append: 'image_tone'
  capture part_image_tone
    render 'region--content', key: k
  endcapture
  assign part_image_tone = part_image_tone | strip | default: 'light'
  assign part_text_color = '#000000'
  if part_image_tone == 'dark'
    assign part_text_color = '#ffffff'
  endif
-%}
{% assign ai_gen_id = part_id %}

{% style %}
  .ai-luxury-banner-outer-{{ ai_gen_id }} {
    background-color: #ffffff;
    padding: 20px;
    width: 100%;
    display: block;
  }

  .ai-luxury-banner-container-{{ ai_gen_id }} {
    background-color: #f5f3f0;
    margin: 0 auto;
    width: 100%;
    position: relative;
    overflow: hidden;
  }

  .ai-luxury-banner-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-luxury-banner-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .ai-luxury-banner-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 16/9;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-luxury-banner-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 400px;
    max-height: 400px;
  }

  .ai-luxury-banner-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-luxury-banner-content-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding: 40px;
  }

  .ai-luxury-banner-content-{{ ai_gen_id }} {
    max-width: 640px;
    text-align: left;
    text-transform: capitalize;
  }

  .ai-luxury-banner-heading-{{ ai_gen_id }} {
    font-family: var(--font-display);
    font-size: 48px;
    line-height: 1.1;
    color: {{ part_text_color }};
    margin: 0;
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  .ai-luxury-banner-heading-{{ ai_gen_id }} .italic-text {
    font-family: var(--font-display-ultralight-italic);
    font-style: italic;
  }

  .ai-luxury-banner-paragraph-{{ ai_gen_id }} {
    font-size: 44px;
    line-height: 1;
    color: {{ part_text_color }};
    margin: 0;
    font-weight: 400;
    font-family: var(--font-display);
  }

  .ai-luxury-banner-paragraph-{{ ai_gen_id }} p {
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-luxury-banner-outer-{{ ai_gen_id }} {
      padding: 15px;
    }

    .ai-luxury-banner-content-overlay-{{ ai_gen_id }} {
      padding: 30px;
      align-items: center;
      justify-content: flex-start;
    }

    .ai-luxury-banner-content-{{ ai_gen_id }} {
      max-width: 57%;
      text-align: left;
    }

    .ai-luxury-banner-heading-{{ ai_gen_id }} {
      font-size: 16px;
    }

    .ai-luxury-banner-paragraph-{{ ai_gen_id }} {
      font-size: 16px;
    }
  }

  /* Was per-article custom CSS in every template using this part. */
  .ai-luxury-banner-heading-{{ ai_gen_id }} { margin-bottom: -53px; }
  @media screen and (max-width: 749px) {
    .ai-luxury-banner-heading-{{ ai_gen_id }} { margin-bottom: -19px; }
  }
{% endstyle %}

<luxury-banner-{{ ai_gen_id }} class="ai-luxury-banner-outer-{{ ai_gen_id }}">
  <div class="ai-luxury-banner-container-{{ ai_gen_id }}">
    <div class="ai-luxury-banner-image-wrapper-{{ ai_gen_id }}">
      {% if part_desktop_image != blank %}
        <picture>
          {% if part_mobile_image != blank %}
            <source
              media="(max-width: 749px)"
              srcset="{{ part_mobile_image | image_url: width: 800 }}"
            >
          {% endif %}
          <img
            src="{{ part_desktop_image | image_url: width: 1600 }}"
            alt="{{ part_desktop_image.alt | escape }}"
            loading="lazy"
            width="{{ part_desktop_image.width }}"
            height="{{ part_desktop_image.height }}"
            class="ai-luxury-banner-image-{{ ai_gen_id }}"
          >
        </picture>
      {% else %}
        <div class="ai-luxury-banner-image-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-luxury-banner-empty-state-{{ ai_gen_id }}">
            Next, add an image
          </div>
        </div>
      {% endif %}
    </div>

    <div class="ai-luxury-banner-content-overlay-{{ ai_gen_id }}">
      <div class="ai-luxury-banner-content-{{ ai_gen_id }}">
        {% if part_heading != blank %}
          <h2 class="ai-luxury-banner-heading-{{ ai_gen_id }}">
            {{ part_heading }}
          </h2>
        {% endif %}
        {% if part_paragraph != blank %}
          <div class="ai-luxury-banner-paragraph-{{ ai_gen_id }}">
            {{ part_paragraph }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</luxury-banner-{{ ai_gen_id }}>

<script>
  (function() {
    class LuxuryBanner{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.processHeading();
      }

      processHeading() {
        const heading = this.querySelector('.ai-luxury-banner-heading-{{ ai_gen_id }}');
        if (!heading) return;

        const text = heading.textContent.trim();
        const scentspiredMatch = text.match(/Scentspired/i);
        
        if (scentspiredMatch) {
          const newHTML = text.replace(/Scentspired/i, 'Scent<span class="italic-text">spired</span>');
          heading.innerHTML = newHTML;
        }
      }
    }

    customElements.define('luxury-banner-{{ ai_gen_id }}', LuxuryBanner{{ ai_gen_id }});
  })();
</script>

