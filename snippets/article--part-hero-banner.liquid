{%- comment -%}
  The "hero_banner" part of an article: its design, the same for every article.
  Edit it here. (Built from blocks/editorial--luxury-perfume-banner-4.liquid, removed once every article used
  this part.) An article's words, images and links are in
  regions/<id>/content/articles.json.

  Fields: heading, subheading, image_desktop, image_mobile, image_tone ("light" | "dark")
  Params: content_key ('articles.<entry>.parts.<n>.'), part_id (unique on the page)
{%- endcomment -%}
{%- liquid
  assign k = content_key | append: 'heading'
  capture part_heading
    render 'region--content', key: k
  endcapture
  assign part_heading = part_heading | strip
  assign k = content_key | append: 'subheading'
  capture part_paragraph
    render 'region--content', key: k
  endcapture
  assign part_paragraph = part_paragraph | strip
  assign k = content_key | append: 'image_desktop'
  capture part_desktop_image
    render 'region--content', key: k
  endcapture
  assign part_desktop_image = part_desktop_image | strip
  # an image is named as in Shopify ("shopify://shop_images/<file>") and read from the store's files
  assign image_file = part_desktop_image | remove_first: 'shopify://shop_images/'
  assign part_desktop_image = nil
  if image_file != blank
    # a file the store does not have comes back as an empty image: treat it
    # as no image, as Shopify does for a missing image setting
    assign image_found = images[image_file]
    if image_found.width > 0
      assign part_desktop_image = image_found
    endif
  endif
  assign k = content_key | append: 'image_mobile'
  capture part_mobile_image
    render 'region--content', key: k
  endcapture
  assign part_mobile_image = part_mobile_image | strip
  # an image is named as in Shopify ("shopify://shop_images/<file>") and read from the store's files
  assign image_file = part_mobile_image | remove_first: 'shopify://shop_images/'
  assign part_mobile_image = nil
  if image_file != blank
    # a file the store does not have comes back as an empty image: treat it
    # as no image, as Shopify does for a missing image setting
    assign image_found = images[image_file]
    if image_found.width > 0
      assign part_mobile_image = image_found
    endif
  endif
  # text over a photo: dark photo, light text; light photo, dark text
  assign k = content_key | append: 'image_tone'
  capture part_image_tone
    render 'region--content', key: k
  endcapture
  assign part_image_tone = part_image_tone | strip | default: 'light'
  assign part_text_color = '#000000'
  if part_image_tone == 'dark'
    assign part_text_color = '#ffffff'
  endif
-%}

{{ 'article--part-hero-banner.css' | asset_url | stylesheet_tag }}

<luxury-banner-hero-banner class="ai-luxury-banner-outer-hero-banner" style="--part-text-color: {{ part_text_color }};">
  <div class="ai-luxury-banner-container-hero-banner">
    <div class="ai-luxury-banner-image-wrapper-hero-banner">
      {% if part_desktop_image != blank %}
        <picture>
          {% if part_mobile_image != blank %}
            <source
              media="(max-width: 749px)"
              srcset="{{ part_mobile_image | image_url: width: 800 }}"
            >
          {% endif %}
          <img
            src="{{ part_desktop_image | image_url: width: 1600 }}"
            alt="{{ part_desktop_image.alt | escape }}"
            loading="lazy"
            width="{{ part_desktop_image.width }}"
            height="{{ part_desktop_image.height }}"
            class="ai-luxury-banner-image-hero-banner"
          >
        </picture>
      {% else %}
        <div class="ai-luxury-banner-image-placeholder-hero-banner">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-luxury-banner-empty-state-hero-banner">
            {{ 'sections.article_parts.add_image_next' | t }}
          </div>
        </div>
      {% endif %}
    </div>

    <div class="ai-luxury-banner-content-overlay-hero-banner">
      <div class="ai-luxury-banner-content-hero-banner">
        {% if part_heading != blank %}
          <h2 class="ai-luxury-banner-heading-hero-banner" data-brand-italic>
            {{ part_heading }}
          </h2>
        {% endif %}
        {% if part_paragraph != blank %}
          <div class="ai-luxury-banner-paragraph-hero-banner">
            {{ part_paragraph }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</luxury-banner-hero-banner>

{% # theme-check-disable ParserBlockingScript %}
<script src="{{ 'article--part-hero-banner.js' | asset_url }}"></script>
{% # theme-check-enable ParserBlockingScript %}

