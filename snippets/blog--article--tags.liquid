{% comment %}
  Renders topic tags for an article.
  Blast Radius: Strictly this file for tag list display and taxonomy navigation links.

  Accepts:
  - article: {Object} Article object (required)
  - blog: {Object} Blog object (optional)
  - label: {String} Label text (the region's: content/article.json, article.tags)

  Usage:
  {% render 'blog--article--tags', article: article, blog: blog, label: "Filed under" %}
{% endcomment %}

{%- if article.tags.size > 0 -%}
  {%- assign tag_label = label -%}
  <div class="page-width page-width--narrow blog-tags">
    <span class="blog-tags__label">{{ tag_label | escape }}:</span>
    <div class="blog-tags__list">
      {%- for tag in article.tags -%}
        <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="blog-tags__tag">
          {{ tag | escape }}
        </a>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}
