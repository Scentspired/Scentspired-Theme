{% comment %}
  Renders topic tags for an article.
  Blast Radius: Strictly this file for tag list display and taxonomy navigation links.

  Accepts:
  - article: {Object} Article object (required)
  - blog: {Object} Blog object (optional)
  - label: {String} Label text (default: "Tags")

  Usage:
  {% render 'article-tags', article: article, blog: blog, label: "Filed under" %}
{% endcomment %}

{%- if article.tags.size > 0 -%}
  {%- assign tag_label = label | default: "Tags" -%}
  <div class="page-width page-width--narrow blog-tags{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    <span class="blog-tags__label">{{ tag_label | escape }}:</span>
    <div class="blog-tags__list">
      {%- for tag in article.tags -%}
        <a href="{{ blog.url | default: '/blogs/news' }}/tagged/{{ tag | handle }}" class="blog-tags__tag">
          {{ tag | escape }}
        </a>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}
