{%- comment -%}
  The "fragrance_guide" part of an article: its design, the same for every article.
  Edit it here. (Built from blocks/catalog--fragrance-guide.liquid, removed once every article used
  this part.) An article's words, images and links are in
  regions/<id>/content/articles.json.

  Fields: title, subtitle, illustration, points.N.title, points.N.description, points.N.sketch, tip_heading, tip_text
  Params: content_key ('articles.<entry>.parts.<n>.'), part_id (unique on the page)
{%- endcomment -%}
{%- liquid
  assign k = content_key | append: 'title'
  capture part_title
    render 'region--content', key: k
  endcapture
  assign part_title = part_title | strip
  assign k = content_key | append: 'subtitle'
  capture part_subtitle
    render 'region--content', key: k
  endcapture
  assign part_subtitle = part_subtitle | strip
  assign k = content_key | append: 'illustration'
  capture part_body_illustration
    render 'region--content', key: k
  endcapture
  assign part_body_illustration = part_body_illustration | strip
  # an image is named as in Shopify ("shopify://shop_images/<file>") and read from the store's files
  assign image_file = part_body_illustration | remove_first: 'shopify://shop_images/'
  assign part_body_illustration = nil
  if image_file != blank
    # a file the store does not have comes back as an empty image: treat it
    # as no image, as Shopify does for a missing image setting
    assign image_found = images[image_file]
    if image_found.width > 0
      assign part_body_illustration = image_found
    endif
  endif
  assign k = content_key | append: 'points.0.title'
  capture part_point_1_title
    render 'region--content', key: k
  endcapture
  assign part_point_1_title = part_point_1_title | strip
  assign k = content_key | append: 'points.0.description'
  capture part_point_1_description
    render 'region--content', key: k
  endcapture
  assign part_point_1_description = part_point_1_description | strip
  assign k = content_key | append: 'points.0.sketch'
  capture part_sketch_1
    render 'region--content', key: k
  endcapture
  assign part_sketch_1 = part_sketch_1 | strip
  # an image is named as in Shopify ("shopify://shop_images/<file>") and read from the store's files
  assign image_file = part_sketch_1 | remove_first: 'shopify://shop_images/'
  assign part_sketch_1 = nil
  if image_file != blank
    # a file the store does not have comes back as an empty image: treat it
    # as no image, as Shopify does for a missing image setting
    assign image_found = images[image_file]
    if image_found.width > 0
      assign part_sketch_1 = image_found
    endif
  endif
  assign k = content_key | append: 'points.1.title'
  capture part_point_2_title
    render 'region--content', key: k
  endcapture
  assign part_point_2_title = part_point_2_title | strip
  assign k = content_key | append: 'points.1.description'
  capture part_point_2_description
    render 'region--content', key: k
  endcapture
  assign part_point_2_description = part_point_2_description | strip
  assign k = content_key | append: 'points.1.sketch'
  capture part_sketch_2
    render 'region--content', key: k
  endcapture
  assign part_sketch_2 = part_sketch_2 | strip
  # an image is named as in Shopify ("shopify://shop_images/<file>") and read from the store's files
  assign image_file = part_sketch_2 | remove_first: 'shopify://shop_images/'
  assign part_sketch_2 = nil
  if image_file != blank
    # a file the store does not have comes back as an empty image: treat it
    # as no image, as Shopify does for a missing image setting
    assign image_found = images[image_file]
    if image_found.width > 0
      assign part_sketch_2 = image_found
    endif
  endif
  assign k = content_key | append: 'points.2.title'
  capture part_point_3_title
    render 'region--content', key: k
  endcapture
  assign part_point_3_title = part_point_3_title | strip
  assign k = content_key | append: 'points.2.description'
  capture part_point_3_description
    render 'region--content', key: k
  endcapture
  assign part_point_3_description = part_point_3_description | strip
  assign k = content_key | append: 'points.2.sketch'
  capture part_sketch_3
    render 'region--content', key: k
  endcapture
  assign part_sketch_3 = part_sketch_3 | strip
  # an image is named as in Shopify ("shopify://shop_images/<file>") and read from the store's files
  assign image_file = part_sketch_3 | remove_first: 'shopify://shop_images/'
  assign part_sketch_3 = nil
  if image_file != blank
    # a file the store does not have comes back as an empty image: treat it
    # as no image, as Shopify does for a missing image setting
    assign image_found = images[image_file]
    if image_found.width > 0
      assign part_sketch_3 = image_found
    endif
  endif
  assign k = content_key | append: 'points.3.title'
  capture part_point_4_title
    render 'region--content', key: k
  endcapture
  assign part_point_4_title = part_point_4_title | strip
  assign k = content_key | append: 'points.3.description'
  capture part_point_4_description
    render 'region--content', key: k
  endcapture
  assign part_point_4_description = part_point_4_description | strip
  assign k = content_key | append: 'points.3.sketch'
  capture part_sketch_4
    render 'region--content', key: k
  endcapture
  assign part_sketch_4 = part_sketch_4 | strip
  # an image is named as in Shopify ("shopify://shop_images/<file>") and read from the store's files
  assign image_file = part_sketch_4 | remove_first: 'shopify://shop_images/'
  assign part_sketch_4 = nil
  if image_file != blank
    # a file the store does not have comes back as an empty image: treat it
    # as no image, as Shopify does for a missing image setting
    assign image_found = images[image_file]
    if image_found.width > 0
      assign part_sketch_4 = image_found
    endif
  endif
  assign k = content_key | append: 'tip_heading'
  capture part_protip_heading
    render 'region--content', key: k
  endcapture
  assign part_protip_heading = part_protip_heading | strip
  assign k = content_key | append: 'tip_text'
  capture part_protip_text
    render 'region--content', key: k
  endcapture
  assign part_protip_text = part_protip_text | strip
-%}
{% assign ai_gen_id = part_id %}

{% style %}
  .ai-fragrance-guide-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: #ffffff;
    padding: 0;
    margin: 0;
  }

  .ai-fragrance-guide-header-{{ ai_gen_id }} {
    background-color: #f9f6f1;
    padding: 40px 20px;
    text-align: center;
  }

  .ai-fragrance-guide-title-{{ ai_gen_id }} {
    font-size: 32px;
    font-weight: 700;
    color: #000000;
    margin: 0 0 12px 0;
    letter-spacing: 0.5px;
    text-transform: capitalize;
    font-family: var(--font-display-italic);
    font-style: italic;
  }

  .ai-fragrance-guide-subtitle-{{ ai_gen_id }} {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 400;
    color: #000000;
    margin: 0;
  }

  .ai-fragrance-guide-content-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 60px 20px;
    display: flex;
    gap: 60px;
    align-items: flex-start;
  }

  .ai-fragrance-guide-left-{{ ai_gen_id }} {
    flex: 1;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .ai-fragrance-guide-divider-{{ ai_gen_id }} {
    width: 1px;
    background-color: #000000;
    align-self: stretch;
  }

  .ai-fragrance-guide-right-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .ai-fragrance-guide-illustration-{{ ai_gen_id }} {
    position: relative;
    max-width: 400px;
    width: 100%;
  }

  .ai-fragrance-guide-illustration-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-fragrance-guide-badge-{{ ai_gen_id }} {
    position: absolute;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background-color: #f9f6f1;
    color: #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 700;
    box-shadow: 0 0 0 8px #f9f6f1;
    transform: translate(-50%, -50%);
  }

  .ai-fragrance-guide-badge-1-{{ ai_gen_id }} {
    top: 17%;
    left: 50%;
  }

  .ai-fragrance-guide-badge-2-{{ ai_gen_id }} {
    top: 35%;
    left: 29%;
  }

  .ai-fragrance-guide-badge-3-{{ ai_gen_id }} {
    top: 50%;
    left: 25%;
  }

  .ai-fragrance-guide-badge-4-{{ ai_gen_id }} {
    top: 71%;
    left: 39%;
  }

  .ai-fragrance-guide-point-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .ai-fragrance-guide-point-number-{{ ai_gen_id }} {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: #f9f6f1;
    color: #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 700;
    flex-shrink: 0;
  }

  .ai-fragrance-guide-point-sketch-{{ ai_gen_id }} {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background-color: #ffffff;
    border: 2px solid #000000;
    flex-shrink: 0;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-fragrance-guide-point-sketch-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-fragrance-guide-point-text-{{ ai_gen_id }} {
    flex: 1;
  }

  .ai-fragrance-guide-point-title-{{ ai_gen_id }} {
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 700;
    color: #000000;
    margin: 0 0 8px 0;
  }

  .ai-fragrance-guide-point-description-{{ ai_gen_id }} {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 400;
    color: #000000;
    margin: 0;
    line-height: 1.6;
  }

  .ai-fragrance-guide-protip-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 20px;
    border: 2px solid #000000;
    border-radius: 12px;
    background-color: #ffffff;
    margin-top: 20px;
  }

  .ai-fragrance-guide-protip-icon-{{ ai_gen_id }} {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    color: #000000;
  }

  .ai-fragrance-guide-protip-content-{{ ai_gen_id }} {
    flex: 1;
  }

  .ai-fragrance-guide-protip-heading-{{ ai_gen_id }} {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 700;
    color: #000000;
    margin: 0 0 8px 0;
  }

  .ai-fragrance-guide-protip-text-{{ ai_gen_id }} {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 400;
    color: #000000;
    margin: 0;
    line-height: 1.6;
  }

  @media screen and (max-width: 749px) {
    .ai-fragrance-guide-content-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 40px;
      padding: 40px 20px;
    }

    .ai-fragrance-guide-divider-{{ ai_gen_id }} {
      display: none;
    }

    .ai-fragrance-guide-title-{{ ai_gen_id }} {
      font-size: 24px;
    }

    .ai-fragrance-guide-subtitle-{{ ai_gen_id }} {
      font-size: 14px;
    }

    .ai-fragrance-guide-badge-{{ ai_gen_id }} {
      width: {{ 30 | times: 0.8 }}px;
      height: {{ 30 | times: 0.8 }}px;
      font-size: 14px;
      box-shadow: 0 0 0 6px #f9f6f1;
    }

    .ai-fragrance-guide-point-number-{{ ai_gen_id }} {
      width: 40px;
      height: 40px;
      font-size: 16px;
    }

    .ai-fragrance-guide-point-sketch-{{ ai_gen_id }} {
      width: 60px;
      height: 60px;
    }

    .ai-fragrance-guide-point-title-{{ ai_gen_id }} {
      font-size: 16px;
    }

    .ai-fragrance-guide-point-description-{{ ai_gen_id }} {
      font-size: 13px;
    }
  }
{% endstyle %}

<fragrance-guide-{{ ai_gen_id }} class="ai-fragrance-guide-{{ ai_gen_id }}">
  <div class="ai-fragrance-guide-header-{{ ai_gen_id }}">
    <h2 class="ai-fragrance-guide-title-{{ ai_gen_id }}">{{ part_title }}</h2>
    <p class="ai-fragrance-guide-subtitle-{{ ai_gen_id }}">{{ part_subtitle }}</p>
  </div>

  <div class="ai-fragrance-guide-content-{{ ai_gen_id }}">
    <div class="ai-fragrance-guide-left-{{ ai_gen_id }}">
      <div class="ai-fragrance-guide-illustration-{{ ai_gen_id }}">
        {% if part_body_illustration %}
          <img
            src="{{ part_body_illustration | image_url: width: 800 }}"
            alt="{{ 'sections.article_parts.pulse_points_alt' | t }}"
            loading="lazy"
            width="{{ part_body_illustration.width }}"
            height="{{ part_body_illustration.height }}">
        {% else %}
          <div style="aspect-ratio: 1/2; background: #f0f0f0; display: flex; align-items: center; justify-content: center;">
            {{ "image" | placeholder_svg_tag }}
          </div>
        {% endif %}

        <div class="ai-fragrance-guide-badge-{{ ai_gen_id }} ai-fragrance-guide-badge-1-{{ ai_gen_id }}">1</div>
        <div class="ai-fragrance-guide-badge-{{ ai_gen_id }} ai-fragrance-guide-badge-2-{{ ai_gen_id }}">2</div>
        <div class="ai-fragrance-guide-badge-{{ ai_gen_id }} ai-fragrance-guide-badge-3-{{ ai_gen_id }}">3</div>
        <div class="ai-fragrance-guide-badge-{{ ai_gen_id }} ai-fragrance-guide-badge-4-{{ ai_gen_id }}">4</div>
      </div>
    </div>

    <div class="ai-fragrance-guide-divider-{{ ai_gen_id }}"></div>

    <div class="ai-fragrance-guide-right-{{ ai_gen_id }}">
      <div class="ai-fragrance-guide-point-{{ ai_gen_id }}">
        <div class="ai-fragrance-guide-point-number-{{ ai_gen_id }}">1</div>
        <div class="ai-fragrance-guide-point-sketch-{{ ai_gen_id }}">
          {% if part_sketch_1 %}
            <img
              src="{{ part_sketch_1 | image_url: width: 160 }}"
              alt="{{ 'sections.article_parts.neck_alt' | t }}"
              loading="lazy">
          {% else %}
            {{ "image" | placeholder_svg_tag }}
          {% endif %}
        </div>
        <div class="ai-fragrance-guide-point-text-{{ ai_gen_id }}">
          <h3 class="ai-fragrance-guide-point-title-{{ ai_gen_id }}">{{ part_point_1_title }}</h3>
          <p class="ai-fragrance-guide-point-description-{{ ai_gen_id }}">{{ part_point_1_description }}</p>
        </div>
      </div>

      <div class="ai-fragrance-guide-point-{{ ai_gen_id }}">
        <div class="ai-fragrance-guide-point-number-{{ ai_gen_id }}">2</div>
        <div class="ai-fragrance-guide-point-sketch-{{ ai_gen_id }}">
          {% if part_sketch_2 %}
            <img
              src="{{ part_sketch_2 | image_url: width: 160 }}"
              alt="{{ 'sections.article_parts.inner_elbow_alt' | t }}"
              loading="lazy">
          {% else %}
            {{ "image" | placeholder_svg_tag }}
          {% endif %}
        </div>
        <div class="ai-fragrance-guide-point-text-{{ ai_gen_id }}">
          <h3 class="ai-fragrance-guide-point-title-{{ ai_gen_id }}">{{ part_point_2_title }}</h3>
          <p class="ai-fragrance-guide-point-description-{{ ai_gen_id }}">{{ part_point_2_description }}</p>
        </div>
      </div>

      <div class="ai-fragrance-guide-point-{{ ai_gen_id }}">
        <div class="ai-fragrance-guide-point-number-{{ ai_gen_id }}">3</div>
        <div class="ai-fragrance-guide-point-sketch-{{ ai_gen_id }}">
          {% if part_sketch_3 %}
            <img
              src="{{ part_sketch_3 | image_url: width: 160 }}"
              alt="{{ 'sections.article_parts.wrist_alt' | t }}"
              loading="lazy">
          {% else %}
            {{ "image" | placeholder_svg_tag }}
          {% endif %}
        </div>
        <div class="ai-fragrance-guide-point-text-{{ ai_gen_id }}">
          <h3 class="ai-fragrance-guide-point-title-{{ ai_gen_id }}">{{ part_point_3_title }}</h3>
          <p class="ai-fragrance-guide-point-description-{{ ai_gen_id }}">{{ part_point_3_description }}</p>
        </div>
      </div>

      <div class="ai-fragrance-guide-point-{{ ai_gen_id }}">
        <div class="ai-fragrance-guide-point-number-{{ ai_gen_id }}">4</div>
        <div class="ai-fragrance-guide-point-sketch-{{ ai_gen_id }}">
          {% if part_sketch_4 %}
            <img
              src="{{ part_sketch_4 | image_url: width: 160 }}"
              alt="{{ 'sections.article_parts.knee_alt' | t }}"
              loading="lazy">
          {% else %}
            {{ "image" | placeholder_svg_tag }}
          {% endif %}
        </div>
        <div class="ai-fragrance-guide-point-text-{{ ai_gen_id }}">
          <h3 class="ai-fragrance-guide-point-title-{{ ai_gen_id }}">{{ part_point_4_title }}</h3>
          <p class="ai-fragrance-guide-point-description-{{ ai_gen_id }}">{{ part_point_4_description }}</p>
        </div>
      </div>

      {% if true %}
        <div class="ai-fragrance-guide-protip-{{ ai_gen_id }}">
          <div class="ai-fragrance-guide-protip-icon-{{ ai_gen_id }}">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              width="40"
              height="40"
              fill="none"
              stroke="#000"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round">
              <path d="M12 22a7 7 0 0 0 7-7c0-4.3-7-13-7-13S5 10.7 5 15a7 7 0 0 0 7 7z"/>
            </svg>
          </div>
          <div class="ai-fragrance-guide-protip-content-{{ ai_gen_id }}">
            <h4 class="ai-fragrance-guide-protip-heading-{{ ai_gen_id }}">{{ part_protip_heading }}</h4>
            <p class="ai-fragrance-guide-protip-text-{{ ai_gen_id }}">{{ part_protip_text }}</p>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</fragrance-guide-{{ ai_gen_id }}>

<script>
  (function() {
    class FragranceGuide{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('fragrance-guide-{{ ai_gen_id }}', FragranceGuide{{ ai_gen_id }});
  })();
</script>

