{%- comment -%}
  GENERATED by scripts/build-article-parts.cjs from blocks/editorial--comparison-table-5.liquid — the
  "comparison_table" part of an article. Edit the design here (or regenerate); an
  article's words, images and links are in regions/<id>/content/articles.json.

  Fields: label_heading (over the row labels, optional), column_headings: [...], rows: [{ label, cells: [...] }]
  Params: content_key ('articles.<entry>.parts.<n>.'), part_id (unique on the page)
{%- endcomment -%}
{%- liquid

-%}
{% assign ai_gen_id = part_id %}

{% style %}
  .ai-comparison-table-wrapper-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px 20px;
  }

  .ai-comparison-table-container-{{ ai_gen_id }} {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  @media screen and (max-width: 749px) {
    .ai-comparison-table-container-{{ ai_gen_id }} {
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .ai-comparison-table-container-{{ ai_gen_id }}::-webkit-scrollbar {
      display: none;
    }
  }

  .ai-comparison-table-{{ ai_gen_id }} {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-body);
    background-color: #ffffff;
  }

  .ai-comparison-table-{{ ai_gen_id }} thead {
    background-color: #000000;
  }

  .ai-comparison-table-{{ ai_gen_id }} thead th {
    color: #ffffff;
    font-weight: bold;
    padding: 16px;
    text-align: left;
    border: 1px solid #e0e0e0;
  }

  .ai-comparison-table-{{ ai_gen_id }} thead th:first-child {
    background-color: #000000;
  }

  .ai-comparison-table-{{ ai_gen_id }} tbody tr {
    background-color: #f9f9f9;
  }

  .ai-comparison-table-{{ ai_gen_id }} tbody td {
    padding: 16px;
    border: 1px solid #e0e0e0;
    text-align: left;
    font-weight: normal;
    white-space: normal;
    color: #121212;
  }

  .ai-comparison-table-{{ ai_gen_id }} tbody td:first-child {
    font-weight: normal;
  }

  @media screen and (max-width: 749px) {
    .ai-comparison-table-{{ ai_gen_id }} thead th,
    .ai-comparison-table-{{ ai_gen_id }} tbody td {
      min-width: 180px;
    }
  }

  @media screen and (min-width: 750px) {
    .ai-comparison-table-{{ ai_gen_id }} thead th,
    .ai-comparison-table-{{ ai_gen_id }} tbody td {
      min-width: auto;
    }
  }
{% endstyle %}

<fragrance-comparison-table-{{ ai_gen_id }}
  class="ai-comparison-table-wrapper-{{ ai_gen_id }}"
>
  <div class="ai-comparison-table-container-{{ ai_gen_id }}">
    <table class="ai-comparison-table-{{ ai_gen_id }}">
      {%- liquid
        assign k = content_key | append: 'label_heading'
        capture table_label_heading
          render 'region--content', key: k
        endcapture
        assign k = content_key | append: 'column_headings.__keys'
        capture table_columns
          render 'region--content', key: k
        endcapture
        assign table_columns = table_columns | strip | split: ','
        assign k = content_key | append: 'rows.__keys'
        capture table_rows
          render 'region--content', key: k
        endcapture
        assign table_rows = table_rows | strip | split: ','
      -%}
      <thead>
        <tr>
          <th>{{ table_label_heading | strip }}</th>
          {%- for column in table_columns %}
            {%- assign k = content_key | append: 'column_headings.' | append: column %}
          <th>{% render 'region--content', key: k %}</th>
          {%- endfor %}
        </tr>
      </thead>
      <tbody>
        {%- for row in table_rows %}
          {%- assign row_key = content_key | append: 'rows.' | append: row | append: '.' %}
        <tr>
          {%- assign k = row_key | append: 'label' %}
          <td>{% render 'region--content', key: k %}</td>
          {%- for column in table_columns %}
            {%- assign k = row_key | append: 'cells.' | append: column %}
          <td>{% render 'region--content', key: k %}</td>
          {%- endfor %}
        </tr>
        {%- endfor %}
      </tbody>
    </table>
  </div>
</fragrance-comparison-table-{{ ai_gen_id }}>

<script>
  (function() {
    class FragranceComparisonTable{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('fragrance-comparison-table-{{ ai_gen_id }}', FragranceComparisonTable{{ ai_gen_id }});
  })();
</script>

