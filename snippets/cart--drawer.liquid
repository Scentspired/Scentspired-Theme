{%- liquid
  # The brand logo is regional data: each storefront may ship its own file.
  capture region_logo_url
    render 'region--active', key: 'logo_url'
  endcapture
  assign region_logo_url = region_logo_url | strip

  # The recommendation prices below were written with a literal pound sign, so
  # the USA storefront printed pound signs on dollar products.
  capture region_currency_symbol
    render 'region--active', key: 'currency_symbol'
  endcapture
  assign region_currency_symbol = region_currency_symbol | strip

  # Shipping thresholds were hardcoded to the UK's, in the copy and in the JS
  # below, so every other storefront quoted British prices and limits.
  capture region_free_shipping
    render 'region--active', key: 'free_shipping_threshold_display'
  endcapture
  assign region_free_shipping = region_free_shipping | strip
  capture region_shipping_cost
    render 'region--active', key: 'shipping_cost_display'
  endcapture
  assign region_shipping_cost = region_shipping_cost | strip
-%}
{{ 'cart--drawer.css' | asset_url | stylesheet_tag }}

{% comment %}
  Renders cart drawer with empty state collections and all other sections.
  Usage: {% render 'cart--drawer' %}
{% endcomment %}

<!-- Cart Drawer Overlay -->
<div id="sp-cart-overlay" class="sp-cart-overlay" onclick="closeDossierCart()"></div>

<!-- Cart Drawer -->
<div id="sp-cart-drawer" class="sp-cart-drawer">
  <div class="sp-cart-content">

    <!-- Header -->
    <div class="sp-cart-header">
      <button class="sp-back-btn" onclick="closeDossierCart()">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M10 12L6 8L10 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        {% render 'region--content', key: 'global.cart_drawer.back_button' %}
      </button>
    </div>

    {% if cart.items.size == 0 %}
      <!-- Empty Cart State - Full Drawer -->
      <div class="sp-empty-cart-full-container" id="sp-empty-cart-full-container">
        <div class="sp-empty-cart-content">
          <div class="sp-empty-title ui-label">{% render 'region--content', key: 'global.cart_drawer.empty.heading' %}</div>
          <p class="sp-empty-subtitle">{% render 'region--content', key: 'global.cart_drawer.empty.message' %}</p>
          <p class="sp-empty-help">{% render 'region--content', key: 'global.cart_drawer.empty.help' %}</p>

          <!-- Collections Grid -->
          <div class="sp-collections-grid">
            {% comment %} The collections offered in an empty cart: regions/<id>/content/global.json › cart_drawer.empty.collections {% endcomment %}
            {% capture collection_handles %}{% render 'region--content', key: 'global.cart_drawer.empty.collections.handles' %}{% endcapture %}
            {% capture collection_names %}{% render 'region--content', key: 'global.cart_drawer.empty.collections.names' %}{% endcapture %}
            {% assign collection_handles = collection_handles | split: ',' %}
            {% assign collection_names = collection_names | split: ',' %}

            {% for handle in collection_handles %}
              {% assign collection = collections[handle] %}
              {% assign collection_name = collection_names[forloop.index0] %}

              <a href="{{ collection.url | default: '/collections/all' }}" class="sp-collection-card" onclick="closeDossierCart()">
                <div class="sp-collection-image">
                  {% if collection.image %}
                    <img src="{{ collection.image | img_url: '120x120' }}" alt="{{ collection_name }}" loading="lazy">
                  {% else %}
                    <!-- Fallback placeholder based on collection type -->
                    <div class="sp-collection-placeholder" data-collection="{{ forloop.index }}">
                      {% case forloop.index %}
                        {% when 1 %}
                          <!-- Impressions placeholder -->
                          <div class="sp-bottles-group">
                            <div class="sp-bottle impressions"></div>
                            <div class="sp-bottle impressions-2"></div>
                            <div class="sp-bottle impressions-3"></div>
                          </div>
                        {% when 2 %}
                          <!-- Originals placeholder -->
                          <div class="sp-single-bottle originals"></div>
                        {% when 3 %}
                          <!-- Best-sellers placeholder -->
                          <div class="sp-bottles-group bestsellers">
                            <div class="sp-bottle best-1"></div>
                            <div class="sp-bottle best-2"></div>
                          </div>
                        {% when 4 %}
                          <!-- Home Scents placeholder -->
                          <div class="sp-single-bottle home-scents"></div>
                      {% endcase %}
                    </div>
                  {% endif %}
                </div>
                <h3 class="sp-collection-name">{{ collection_name }}</h3>
              </a>
            {% endfor %}
          </div>

          {%- comment -%}
            Relative, so it stays on the current storefront. It was an absolute
            link to the USA store's myshopify domain, which sent shoppers on
            every other storefront to the USA store.
          {%- endcomment %}
          <!-- Shop All Button -->
          <a href="{{ routes.collections_url }}/{% render 'region--content', key: 'global.cart_drawer.empty.button.collection' %}" class="sp-shop-all-btn" onclick="closeDossierCart()">
            {% render 'region--content', key: 'global.cart_drawer.empty.button.label' %}
          </a>

          <!-- Free Shipping Text -->
          <p class="sp-free-shipping-text">{% render 'region--content', key: 'global.cart_drawer.empty.free_shipping' %} {{ region_free_shipping }} </p>
        </div>
      </div>

      <!-- Hidden sections when cart is empty -->
      <div id="sp-full-cart-sections" style="display: none;">
    {% else %}
      <!-- Visible sections when cart has items -->
      <div id="sp-empty-cart-full-container" style="display: none;"></div>
      <div id="sp-full-cart-sections">
    {% endif %}

      <!-- Bundle Offers Section -->
      <div class="sp-bundle-section">
        <div class="sp-bundle-container">
          <div class="sp-bundle-header">
<img 
  src="{{ region_logo_url }}&width=200" 
  alt="{% render 'region--content', key: 'global.cart_drawer.logo_alt' %}" 
  class="sp-logo-image"
/>

            <div class="sp-info-icon">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                <circle cx="7" cy="7" r="6" stroke="#999" stroke-width="1"/>
                <path d="M7 5v4M7 9h.01" stroke="#999" stroke-width="1"/>
              </svg>
            </div>
          </div>


          <!-- Updated bundle tiers from 3 to 5 tiers with new discount and shipping structure -->
          <div class="sp-bundle-tiers">
            <div class="sp-tier" data-items="1">
              <div class="sp-tier-items">{% render 'region--content', key: 'global.cart_drawer.shipping.below' %} {{ region_free_shipping }}</div>
              <div class="sp-tier-discount">{{ region_shipping_cost }} {% render 'region--content', key: 'global.cart_drawer.shipping.label' %}</div>
            </div>
            <div class="sp-tier" data-items="2">
              <div class="sp-tier-items">{{ region_free_shipping }}+</div>
              <div class="sp-tier-discount">{% render 'region--content', key: 'global.cart_drawer.shipping.free_shipping' %}</div>
            </div>
          </div>
          <!-- Free Shipping Threshold -->
          <div class="sp-free-shipping">
            <div class="sp-shipping-circle">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <circle cx="8" cy="8" r="7" stroke="#666" stroke-width="2"/>
                <circle cx="8" cy="8" r="3" fill="#666"/>
              </svg>
            </div>
            <span><strong>{% render 'region--content', key: 'global.cart_drawer.shipping.free' %}</strong> {% render 'region--content', key: 'global.cart_drawer.shipping.on_orders_over' %} {{ region_free_shipping }} | {{ region_shipping_cost }} {% render 'region--content', key: 'global.cart_drawer.shipping.under' %} {{ region_free_shipping }}</span>
          </div>
        </div>
      </div>

      <!-- Login Section - Updated Design -->
      <div class="sp-login-section">
  <div class="sp-login-header">
    <button class="sp-go-to-summary" onclick="scrollToOrderSummary()">
      <span>{% render 'region--content', key: 'global.cart_drawer.order_summary_link' %}</span>
      <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
        <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    {% if customer %}
      <a href="{% render 'region--content', key: 'global.cart_drawer.account.view.link' %}" class="sp-login-link">{% render 'region--content', key: 'global.cart_drawer.account.view.label' %}</a>
    {% else %}
      <a href="{% render 'region--content', key: 'global.cart_drawer.account.login.link' %}" class="sp-login-link">{% render 'region--content', key: 'global.cart_drawer.account.login.label' %}</a>
    {% endif %}
  </div>
</div>

      <!-- Your Cart Section - ALL PRODUCTS VERTICAL -->
      <div class="sp-cart-section">
        <div class="sp-cart-container">
          <div class="sp-cart-header-section">
            <div class="sp-section-number">1</div>
            <div class="sp-cart-title ui-label">{% render 'region--content', key: 'global.cart_drawer.title' %}</div>
          </div>

          <div class="sp-cart-items-list" id="sp-cart-items-list">
            {% comment %} This content will be dynamically updated by JavaScript {% endcomment %}
            {% comment %} Initial render based on Liquid for first load {% endcomment %}
            {% assign total_cart_quantity = 0 %}
            {% for item in cart.items %}
              {% assign total_cart_quantity = total_cart_quantity | plus: item.quantity %}
            {% endfor %}

            <!-- SHIPPING LOGIC ONLY: No Discounts -->
            {% assign bundle_discount_percentage = 0 %}
            {% assign shipping_cost_cents = 499 %}

            {% for item in cart.items %}
              <div class="sp-product-item" data-key="{{ item.key }}" data-variant-id="{{ item.variant.id }}" data-inventory="{{ item.variant.inventory_quantity | default: 999 }}">
                <div class="sp-product-image-container">
                  <img src="{{ item.image | img_url: '120x120' }}" alt="{{ item.title }}" class="sp-product-image">
                </div>

                <div class="sp-product-details">
                  <div class="sp-product-header">
                    <h3 class="sp-product-title">{{ item.product.title | upcase }}</h3>
                    <div class="sp-product-pricing">
                      {% assign original_price_per_item = item.original_price %}
                      {% assign total_discounted_line_price = original_price_per_item | times: item.quantity %}

                      <span class="sp-discounted-price">
                        {{ region_currency_symbol }}<span class="price-value" data-single-price="{{ original_price_per_item | money_without_currency }}" data-original-single="{{ original_price_per_item | money_without_currency }}" data-discount="0">{{ total_discounted_line_price | money_without_currency }}</span>
                      </span>

                    </div>
                  </div>

                  <div class="sp-product-description">
                    {% if item.product.description != blank %}
                      {{ item.product.description | strip_html | truncate: 60 }}
                    {% else %}
                      Eau de Parfum, Size: {{ item.variant.option1 | default: '50ml' }} / 1.7oz
                    {% endif %}
                  </div>

                  <div class="sp-product-vendor">
                    {% if item.product.metafields.custom.inspired_by != blank %}
                      {% render 'region--content', key: 'global.cart_drawer.product.inspired_by' %} {{ item.product.metafields.custom.inspired_by }}
                    {% elsif item.vendor != blank and item.vendor != 'Your Store' %}
                      {{ item.vendor }}
                    {% else %}
                      {% render 'region--content', key: 'global.cart_drawer.product.brand_fallback' %}
                    {% endif %}
                  </div>

                  <div class="sp-product-actions">
                    <div class="sp-quantity-section">
                      <button class="sp-qty-decrease">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                          <path d="M3 7h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                      </button>
                      <span class="sp-quantity-display" data-quantity="{{ item.quantity }}">{{ item.quantity }}</span>
                      <button class="sp-qty-increase">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                          <path d="M7 3v8M3 7h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                      </button>
                    </div>

                    <button class="sp-remove-product" onclick="removeDossierCartItem('{{ item.key }}')">
                      <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                        <path d="M2.25 4.5h13.5M6 4.5V3a1.5 1.5 0 011.5-1.5h3A1.5 1.5 0 0112 3v1.5m3 0v10.5a1.5 1.5 0 01-1.5 1.5h-9A1.5 1.5 0 013 15V4.5h12z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      </div>


      <!-- Order Summary Section - Move this right after Pick the Way You Shop -->
      <div class="sp-order-summary-section" id="sp-order-summary">
        <div class="sp-summary-box">
          <div class="sp-section-header">
            <span class="sp-section-number">2</span>
            <div class="sp-section-title ui-label">{% render 'region--content', key: 'global.cart_drawer.summary.title' %}</div>
          </div>

          <div class="sp-summary-details">
            <div class="sp-summary-line">
              <span class="sp-summary-label"> {% render 'region--content', key: 'global.cart_drawer.summary.subtotal' %} </span>
              <span class="sp-summary-price" id="summary-initial-price">{{ region_currency_symbol }}0.00</span>
            </div>

            <div class="sp-summary-line">
              <span class="sp-summary-label">{% render 'region--content', key: 'global.cart_drawer.shipping.label' %}</span>
              <span class="sp-summary-price" id="sp-shipping-cost">{{ region_shipping_cost }}</span>
            </div>

            <div class="sp-summary-line sp-member-discount-line" id="member-discount-line" style="display: none;">
              <span>d<sup>+</sup> {% render 'region--content', key: 'global.cart_drawer.summary.discount' %}</span>
              <span id="summary-member-discount">-{{ region_currency_symbol }}0.00</span>
            </div>

            <div class="sp-tax-note" style="display: none;">
              <span>{% render 'region--content', key: 'global.cart_drawer.summary.tax_note' %}</span>
            </div>
          </div>
        </div>

        <!-- Move discount notice outside the box -->
        <div class="sp-discount-notice" id="discount-notice" style="display: none;">
          <div class="sp-check-icon">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <rect width="16" height="16" rx="8" fill="#e67e5b"/>
              <path d="M4.5 8l2.5 2.5 5-5" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <span>{% render 'region--content', key: 'global.cart_drawer.summary.discount_note' %}</span>
        </div>
      </div>

      <!-- You Might Like to Add Section -->
      <div class="sp-recommendations-section">
        <div class="sp-recommendations-title ui-label">{% render 'region--content', key: 'global.cart_drawer.recommendations.title' %}</div>

        <div class="sp-recommended-products">
          {% comment %} Get products from most-popular collection {% endcomment %}
          {% assign recommended_collection = collections['bestsellers'] %}
          {% if recommended_collection.products.size > 0 %}
            {% for product in recommended_collection.products limit: 10 %}
              <div class="sp-recommended-item" data-product-id="{{ product.id }}">
                <a href="{{ product.url }}" class="sp-rec-link">
                <div class="sp-rec-image">
                  {% if product.featured_image %}
                    <img src="{{ product.featured_image | img_url: '200x200' }}" alt="{{ product.title }}" class="sp-rec-product-image">
                  {% else %}
                    <div class="sp-rec-placeholder">
                      <div class="sp-single-bottle"></div>
                    </div>
                  {% endif %}
                </div>
                <div class="sp-rec-details">
                  <h4>{{ product.title | upcase }}</h4>
                  <p class="sp-rec-vendor">
                    {% if product.vendor and product.vendor != 'Your Store' %}
                      {{ product.vendor }}
                    {% else %}
                      {% render 'region--content', key: 'global.cart_drawer.product.brand_fallback' %}
                    {% endif %}
                  </p>
                  {% if product.metafields.custom.inspired_by %}
                    <p class="sp-rec-inspired">{% render 'region--content', key: 'global.cart_drawer.product.inspired_by' %} {{ product.metafields.custom.inspired_by }}</p>
                  {% endif %}
                  <div class="sp-rec-price">{{ region_currency_symbol }}{{ product.price | money_without_currency }}</div>
                </a>
                  <button class="sp-add-to-cart-btn" onclick="addDossierRecommended('{{ product.variants.first.id }}', '{{ product.title | escape }}', '{{ product.featured_image | img_url: '120x120' }}', {{ product.price }}, {{ product.compare_at_price | default: product.price }})">
                    {% render 'region--content', key: 'global.cart_drawer.recommendations.add_to_cart' %}
                  </button>
                </div>
              </div>
            {% endfor %}
          {% else %}
            {% comment %} Fallback products if collection doesn't exist {% endcomment %}
            <div class="sp-recommended-item">
              <div class="sp-rec-image">
                <div class="sp-rec-placeholder">
                  <div class="sp-bottles-group">
                    <div class="sp-bottle"></div>
                    <div class="sp-bottle"></div>
                    <div class="sp-bottle"></div>
                  </div>
                </div>
              </div>
              <div class="sp-rec-details">
                <h4>DISCOVERY SET</h4>
                <p class="sp-rec-vendor">{% render 'region--content', key: 'global.cart_drawer.product.brand_fallback' %}</p>
                <div class="sp-rec-price">{{ region_currency_symbol }}99</div>
                <button class="sp-add-to-cart-btn" onclick="addDossierRecommended('discovery-set')">
                  {% render 'region--content', key: 'global.cart_drawer.recommendations.add_to_cart' %}
                </button>
              </div>
            </div>

            <div class="sp-recommended-item">
              <div class="sp-rec-image">
                <div class="sp-rec-placeholder">
                  <div class="sp-single-bottle"></div>
                </div>
              </div>
              <div class="sp-rec-details">
                <h4>WOODY SAGE</h4>
                <p class="sp-rec-vendor">{% render 'region--content', key: 'global.cart_drawer.product.inspired_by' %}</p>
                <p class="sp-rec-inspired">Jo Malone's Wood Sage & Sea Salt</p>
                <div class="sp-rec-price">{{ region_currency_symbol }}29</div>
                <button class="sp-add-to-cart-btn" onclick="addDossierRecommended('woody-sage')">
                  {% render 'region--content', key: 'global.cart_drawer.recommendations.add_to_cart' %}
                </button>
              </div>
            </div>

            <div class="sp-recommended-item">
              <div class="sp-rec-image">
                <div class="sp-rec-placeholder">
                  <div class="sp-single-bottle citrus"></div>
                </div>
              </div>
              <div class="sp-rec-details">
                <h4>FLORA LAVENDER</h4>
                <p class="sp-rec-vendor">{% render 'region--content', key: 'global.cart_drawer.product.inspired_by' %}</p>
                <p class="sp-rec-inspired">YSL's Libre</p>
                <div class="sp-rec-price">{{ region_currency_symbol }}29</div>
                <button class="sp-add-to-cart-btn" onclick="addDossierRecommended('flora-lavender')">
                  {% render 'region--content', key: 'global.cart_drawer.recommendations.add_to_cart' %}
                </button>
              </div>
            </div>
          {% endif %}
        </div>
      </div>

      <!-- Checkout Button -->
      <div class="sp-checkout-section">
        <button class="sp-checkout-btn" onclick="proceedToDossierCheckout()">
          {% render 'region--content', key: 'global.cart_drawer.checkout_button' %}
          <span class="sp-checkout-total" id="checkout-total">{{ region_currency_symbol }}0.00</span>
        </button>


      </div>

    </div>
  </div>
</div>

<script>
  // var, not const: several sections declare this and a top-level const is a
  // global lexical binding, so the second one on the page throws and takes the
  // rest of its script with it.
  var currSym = (window.__STORE_CONFIG && window.__STORE_CONFIG.currencySymbol) || '{{ cart.currency.symbol }}' || '$';
// Global variables
let isUserLoggedIn = false;
let currentShopMethod = 'guest';
let isProcessingCartAction = false; // Added flag to prevent duplicate submissions

// Helper function to generate HTML for a single cart item
function generateCartItemHtml(item) {
  const originalPricePerItem = item.original_price;
  const totalDiscountedLinePrice = originalPricePerItem * item.quantity;

  const categoryBadge = 'Unisex';
  const description = `Eau de Parfum, Size: ${item.variant_options[0] || '50ml'} / 1.7oz`;
  const vendor = item.vendor && item.vendor !== 'Your Store' ? item.vendor : '{% render 'region--content', key: 'global.cart_drawer.product.brand_fallback', js: true %}';

  return `
    <div class="sp-product-item" data-key="${item.key}" data-variant-id="${item.variant_id}" data-inventory="${item.variant_inventory_quantity || 999}">
      <div class="sp-product-image-container">
        <img
          src="${item.image.replace(/(\.[^.]*)$/, '_200x$1')}"
          alt="${item.title}"
          class="sp-product-image"
          loading="lazy"
          width="80"
          height="100">
      </div>

      <div class="sp-product-details">
           <div class="sp-product-header">
  <h3 class="sp-product-title">
    ${
      // Keywords that make the title non-clickable
      !['SET', 'FAVOURITES', 'SIGNATURE', 'DISCOVERY SET'].some(keyword =>
        item.title.toUpperCase().includes(keyword)
      )
        ? `<a href="${item.url}" style="text-decoration: none; color: inherit;">
            ${item.title.toUpperCase()}
          </a>`
        : item.title.toUpperCase()
    }
  </h3>
  <div class="sp-product-pricing">
    <span class="sp-discounted-price">
      {{ region_currency_symbol }}<span class="price-value"
        data-single-price="${(originalPricePerItem / 100).toFixed(2)}"
        data-original-single="${(originalPricePerItem / 100).toFixed(2)}"
        data-discount="0">${(totalDiscountedLinePrice / 100).toFixed(2)}
      </span>
    </span>
  </div>
</div>

        <div class="sp-product-vendor">${vendor}</div>

        <!-- quantity and remove buttons -->
        <div class="sp-product-actions">
                  <div class="sp-quantity-section">
                      <button class="sp-qty-decrease">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                          <path d="M3 7h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                      </button>
                      <span class="sp-quantity-display" data-quantity="${item.quantity}">${item.quantity}</span>
                      <button class="sp-qty-increase">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                          <path d="M7 3v8M3 7h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                      </button>
                    </div>

          <button class="sp-remove-product" data-key="${item.key}" onclick="removeDossierCartItem(this.dataset.key)">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
              <path d="M2.25 4.5h13.5M6 4.5V3a1.5 1.5 0 011.5-1.5h3A1.5 1.5 0 0112 3v1.5m3 0v10.5a1.5 1.5 0 01-1.5 1.5h-9A1.5 1.5 0 013 15V4.5h12z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
  `;
}

// Main function to update the entire cart UI based on new cart data
function updateDossierCartUI(cart) {
  const emptyCartContainer = document.getElementById('sp-empty-cart-full-container');
  const fullCartSections = document.getElementById('sp-full-cart-sections');
  const cartItemsList = document.getElementById('sp-cart-items-list');
  {% comment %} const cartCount = document.querySelector('.cart-count, [data-cart-count]'); {% endcomment %}

  if (cart.item_count === 0) {
    if (emptyCartContainer) emptyCartContainer.style.display = 'flex';
    if (fullCartSections) fullCartSections.style.display = 'none';
  } else {
    if (emptyCartContainer) emptyCartContainer.style.display = 'none';
    if (fullCartSections) fullCartSections.style.display = 'block';

    // Re-render cart items
    let itemsHtml = '';
    
    cart.items.forEach(item => {
      itemsHtml += generateCartItemHtml(item);
    });



   if (cartItemsList) {
  cartItemsList.innerHTML = itemsHtml;

