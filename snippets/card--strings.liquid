{%- comment -%}
  The product card's interface wording (locale), for the scripts that set a
  card's labels: assets/card--product.js (badges) and the sections that host
  cards (their buttons after a size change, their alerts). Rendered once, in the
  page head (layout/theme.liquid), so it is there before any section's script
  runs. Tokens in [brackets] are filled in by the script.

  The button's states (Add to Cart, Adding..., Added!, Sold Out) are Shopify's
  products.product keys, the one wording every button that adds to the cart uses.
{%- endcomment -%}
<script type="application/json" id="cardStrings">
  {
    "badgeMen": {{ 'sections.product_card.badge_men' | t | json }},
    "badgeWomen": {{ 'sections.product_card.badge_women' | t | json }},
    "badgeUnisex": {{ 'sections.product_card.badge_unisex' | t | json }},
    "soldOut": {{ 'products.product.sold_out' | t | json }},
    "addToCart": {{ 'products.product.add_to_cart' | t | json }},
    "selectVariant": {{ 'sections.product_card.select_variant' | t | json }},
    "addFailed": {{ 'sections.product_card.add_failed' | t | json }},
    "addFailedRetry": {{ 'sections.product_card.add_failed_retry' | t | json }},
    "adding": {{ 'products.product.adding_to_cart' | t | json }},
    "added": {{ 'products.product.added_to_cart' | t | json }}
  }
</script>
