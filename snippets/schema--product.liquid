{%- comment -%}
  Structured Data: Product
  Google-compliant canonical Product schema with variant offers, dynamic pricing & currency.
  Blast radius: SEO metadata only. Non-blocking.
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant | default: product.variants.first
  assign currency = cart.currency.iso_code | default: shop.currency
  assign country_code = localization.country.iso_code | default: 'GB'
  assign price_valid_until = 'now' | date: '%s' | plus: 31536000 | date: '%Y-%m-%d'
-%}

<script type="application/ld+json" id="product-schema-{{ product.id }}">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": "{{ canonical_url }}#product",
  "name": {{ product.title | json }},
  "url": {{ canonical_url | json }},
  {%- if product.description != blank -%}
  "description": {{ product.description | strip_html | strip_newlines | truncate: 1000 | json }},
  {%- endif -%}
  {%- if product.images.size > 0 -%}
  "image": [
    {%- for image in product.images -%}
      {{ image | image_url: width: 1200 | prepend: 'https:' | json }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ],
  {%- endif -%}
  {%- if current_variant.sku != blank -%}
  "sku": {{ current_variant.sku | json }},
  {%- endif -%}
  {%- if current_variant.barcode != blank -%}
  "gtin": {{ current_variant.barcode | json }},
  {%- endif -%}
  "brand": {
    "@type": "Brand",
    "name": {{ product.vendor | default: "Scentspired" | json }}
  },
  "offers": [
    {%- for variant in product.variants -%}
      {
        "@type": "Offer",
        "@id": "{{ shop.url }}{{ variant.url }}",
        "name": {{ variant.title | json }},
        "price": "{{ variant.price | money_without_currency | remove: ',' }}",
        "priceCurrency": {{ currency | json }},
        "priceValidUntil": {{ price_valid_until | json }},
        "availability": "{% if variant.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
        "itemCondition": "https://schema.org/NewCondition",
        "url": "{{ shop.url }}{{ variant.url }}",
        {%- if variant.sku != blank -%}
        "sku": {{ variant.sku | json }},
        {%- endif -%}
        {%- if variant.barcode != blank -%}
        "gtin": {{ variant.barcode | json }},
        {%- endif -%}
        "seller": {
          "@id": "{{ shop.url }}/#organization"
        },
        "shippingDetails": {
          "@type": "OfferShippingDetails",
          "shippingRate": {
            "@type": "MonetaryAmount",
            "value": "{% if variant.price >= 7000 %}0.00{% else %}7.99{% endif %}",
            "currency": {{ currency | json }}
          },
          "shippingDestination": {
            "@type": "DefinedRegion",
            "addressCountry": {{ country_code | json }}
          },
          "deliveryTime": {
            "@type": "ShippingDeliveryTime",
            "transitTime": {
              "@type": "QuantitativeValue",
              "minValue": 3,
              "maxValue": 7,
              "unitCode": "DAY"
            }
          }
        },
        "hasMerchantReturnPolicy": {
          "@type": "MerchantReturnPolicy",
          "applicableCountry": {{ country_code | json }},
          "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
          "merchantReturnDays": 30,
          "returnMethod": "https://schema.org/ReturnByMail",
          "returnFees": "https://schema.org/ReturnShippingFees",
          "returnShippingFeesAmount": {
            "@type": "MonetaryAmount",
            "value": "4.99",
            "currency": {{ currency | json }}
          }
        }
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
  {%- if product.metafields.reviews.rating.value != blank and product.metafields.reviews.rating_count.value != blank and product.metafields.reviews.rating_count.value > 0 -%}
  ,
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "{{ product.metafields.reviews.rating.value.rating | round: 2 }}",
    "reviewCount": "{{ product.metafields.reviews.rating_count.value }}"
  }
  {%- endif -%}
}
</script>

<script>
  (function () {
    function addJudgeMeReviews() {
      if (
        typeof jdgm === "undefined" ||
        !jdgm.data ||
        !jdgm.data.reviewWidget
      ) {
        return;
      }

      var productId = {{ product.id }};
      var jdgmProduct = jdgm.data.reviewWidget[productId];

      if (
        !jdgmProduct ||
        !jdgmProduct.reviews ||
        !jdgmProduct.reviews.length
      ) {
        return;
      }

      var reviews = jdgmProduct.reviews.map(function(review){
        return {
          "@type": "Review",
          "author": {
            "@type": "Person",
            "name": review.reviewer_name || "Verified Customer"
          },
          "datePublished": review.created_at,
          "reviewBody": review.body,
          "reviewRating": {
            "@type": "Rating",
            "ratingValue": review.rating,
            "bestRating": "5",
            "worstRating": "1"
          }
        };
      });

      var scriptTag = document.getElementById("product-schema-{{ product.id }}");
      if (!scriptTag) return;

      try {
        var productSchema = JSON.parse(scriptTag.textContent);
        productSchema.review = reviews;
        scriptTag.textContent = JSON.stringify(productSchema);
      } catch (e) {
        // Safe non-blocking execution
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", function() {
        setTimeout(addJudgeMeReviews, 1000);
      });
    } else {
      setTimeout(addJudgeMeReviews, 1000);
    }
  })();
</script>
