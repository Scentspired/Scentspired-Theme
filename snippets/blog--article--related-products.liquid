{% comment %}
  Renders contextual related product recommendations for an article.
  Blast Radius: Strictly this file for article-to-product merchandising logic.

  Accepts:
  - article: {Object} Current article object (required)
  - collection: {Object} Optional curated collection to draw products from
  - auto_related: {Boolean} Automatically match products by tag if collection is blank (default: true)
  - heading: {String} Section heading (default: "Shop the scents")
  - products_to_show: {Number} Max products to display (default: 4)

  Usage:
  {% render 'article-related-products', article: article, collection: block.settings.collection, auto_related: true, products_to_show: 4 %}
{% endcomment %}

{%- assign max_products = products_to_show | default: 4 -%}
{%- assign heading_text = heading | default: "Shop the scents" -%}
{%- assign auto_match = auto_related | default: true -%}

{%- if collection != blank -%}
  <div class="blog-related{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    <h2 class="blog-related__heading">{{ heading_text | escape }}</h2>
    <div class="blog-related__grid">
      {%- for product in collection.products limit: max_products -%}
        {%- render "card-product",
          card_product: product,
          media_aspect_ratio: "adapt",
          image_shape: "default",
          show_secondary_image: true,
          show_vendor: false,
          show_rating: false
        -%}
      {%- endfor -%}
    </div>
  </div>
{%- elsif auto_match and article.tags.size > 0 -%}
  {%- assign products_shown = 0 -%}
  {%- capture products_html -%}
    {%- for coll in collections -%}
      {%- if products_shown >= max_products -%}{%- break -%}{%- endif -%}
      {%- for product in coll.products -%}
        {%- if products_shown >= max_products -%}{%- break -%}{%- endif -%}
        {%- for ptag in product.tags -%}
          {%- if article.tags contains ptag and products_shown < max_products -%}
            {%- render "card-product",
              card_product: product,
              media_aspect_ratio: "adapt",
              image_shape: "default",
              show_secondary_image: true,
              show_vendor: false,
              show_rating: false
            -%}
            {%- assign products_shown = products_shown | plus: 1 -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- if products_shown > 0 -%}
    <div class="blog-related{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <h2 class="blog-related__heading">{{ heading_text | escape }}</h2>
      <div class="blog-related__grid">
        {{ products_html }}
      </div>
    </div>
  {%- endif -%}
{%- endif -%}
